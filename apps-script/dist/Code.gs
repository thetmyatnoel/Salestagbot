   */
  addListOption: function (rec, seedRows) {
    return gasLocked(function () {
      gasInvalidate();
      rec = rec || {};
      var name = String(rec.list || '');
      if (CFG.LIST_NAMES.indexOf(name) < 0) throw new Error('addListOption: unknown list "' + name + '"');
      var ss = gasSpreadsheet(), created = false;
      if (!ss.getSheetByName('Lists')) {
        ensureListsTab(ss);
        created = true;
      }
      var res = listUpsert(gasListRows(name), rec, seedRows);
      if (res.ops.length) gasListsPersist(name, res.ops);
      if (res.ops.length || created) {
        SpreadsheetApp.flush();
        gasInvalidate();
        GAS_DASH_DIRTY = true;
      }
      return { status: res.status, key: res.key };
    }, 15000);
  },
  getSetting: function (key, def) {
    var rows = gasTable('Settings');
    for (var i = 0; i < rows.length; i++) if (String(rows[i].Key) === key && rows[i].Value !== '') return rows[i].Value;
    return def;
  },
  /**
   * One Settings value written by the sync server (round 6, revision 3: the owner's Shops screen and AI switch through a
   * phone's setting entry, core_sync.js, which whitelists the key). Under the lock, from a fresh read: the Value cell of the
   * row whose Key is key, or of a new row below the last one, is made plain text ('@') BEFORE the value goes in as a
   * string, as the Lists and Measurements writers do, so '09123456789' keeps its zero, '+95 9 777' its '+' and 'TRUE'
   * stays the text TRUE (Settings are read back through getValues). A member of gasStore, not a global: poc/run_gas.js has
   * a test helper of that name.
   */
  setSetting: function (key, value) {
    return gasLocked(function () {
      gasInvalidate();
      var k = String(key), v = String(value === null || value === undefined ? '' : value), sh = gasSheet('Settings'), row = null;
      gasTable('Settings').forEach(function (r) { if (!row && String(r.Key) === k) row = r; });
      if (row) {
        var cell = sh.getRange(row._row, 2);
        cell.setNumberFormat('@');
        cell.setValue(v);
      } else {
        var at = sh.getLastRow() + 1;
        gasEnsureRows(sh, at);
        var line = sh.getRange(at, 1, 1, 2);
        line.setNumberFormat('@');
        line.setValues([[k, v]]);
      }
      SpreadsheetApp.flush();
      gasInvalidate();
    }, 15000);
  },
  getMessage: function (key) {
    var rows = gasTable('Messages');
    for (var i = 0; i < rows.length; i++) if (String(rows[i].Key) === key && rows[i].Text !== '') return String(rows[i].Text);
    return null;
  },
  /**
   * Rewrite the Credits and Deposits tabs from the computed views, and fill the Customers
   * summary columns F:K (Bought..Visits) from customerSummaries(ports). The Customers tab is
   * never cleared: A:E is master data (name, phone, note), so only F:K is written, row by row.
   * The third argument is optional so older callers keep working; rebuildViews() in gas_main.js
   * should pass customerSummaries(ports) as well.
   * A Credits row is 15 cells: round 5 adds DueDay (the promised date, '' when none) and Overdue (a boolean). The whole
   * Day and DueDay columns are made plain text before the values go in: the tab is cleared and rewritten whole, and
   * without the format Sheets would turn 2026-12-30 into a Date.
   */
  refreshViews: function (credits, deposits, customers) {
    var cs = gasSheet('Credits');
    cs.clearContents();
    var crows = [CFG.CREDIT_COLS].concat(credits.map(function (c) {
      return [c.groupId, c.day, c.shop, c.customerId, c.customer, c.itemId, c.item, c.total, c.cash, c.payments, c.applied, c.owed, c.days,
              c.dueDay || '', c.overdue === true];
    }));
    ['Day', 'DueDay'].forEach(function (name) {
      cs.getRange(1, CFG.CREDIT_COLS.indexOf(name) + 1, cs.getMaxRows(), 1).setNumberFormat('@');
    });
    cs.getRange(1, 1, crows.length, CFG.CREDIT_COLS.length).setValues(crows);
    var ds = gasSheet('Deposits');
    ds.clearContents();
    var drows = [CFG.DEPOSIT_COLS].concat(deposits.map(function (d) {
      return [d.customerId, d.customer, d.received, d.used, d.held, d.lastDay, d.earmarked || ''];
    }));
    ds.getRange(1, 1, drows.length, CFG.DEPOSIT_COLS.length).setValues(drows);
    cs.getRange(1, 1, 1, CFG.CREDIT_COLS.length).setFontWeight('bold');
    ds.getRange(1, 1, 1, CFG.DEPOSIT_COLS.length).setFontWeight('bold');
    if (customers && customers.length !== undefined) gasWriteCustomerView(customers);
    SpreadsheetApp.flush();
  },
  logError: function (where, err, updateId, payload) {
    var msg = err && err.message ? err.message + (err.stack ? '\n' + String(err.stack).slice(0, 500) : '') : String(err);
    gasSheet('Errors').appendRow([new Date(), where, msg, updateId || '', String(payload || '').slice(0, 2000)]);
  },
  logUnknownUser: function (from, updateId) {
    gasSheet('Errors').appendRow([new Date(), 'unknown_user',
      'Not in Staff tab: ' + from.id + ' (' + [from.first_name, from.last_name, from.username].filter(Boolean).join(' ') + '). Add the id to Staff to allow.',
      updateId || '', JSON.stringify(from)]);
  }
};

/** Columns F:K of Customers (Bought, Paid, Owed, DepositHeld, LastVisit, Visits), one block write, A:E untouched. */
function gasWriteCustomerView(customers) {
  var rows = gasTable('Customers');
  if (!rows.length) return;
  var byId = {};
  customers.forEach(function (c) { byId[String(c.id || c.customerId)] = c; });
  var first = CFG.CUSTOMER_COLS.indexOf('Bought') + 1;
  var width = CFG.CUSTOMER_COLS.indexOf('Visits') - CFG.CUSTOMER_COLS.indexOf('Bought') + 1;
  var maxRow = rows.reduce(function (m, r) { return Math.max(m, r._row); }, 1);
  var block = [];
  for (var i = 2; i <= maxRow; i++) block.push(['', '', '', '', '', '']);
  rows.forEach(function (r) {
    var m = byId[String(r.CustomerID)];
    if (m) block[r._row - 2] = [m.bought, m.paid, m.owed, m.depositHeld, m.lastDay, m.visits];
  });
  if (block.length) gasSheet('Customers').getRange(2, first, block.length, width).setValues(block);
}

/**
 * The spreadsheet this script works on. A project created from the sheet
 * (Extensions > Apps Script) is bound to it; a standalone project created at
 * script.google.com/home reads Script Property SHEET_ID instead.
 */
function gasSpreadsheet() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  if (ss) return ss;
  var id = PropertiesService.getScriptProperties().getProperty('SHEET_ID');
  if (!id) throw new Error('Not bound to a sheet. Set Script Property SHEET_ID to the spreadsheet id (the long part of its URL).');
  return SpreadsheetApp.openById(id);
}

/* ======================================================================
 * gas_telegram.js
 * ====================================================================== */
/**
 * gas_telegram.js — the only file that talks to Telegram. Swap this file to
 * move the bot to another channel; the core never changes.
 */
function tgToken() {
  var t = PropertiesService.getScriptProperties().getProperty('BOT_TOKEN');
  if (!t) throw new Error('Script Property BOT_TOKEN is missing');
  return t;
}

function tg(method, payload) {
  var res = UrlFetchApp.fetch('https://api.telegram.org/bot' + tgToken() + '/' + method, {
    method: 'post', contentType: 'application/json', payload: JSON.stringify(payload || {}), muteHttpExceptions: true
  });
  var body = JSON.parse(res.getContentText() || '{}');
  if (!body.ok) throw new Error('Telegram ' + method + ': ' + res.getContentText().slice(0, 300));
  return body;
}

/** Same as tg() but multipart, for uploading files (sendDocument, sendPhoto with a blob). */
function tgUpload(method, payload) {
  var res = UrlFetchApp.fetch('https://api.telegram.org/bot' + tgToken() + '/' + method, {
    method: 'post', payload: payload, muteHttpExceptions: true
  });
  var body = JSON.parse(res.getContentText() || '{}');
  if (!body.ok) throw new Error('Telegram ' + method + ': ' + res.getContentText().slice(0, 300));
  return body;
}

function tgMarkup(keyboard) {
  return { inline_keyboard: keyboard && keyboard.length ? keyboard : [] };
}

var gasChat = {
  sendMessage: function (chatId, text, keyboard) {
    var r = tg('sendMessage', { chat_id: chatId, text: text, reply_markup: tgMarkup(keyboard) });
    return { messageId: r.result.message_id };
  },
  sendPhoto: function (chatId, photo, caption, keyboard) {
    try {
      var r = tg('sendPhoto', { chat_id: chatId, photo: photo, caption: caption, reply_markup: tgMarkup(keyboard) });
      return { messageId: r.result.message_id };
    } catch (err) {
      return gasChat.sendMessage(chatId, caption, keyboard);   // bad file id: degrade to text
    }
  },
  /** doc is a Blob from gasPdf.make. */
  sendDocument: function (chatId, doc, caption) {
    var r = tgUpload('sendDocument', { chat_id: String(chatId), caption: caption || '', document: doc });
    return { messageId: r.result.message_id };
  },
  editMessage: function (chatId, messageId, text, keyboard, isCaption) {
    var payload = { chat_id: chatId, message_id: messageId, reply_markup: tgMarkup(keyboard) };
    payload[isCaption ? 'caption' : 'text'] = text;
    try {
      tg(isCaption ? 'editMessageCaption' : 'editMessageText', payload);
    } catch (err) {
      if (String(err.message).indexOf('not modified') >= 0) return;
      return gasChat.sendMessage(chatId, text, keyboard);     // too old to edit: send instead (the core keeps the new id)
    }
  },
  answerCallback: function (id) {
    try { tg('answerCallbackQuery', { callback_query_id: id }); } catch (err) { /* stale query, ignore */ }
  },
  typing: function (chatId) {
    try { tg('sendChatAction', { chat_id: chatId, action: 'typing' }); } catch (err) { /* cosmetic */ }
  },
  /** Voice notes and photos, up to Telegram's 20 MB bot limit. Returns a Blob. */
  getFile: function (fileId) {
    var info = tg('getFile', { file_id: fileId });
    var url = 'https://api.telegram.org/file/bot' + tgToken() + '/' + info.result.file_path;
    var blob = UrlFetchApp.fetch(url).getBlob();
    var ext = String(info.result.file_path).split('.').pop().toLowerCase();
    if (ext === 'oga' || ext === 'ogg' || ext === 'opus') blob.setContentType('audio/ogg');
    if (ext === 'jpg' || ext === 'jpeg') blob.setContentType('image/jpeg');
    return blob;
  },
  /** Keep a copy of item photos in Drive for the catalog. Returns the Drive URL. */
  savePhoto: function (fileId, name) {
    var blob = gasChat.getFile(fileId).setName(name + '.jpg');
    var file = gasPhotoFolder().createFile(blob);
    return file.getUrl();
  }
};

function gasPhotoFolder() {
  var props = PropertiesService.getScriptProperties();
  var id = props.getProperty('PHOTO_FOLDER_ID');
  if (id) return DriveApp.getFolderById(id);
  var folder = DriveApp.createFolder('POS Photos');
  props.setProperty('PHOTO_FOLDER_ID', folder.getId());
  return folder;
}

/* ======================================================================
 * gas_gemini.js
 * ====================================================================== */
/**
 * gas_gemini.js — the only file that talks to Gemini.
 * Model name lives in Script Property GEMINI_MODEL so it can change without a deploy.
 * The key must be created from a country where the Gemini API is offered (Myanmar is not);
 * the calls themselves leave from Google's servers, never from a phone.
 */
function geminiCall(parts, schema, systemPrompt) {
  var props = PropertiesService.getScriptProperties();
  var key = props.getProperty('GEMINI_KEY');
  var model = props.getProperty('GEMINI_MODEL') || 'gemini-2.5-flash-lite';
  if (!key) throw new Error('Script Property GEMINI_KEY is missing');
  var body = {
    systemInstruction: { parts: [{ text: systemPrompt }] },
    contents: [{ parts: parts }],
    generationConfig: { temperature: 0, responseMimeType: 'application/json', responseSchema: schema }
  };
  var res = UrlFetchApp.fetch('https://generativelanguage.googleapis.com/v1beta/models/' + model + ':generateContent', {
    method: 'post', contentType: 'application/json', headers: { 'x-goog-api-key': key },
    payload: JSON.stringify(body), muteHttpExceptions: true
  });
  if (res.getResponseCode() !== 200) throw new Error('Gemini ' + res.getResponseCode() + ': ' + res.getContentText().slice(0, 300));
  var data = JSON.parse(res.getContentText());
  var text = data.candidates && data.candidates[0] && data.candidates[0].content.parts[0].text;
  if (!text) throw new Error('Gemini returned no text: ' + res.getContentText().slice(0, 300));
  return JSON.parse(text);
}

function inlinePart(blob, fallbackMime) {
  return { inlineData: { mimeType: blob.getContentType() || fallbackMime, data: Utilities.base64Encode(blob.getBytes()) } };
}

var gasAi = {
  parseVoice: function (blob, ctx) {
    return geminiCall([inlinePart(blob, 'audio/ogg'), { text: aiContextText(ctx) }], INTENT_SCHEMA, SYSTEM_PROMPT);
  },
  parseText: function (text, ctx) {
    return geminiCall([{ text: 'Staff wrote: ' + text }, { text: aiContextText(ctx) }], INTENT_SCHEMA, SYSTEM_PROMPT);
  },
  describePhoto: function (blob, ctx) {
    return geminiCall([inlinePart(blob, 'image/jpeg'), { text: 'Allowed categories: ' + (ctx.categories || CFG.CATEGORIES).join(', ') }], PHOTO_SCHEMA, PHOTO_PROMPT);
  },
  /** Handwritten notebook page -> lines. Gated by the notebook_import setting until the Phase 0 test passes. */
  readNotebook: function (blob, ctx) {
    var out = geminiCall([inlinePart(blob, 'image/jpeg'),
      { text: 'Known item names in this shop: ' + (ctx.itemNames || []).join(' | ') }], NOTEBOOK_SCHEMA, NOTEBOOK_PROMPT);
    return out && out.lines ? out.lines : [];
  },
  /**
   * A photo of the filled paper measurement sheet. The prompt and the response schema are built from the active
   * MeasureFields the bot passes (ctx.fields = [{key, labelMy, labelEn, multi, type}]), so a renamed or added field
   * reaches the model without a code change. Returns {fields: {key: 'text'}, low_confidence: [keys], name,
   * order_date, due_date, phone, notes}; blank cells are left out, every value is a trimmed string.
   */
  readMeasurementSheet: function (blob, ctx) {
    ctx = ctx || {};
    var fields = ctx.fields || [];
    var out = geminiCall([inlinePart(blob, 'image/jpeg'), { text: 'Customer chosen in the shop: ' + (ctx.customer || '') }],
      measurementSchema(fields), measurementPrompt(fields)) || {};
    var got = out.fields || {}, values = {};
    fields.forEach(function (f) {
      var v = got[f.key];
      if (v !== undefined && v !== null && String(v).trim() !== '') values[f.key] = String(v).trim();
    });
    return {
      fields: values,
      low_confidence: (out.low_confidence || []).filter(function (k) { return values[k] !== undefined; }),
      name: out.name || '', order_date: out.order_date || '', due_date: out.due_date || '', phone: out.phone || '', notes: out.notes || ''
    };
  }
};

/* ======================================================================
 * gas_pdf.js
 * ====================================================================== */
/**
 * gas_pdf.js — turns a report (core_report.js) into a PDF blob.
 * Writes the report into the hidden "Print" tab, exports that tab as A4 PDF
 * through the Sheets export endpoint, and returns the blob for Telegram.
 * Burmese text relies on the export's font handling; check the first real
 * PDF on a phone and switch the font below if any glyphs are missing.
 * Round 6, revision 3: a report with an image (the measurement PDF of a session with a drawing: report.image = {url,
 * caption}, core_orders.js measurementReport) ends with a caption row and GAS_PDF_IMAGE_ROWS blank rows that the
 * picture covers (240 x 360 px at the default row height, so the export's print range takes it in); the Drive file of
 * the URL is placed over them before the flush. A picture that cannot be fetched is one Errors row (pdf_image) and the
 * PDF prints without it. The Print tab's earlier pictures are removed first (clear() keeps over-grid images).
 */
var GAS_PDF_IMAGE_ROWS = 18;
var GAS_PDF_IMAGE_SIZE = { width: 240, height: 360 };

var gasPdf = {
  make: function (report) {
    var ss = gasSpreadsheet();
    var sh = ss.getSheetByName('Print') || ss.insertSheet('Print');
    sh.clear();
    sh.getImages().forEach(function (im) { im.remove(); });
    var rows = [], bold = [], numberRows = [];
    rows.push([report.title]); bold.push(rows.length);
    if (report.subtitle) rows.push([report.subtitle]);
    (report.sections || []).forEach(function (sec) {
      rows.push(['']);
      if (sec.heading) { rows.push([sec.heading]); bold.push(rows.length); }
      rows.push(sec.columns.slice()); bold.push(rows.length);
      sec.rows.forEach(function (r) { rows.push(r.slice()); numberRows.push(rows.length); });
      (sec.totals || []).forEach(function (r) { rows.push(r.slice()); bold.push(rows.length); numberRows.push(rows.length); });
    });
    if (report.footer) { rows.push(['']); rows.push([report.footer]); }
    var imageRow = 0;
    if (report.image && report.image.url) {
      rows.push(['']);
      rows.push([report.image.caption || '']); bold.push(rows.length);
      imageRow = rows.length + 1;
      for (var b = 0; b < GAS_PDF_IMAGE_ROWS; b++) rows.push(['']);
    }
    var width = rows.reduce(function (w, r) { return Math.max(w, r.length); }, 1);
    var padded = rows.map(function (r) { while (r.length < width) r.push(''); return r; });
    var range = sh.getRange(1, 1, padded.length, width);
    range.setValues(padded);
    range.setFontFamily('Noto Sans Myanmar');
    range.setFontSize(10);
    range.setVerticalAlignment('top');
    sh.getRange(1, 1).setFontSize(14);
    bold.forEach(function (r) { sh.getRange(r, 1, 1, width).setFontWeight('bold'); });
    numberRows.forEach(function (r) { sh.getRange(r, 1, 1, width).setNumberFormat('#,##0'); });
    sh.autoResizeColumns(1, width);
    if (imageRow) {
      try {
        var id = /[-\w]{25,}/.exec(String(report.image.url));
        if (!id) throw new Error('no Drive file id in ' + report.image.url);
        sh.insertImage(DriveApp.getFileById(id[0]).getBlob(), 1, imageRow).setWidth(GAS_PDF_IMAGE_SIZE.width).setHeight(GAS_PDF_IMAGE_SIZE.height);
      } catch (err) {
        try { gasStore.logError('pdf_image', err, '', String(report.image.url)); } catch (ignore) {}
      }
    }
    SpreadsheetApp.flush();

    var url = ss.getUrl().replace(/\/edit.*$/, '') + '/export?format=pdf&gid=' + sh.getSheetId() +
      '&size=A4&portrait=true&fitw=true&gridlines=false&printtitle=false&sheetnames=false&pagenum=UNDEFINED&fzr=false' +
      '&top_margin=0.5&bottom_margin=0.5&left_margin=0.5&right_margin=0.5';
    var res = UrlFetchApp.fetch(url, { headers: { Authorization: 'Bearer ' + ScriptApp.getOAuthToken() }, muteHttpExceptions: true });
    if (res.getResponseCode() !== 200) throw new Error('PDF export ' + res.getResponseCode() + ': ' + res.getContentText().slice(0, 200));
    return res.getBlob().setName((report.fileName || 'report') + '.pdf').setContentType('application/pdf');
  }
};

/** Manual check from the editor: builds this month's PDF and saves it to Drive. */
function previewMonthlyPdf() {
  var ports = buildPorts();
  var blob = gasPdf.make(buildReport(ports, 'month', { shop: null, now: new Date() }));
  var file = DriveApp.createFile(blob);
  Logger.log('Saved ' + file.getName() + ' at ' + file.getUrl());
}

/* ======================================================================
 * gas_import.js
 * ====================================================================== */
/**
 * gas_import.js — one-time import of the product list from the old software.
 *
 * 1. Export the product list from the current POS as Excel or CSV.
 * 2. Paste it into the "Import" tab under the headers:
 *    Code | Name | Category | Type | Price | Cost | Stock | Shop
 *    Type is UNIQUE or SKU (blank = SKU). Shop is S1 or S2. Category: a name of the Lists tab's item_category (a
 *    built-in's old name finds its row); another name becomes the catch-all.
 * 3. Run importProductsFromSheet() from the editor. The log shows what was imported and skipped.
 *
 * Codes that already match a blank tag id (S1-0042) are used directly; any other code
 * becomes the Alias of the next blank tag in that shop, so the old code still finds the item.
 */
function importProductsFromSheet() {
  var rows = gasTable('Import').map(function (o) {
    return { Code: o.Code, Name: o.Name, Category: o.Category, Type: o.Type, Price: o.Price, Cost: o.Cost, Stock: o.Stock, Shop: o.Shop };
  });
  if (!rows.length) { Logger.log('Import tab is empty.'); return; }
  var owner = gasStore.listStaff().filter(function (s) { return s.role === 'owner'; })[0] || { id: 'import', name: 'import', shop: 'S1', role: 'owner' };
  var result = importProducts(buildPorts(), rows, owner);
  Logger.log('Imported ' + result.done.length + ', skipped ' + result.skipped.length);
  result.done.forEach(function (d) { Logger.log('  ' + d.code + ' -> ' + d.id + (d.alias ? ' (alias ' + d.alias + ')' : '') + ' stock ' + d.stock); });
  result.skipped.forEach(function (s) { Logger.log('  skipped ' + s.code + ': ' + s.reason); });
}

/* ======================================================================
 * gas_setup.js
 * ====================================================================== */
/**
 * gas_setup.js — run setupSheet() once from the Apps Script editor.
 * Creates every tab with headers, formulas, defaults and 200 blank tag ids per shop.
 * Safe to re-run: it only adds what is missing (and always rewrites the Dashboard).
 * On an existing sheet it also appends the columns this version added (Ledger Method and
 * Category, Customers Bought..Visits). It never writes into existing Ledger rows: a blank
 * Method on an old row already reads as CASH everywhere (methodOf in core_ledger.js, the
 * Dashboard formulas). backfillMethod() below is an optional one-time migration the
 * maintainer runs on purpose from the editor, never from here.
 * The Lists tab (ensureListsTab): one row per option the buttons offer. Created here, seeded once
 * from the Settings rows of the version before (pay_methods, expense_categories, fabric_presets and
 * the Messages labels) and, last, the five built-in item categories (item_category, round 6b); from then
 * on the tab wins and the family edits it on the laptop.
 * Round 5, on a round-4 sheet (run it right after publishing the server): the Ledger grows to 27 columns with DueDay
 * last (plain text), the Lists tab gets Kind as its ninth column with a dropdown, the Credits header becomes 15 wide
 * (DueDay, Overdue), Settings gets sale_flow and sale_due_presets, Messages the new keys, and the Dashboard's
 * Overdue cell reads the Credits Overdue column. A second run changes nothing.
 * Round 6: sale_flow is form (the app's forms and the Telegram review card) or quick (the one-tap card); a round-5 value
 * steps is rewritten to form, and a round-5 default note to the round-6 one. Revision 3: the ai row (TRUE), its note, a
 * note on each shop's name, brand, address and phone row (one set per CFG.SHOP_IDS) and one conditional-format rule that
 * colours that Shops block wherever its rows are; no row moves and no typed value is touched.
 * Round 6b: the sample toggle's two default texts (🧵 → 🎨) are rewritten where the tab still holds round 3's exact text;
 * the Lists tab's first seed writes item_category's five built-in rows after the three round-4 lists, and the List header
 * note explains them (lists_note_item_category).
 */
function setupSheet() {
  var ss = gasSpreadsheet();
  ss.setSpreadsheetTimeZone('Asia/Yangon');

  var items = ensureTab(ss, 'Items', CFG.ITEM_COLS);
  var ledger = ensureTab(ss, 'Ledger', CFG.LEDGER_COLS);
  ensureTab(ss, 'Staff', CFG.STAFF_COLS);
  var settings = ensureTab(ss, 'Settings', ['Key', 'Value']);
  var messages = ensureTab(ss, 'Messages', ['Key', 'Text']);
  ensureTab(ss, 'Errors', CFG.ERROR_COLS);
  var customers = ensureTab(ss, 'Customers', CFG.CUSTOMER_COLS);
  // Existing sheets: append any header this version added, at the end, so formulas keep their letters.
  ensureColumns(items, CFG.ITEM_COLS);
  ensureColumns(ledger, CFG.LEDGER_COLS);
  ensureColumns(customers, CFG.CUSTOMER_COLS);
  // Credits is a view rewritten whole by refreshViews, but the Dashboard reads its columns by letter: an existing tab
  // gets the round-5 headers (DueDay, Overdue) now, not only at the next credit write.
  var credits = ensureTab(ss, 'Credits', CFG.CREDIT_COLS);
  ensureColumns(credits, CFG.CREDIT_COLS);
  ensureTab(ss, 'Deposits', CFG.DEPOSIT_COLS);
  var imp = ensureTab(ss, 'Import', CFG.IMPORT_COLS);
  var print = ensureTab(ss, 'Print', []);
  var dash = ensureTab(ss, 'Dashboard', []);
  setupTailoringTabs(ss);

  textColumn(ledger, CFG.LEDGER_COLS, 'Day');        // Day stays text, never auto-dated
  textColumn(ledger, CFG.LEDGER_COLS, 'Time');
  textColumn(ledger, CFG.LEDGER_COLS, 'Method');
  textColumn(ledger, CFG.LEDGER_COLS, 'Category');
  textColumn(ledger, CFG.LEDGER_COLS, 'DueDay');     // the promised date of a part-paid sale, text like Day
  textColumn(customers, CFG.CUSTOMER_COLS, 'Phone');  // 09... must keep its leading zero
  items.getRange('A:A').setNumberFormat('@');
  imp.getRange('A:A').setNumberFormat('@');

  // The rows of each shop come from CFG.SHOP_IDS (amendment F10b: an id added there gets its name, voucher number and
  // letterhead rows here too, in the same places as S1's and S2's; like every default, only when the key is missing).
  var shopRows = function (rowsOf) { var out = []; CFG.SHOP_IDS.forEach(function (id) { out = out.concat(rowsOf(id)); }); return out; };
  var defaults = [].concat(shopRows(function (id) { return [['shop_name_' + id, CFG.SHOP_NAMES[id] || id]]; }), [
    ['low_stock_threshold', 2], ['summary_hour', 21],
    ['price_presets', '10000,15000,20000,25000,30000'], ['deposit_presets', '50000,100000,200000,300000'],
    ['notebook_import', 'FALSE'], ['text_cards', 'FALSE'], ['group_chat_id', ''],
    // Payment methods (CASH first; the others become the 🏦 buttons). Keys are short ASCII codes of at most
    // CFG.METHOD_KEY_MAX_BYTES (12) bytes: they travel inside the 64-byte callback data (PM|<group id>|<KEY>);
    // a longer key is left out of the buttons and logged. The Burmese label goes in Messages as method_<KEY>.
    // Then expense categories as key:label and the expense amount presets.
    // pay_methods, expense_categories and fabric_presets are what the Lists tab is seeded from (ensureListsTab
    // below) and what the core reads while that tab has no rows; once it has rows, the tab wins.
    ['pay_methods', CFG.DEFAULT_PAY_METHODS.join(',')],
    ['expense_categories', CFG.EXPENSE_CATEGORIES.map(function (c) { return c[0] + ':' + c[1]; }).join(',')],
    ['expense_presets', CFG.EXPENSE_PRESETS.join(',')],
    ['pc_pin', '']
    // Custom tailoring: the NEXT voucher number of each shop's paper book (type the number on the next blank page),
    // fabric and due-date buttons, the reminder window of the 21:00 summary, and each shop's letterhead for the
    // voucher and the measurement sheet (brand, address, phones).
  ], shopRows(function (id) { return [['order_next_no_' + id, 1]]; }), [
    ['fabric_presets', CFG.FABRIC_PRESETS.join(',')], ['due_presets', CFG.DUE_PRESETS.join(',')],
    ['order_remind_days', CFG.ORDER_REMIND_DAYS]
  ], shopRows(function (id) { return [['shop_brand_' + id, ''], ['shop_address_' + id, ''], ['shop_phone_' + id, '']]; }), [
    // The sale (round 6): form = the app's forms and the Telegram review card, one write at Save; quick = the one-tap
    // card. Then the day buttons of "when is the rest paid" (days from today).
    ['sale_flow', CFG.SALE_FLOW.FORM], ['sale_due_presets', CFG.SALE_DUE_PRESETS.join(',')],
    // The owner's one AI switch (round 6, revision 3): TRUE keeps today's behaviour; the app's Settings can turn it off.
    ['ai', 'TRUE']
  ]);
  var have = gasTable('Settings').map(function (r) { return String(r.Key); });
  defaults.forEach(function (d) { if (have.indexOf(d[0]) < 0) settings.appendRow(d); });
  gasInvalidate();   // writeDashboard below reads expense_categories through the store
  // A round-5 book says steps (one question per screen): the word its note no longer explains becomes form.
  gasTable('Settings').forEach(function (r) {
    if (String(r.Key) === 'sale_flow' && String(r.Value === undefined || r.Value === null ? '' : r.Value).trim().toLowerCase() === 'steps') {
      settings.getRange(r._row, 2).setValue(CFG.SALE_FLOW.FORM);
    }
  });
  gasInvalidate();

  var haveMsg = gasTable('Messages').map(function (r) { return String(r.Key); });
  var missing = Object.keys(MSG).filter(function (k) { return haveMsg.indexOf(k) < 0; }).map(function (k) { return [k, MSG[k]]; });
  if (missing.length) messages.getRange(messages.getLastRow() + 1, 1, missing.length, 2).setValues(missing);
  // Nicety, in its own try/catch: the Key cell of the sale_flow row explains its two values (Messages settings_note_sale_flow).
  try {
    gasInvalidate();
    // Round 5's default text of that note (exactly) becomes round 6's; a text the family typed is kept.
    gasTable('Messages').forEach(function (r) {
      if (String(r.Key) === 'settings_note_sale_flow' && String(r.Text) === 'steps = တစ်ဆင့်ချင်း မေး · quick = ခလုတ်တစ်ချက် ရောင်း') {
        messages.getRange(r._row, 2).setValue(MSG.settings_note_sale_flow);
      }
    });
    gasInvalidate();
    var flowRow = 0;
    gasTable('Settings').forEach(function (r) { if (!flowRow && String(r.Key) === 'sale_flow') flowRow = r._row; });
    if (flowRow) settings.getRange(flowRow, 1).setNote(t({ store: gasStore }, 'settings_note_sale_flow'));
  } catch (err) {
    try { gasStore.logError('setup', 'Settings sale_flow note: ' + (err && err.message ? err.message : err), '', ''); } catch (ignore) {}
  }
  // Round 6b, in its own try/catch: the sample toggle's two texts of round 3 (exactly, with 🧵) become the 🎨 ones, because
  // t() reads this tab first; a text the family typed is kept, and a second run finds nothing to rewrite.
  try {
    gasInvalidate();
    var oldSample = { btn_sample_on: '🧵 နမူနာ: ဟုတ်', btn_sample_off: '🧵 နမူနာ: မဟုတ်' };
    gasTable('Messages').forEach(function (r) {
      var key = String(r.Key);
      if (Object.prototype.hasOwnProperty.call(oldSample, key) && String(r.Text) === oldSample[key]) messages.getRange(r._row, 2).setValue(MSG[key]);
    });
    gasInvalidate();
  } catch (err) {
    try { gasStore.logError('setup', 'Messages sample texts: ' + (err && err.message ? err.message : err), '', ''); } catch (ignore) {}
  }
  // Niceties of revision 3, in their own try/catch: the ai row's note, a note on each shop's rows (one set per id of
  // CFG.SHOP_IDS: name, brand, address, phone) and ONE conditional-format rule that colours those rows (the Shops block).
  try {
    gasInvalidate();
    var ports = { store: gasStore }, shopKey = {}, fields = ['name', 'brand', 'address', 'phone'];
    CFG.SHOP_IDS.forEach(function (id, i) {
      fields.forEach(function (f) { shopKey['shop_' + f + '_' + id] = t(ports, 'settings_note_shop_' + f, { n: myDigits(i + 1) }); });
    });
    gasTable('Settings').forEach(function (r) {
      var key = String(r.Key);
      if (key === 'ai') settings.getRange(r._row, 1).setNote(t(ports, 'settings_note_ai'));
      else if (Object.prototype.hasOwnProperty.call(shopKey, key)) settings.getRange(r._row, 1).setNote(shopKey[key]);
    });
    var rule = SpreadsheetApp.newConditionalFormatRule()
      .whenFormulaSatisfied('=REGEXMATCH($A2,"^shop_(' + fields.join('|') + ')_(' + CFG.SHOP_IDS.join('|') + ')$")')
      .setBackground('#e3e7f7').setRanges([settings.getRange(2, 1, Math.max(1, settings.getMaxRows() - 1), 2)]).build();
    settings.setConditionalFormatRules([rule]);
  } catch (err) {
    try { gasStore.logError('setup', 'Settings Shops block: ' + (err && err.message ? err.message : err), '', ''); } catch (ignore) {}
  }

  if (items.getLastRow() < 2) {
    generateBlankTags('S1', 1, 200);
    generateBlankTags('S2', 1, 200);
  }

  print.hideSheet();
  ensureListsTab(ss);   // before the Dashboard: its category and account blocks are built from the lists
  writeDashboard(dash);
  protectTab(items);
  protectTab(ledger);
  gasInvalidate();
  Logger.log('Sheet ready. Next: add your Telegram id to Staff, set Script Properties, deploy, registerWebhook(). ' +
    'Then run rebuildViews() to fill the Customers summary columns, and backfillSync() once (gas_sync.js) on a sheet that has rows from before the sync version.');
}

/**
 * The custom-tailoring tabs (core_orders.js). Orders and OrderItems: master data with text day/time columns.
 * MeasureFields: seeded once from CFG.MEASURE_FIELDS (the unified paper form); afterwards the family renames,
 * reorders or sets Active FALSE there, and never changes a Key that was used. Measurements: the fixed columns
 * plus one column per MeasureFields key, every cell plain text ('@') so '36/30/20' or '7/3/20' never become
 * dates and '17.5' keeps its form. Designs: the catalogue of design codes (TSL-0018) with base price and days.
 */
function setupTailoringTabs(ss) {
  var orders = ensureTab(ss, 'Orders', CFG.ORDER_COLS);
  ensureColumns(orders, CFG.ORDER_COLS);
  ['OrderID', 'OrderedDay', 'DueDay', 'DeliveredDay', 'StatusAt', 'CreatedAt', 'VoucherSentAt'].forEach(function (c) { textColumn(orders, CFG.ORDER_COLS, c); });
  var lines = ensureTab(ss, 'OrderItems', CFG.ORDER_ITEM_COLS);
  ensureColumns(lines, CFG.ORDER_ITEM_COLS);
  textColumn(lines, CFG.ORDER_ITEM_COLS, 'OrderID');
  textColumn(lines, CFG.ORDER_ITEM_COLS, 'DesignCode');
  var designs = ensureTab(ss, 'Designs', CFG.DESIGN_COLS);
  ensureColumns(designs, CFG.DESIGN_COLS);
  textColumn(designs, CFG.DESIGN_COLS, 'DesignCode');
  var fields = ensureTab(ss, 'MeasureFields', CFG.MEAS_FIELD_COLS);
  ensureColumns(fields, CFG.MEAS_FIELD_COLS);
  if (fields.getLastRow() < 2) {
    fields.getRange(2, 1, CFG.MEASURE_FIELDS.length, CFG.MEAS_FIELD_COLS.length).setValues(CFG.MEASURE_FIELDS.map(function (f, i) {
      return [f[0], f[1], f[2], f[3], f[4], f[5], i + 1, true];
    }));
  }
  gasInvalidate();
  var keys = gasTable('MeasureFields').map(function (r) { return String(r.Key || ''); }).filter(function (k) { return k !== ''; });
  var measCols = CFG.MEAS_FIXED_COLS.concat(keys);
  // A new tab has 26 columns; 9 fixed + 32 fields do not fit, and writing past the grid fails. On a tab set up before
  // EntryID, ensureColumns appends it after the field keys (every reader goes by the header).
  var measSheet = ss.getSheetByName('Measurements') || ss.insertSheet('Measurements');
  var haveCols = measSheet.getLastRow() ? gasHeader(measSheet).filter(function (h) { return h !== ''; }) : [];
  gasEnsureWidth(measSheet, haveCols.length + measCols.filter(function (c) { return haveCols.indexOf(c) < 0; }).length);
  var meas = ensureTab(ss, 'Measurements', measCols);
  ensureColumns(meas, measCols);
  meas.getRange(1, 1, meas.getMaxRows(), Math.max(meas.getLastColumn(), measCols.length)).setNumberFormat('@');
  gasInvalidate();
}

/**
 * The Lists tab: one row per option the buttons offer (List, Key, Label, Active, Order, Shop, Detail, Note, Kind) for
 * the three lists pay_method (bank and wallet accounts), expense_category and fabric. Idempotent. setupSheet()
 * runs it, and so does gasStore.addListOption on a sheet that has no Lists tab yet. Kind (round 5) is wallet or bank
 * on a pay_method row; blank is a wallet (the legacy BANK key is a bank by name). In this order:
 *  1. the tab and its header (a round-4 tab gets Kind as its ninth column, at the right-hand end);
 *  2. Key, Label, Detail and Note become plain text BEFORE any value is written: an account number such as
 *     09777123456 must keep its leading zero (it is what receipts print). This is part of the contract and
 *     deliberately not inside a try/catch: a failure stops here with its error;
 *  3. a tab without rows is seeded from the lists of the version before (legacyListRows: Settings pay_methods
 *     with the Messages labels, expense_categories, fabric_presets), every row active, Order 1..n, Shop blank;
 *  4. a row that has a Key and a blank Active gets TRUE, so the box shows what the code does (a blank Active
 *     counts as active); a cell that holds FALSE is never changed;
 *  5. niceties, each in its own try/catch (a failure is logged to Errors and setup goes on): tick boxes on Active
 *     through a data-validation rule, dropdowns on List, Shop and Kind from row 2, the Burmese notes on the header
 *     cells (Messages lists_note_<column>), and two red highlights (a key used twice in one list, a row without
 *     a label), set as the sheet's only conditional-format rules so that a second run adds none.
 *     NEVER Range.insertCheckboxes(): it sets every cell of its range to FALSE and would switch every option off;
 *  6. the per-execution table cache is dropped, so writeDashboard() reads the seeded rows.
 * Under the script lock (gasLocked is re-entrant), so a ➕ tapped in the bot while setupSheet() runs cannot seed
 * the tab a second time.
 */
function ensureListsTab(ss) {
  return gasLocked(function () {
    var ports = gasListsPorts();
    var sh = ensureTab(ss, 'Lists', CFG.LIST_COLS);
    ensureColumns(sh, CFG.LIST_COLS);
    var header = gasHeader(sh);
    function col(name) {
      var c = header.indexOf(name) + 1;
      if (c < 1) throw new Error('The Lists tab has no "' + name + '" column.');
      return c;
    }
    var maxRows = sh.getMaxRows();
    GAS_LIST_TEXT_COLS.forEach(function (name) { sh.getRange(1, col(name), maxRows, 1).setNumberFormat('@'); });
    gasInvalidate();   // from here on every table is read again: the caller's Lists, Settings and Messages may be older
    if (gasListsLastRow() < 2) {
      var seed = [];
      CFG.LIST_NAMES.forEach(function (name) {
        legacyListRows(ports, name).forEach(function (r, i) {
          seed.push({ list: name, key: r.key, label: r.label, active: true, order: i + 1, shop: '', detail: r.detail, note: r.note });
        });
      });
      gasListsWriteRows(sh, header, 2, seed);
      SpreadsheetApp.flush();
      gasInvalidate();
    }
    gasListsFillActive(sh);

    function nicety(what, fn) {
      try { fn(); } catch (err) {
        try { gasStore.logError('lists_setup', 'Lists tab, ' + what + ': ' + (err && err.message ? err.message : err), '', ''); } catch (ignore) {}
      }
    }
    function below(name) { return sh.getRange(2, col(name), sh.getMaxRows() - 1, 1); }   // from row 2: never the header
    nicety('Active tick boxes', function () {
      below('Active').setDataValidation(SpreadsheetApp.newDataValidation().requireCheckbox().build());
    });
    nicety('List dropdown', function () {
      below('List').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(CFG.LIST_NAMES, true).setAllowInvalid(false).build());
    });
    nicety('Shop dropdown', function () {   // a blank Shop (both shops) stays allowed: a rule never rejects an empty cell
      below('Shop').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(CFG.SHOP_IDS, true).setAllowInvalid(false).build());
    });
    nicety('Kind dropdown', function () {   // a blank Kind stays allowed: a wallet, or a bank by name for the legacy BANK key
      below('Kind').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(CFG.LIST_KINDS, true).setAllowInvalid(false).build());
    });
    nicety('header notes', function () {
      CFG.LIST_COLS.forEach(function (name) {
        // Round 6b: the List cell also explains the item_category rows (rename = new pieces only, the catch-all last, ➕).
        var note = t(ports, 'lists_note_' + name.toLowerCase());
        if (name === 'List') note += '\n' + t(ports, 'lists_note_item_category');
        sh.getRange(1, col(name)).setNote(note);
      });
    });
    nicety('highlights', function () {
      var L = colLetter(header, 'List'), K = colLetter(header, 'Key'), B = colLetter(header, 'Label'), red = '#f4c7c3';
      var dupRule = SpreadsheetApp.newConditionalFormatRule()
        .whenFormulaSatisfied('=AND($' + K + '2<>"",COUNTIFS($' + L + '$2:$' + L + ',$' + L + '2,$' + K + '$2:$' + K + ',$' + K + '2)>1)')
        .setBackground(red).setRanges([below('Key')]).build();
      var blankLabelRule = SpreadsheetApp.newConditionalFormatRule()
        .whenFormulaSatisfied('=AND($' + K + '2<>"",$' + B + '2="")')
        .setBackground(red).setRanges([below('Label')]).build();
      sh.setConditionalFormatRules([dupRule, blankLabelRule]);
    });
    gasInvalidate();
    return sh;
  }, 15000);
}

/**
 * The ports the Lists readers of this file use (ensureListsTab's seed and header notes, writeDashboard): the store
 * and the Script cache of buildPorts(). The cache matters for the warnings about a Lists row (a key holding '|', a
 * pay_method key that is too long): listWarnOnce (core_ledger.js) logs each once per 6 hours through it. Without it
 * every hand edit of the Lists tab (onEdit), every Dashboard rewrite and every setupSheet() run would add the same
 * Errors row again.
 */
function gasListsPorts() {
  return { store: gasStore, cache: buildPorts().cache };
}

/**
 * Write TRUE into the Active cell of every Lists row that has a Key and a blank Active (a row the family typed
 * by hand: a blank Active already counts as active, and now its box shows it). Only blank cells are written,
 * one by one: a cell that holds FALSE (an option switched off) is never touched. Returns how many were filled.
 */
function gasListsFillActive(sh) {
  var header = gasHeader(sh), keyCol = header.indexOf('Key') + 1, activeCol = header.indexOf('Active') + 1, last = sh.getLastRow();
  if (keyCol < 1 || activeCol < 1 || last < 2) return 0;
  var keys = sh.getRange(2, keyCol, last - 1, 1).getValues(), active = sh.getRange(2, activeCol, last - 1, 1).getValues(), filled = 0;
  for (var i = 0; i < keys.length; i++) {
    var k = keys[i][0], a = active[i][0];
    if (k === null || k === undefined || String(k).trim() === '') continue;
    if (a === '' || a === null || a === undefined) {
      sh.getRange(i + 2, activeCol).setValue(true);
      filled++;
    }
  }
  if (filled) {
    SpreadsheetApp.flush();
    gasInvalidate();
  }
  return filled;
}

/** The tab, created when missing; an empty tab gets the header, the grid grown first (a new tab has 26 columns). */
function ensureTab(ss, name, header) {
  var sh = ss.getSheetByName(name) || ss.insertSheet(name);
  if (header.length && sh.getLastRow() === 0) {
    gasEnsureWidth(sh, header.length);
    sh.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
    sh.setFrozenRows(1);
  }
  return sh;
}

/**
 * Add the headers of cols that row 1 does not have yet. Never moves or renames an existing one. A missing name whose
 * own cell (its place in cols) is a blank inside the header row goes back into that cell (a header cell somebody
 * cleared, with the columns after it still in place); every other missing name is appended after the last non-empty
 * header cell, in cols order, so formulas keep their letters. The grid grows first (a tab has 26 columns, and a tab
 * whose spare columns were deleted has fewer; writing past the grid fails).
 */
function ensureColumns(sh, cols) {
  var last = Math.max(1, sh.getLastColumn());
  var have = sh.getRange(1, 1, 1, last).getValues()[0].map(function (v) { return String(v); });
  var missing = cols.filter(function (c) { return have.indexOf(c) < 0; });
  if (!missing.length) return;
  var end = 0;   // the column of the last non-empty header cell
  have.forEach(function (v, i) { if (v !== '') end = i + 1; });
  var at = [];   // [column, name]
  missing.forEach(function (name) {
    var own = cols.indexOf(name);
    if (own < end && have[own] === '') at.push([own + 1, name]);
    else at.push([++end, name]);
  });
  at.sort(function (a, b) { return a[0] - b[0]; });
  gasEnsureWidth(sh, at[at.length - 1][0]);
  for (var i = 0; i < at.length;) {   // one block per run of neighbouring cells (the usual case: one block at the end)
    var j = i;
    while (j + 1 < at.length && at[j + 1][0] === at[j][0] + 1) j++;
    sh.getRange(1, at[i][0], 1, j - i + 1).setValues([at.slice(i, j + 1).map(function (p) { return p[1]; })]).setFontWeight('bold');
    i = j + 1;
  }
  gasInvalidate();
}

/** Whole column as plain text so Sheets never turns "2026-09-06", "09777123456" or "CASH" into something else. */
function textColumn(sh, cols, name) {
  sh.getRange(1, cols.indexOf(name) + 1, sh.getMaxRows(), 1).setNumberFormat('@');
}

/**
 * OPTIONAL one-time migration, run by hand from the editor, never called by setupSheet() or any
 * request path (plan section 6 rule 8: code never edits Ledger rows). Rows where money moved
 * (Cash <> 0) but Method is blank get Method = CASH, which is exactly what every reader already
 * assumes for them (methodOf in core_ledger.js; the Dashboard's bank column subtracts blank
 * Methods), so nothing needs this to be right; it only makes the Method column complete to the
 * eye. No business fact changes. Safe to re-run: it only touches blank cells. Returns the number
 * of rows filled.
 */
function backfillMethod(ledger) {
  ledger = ledger || gasSheet('Ledger');
  var last = ledger.getLastRow();
  if (last < 2) return 0;
  var cashCol = CFG.LEDGER_COLS.indexOf('Cash') + 1, methodCol = CFG.LEDGER_COLS.indexOf('Method') + 1;
  var cash = ledger.getRange(2, cashCol, last - 1, 1).getValues();
  var methodRange = ledger.getRange(2, methodCol, last - 1, 1);
  var methods = methodRange.getValues(), changed = 0;
  for (var i = 0; i < methods.length; i++) {
    if (Number(cash[i][0]) && String(methods[i][0] === null || methods[i][0] === undefined ? '' : methods[i][0]) === '') {
      methods[i][0] = CFG.METHOD.CASH;
      changed++;
    }
  }
  if (changed) {
    methodRange.setValues(methods);
    SpreadsheetApp.flush();
    gasInvalidate();
  }
  return changed;
}

function protectTab(sh) {
  var existing = sh.getProtections(SpreadsheetApp.ProtectionType.SHEET);
  if (existing.length) return;
  sh.protect().setDescription('Edited by the bot. Corrections go in as new rows.').setWarningOnly(true);
}

/** Pre-generate tag ids so blank QR tags can be printed before items exist. */
function generateBlankTags(shop, from, to, rev) {
  var sh = gasSheet('Items');
  var start = sh.getLastRow() + 1, values = [], formulas = [];
  var statusCol = colLetter(CFG.ITEM_COLS, 'Status'), stockCol = colLetter(CFG.ITEM_COLS, 'Stock');
  var nameCol = colLetter(CFG.ITEM_COLS, 'Name'), typeCol = colLetter(CFG.ITEM_COLS, 'Type');
  var LItem = 'Ledger!$' + colLetter(CFG.LEDGER_COLS, 'ItemID') + ':$' + colLetter(CFG.LEDGER_COLS, 'ItemID');
  var LQty = 'Ledger!$' + colLetter(CFG.LEDGER_COLS, 'Qty') + ':$' + colLetter(CFG.LEDGER_COLS, 'Qty');
  for (var n = from; n <= to; n++) {
    var id = shop + '-' + ('0000' + n).slice(-4);
    var r = start + values.length;
    var row = CFG.ITEM_COLS.map(function () { return ''; });
    row[0] = id;
    row[1] = shop;
    if (rev) { row[CFG.ITEM_COLS.indexOf('Rev')] = rev; row[CFG.ITEM_COLS.indexOf('UpdatedAt')] = new Date(); }
    values.push(row);
    formulas.push([
      '=IF(' + nameCol + r + '="","BLANK",IF(AND(' + typeCol + r + '="UNIQUE",' + stockCol + r + '<=0),"SOLD","ACTIVE"))',
      '=SUMIF(' + LItem + ',A' + r + ',' + LQty + ')'
    ]);
  }
  gasEnsureRows(sh, start + values.length - 1);
  sh.getRange(start, 1, values.length, CFG.ITEM_COLS.length).setValues(values);
  sh.getRange(start, CFG.ITEM_COLS.indexOf('Status') + 1, formulas.length, 2).setFormulas(formulas);
  gasInvalidate();
}

/**
 * Owner view in the Sheet. Everything here is a formula over Ledger, Credits and Deposits.
 * Cash in is split into drawer (Method CASH) and bank (any other Method): drawer + bank = cash in.
 * A blank Method (rows older than the column) reads as CASH in the code, and the bank column
 * subtracts blanks, so a legacy row is never counted twice without any cell being rewritten.
 * A block "Expenses by category" follows the shop blocks: one row per expense_category option, a
 * retired one included (it may still have expenses this month), plus "other". Then "Money by account":
 * one row per bank or wallet account (every pay_method option except CASH, retired ones included) with
 * this month's money in, out and net over both shops. Both blocks are built from the lists at the time
 * of writing, so the Dashboard is rewritten when a list changes: by setupSheet(), by onEdit() after a
 * hand edit of the Lists tab, and by gasDashboardRefresh() after the bot added an option (gas_main.js).
 * Every rewrite can be a row longer than the last one, and the family may have deleted the empty rows at the
 * bottom of the tab, so the rows are built first, the grid is grown to fit them, and only then is the tab cleared
 * and written: a failure on the way never leaves the Dashboard blank. The account and category names in column A
 * come from the Lists tab, where a seller's ➕ can put any text: each is written with a leading apostrophe, so a
 * name that starts with =, + or - stays text instead of becoming a broken formula. (Column A is not made '@':
 * the low-stock formula lives there.)
 */
function writeDashboard(sh) {
  var L = function (n) { var c = colLetter(CFG.LEDGER_COLS, n); return 'Ledger!$' + c + ':$' + c; };
  var L2 = function (n) { var c = colLetter(CFG.LEDGER_COLS, n); return 'Ledger!$' + c + '$2:$' + c; };
  var CR = function (n) { var c = colLetter(CFG.CREDIT_COLS, n); return 'Credits!$' + c + ':$' + c; };
  var DP = function (n) { var c = colLetter(CFG.DEPOSIT_COLS, n); return 'Deposits!$' + c + ':$' + c; };
  function sumType(col, shop, dayRef, type) {
    return 'SUMIFS(' + L(col) + ',' + L('Day') + ',' + dayRef + ',' + L('Shop') + ',"' + shop + '",' + L('Type') + ',"' + type + '")';
  }
  function rev(shop, dayRef) { return '=' + sumType('Amount', shop, dayRef, 'SALE') + '+' + sumType('Amount', shop, dayRef, 'RETURN'); }
  function pieces(shop, dayRef) { return '=-(' + sumType('Qty', shop, dayRef, 'SALE') + '+' + sumType('Qty', shop, dayRef, 'RETURN') + ')'; }
  function cashIn(shop, dayRef, extra) {
    // Positive cash on normal rows, minus the negative cash of undo mirrors (so corrections do not inflate the gross).
    var base = L('Cash') + ',' + L('Day') + ',' + dayRef + ',' + L('Shop') + ',"' + shop + '"' + (extra || '');
    return 'SUMIFS(' + base + ',' + L('Cash') + ',">0",' + L('ReversesTxID') + ',"=")' +
           '+SUMIFS(' + base + ',' + L('Cash') + ',"<0",' + L('ReversesTxID') + ',"<>")';
  }
  function cashDrawer(shop, dayRef) { return '=' + cashIn(shop, dayRef, ',' + L('Method') + ',"CASH"'); }
  function cashBank(shop, dayRef) {
    return '=' + cashIn(shop, dayRef, ',' + L('Method') + ',"<>CASH"') + '-(' + cashIn(shop, dayRef, ',' + L('Method') + ',"="') + ')';
  }
  function expenses(shop, dayRef) { return '=-' + sumType('Amount', shop, dayRef, 'EXPENSE'); }
  function cogs(shop, prefixRef) {
    return '=SUMPRODUCT((LEFT(' + L2('Day') + ',LEN(' + prefixRef + '))=' + prefixRef + ')*(' + L2('Shop') + '="' + shop + '")' +
           '*((' + L2('Type') + '="SALE")+(' + L2('Type') + '="RETURN"))*(-' + L2('Qty') + ')*IF(ISNUMBER(' + L2('CostAtSale') + '),' + L2('CostAtSale') + ',0))';
  }
  function owed(shop) { return '=SUMIF(' + CR('Shop') + ',"' + shop + '",' + CR('Owed') + ')'; }
  var H = ['', 'Revenue', 'Pieces', 'Cash in', 'Cash in (drawer)', 'Cash in (bank)', 'Expenses', 'COGS', 'Operating profit', 'Still owed'];
  var W = H.length;
  function blank() { return H.map(function () { return ''; }); }
  function pad(row) { while (row.length < W) row.push(''); return row; }
  var boldRows = [], numberRows = [];
  function block(label, dayRef, prefixRef, r0) {
    var rows = [[label].concat(H.slice(1))];
    boldRows.push(r0);
    CFG.SHOP_IDS.forEach(function (shop, i) {
      var r = r0 + 1 + i;
      numberRows.push(r);
      // Operating profit = Revenue (B) - Expenses (G) - COGS (H)
      rows.push([shop, rev(shop, dayRef), pieces(shop, dayRef), '=' + cashIn(shop, dayRef), cashDrawer(shop, dayRef), cashBank(shop, dayRef),
                 expenses(shop, dayRef), cogs(shop, prefixRef), '=B' + r + '-G' + r + '-H' + r, owed(shop)]);
    });
    return rows;
  }
  var rows = [
    pad(['POS dashboard']),
    pad(['Today', '=TEXT(TODAY(),"yyyy-mm-dd")', 'This month', '=TEXT(TODAY(),"yyyy-mm")']),
    blank()
  ];
  rows = rows.concat(block('TODAY', '$B$2', '$B$2', rows.length + 1));
  rows.push(blank());
  rows = rows.concat(block('THIS MONTH', '$D$2&"*"', '$D$2', rows.length + 1));
  rows.push(blank());
  numberRows.push(rows.length + 1);
  // Overdue: the Credits tab's own Overdue column (past the promised DueDay, or OVERDUE_DAYS old when undated; creditOverdue).
  rows.push(pad(['Deposits held', '=SUM(' + DP('Held') + ')', 'Owed, all', '=SUM(' + CR('Owed') + ')', 'Overdue',
             '=SUMIF(' + CR('Overdue') + ',TRUE,' + CR('Owed') + ')']));
  rows.push(blank());
  // Expenses by category, this month. One row per expense_category option of the Lists tab (on a sheet without
  // Lists rows: Settings expense_categories, as before), a retired option included because it may still have
  // expenses this month, plus "other"; blank Category (legacy rows) counts as "other".
  var lists = gasListsPorts();
  var cats = listOptions(lists, 'expense_category', null, true).map(function (r) { return [r.key, r.label]; });
  if (!cats.some(function (c) { return c[0] === 'other'; })) cats.push(['other', t(lists, 'cat_other')]);
  boldRows.push(rows.length + 1);
  rows.push(pad(['Expenses by category (this month)', 'Amount']));
  cats.forEach(function (c) {
    var f = 'SUMIFS(' + L('Amount') + ',' + L('Day') + ',$D$2&"*",' + L('Type') + ',"EXPENSE",' + L('Category') + ',"' + String(c[0]).replace(/"/g, '""') + '")';
    if (c[0] === 'other') f += '+SUMIFS(' + L('Amount') + ',' + L('Day') + ',$D$2&"*",' + L('Type') + ',"EXPENSE",' + L('Category') + ',"=")';
    numberRows.push(rows.length + 1);
    rows.push(pad(["'" + c[1] + ' (' + c[0] + ')', '=-(' + f + ')']));
  });
  rows.push(blank());
  // Money by account, this month, all shops: addMethodCash (core_ledger.js) as formulas. In = positive cash on
  // normal rows plus the negative cash of mirrors (a mirror reduces the bucket its original filled); Out the same
  // with the signs swapped. No Shop criterion, and no blank-Method term: a blank Method is CASH, which has no row here.
  function mBase(KEY) { return L('Cash') + ',' + L('Day') + ',$D$2&"*",' + L('Method') + ',"' + String(KEY).replace(/"/g, '""') + '"'; }
  function mIn(KEY) { var b = mBase(KEY); return 'SUMIFS(' + b + ',' + L('Cash') + ',">0",' + L('ReversesTxID') + ',"=")+SUMIFS(' + b + ',' + L('Cash') + ',"<0",' + L('ReversesTxID') + ',"<>")'; }
  function mOut(KEY) { var b = mBase(KEY); return '-(SUMIFS(' + b + ',' + L('Cash') + ',"<0",' + L('ReversesTxID') + ',"=")+SUMIFS(' + b + ',' + L('Cash') + ',">0",' + L('ReversesTxID') + ',"<>"))'; }
  boldRows.push(rows.length + 1);
  rows.push(pad(['Money by account (this month)', 'In', 'Out', 'Net']));
  listOptions(lists, 'pay_method', null, true).forEach(function (a) {
    if (a.key === CFG.METHOD.CASH) return;
    var r = rows.length + 1;
    numberRows.push(r);
    rows.push(pad(["'" + a.label + ' (' + a.key + ')', '=' + mIn(a.key), '=' + mOut(a.key), '=B' + r + '-C' + r]));
  });
  rows.push(blank());
  rows.push(pad(['Low stock (SKU items at or below the threshold)']));
  rows.push(pad(['=IFERROR(JOIN(", ",FILTER(Items!$C:$C&" ("&Items!$' + colLetter(CFG.ITEM_COLS, 'Stock') + ':$' + colLetter(CFG.ITEM_COLS, 'Stock') +
             '&")",Items!$' + colLetter(CFG.ITEM_COLS, 'Status') + ':$' + colLetter(CFG.ITEM_COLS, 'Status') + '="ACTIVE",Items!$E:$E="SKU",Items!$' +
             colLetter(CFG.ITEM_COLS, 'Stock') + ':$' + colLetter(CFG.ITEM_COLS, 'Stock') + '<=VLOOKUP("low_stock_threshold",Settings!$A:$B,2,FALSE))),"none")']));
  rows.push(blank());
  rows.push(pad(['Active items', '=COUNTIF(Items!$' + colLetter(CFG.ITEM_COLS, 'Status') + ':$' + colLetter(CFG.ITEM_COLS, 'Status') + ',"ACTIVE")',
             'Sold unique pieces', '=COUNTIF(Items!$' + colLetter(CFG.ITEM_COLS, 'Status') + ':$' + colLetter(CFG.ITEM_COLS, 'Status') + ',"SOLD")',
             'Blank tags left', '=COUNTIF(Items!$' + colLetter(CFG.ITEM_COLS, 'Status') + ':$' + colLetter(CFG.ITEM_COLS, 'Status') + ',"BLANK")']));
  gasEnsureRows(sh, rows.length);
  gasEnsureWidth(sh, W);
  sh.clear();
  sh.getRange(1, 1, rows.length, W).setValues(rows);
  sh.getRange('A1').setFontWeight('bold').setFontSize(14);
  boldRows.forEach(function (r) { sh.getRange(r, 1, 1, W).setFontWeight('bold'); });
  numberRows.forEach(function (r) { sh.getRange(r, 2, 1, W - 1).setNumberFormat('#,##0'); });
  sh.setColumnWidth(1, 220);
}

/* ======================================================================
 * gas_sync.js
 * ====================================================================== */
/**
 * gas_sync.js — the Google side of the sync API (core_sync.js holds every rule).
 *
 * doPost(e) in gas_main.js routes `?api=<name>` here before the Telegram token check. The reply is
 * JSON through ContentService (the phone's fetch follows the 302 to script.googleusercontent.com);
 * the Telegram branch keeps HtmlService. Device tokens travel only in the JSON body and are stored
 * as SHA-256 in the Devices tab. Tabs Devices, SyncLog, Quarantine and AiJobs are created on first
 * use with the CFG headers. LEDGER_SEQ and MASTER_REV live in Script Properties and are touched only
 * inside the script lock (serverPorts.lock.run wraps every write path; it is gasLocked() of gas_main.js,
 * the one re-entrant holder, so a store method that locks itself can run inside a batch).
 *
 * One-time helper for the editor: backfillSync() stamps Seq on rows from before this version, Rev on
 * masters and ReceiptNo on old SALE groups. It is the single sanctioned code path that writes into
 * existing Ledger rows, run by hand once after the paste; new rows are stamped as they are appended
 * (gasStore.appendLedger, gasSyncTabs.appendRows), so it never has to be re-run unless someone inserts
 * a Sheet row by hand. Telegram side: gasSyncBotPort() is ports.sync for core_bot (the 📲 button mints
 * a typed code with syncMintEnrollCode, /devices and the DV| buttons use gasSyncDevicesText and
 * gasSyncDeviceAction), gasSyncTelegramDocument(update) is called by doPost for Transport B,
 * gasSyncSummaryLines() adds the stale-phone line to the 21:00 summary.
 */

var GAS_SYNC_TABS = {
  Devices: CFG.DEVICE_COLS, SyncLog: CFG.SYNCLOG_COLS, Quarantine: CFG.QUARANTINE_COLS, AiJobs: CFG.AIJOB_COLS
};

/** The web app branch: always JSON, always 200 after the redirect, never throws. */
function gasSyncHandle(api, e) {
  var body = {}, out;
  try {
    var raw = e && e.postData && e.postData.contents ? String(e.postData.contents) : '';
    if (raw) body = JSON.parse(raw);
  } catch (err) {
    return gasSyncJson({ ok: false, error: 'bad_request', message: 'body is not JSON', serverTime: new Date().toISOString() });
  }
  try {
    out = syncHandle(gasSyncServerPorts(), String(api), body, new Date(), gasSyncHooks());
  } catch (err) {
    var msg = err && err.message ? err.message : String(err);
    try { gasStore.logError('gasSyncHandle:' + api, err, body && body.device ? String(body.device) : '', String(api)); } catch (ignore) {}
    out = /lock|timed out|timeout/i.test(msg) ? { ok: false, error: 'busy', message: 'try again', retryAfterSec: 10 }
                                             : { ok: false, error: 'server', message: msg.slice(0, 200) };
    out.serverTime = new Date().toISOString();
  }
  return gasSyncJson(out);
}

function gasSyncJson(obj) {
  return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
}

/* ------------------------------ tabs ------------------------------ */

function gasSyncSheet(name) {
  var ss = gasSpreadsheet();
  var sh = ss.getSheetByName(name);
  if (!sh) {
    sh = ss.insertSheet(name);
    var header = GAS_SYNC_TABS[name];
    sh.getRange(1, 1, 1, header.length).setValues([header]).setFontWeight('bold');
    sh.setFrozenRows(1);
    if (name === 'Devices') sh.hideSheet();          // token hashes: not a tab the family browses
  }
  return sh;
}

/** Every row of a sync tab as objects keyed by header (no caching: these tabs are small and change often). */
function gasSyncRows(name) {
  var sh = gasSyncSheet(name);
  var values = sh.getDataRange().getValues();
  var header = values[0] || [], rows = [];
  for (var r = 1; r < values.length; r++) {
    var o = { _row: r + 1 }, empty = true;
    for (var c = 0; c < header.length; c++) {
      var v = values[r][c];
      o[header[c]] = v;
      if (v !== '' && v !== null && v !== undefined) empty = false;
    }
    if (!empty) rows.push(o);
  }
  return rows;
}

/* ------------------------------ counters (Script Properties, under the caller's lock) ------------------------------ */

function gasSyncProp(key, def) {
  var v = PropertiesService.getScriptProperties().getProperty(key);
  return v === null || v === undefined || v === '' ? def : Number(v);
}
function gasSyncSetProp(key, value) { PropertiesService.getScriptProperties().setProperty(key, String(value)); }

var gasSyncCounters = {
  counters: function () { return { seq: gasSyncProp('LEDGER_SEQ', 0), rev: gasSyncProp('MASTER_REV', 0) }; },
  setCounters: function (c) {
    if (c.seq !== undefined) gasSyncSetProp('LEDGER_SEQ', c.seq);
    if (c.rev !== undefined) gasSyncSetProp('MASTER_REV', c.rev);
  },
  nextSeq: function () { var n = gasSyncProp('LEDGER_SEQ', 0) + 1; gasSyncSetProp('LEDGER_SEQ', n); return n; },
  nextRev: function () { var n = gasSyncProp('MASTER_REV', 0) + 1; gasSyncSetProp('MASTER_REV', n); return n; }
};

/* ------------------------------ Devices tab ------------------------------ */

function gasSyncDeviceFromRow(o) {
  var d = { _row: o._row };
  SYNC.DEVICE_FIELDS.forEach(function (f, i) {
    var v = o[CFG.DEVICE_COLS[i]];
    if (v instanceof Date) v = v.toISOString();
    if (f === 'pendingCount') v = Number(v) || 0;
    else if (f === 'appVersion') v = v === '' || v === null || v === undefined ? '' : v;
    else v = v === null || v === undefined ? '' : String(v);
    d[f] = v;
  });
  return d;
}

var gasDevices = {
  list: function () { return gasSyncRows('Devices').map(gasSyncDeviceFromRow); },
  get: function (id) {
    var list = gasDevices.list();
    for (var i = 0; i < list.length; i++) if (list[i].id === String(id)) return list[i];
    return null;
  },
  create: function (rec) {
    var sh = gasSyncSheet('Devices');
    sh.appendRow(SYNC.DEVICE_FIELDS.map(function (f) { return rec[f] === undefined || rec[f] === null ? '' : rec[f]; }));
    SpreadsheetApp.flush();
  },
  update: function (id, fields) {
    var d = gasDevices.get(id);
    if (!d) throw new Error('no device ' + id);
    var sh = gasSyncSheet('Devices');
    for (var f in fields) {
      var i = SYNC.DEVICE_FIELDS.indexOf(f);
      if (i < 0) continue;
      var v = fields[f];
      sh.getRange(d._row, i + 1).setValue(v === null || v === undefined ? '' : v);
    }
    SpreadsheetApp.flush();
  },
  counters: function () { return gasSyncCounters.counters(); },
  setCounters: function (c) { gasSyncCounters.setCounters(c); },
  nextSeq: function () { return gasSyncCounters.nextSeq(); },
  nextRev: function () { return gasSyncCounters.nextRev(); },
  nextLetter: function () { return syncNextLetter(gasDevices.list()); },
  /** PENDING row holding the code's hash; the plain code goes to the staff member in Telegram once. */
  mintCode: function (rec) { gasDevices.create(rec); },
  /** {match} or {fail, left}. A wrong code counts against every live code (it cannot be tied to one row). */
  verifyCode: function (codeHash, now) {
    var r = syncMatchEnrollCode(gasDevices.list(), codeHash, now);
    if (!r.match) (r.bump || []).forEach(function (id) {
      var d = gasDevices.get(id);
      if (d) gasDevices.update(id, { note: 'attempts=' + (syncAttemptsOf(d) + 1) });
    });
    return r;
  }
};

/* ------------------------------ Ledger writes, SyncLog, Quarantine, AiJobs ------------------------------ */

function gasSyncLedgerValues(tx) {
  var map = {
    TxID: tx.txId, GroupID: tx.groupId, Time: tx.time, Day: tx.day, Shop: tx.shop, ItemID: tx.itemId, Type: tx.type,
    Qty: tx.qty, UnitPrice: tx.unitPrice, Amount: tx.amount, Cash: tx.cash, CostAtSale: tx.costAtSale,
    CustomerID: tx.customerId, RefGroupID: tx.refGroupId, Note: tx.note, Source: tx.source,
    Transcript: tx.transcript, StaffID: tx.staffId, UpdateID: tx.updateId, ReversesTxID: tx.reversesTxId,
    Method: tx.method || '', Category: tx.category || '', Seq: tx.seq || '', ReceivedAt: tx.receivedAt || '',
    DeviceID: tx.deviceId || '', ReceiptNo: tx.receiptNo || '', DueDay: tx.dueDay || ''
  };
  return CFG.LEDGER_COLS.map(function (c) { return map[c] === undefined || map[c] === null ? '' : map[c]; });
}

var gasSyncTabs = {
  /** A whole group with one setValues: a timeout cannot split it. The grid is CFG.LEDGER_COLS wide first (gasLedgerWidth). */
  appendRows: function (rows) {
    if (!rows.length) return;
    var sh = gasSheet('Ledger');
    gasLedgerWidth(sh);
    var values = rows.map(gasSyncLedgerValues);
    var first = sh.getLastRow() + 1;
    gasEnsureRows(sh, first + values.length - 1);   // room first: appendRow fills the tab to its last grid row, and this is a block write
    sh.getRange(first, 1, values.length, CFG.LEDGER_COLS.length).setValues(values);
    SpreadsheetApp.flush();
    gasInvalidate();
  },
  /**
   * Seq, ReceivedAt, DeviceID written into existing rows. Only backfillSync() reaches this (through
   * syncStampMissingSeq): on the request path every row is stamped as it is appended, and the server
   * never edits a Ledger row.
   */
  stampSeq: function (list) {
    if (!list.length) return;
    var sh = gasSheet('Ledger'), rows = gasTable('Ledger'), byTx = {};
    rows.forEach(function (o) { byTx[String(o.TxID)] = o._row; });
    var col = CFG.LEDGER_COLS.indexOf('Seq') + 1;
    list.forEach(function (s) {
      var r = byTx[s.txId];
      if (!r) return;
      sh.getRange(r, col, 1, 3).setValues([[s.seq, s.receivedAt || '', s.deviceId || 'TG']]);
    });
    SpreadsheetApp.flush();
    gasInvalidate();
  },
  quarantine: function (q) {
    gasSyncSheet('Quarantine').appendRow([q.time, q.deviceId, q.groupId, q.reason, String(q.rowsJson || '').slice(0, 45000)]);
  },
  log: function (l) {
    gasSyncSheet('SyncLog').appendRow([l.time, l.deviceId, l.transport, l.rowsPushed, l.rowsPulled, l.durationMs, l.result, l.appVersion, l.note || '']);
  },
  /** aiJob(id) -> cached record or null; aiJob(id, rec) stores it (CacheService 6 h plus the AiJobs tab). */
  aiJob: function (id, rec) {
    var key = 'ai:' + id, cache = CacheService.getScriptCache();
    if (rec === undefined) {
      var hit = cache.get(key);
      if (hit) { try { return JSON.parse(hit); } catch (ignore) {} }
      var rows = gasSyncRows('AiJobs');
      for (var i = rows.length - 1; i >= 0; i--) {
        if (String(rows[i].JobID) !== String(id) || String(rows[i].Status) !== 'done') continue;
        try { return JSON.parse(String(rows[i].ResultJSON || '{}')); } catch (ignore) { return null; }
      }
      return null;
    }
    var json = JSON.stringify(rec);
    if (rec.status === 'done') { try { cache.put(key, json.slice(0, 100000), SYNC.AI_CACHE_SEC); } catch (ignore) {} }
    gasSyncSheet('AiJobs').appendRow([rec.id, rec.deviceId, rec.kind, rec.status, json.slice(0, 2000), rec.error || '', rec.createdAt || '', rec.doneAt || '', rec.itemId || '']);
  }
};

/* ------------------------------ serverPorts ------------------------------ */

function gasSyncSha256(text) {
  var bytes = Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, String(text), Utilities.Charset.UTF_8);
  return bytes.map(function (b) { var h = (b < 0 ? b + 256 : b).toString(16); return h.length === 1 ? '0' + h : h; }).join('');
}

/** gasStore plus what the sync core needs: whole Settings/Messages maps, client-supplied customer ids, customer edits. */
function gasSyncStore() {
  var store = {};
  for (var k in gasStore) store[k] = gasStore[k];
  store.allSettings = function () {
    var m = {};
    gasTable('Settings').forEach(function (r) { if (r.Key !== '') m[String(r.Key)] = r.Value instanceof Date ? r.Value.toISOString() : r.Value; });
    return m;
  };
  store.allMessages = function () {
    var m = {};
    gasTable('Messages').forEach(function (r) { if (r.Key !== '' && r.Text !== '') m[String(r.Key)] = String(r.Text); });
    return m;
  };
  /** Phones bring their own ids (C- plus 8 hex); the row is written as given, with Rev and UpdatedAt. */
  store.addCustomer = function (c) {
    if (!c.id) return gasStore.addCustomer(c);
    var sh = gasSheet('Customers');
    var map = { CustomerID: c.id, Name: c.name, Phone: c.phone || '', Note: c.note || '', CreatedAt: c.createdAt || new Date().toISOString(), Rev: c.rev || '', UpdatedAt: c.updatedAt || '' };
    sh.appendRow(CFG.CUSTOMER_COLS.map(function (col) { return map[col] === undefined ? '' : map[col]; }));
    SpreadsheetApp.flush();
    gasInvalidate();
    return { id: c.id, name: c.name, phone: c.phone || '', note: c.note || '', createdAt: map.CreatedAt, rev: c.rev || 0 };
  };
  store.updateCustomer = function (id, fields) {
    var rows = gasTable('Customers'), sh = gasSheet('Customers');
    for (var i = 0; i < rows.length; i++) {
      if (String(rows[i].CustomerID) !== String(id)) continue;
      var colOf = { name: 'Name', phone: 'Phone', note: 'Note', rev: 'Rev', updatedAt: 'UpdatedAt' };
      for (var f in fields) {
        if (!colOf[f]) continue;
        sh.getRange(rows[i]._row, CFG.CUSTOMER_COLS.indexOf(colOf[f]) + 1).setValue(fields[f] === null || fields[f] === undefined ? '' : fields[f]);
      }
      SpreadsheetApp.flush();
      gasInvalidate();
      return;
    }
  };
  return store;
}

function gasSyncServerPorts() {
  return {
    store: gasSyncStore(),
    devices: gasDevices,
    sync: gasSyncTabs,
    cache: {
      get: function (k) { return CacheService.getScriptCache().get(k); },
      put: function (k, v, ttl) { CacheService.getScriptCache().put(k, v, Math.min(ttl || 600, 21600)); },
      remove: function (k) { CacheService.getScriptCache().remove(k); }
    },
    hash: gasSyncSha256,
    clock: { now: function () { return new Date(); } },
    uuid: function () { return Utilities.getUuid(); },
    // The re-entrant script lock of gas_main.js: a store method that locks itself (addListOption, addMeasurement,
    // addCustomer without an id) runs inside this batch lock without taking or releasing it again.
    lock: { run: function (fn) { return gasLocked(fn, 15000); } }
  };
}

/* ------------------------------ hooks: Gemini, Drive, PDF, Telegram ------------------------------ */

function gasSyncHooks() {
  return {
    /**
     * One job: the phone sends base64 media plus the context the core would have built. Round 6, revision 3: two kinds are
     * not AI and come first, before any Gemini call (core_sync.js runs them whatever the owner's AI switch says): `sketch`,
     * the PNG of a measurement session's drawing (the session found by the phone's entry id, else no_session, which the
     * phone tries again; saved as <MeasID>-figure.png and written into that session's PhotoURL), and `pic`, a new piece's
     * photo while AI is off (the item missing: no_item; saved as <itemId>.jpg and written into its photoUrl). A photo job's
     * AI name goes into the same updateItem as its Drive URL (aiRenameFields: a placeholder name only), so the item's Rev
     * moves once and the phone's own rename of the placeholder reaches the server as a dup, not a conflict.
     */
    ai: function (job, device) {
      var blob = null;
      if (job.data) {
        var mime = job.mime || (job.kind === 'sketch' ? 'image/png' : job.kind === 'photo' || job.kind === 'notebook' || job.kind === 'pic' ? 'image/jpeg' : 'audio/ogg');
        blob = Utilities.newBlob(Utilities.base64Decode(String(job.data)), mime, job.id);
      }
      if (job.kind === 'sketch') {
        var meas = gasStore.findMeasurementByEntry(job.entryId);
        if (!meas) throw new Error('no_session');
        if (!blob) throw new Error('sketch job without a picture');
        var figure = gasPhotoFolder().createFile(blob.setName(meas.id + '-figure.png')).getUrl();
        gasStore.setMeasurementPhoto(meas.id, figure);
        return { photoUrl: figure };
      }
      if (job.kind === 'pic') {
        if (!job.itemId || !gasStore.getItem(job.itemId)) throw new Error('no_item');
        if (!blob) throw new Error('pic job without a picture');
        var pic = gasPhotoFolder().createFile(blob.setName(job.itemId + '.jpg')).getUrl();
        gasStore.updateItem(job.itemId, { photoUrl: pic });
        return { photoUrl: pic };
      }
      var ctx = job.ctx || {};
      if (job.kind === 'voice') return { intent: gasAi.parseVoice(blob, ctx) };
      if (job.kind === 'text') return { intent: gasAi.parseText(String(job.text || ''), ctx) };
      if (job.kind === 'photo') {
        // Round 6b: the job's own list (a phone sends its item categories) or, without one, the piece's shop's offered list.
        var jobItem = job.itemId ? gasStore.getItem(job.itemId) : null;
        var desc = gasAi.describePhoto(blob, { categories: itemCategoryCats(ctx, { store: gasStore }, jobItem ? jobItem.shop : '').names });
        var url = '';
        if (job.itemId && blob) {
          try { url = gasPhotoFolder().createFile(blob.setName(job.itemId + '.jpg')).getUrl(); } catch (err) { gasStore.logError('photo_save', err, job.id, job.itemId); }
        }
        if (job.itemId) {
          // One write (one Rev bump): the Drive URL and, for a piece still named by its placeholder, the AI's name and category
          // (round 6b: decided against the job's own list, as the phone's replay decides, so the two agree).
          var cur = gasStore.getItem(job.itemId), f = url ? { photoUrl: url } : {}, any = !!url;
          var ren = cur ? aiRenameFields(cur, desc, itemCategoryCats(ctx, { store: gasStore }, cur.shop)) : null;
          if (ren) { f.name = ren.name; any = true; if (ren.category) f.category = ren.category; }
          if (cur && any) { try { gasStore.updateItem(job.itemId, f); } catch (ignore) {} }
        }
        return { desc: desc, photoUrl: url, thumb: '' };
      }
      if (job.kind === 'notebook') return { lines: gasAi.readNotebook(blob, ctx) };
      throw new Error('unknown ai job kind ' + job.kind);
    },
    /** Drive thumbnails as base64 so phones never fetch from googleusercontent image hosts. */
    photo: function (itemIds) {
      var out = {};
      itemIds.forEach(function (id) {
        out[id] = null;
        var item = gasStore.getItem(id);
        if (!item || !item.photoUrl) return;
        var m = /[-\w]{25,}/.exec(String(item.photoUrl));
        if (!m) return;
        try {
          var thumb = DriveApp.getFileById(m[0]).getThumbnail();
          if (thumb) out[id] = Utilities.base64Encode(thumb.getBytes());
        } catch (err) { gasStore.logError('photo_thumb', err, '', id); }
      });
      return out;
    },
    /** PDF to the staff member's Telegram chat, or inline base64 when small and asked for. */
    report: function (report, device, inline) {
      var blob = gasPdf.make(report);
      if (inline && blob.getBytes().length <= SYNC.INLINE_PDF_MAX) {
        return { sentTo: 'inline', pdf: Utilities.base64Encode(blob.getBytes()), fileName: blob.getName() };
      }
      var ports = buildPorts();
      var r = gasChat.sendDocument(device.staffId, blob, t(ports, 'rep_caption', { title: report.title }));
      return { sentTo: 'telegram', messageId: r.messageId };
    },
    relay: function (notice) { gasChat.sendMessage(notice.to, notice.text, notice.kb || []); },
    ping: function (ownerId, text, kb) { gasChat.sendMessage(ownerId, text, kb || []); }
  };
}

