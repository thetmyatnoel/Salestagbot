/**
 * Context text sent with every audio/photo request. Small on purpose. Uses nothing but CFG
 * (tools/score_voice.js loads only core_config, core_burmese and this file).
 * pay_methods is printed as KEY:label strings. ctx.payMethods comes in two shapes, because a phone queues the
 * context it built and the server prints it later: an entry [KEY, label] becomes 'KEY:label', a string entry
 * (a bare KEY from an older build, or already 'KEY:label') stays as it is. Without ctx.payMethods the
 * default keys are printed as before.
 */
function aiContextText(ctx) {
  var methods = ctx.payMethods ? Array.prototype.map.call(ctx.payMethods, function (m) {
    return Array.isArray(m) ? String(m[0]) + ':' + String(m.length > 1 && m[1] !== null && m[1] !== undefined ? m[1] : m[0]) : String(m);
  }) : CFG.DEFAULT_PAY_METHODS;
  return 'Context: ' + JSON.stringify({
    shop: ctx.shop,
    staff: ctx.staff,
    item: ctx.item ? { id: ctx.item.id, name: ctx.item.name, price: ctx.item.price, stock: ctx.item.stock, type: ctx.item.type } : null,
    awaiting: ctx.awaiting || null,
    categories: ctx.categories || CFG.CATEGORIES,
    pay_methods: methods,
    expense_categories: (ctx.expenseCategories || CFG.EXPENSE_CATEGORIES).map(function (c) { return c[0] + ':' + c[1]; }),
    known_items: ctx.itemNames || undefined
  });
}

/* ------------------------------ measurement sheet (photo of the paper form) ------------------------------ */

/**
 * The prompt for a photo of the filled measurement sheet, built from the MeasureFields rows so a renamed
 * or added field reaches the model without a code change. fields = [{key, labelMy, labelEn, multi, type}].
 */
function measurementPrompt(fields) {
  var list = fields.map(function (f) {
    return '- ' + f.key + ': printed label "' + f.labelMy + '" (' + f.labelEn + ')' +
      (Number(f.multi) > 1 ? ', ' + f.multi + ' slash-separated values written in one cell, e.g. 36/30/20' : '') +
      (f.type === 'text' ? ', free text' : ', a number in centimetres, decimals allowed');
  });
  return [
    'You see a photo of a body-measurement sheet from a tailoring shop in Myanmar: a printed form with Burmese labels',
    '(Unicode or Zawgyi rendering) and handwritten values next to them, sometimes rotated or upside down, sometimes with',
    'glare, strike-throughs or Burmese digits. Read every value exactly as written and return ONE JSON object.',
    '"fields" has one entry per key below with the value as a STRING ("32", "17.5", "36/30/20", "ဘယ်"); use an empty',
    'string when the cell is blank or unreadable. Never guess: when a digit is doubtful (1/7, 0/6, smudged), still give',
    'your best reading but put the key in "low_confidence". Also read the header: name (any script), order_date,',
    'due_date, phone, and put margin notes in notes (verbatim Burmese). Convert Burmese digits to Arabic digits.',
    '',
    'Fields:'
  ].concat(list).join('\n');
}

/** Response schema for measurementPrompt: a fields object with one nullable string per key plus the header. */
function measurementSchema(fields) {
  var props = {};
  fields.forEach(function (f) { props[f.key] = { type: 'string', nullable: true }; });
  return {
    type: 'object',
    properties: {
      fields: { type: 'object', properties: props },
      name: { type: 'string', nullable: true },
      order_date: { type: 'string', nullable: true },
      due_date: { type: 'string', nullable: true },
      phone: { type: 'string', nullable: true },
      notes: { type: 'string', nullable: true },
      low_confidence: { type: 'array', items: { type: 'string' } }
    },
    required: ['fields', 'low_confidence']
  };
}

/* ======================================================================
 * core_ledger.js
 * ====================================================================== */
/**
 * core_ledger.js — append-only ledger operations and reporting.
 * Nothing here edits or deletes a row. Undo appends reversing rows.
 *
 * Amount = value of the event (SALE +, RETURN -, EXPENSE -, PAYMENT +, DEPOSIT +).
 * Cash   = money that actually moved on this row (SALE: paid now; PAYMENT/DEPOSIT: all;
 *          DEPOSIT_APPLIED: 0; EXPENSE: negative).
 * Qty    = signed stock movement: SALE -, RESTOCK +, RETURN +.
 * Method = how the cash moved: CASH, or the key of a pay_method option (KBZ, WAVE, BANK, or an account
 *          the family added to the Lists tab). The commit functions default it to CASH
 *          whenever Cash != 0; readers treat a blank Method with Cash != 0 as CASH (rows written
 *          before the column existed). Mirrors copy the Method so per-method totals net out.
 * A sale's open balance = Amount - Cash - its DEPOSIT_APPLIED rows - PAYMENT rows that reference it.
 *
 * Corrections come in two shapes, both append-only:
 *   undoGroup    - mirror rows that reverse every live row of a group (the group is then "voided").
 *   rewriteGroup - mirror row + replacement row inside the SAME group (method, customer, credit,
 *                  note), so receipt numbers, RefGroupIDs and the buttons on the card stay valid.
 *   splitSale    - a rewrite of the SALE row to its cash part plus a PAYMENT row for the part paid into
 *                  one account, in the sale's own group (the shape a custom-order delivery already has).
 * "Live rows" of a group are the rows that neither reverse another row nor are reversed by one.
 *
 * Option lists (pay_method, expense_category, fabric) are read through listRows(): the Lists tab when
 * the store has one with rows, the phone's synced copy (Settings lists_json), else the Settings rows
 * of version 3 (legacyListRows). This file calls nothing defined in core_orders.js, core_sync.js or
 * core_bot.js (the test runners and the simulator load different sets of files).
 */

function nullish(v) { return v === null || v === undefined; }

function newTx(ports, f) {
  var when = f.when instanceof Date ? f.when : ports.clock.now();
  var tx = {
    txId: ports.uuid(),
    groupId: f.groupId || '',
    time: when.toISOString(),
    day: dayKey(when),
    shop: f.shop,
    itemId: f.itemId || '',
    type: f.type,
    qty: Number(f.qty) || 0,
    unitPrice: nullish(f.unitPrice) ? '' : Number(f.unitPrice),
    amount: Number(f.amount) || 0,
    cash: Number(f.cash) || 0,
    costAtSale: (nullish(f.costAtSale) || f.costAtSale === '') ? '' : Number(f.costAtSale),
    customerId: f.customerId || '',
    refGroupId: f.refGroupId || '',
    note: f.note || '',
    source: f.source || CFG.SOURCE.SYSTEM,
    transcript: f.transcript || '',
    staffId: f.staffId || '',
    updateId: f.updateId || '',
    reversesTxId: f.reversesTxId || '',
    method: f.method || '',          // CASH, KBZ, WAVE, BANK on rows where cash moved
    category: f.category || '',      // expense category key
    seq: f.seq || '',                // server-assigned on arrival
    receivedAt: f.receivedAt || '',
    deviceId: f.deviceId || '',
    receiptNo: f.receiptNo || '',    // per-device receipt number on SALE rows (app); server derives for Telegram rows
    dueDay: f.dueDay || ''           // yyyy-mm-dd on the SALE row of a guided sale that still owes and has a promised date (round 5)
  };
  if (!tx.groupId) tx.groupId = tx.txId;
  return tx;
}

/** Append one or more rows atomically. Returns {groupId, txs}. */
function writeGroup(ports, txs) {
  if (txs.some(function (tx) { return !shopAcceptsEntry(ports, tx.shop, tx.time); })) throw new Error('ဆိုင် ပိတ်ထားပါသည်');
  var groupId = txs[0].groupId;
  txs.forEach(function (tx) { tx.groupId = groupId; });
  ports.lock.run(function () {
    txs.forEach(function (tx) { ports.store.appendLedger(tx); });
  });
  afterWrite(ports, txs);
  return { groupId: groupId, txs: txs };
}

/**
 * Refresh the Credits, Deposits and Customers views when a write could have changed them.
 * refreshViews(credits, deposits, customers): the third argument is the per-customer summary
 * (customerSummaries) that fills columns F:K of the Customers tab. gas_main.js rebuildViews()
 * should pass the same three arguments.
 */
function afterWrite(ports, txs) {
  if (!ports.store.refreshViews) return;
  var T = CFG.TX;
  var needs = txs.some(function (tx) {
    if (tx.customerId) return true;
    if (tx.type === T.PAYMENT || tx.type === T.DEPOSIT || tx.type === T.DEPOSIT_APPLIED) return true;
    if ((tx.type === T.SALE || tx.type === T.RETURN) && tx.cash !== tx.amount) return true;
    return !!tx.reversesTxId;
  });
  if (needs) ports.store.refreshViews(openCredits(ports, null), depositsHeldList(ports), customerSummaries(ports));
}

/* ----------------------------- payment method helpers ----------------------------- */

/** Method of a row for reading: blank with cash moved counts as CASH (rows older than the column). */
function methodOf(r) {
  if (r.method) return String(r.method).toUpperCase();
  return r.cash ? CFG.METHOD.CASH : '';
}

/** The method to store on a new row: the given key, or CASH when cash moved, or '' when it did not. */
function methodFor(method, cash) {
  if (!cash) return '';
  return method ? String(method).toUpperCase() : CFG.METHOD.CASH;
}

/**
 * The method keys offered as buttons: CASH first, then the active accounts of the pay_method list for
 * that shop (every shop's when no shop is given), in list order. On a sheet without Lists rows this is
 * Settings pay_methods ("CASH,KBZ,WAVE,BANK") exactly as before. A key longer than CFG.LIST_KEY_MAX_BYTES
 * (UTF-8) would push PM|<group id>|<KEY> past Telegram's 64-byte limit and make it reject the whole
 * keyboard under every sale, so such a key is left out and logged once; so are the accounts beyond
 * CFG.MAX_BANK_BUTTONS.
 */
function payMethods(ports, shop) {
  var keys = [CFG.METHOD.CASH], dropped = [];
  listOptions(ports, 'pay_method', shop).forEach(function (r) {
    if (r.key === CFG.METHOD.CASH) return;
    if (utf8ByteLength(r.key) > CFG.LIST_KEY_MAX_BYTES) { warnPayMethodKey(ports, r.key); return; }
    if (keys.length > CFG.MAX_BANK_BUTTONS) { dropped.push(r.key); return; }
    keys.push(r.key);
  });
  if (dropped.length) {
    listWarnOnce(ports, 'pmcap:' + listHash((shop || '') + ':' + dropped.join(',')), 'pay_methods',
      'More than ' + CFG.MAX_BANK_BUTTONS + ' active accounts' + (shop ? ' for ' + shop : '') + ': ' + dropped.join(', ') +
      ' are left out of the 🏦 buttons. Untick Active in the Lists tab on the accounts that are no longer used.');
  }
  return keys;
}

/**
 * The keys payMethods(ports, shop) returns (CASH first, the 12-byte drop, the MAX_BANK_BUTTONS cap), without CASH, split
 * into {wallets: [KEY], banks: [KEY]} by methodKind of each key's row; a key with no row (legacy Settings) is a wallet
 * unless it is BANK. The guided sale lists wallets by name and offers one 🏛 ဘဏ် button for the banks (round 5).
 */
function payMethodsByKind(ports, shop) {
  var out = { wallets: [], banks: [] };
  payMethods(ports, shop).forEach(function (k) {
    if (k === CFG.METHOD.CASH) return;
    var row = listOption(ports, 'pay_method', k);
    var kind = row ? methodKind(row) : (k === CFG.METHOD.BANK ? 'bank' : 'wallet');
    if (kind === 'bank') out.banks.push(k); else out.wallets.push(k);
  });
  return out;
}

/** UTF-8 byte length without Buffer or TextEncoder (Apps Script, old browsers). */
function utf8ByteLength(s) {
  s = String(s || '');
  var n = 0;
  for (var i = 0; i < s.length; i++) {
    var c = s.charCodeAt(i);
    if (c < 0x80) n += 1;
    else if (c < 0x800) n += 2;
    else if (c >= 0xd800 && c <= 0xdbff) { n += 4; i++; }   // surrogate pair (emoji)
    else n += 3;
  }
  return n;
}

var PAY_METHOD_WARNED = {};
/**
 * One Errors row per cache key ck: per execution, and per 6 hours when the ports have a cache. Never throws.
 * Without ports (the pure list functions) nothing is logged and nothing is remembered.
 */
function listWarnOnce(ports, ck, where, message) {
  if (!ports || PAY_METHOD_WARNED[ck]) return;
  PAY_METHOD_WARNED[ck] = true;
  if (ports.cache && ports.cache.get) {
    try {
      if (ports.cache.get(ck)) return;
      ports.cache.put(ck, '1', 21600);
    } catch (ignore) {}
  }
  if (!ports.store || !ports.store.logError) return;
  try { ports.store.logError(where, message, '', ''); } catch (ignore) {}
}

/** One Errors row per oversize account key (Lists tab or Settings pay_methods). */
function warnPayMethodKey(ports, key) {
  listWarnOnce(ports, 'pmwarn:' + key, 'pay_methods', 'Pay method key "' + key + '" (Lists tab or Settings pay_methods) is longer than ' +
    CFG.LIST_KEY_MAX_BYTES + ' bytes and is left out of the 🏦 buttons (Telegram allows 64 bytes of callback data). Use a short ASCII key such as AYA; ' +
    'the Burmese name goes in the Label column of the Lists tab (on a sheet without that tab: Messages method_<KEY>).');
}

/** True for CASH and for every key of the pay_method list, a retired (inactive) account included: old cards and rows stay valid. */
function methodKnown(ports, key) {
  key = String(key === null || key === undefined ? '' : key).trim().toUpperCase();
  if (!key) return false;
  if (key === CFG.METHOD.CASH) return true;
  return !!listOption(ports, 'pay_method', key);
}

/** The account's label (a retired account included), else Messages method_<KEY>, else the key itself. */
function methodLabel(ports, key) {
  key = String(key || '').toUpperCase();
  if (!key) return '';
  var row = listOption(ports, 'pay_method', key);
  if (row) return row.label;
  var s = t(ports, 'method_' + key);
  return s === 'method_' + key ? key : s;
}

/** The account number and holder of a pay_method key (Lists.Detail), or ''. */
function accountDetail(ports, key) {
  var row = listOption(ports, 'pay_method', key);
  return row ? row.detail : '';
}

/**
 * A spoken or typed method (what the AI answered) as a key: CASH, or the exact key of an account that is a
 * button of that shop; else the active account of that shop whose label is the same name, or contains the
 * text, or is contained in it (the longest label first; a name shorter than 2 characters never matches by
 * containment); else an exact key the lists still know (a retired or another shop's account: old cards);
 * else ''. So "KBZ" goes to the shop's own "KBZ ဦးမောင်" once the family has unticked the generic KBZ row.
 */
function methodKeyFor(ports, text, shop) {
  var raw = String(text === null || text === undefined ? '' : text).trim();
  if (!raw) return '';
  var exact = raw.toUpperCase();
  if (exact === CFG.METHOD.CASH || payMethods(ports, shop).indexOf(exact) >= 0) return exact;
  var byLabel = methodKeyByLabel(ports, raw, shop);
  if (byLabel) return byLabel;
  return methodKnown(ports, exact) ? exact : '';
}

/** methodKeyFor's label match over the active accounts of that shop, or ''. */
function methodKeyByLabel(ports, raw, shop) {
  var want = listNameKey(raw), i;
  if (!want) return '';
  var cands = listOptions(ports, 'pay_method', shop).map(function (r, idx) { return { key: r.key, name: listNameKey(r.label), idx: idx }; })
    .filter(function (c) { return c.name.length > 0; });
  cands.sort(function (a, b) { return (b.name.length - a.name.length) || (a.idx - b.idx); });
  for (i = 0; i < cands.length; i++) if (cands[i].name === want) return cands[i].key;
  if (want.length < 2) return '';
  for (i = 0; i < cands.length; i++) {
    var n = cands[i].name;
    if (n.length >= 2 && (want.indexOf(n) >= 0 || n.indexOf(want) >= 0)) return cands[i].key;
  }
  return '';
}

/**
 * Where a customer can transfer money: 'label detail' for the active accounts of that shop that carry an
 * account number (Lists.Detail), the first four in list order. Printed on receipts and vouchers with a balance.
 */
function transferLines(ports, shop) {
  var out = [];
  listOptions(ports, 'pay_method', shop).forEach(function (r) {
    if (r.key === CFG.METHOD.CASH || !r.detail || out.length >= 4) return;
    out.push(r.label + ' ' + r.detail);
  });
  return out;
}

/** The same accounts as one chat line (Messages receipt_transfer, the accounts joined with ' · '), or '' when no account has a number. */
function transferLine(ports, shop) {
  var lines = transferLines(ports, shop);
  return lines.length ? t(ports, 'receipt_transfer', { accounts: lines.join(' · ') }) : '';
}

/* ----------------------------- expense category helpers ----------------------------- */

/**
 * The expense categories offered as buttons: [[key, label], ...] of the active expense_category options
 * (every shop's when no shop is given), 'other' always present. On a sheet without Lists rows this is
 * Settings expense_categories ("key:label,...") or the defaults with Messages labels, exactly as before.
 */
function expenseCategories(ports, shop) {
  var list = listOptions(ports, 'expense_category', shop).map(function (r) { return [r.key, r.label]; });
  if (!list.some(function (c) { return c[0] === 'other'; })) list.push(['other', t(ports, 'cat_other')]);
  return list;
}

/** The label of a category key; a retired (inactive) category still resolves, an unknown key shows itself. */
function categoryLabel(ports, key) {
  key = String(key || 'other').toLowerCase();
  var row = listOption(ports, 'expense_category', key);
  if (row) return row.label;
  return key === 'other' ? t(ports, 'cat_other') : key;
}

/**
 * The emoji in front of an expense category button: the option's Detail when it has one, else the built-in
 * one for the key, else the box. (categoryEmoji(category) in core_config.js is the ITEM category emoji.)
 */
function expenseEmoji(ports, key) {
  key = String(key || 'other').toLowerCase();
  var row = listOption(ports, 'expense_category', key);
  if (row && row.detail) return row.detail;
  return (Object.prototype.hasOwnProperty.call(CFG.EXPENSE_EMOJI, key) && CFG.EXPENSE_EMOJI[key]) || '📦';
}

/** The fabrics offered on an order line: the active fabric options (normalised rows; the label is the fabric's name). */
function fabricOptions(ports, shop) {
  return listOptions(ports, 'fabric', shop);
}

/** Map a spoken or typed category (key, label, or a phrase containing a label) to a key; unknown -> 'other'. */
function expenseCategoryKey(ports, text) {
  var s = String(text || '').trim();
  if (!s) return 'other';
  var list = expenseCategories(ports), low = s.toLowerCase(), i;
  for (i = 0; i < list.length; i++) if (list[i][0] === low) return list[i][0];
  var compact = normName(s);
  for (i = 0; i < list.length; i++) {
    var lab = normName(list[i][1]);
    if (lab && (compact.indexOf(lab) >= 0 || lab.indexOf(compact) >= 0)) return list[i][0];
  }
  return 'other';
}

/** Up to four amount buttons for an expense category: most common past amounts, padded from Settings. */
function expensePresets(ports, category) {
  var counts = {};
  liveRows(ports.store.ledgerRows()).forEach(function (r) {
    if (r.type !== CFG.TX.EXPENSE) return;
    if (category && (r.category || 'other') !== category) return;
    var a = Math.abs(r.amount);
    if (a > 0) counts[a] = (counts[a] || 0) + 1;
  });
  var amounts = Object.keys(counts).map(Number).sort(function (a, b) { return counts[b] - counts[a] || a - b; }).slice(0, 4);
  var defaults = (ports.store.getSetting('expense_presets', '') || '').toString().split(',').map(Number).filter(function (x) { return x > 0; });
  if (!defaults.length) defaults = CFG.EXPENSE_PRESETS;
  for (var i = 0; i < defaults.length && amounts.length < 4; i++) {
    if (amounts.indexOf(defaults[i]) < 0) amounts.push(defaults[i]);
  }
  return amounts;
}

/* ----------------------------- option lists: rows and sources ----------------------------- */

/*
 * A normalised list row, the only shape the helpers work with:
 *   {list, key, label, active (boolean), order (number, 0 = no order), shop ('' | 'S1' | 'S2'), detail, note}
 * shop '' = both shops. detail = account number and holder (pay_method), emoji (expense_category).
 * Keys never change once used: Ledger.Method and Ledger.Category store them.
 */

/** A key as rows and callback data carry it: trimmed, upper case for pay_method, lower case for the other lists. */
function listNormKey(name, key) {
  var k = String(key === null || key === undefined ? '' : key).trim();
  return name === 'pay_method' ? k.toUpperCase() : k.toLowerCase();
}

function listText(v) {
  return v === null || v === undefined ? '' : String(v).trim();
}

/** One source row (a Lists tab row, a compact row, a legacy value) as a normalised row; null when it has no key. */
function listNormRow(name, r) {
  if (!r || typeof r !== 'object') return null;
  var key = listNormKey(name, r.key);
  if (!key) return null;
  var a = r.active, order = typeof r.order === 'boolean' ? 0 : Number(r.order), shop = listText(r.shop).toUpperCase();
  var off = a === false || a === 0 || (typeof a === 'string' && /^(false|0|no)$/i.test(a.trim()));
  var row = {
    list: name, key: key, label: listText(r.label) || key, active: !off,
    order: isFinite(order) && order > 0 ? order : 0,
    shop: CFG.SHOP_IDS.indexOf(shop) >= 0 ? shop : '',
    detail: listText(r.detail), note: listText(r.note)
  };
  // Kind (round 5): present ONLY when the cell holds a known kind, so a row without one keeps the eight-field shape.
  var kind = listText(r.kind).toLowerCase();
  if (CFG.LIST_KINDS.indexOf(kind) >= 0) row.kind = kind;
  return row;
}

/** 'wallet' or 'bank' for a pay_method row: its Kind when set, else the legacy BANK key is a bank by name and everything else a wallet. */
function methodKind(row) {
  return row.kind || (row.key === CFG.METHOD.BANK ? 'bank' : 'wallet');
}

/**
 * Normalisation, applied to every source: a row without a key is skipped, so is a key containing '|' (it would
 * break the parts of a button's callback data; logged once) and a later row whose key repeats an earlier one.
 * Always returns new row objects. The ports may be null (nothing is logged then).
 */
function listNormRows(ports, name, rows) {
  var out = [], seen = {}, list = rows || [];
  for (var i = 0; i < list.length; i++) {
    var r = listNormRow(name, list[i]);
    if (!r) continue;
    if (r.key.indexOf('|') >= 0) {
      listWarnOnce(ports, 'listkey:' + listHash(name + ':' + r.key), 'lists', 'Lists: the ' + name + ' key "' + r.key +
        '" contains "|" and is ignored (the bar separates the parts of a button). Change the Key in the Lists tab.');
      continue;
    }
    if (seen['k:' + r.key]) continue;
    seen['k:' + r.key] = true;
    out.push(r);
  }
  return out;
}

/**
 * The lists as version 3 holds them, as normalised rows with Order 1..n: Settings pay_methods with the
 * Messages method_<KEY> labels, Settings expense_categories (or the CFG defaults with cat_<key> labels),
 * Settings fabric_presets (or CFG.FABRIC_PRESETS, keys f1, f2, ...), and (round 6b) the five built-in item
 * categories: CFG.CATEGORIES under the fixed keys CFG.ITEM_CATEGORY_KEYS with CFG.CATEGORY_EMOJI in Detail (no
 * Settings read, so every device builds the same five). Never reads the Lists tab or lists_json.
 * It is the fallback of listRows, the seed of a new Lists tab and the seed a phone uses for a pending add.
 */
function legacyListRows(ports, name) {
  var rows = [];
  if (name === 'pay_method') {
    var rawM = (ports.store.getSetting('pay_methods', '') || '').toString();
    var keys = rawM.split(',').map(function (k) { return k.trim().toUpperCase(); }).filter(function (k) { return k.length > 0; });
    keys = keys.filter(function (k) {
      if (utf8ByteLength(k) <= CFG.LIST_KEY_MAX_BYTES) return true;
      warnPayMethodKey(ports, k);
      return false;
    });
    if (!keys.length) keys = CFG.DEFAULT_PAY_METHODS.slice();
    var at = keys.indexOf(CFG.METHOD.CASH);
    if (at > 0) keys.splice(at, 1);
    if (at !== 0) keys.unshift(CFG.METHOD.CASH);
    keys.forEach(function (k) {
      var s = t(ports, 'method_' + k);
      rows.push({ key: k, label: s === 'method_' + k ? k : s });
    });
  } else if (name === 'expense_category') {
    var rawC = (ports.store.getSetting('expense_categories', '') || '').toString(), cats = [];
    rawC.split(',').forEach(function (pair) {
      var p = pair.split(':');
      var key = String(p[0] || '').trim().toLowerCase();
      if (!key) return;
      cats.push([key, String(p[1] || '').trim() || key]);
    });
    if (!cats.length) {
      cats = CFG.EXPENSE_CATEGORIES.map(function (c) {
        var label = t(ports, 'cat_' + c[0]);
        return [c[0], label === 'cat_' + c[0] ? c[1] : label];
      });
    }
    if (!cats.some(function (c) { return c[0] === 'other'; })) cats.push(['other', t(ports, 'cat_other')]);
    cats.forEach(function (c) {
      rows.push({ key: c[0], label: c[1], detail: Object.prototype.hasOwnProperty.call(CFG.EXPENSE_EMOJI, c[0]) ? CFG.EXPENSE_EMOJI[c[0]] : '' });
    });
  } else if (name === 'fabric') {
    var rawF = (ports.store.getSetting('fabric_presets', '') || '').toString();
    var fabrics = rawF.split(',').map(function (x) { return x.trim(); }).filter(function (x) { return x.length > 0; });
    if (!fabrics.length) fabrics = CFG.FABRIC_PRESETS.slice();
    fabrics.forEach(function (label, idx) { rows.push({ key: 'f' + (idx + 1), label: label }); });
  } else if (name === 'item_category') {
    CFG.CATEGORIES.forEach(function (label, idx) {
      rows.push({ key: CFG.ITEM_CATEGORY_KEYS[idx], label: label,
        detail: Object.prototype.hasOwnProperty.call(CFG.CATEGORY_EMOJI, label) ? CFG.CATEGORY_EMOJI[label] : '' });
    });
  }
  var out = listNormRows(ports, name, rows);
  out.forEach(function (r, idx) { r.order = idx + 1; });
  return out;
}

/** Settings lists_json as an object {pay_method: [...], expense_category: [...], fabric: [...], item_category: [...]}, or null when it is not one. */
function listsJsonParse(raw) {
  if (typeof raw !== 'string' || !raw) return null;
  try {
    var data = JSON.parse(raw);
    return data && typeof data === 'object' && !Array.isArray(data) ? data : null;
  } catch (err) {
    return null;
  }
}

// The last lists_json string parsed (a phone reads its lists on every screen). Read-only: listRows builds new
// row objects from it on every call and listsJsonUpsert parses its string itself.
var LISTS_JSON_MEMO = { raw: null, data: null };

/**
 * The normalised rows of one list (active or not, in source order) from the first source that has any:
 * 1. store.listOptions(name): the Lists tab (server, simulator);
 * 2. Settings lists_json: the copy the sync server derives for the phones (compact rows);
 * 3. legacyListRows: the Settings and Messages rows of version 3.
 * The fallback is per list: a Lists tab with accounts but no fabric rows still offers the old fabrics.
 */
function listRows(ports, name) {
  var store = ports.store, rows;
  if (store.listOptions) {
    rows = listNormRows(ports, name, store.listOptions(name));
    if (rows.length) return rows;
  }
  var raw = store.getSetting ? store.getSetting('lists_json', '') : '';
  if (raw && typeof raw === 'string') {
    if (LISTS_JSON_MEMO.raw !== raw) LISTS_JSON_MEMO = { raw: raw, data: listsJsonParse(raw) };
    var compact = LISTS_JSON_MEMO.data ? LISTS_JSON_MEMO.data[name] : null;
    if (compact && compact.length) {
      rows = listNormRows(ports, name, Array.prototype.map.call(compact, function (c) { return listRowFromCompact(name, c); }));
      if (rows.length) return rows;
    }
  }
  return legacyListRows(ports, name);
}

/**
 * The filter and sort of listOptions, on rows already read (pure; round 6b took it out so the item categories can
 * use it on their merged rows): active rows (all rows with includeInactive), for that shop when one is given (a row
 * with a blank Shop belongs to every shop), sorted by Order; rows without an Order come last, in source order.
 */
function listPick(rows, shop, includeInactive) {
  var want = shop ? String(shop).toUpperCase() : '';
  var picked = [];
  (rows || []).forEach(function (r, idx) {
    if (!includeInactive && !r.active) return;
    if (want && r.shop && r.shop !== want) return;
    picked.push({ r: r, idx: idx });
  });
  picked.sort(function (a, b) {
    var ao = a.r.order > 0 ? a.r.order : Infinity, bo = b.r.order > 0 ? b.r.order : Infinity;
    if (ao !== bo) return ao < bo ? -1 : 1;
    return a.idx - b.idx;
  });
  return picked.map(function (x) { return x.r; });
}

/**
 * The options of a list as the buttons show them: active rows (all rows with includeInactive), for that
 * shop when one is given (a row with a blank Shop belongs to both), sorted by Order; rows without an Order
 * come last, in source order.
 */
function listOptions(ports, name, shop, includeInactive) {
  return listPick(listRows(ports, name), shop, includeInactive);
}

/** The row with that key (any case), a retired one included, or null. */
function listOption(ports, name, key) {
  var k = listNormKey(name, key);
  if (!k) return null;
  var rows = listRows(ports, name);
  for (var i = 0; i < rows.length; i++) if (rows[i].key === k) return rows[i];
  return null;
}

/* ----------------------------- option lists: how they reach a phone ----------------------------- */

/** A row as lists_json carries it: {k, l, a (1|0), o, s, d} plus t (the Kind) only when the row has one. The Note stays on the server. */
function listRowToCompact(row) {
  var c = { k: row.key, l: row.label, a: row.active ? 1 : 0, o: row.order, s: row.shop, d: row.detail };
  if (row.kind) c.t = row.kind;
  return c;
}

/** A compact row back as a normalised row of the list called name (null when it has no key). */
function listRowFromCompact(name, c) {
  if (!c || typeof c !== 'object') return null;
  return listNormRow(name, { key: c.k, label: c.l, active: c.a, order: c.o, shop: c.s, detail: c.d, note: '', kind: c.t });
}

/**
 * The Settings value the sync server sends to the phones: every Lists row (active or not, sheet order) of every
 * list of CFG.LIST_NAMES as compact rows, or '' when the store has no listOptions or every list is empty.
 */
function listsJsonFor(ports) {
  var store = ports && ports.store;
  if (!store || !store.listOptions) return '';
  var out = {}, any = false;
  CFG.LIST_NAMES.forEach(function (name) {
    var rows = listNormRows(ports, name, store.listOptions(name));
    if (rows.length) any = true;
    out[name] = rows.map(listRowToCompact);
  });
  return any ? JSON.stringify(out) : '';
}

/**
 * The phone's side of an add: apply rec to the list called name inside a lists_json string. Parses raw itself
 * (never the memo; a missing or unparseable value counts as empty), runs listUpsert and returns
 * {raw: <the new JSON, or the old string when nothing changed>, status, key}.
 */
function listsJsonUpsert(raw, name, seedRows, rec) {
  var data = listsJsonParse(raw) || {}, r2 = {}, k;
  for (k in rec) if (Object.prototype.hasOwnProperty.call(rec, k)) r2[k] = rec[k];
  r2.list = name;
  var cur = data[name] && data[name].length ? Array.prototype.map.call(data[name], function (c) { return listRowFromCompact(name, c); }) : [];
  var res = listUpsert(cur, r2, seedRows);
  if (!res.ops.length) return { raw: typeof raw === 'string' ? raw : '', status: res.status, key: res.key };
  var out = {};
  for (k in data) if (Object.prototype.hasOwnProperty.call(data, k)) out[k] = data[k];
  CFG.LIST_NAMES.forEach(function (n) { if (!Array.isArray(out[n])) out[n] = []; });
  out[name] = res.rows.map(listRowToCompact);
  return { raw: JSON.stringify(out), status: res.status, key: res.key };
}

/* ----------------------------- option lists: the upsert rule ----------------------------- */

/**
 * The one rule every store follows when an option is added or an account number is set. Pure.
 * rows = the rows of rec.list now stored; rec = {list, key, label?, detail?, detailWas?, shop?, note?};
 * seedRows = what the user sees today (legacyListRows or the phone's copy), used only when rows is empty.
 * Returns {rows: <the new state>, ops, status: 'ok' | 'dup', key: <the stored key>} where ops is what the
 * store has to persist, in order: {op: 'append', row} and {op: 'set', key, field: 'label' | 'detail', value}.
 *  - No row stored yet: the seed rows are appended first, so adding one option never hides the old ones.
 *  - Key absent and a label given: append it, active, Order = the largest Order + 1. 'ok'.
 *  - Key absent and no label (an account number for an unknown key): nothing. 'dup'.
 *  - Key present: the label is set only while the stored one is blank (= the key); the detail is set when it
 *    differs and either none is stored or rec.detailWas is the stored one (the user replaced the value they
 *    were looking at: a stale edit from an offline phone never overwrites a newer one). Active, Order and
 *    Shop are never touched. 'ok' when something was set, else 'dup'.
 * Keys compare after normalisation (any case); op.key and the returned key are the normalised stored key
 * (a store finds its row with listNormKey(list, <its Key cell>) === op.key).
 */
function listUpsert(rows, rec, seedRows) {
  rec = rec || {};
  var name = String(rec.list || ''), out = listNormRows(null, name, rows), ops = [];
  var key = listNormKey(name, rec.key), i;
  if (!key || key.indexOf('|') >= 0) return { rows: out, ops: ops, status: 'dup', key: key };
  if (!out.length) {
    listNormRows(null, name, seedRows).forEach(function (s) {
      out.push(s);
      ops.push({ op: 'append', row: listNormRow(name, s) });
    });
  }
  var found = null, maxOrder = 0;
  for (i = 0; i < out.length; i++) {
    if (out[i].key === key) found = out[i];
    if (out[i].order > maxOrder) maxOrder = out[i].order;
  }
  var label = typeof rec.label === 'string' ? rec.label.trim() : '';
  var detail = typeof rec.detail === 'string' ? rec.detail.trim() : '';
  var changed = false;
  if (!found) {
    if (!label) return { rows: out, ops: ops, status: 'dup', key: key };
    var row = listNormRow(name, { key: key, label: label, active: true, order: maxOrder + 1, shop: rec.shop, detail: detail, note: rec.note, kind: rec.kind });
    out.push(row);
    ops.push({ op: 'append', row: listNormRow(name, row) });
    changed = true;
  } else {
    if (label && found.label === found.key && label !== found.label) {
      found.label = label;
      ops.push({ op: 'set', key: key, field: 'label', value: label });
      changed = true;
    }
    if (detail && detail !== found.detail &&
        (found.detail === '' || (typeof rec.detailWas === 'string' && rec.detailWas.trim() === found.detail))) {
      found.detail = detail;
      ops.push({ op: 'set', key: key, field: 'detail', value: detail });
      changed = true;
    }
  }
  return { rows: out, ops: ops, status: changed ? 'ok' : 'dup', key: key };
}

/* ----------------------------- option lists: adding one where it is needed ----------------------------- */

/** 32-bit FNV-1a of the text's UTF-8 bytes as 8 lower-case hex digits (shift-add form: no Math.imul in ES5). */
function listHash(text) {
  var s = String(text === null || text === undefined ? '' : text), h = 0x811c9dc5;
  function mix(b) {
    h ^= b;
    h = (h + (h << 1) + (h << 4) + (h << 7) + (h << 8) + (h << 24)) >>> 0;
  }
  for (var i = 0; i < s.length; i++) {
    var c = s.charCodeAt(i);
    if (c >= 0xd800 && c <= 0xdbff && i + 1 < s.length) {
      var d = s.charCodeAt(i + 1);
      if (d >= 0xdc00 && d <= 0xdfff) { c = 0x10000 + ((c - 0xd800) << 10) + (d - 0xdc00); i++; }
    }
    if (c < 0x80) mix(c);
    else if (c < 0x800) { mix(0xc0 | (c >> 6)); mix(0x80 | (c & 63)); }
    else if (c < 0x10000) { mix(0xe0 | (c >> 12)); mix(0x80 | ((c >> 6) & 63)); mix(0x80 | (c & 63)); }
    else { mix(0xf0 | (c >> 18)); mix(0x80 | ((c >> 12) & 63)); mix(0x80 | ((c >> 6) & 63)); mix(0x80 | (c & 63)); }
  }
  return ('0000000' + h.toString(16)).slice(-8);
}

// The invisible characters Burmese keyboards and pasted text insert between words: zero-width space (200B),
// non-joiner (200C), joiner (200D), word joiner (2060), byte-order mark (FEFF). Built from character codes
// so that this source file itself never holds an invisible character.
var LIST_ZW_NAME = new RegExp('[' + String.fromCharCode(0x200b, 0x200c, 0x200d, 0x2060, 0xfeff) + ']', 'g');
var LIST_ZW_TEXT = new RegExp('[' + String.fromCharCode(0x200b, 0xfeff) + ']', 'g');

/**
 * A label reduced to what makes it the same name: no spaces, lower case, and none of the invisible characters
 * above. Two labels are the same name when their listNameKey is equal.
 */
function listNameKey(label) {
  return normName(String(label === null || label === undefined ? '' : label).replace(LIST_ZW_NAME, ''));
}

/**
 * The key of a new option, derived from its name so every device makes the same key for the same name and
 * the upsert merges them: the first 7 ASCII letters and digits of the label plus the first 4 hex digits of
 * listHash(listNameKey(label)); upper case for pay_method, lower case otherwise. A slug that is empty or starts
 * with a digit gets the list's prefix letter (and is cut to 6), so a key always starts with a letter and a
 * Sheet never reads it as a number. Only when another option already holds that key the 4 hex digits come
 * from ports.uuid() (at most 5 draws). At most 11 bytes; never CASH, never other.
 */
function listKeyFor(ports, name, label, existingKeys) {
  var upper = name === 'pay_method', taken = {};
  var slug = String(label === null || label === undefined ? '' : label).replace(/[^A-Za-z0-9]/g, '').slice(0, 7);
  slug = upper ? slug.toUpperCase() : slug.toLowerCase();
  if (!slug || /^[0-9]/.test(slug)) slug = (CFG.LIST_PREFIX[name] || 'x') + slug.slice(0, 6);
  (existingKeys || []).forEach(function (k) { taken['k:' + listNormKey(name, k)] = true; });
  function make(hex) {
    var h = String(hex).slice(0, 4);
    return slug + (upper ? h.toUpperCase() : h.toLowerCase());
  }
  function free(k) { return !taken['k:' + k] && k !== CFG.METHOD.CASH && k !== 'other'; }
  var key = make(listHash(listNameKey(label)));
  for (var n = 0; n < 5 && !free(key); n++) {
    var hex = String(ports && ports.uuid ? ports.uuid() : '').replace(/[^0-9a-fA-F]/g, '');
    key = make(hex.length >= 4 ? hex : listHash(key + ':' + n));
  }
  return key;
}

/**
 * Typed or spoken text as one clean line of at most max characters: zero-width spaces and byte-order marks
 * removed, line breaks and runs of spaces turned into one space, trimmed.
 */
function listCleanText(text, max) {
  var s = String(text === null || text === undefined ? '' : text).replace(LIST_ZW_TEXT, '').replace(/\s+/g, ' ').trim();
  if (s.length > max) {
    s = s.slice(0, max);
    var last = s.charCodeAt(s.length - 1);
    if (last >= 0xd800 && last <= 0xdbff) s = s.slice(0, -1);   // never half of an emoji
    s = s.trim();
  }
  return s;
}

// Currency and unit words that may follow an amount ("5000 ကျပ်", "10k", "5,000 ks"); the number words themselves
// (တစ်, ငါး, ထောင်, သောင်း, သိန်း, ရာ ...) are found by parseBurmeseNumbers, all but the joined form ထောင့်
// (သုံးထောင့်ငါးရာ) and ခွဲ (a half: တစ်သိန်းခွဲ), listed here.
var LIST_AMOUNT_WORDS = ['ကျပ်', 'ကျပ', 'k', 'ks', 'kyat', 'kyats', 'mmk', 'lakh', 'lakhs', 'ထောင့်', 'ခွဲ'];

/**
 * True when a name is only an amount written some other way than plain digits: numbers (digits, Burmese digits,
 * number words such as တစ်သောင်း or ငါးထောင်) with nothing left beside them but separators and currency words.
 * "5000 ကျပ်", "10k", "၅၀၀၀ ကျပ်" and "တစ်သောင်း" are amounts; "KBZ 2" and "ငါးမျိုး" are names.
 */
function listLooksLikeAmount(clean) {
  var s = String(clean || ''), nums = parseBurmeseNumbers(s);
  if (!nums.length) return false;
  var rest = '', at = 0;
  nums.forEach(function (n) {
    if (n.index < at) return;
    rest += s.slice(at, n.index) + ' ';
    at = n.end;
  });
  rest += s.slice(at);
  var words = rest.toLowerCase().split(/[\s.,\-+()\/]+/);
  for (var i = 0; i < words.length; i++) {
    if (words[i] && LIST_AMOUNT_WORDS.indexOf(words[i]) < 0) return false;
  }
  return true;
}

/**
 * The first half of ➕: is the typed name usable, and does an option of that name exist already? Nothing is written.
 *   {ok: false, reason: 'empty'}             nothing usable (also digits only: a mistyped amount must not become an option)
 *   {ok: false, reason: 'unavailable'}       not one of the lists
 *   {ok: true, existed: true, key, label}    an option (active or retired) already has that name
 *   {ok: true, existed: false, label}        free: label is the clean text; the caller decides when to write it
 */
function listFindByLabel(ports, name, label) {
  if (CFG.LIST_NAMES.indexOf(name) < 0) return { ok: false, reason: 'unavailable' };
  var clean = listCleanText(label, CFG.LIST_LABEL_MAX), want = listNameKey(clean);
  if (!want || /^[0-9၀-၉\s.,\-+()\/]*$/.test(clean) || listLooksLikeAmount(clean)) return { ok: false, reason: 'empty' };
  // item_category (round 6b): its merged rows, so the always-there catch-all is found and a left-out row is not matched.
  var rows = name === 'item_category' ? itemCategoryRows(ports) : listRows(ports, name);
  for (var i = 0; i < rows.length; i++) {
    if (listNameKey(rows[i].label) === want) return { ok: true, existed: true, key: rows[i].key, label: rows[i].label };
  }
  return { ok: true, existed: false, label: clean };
}

/**
 * The ➕ of every pick list: add an option by the name the seller typed or said.
 *   {ok: false, reason: 'empty'}        nothing usable (also digits only: a mistyped amount must not become an option)
 *   {ok: true, existed: true, key, label}  an option (active or retired) already has that name; nothing is written
 *   {ok: false, reason: 'unavailable'}  this store cannot add options
 *   {ok: true, created: true, key, label}  written through store.addListOption; shared by both shops
 * extra.kind ('wallet' | 'bank', round 5) is stored on the new pay_method row; anything else adds no kind.
 */
function addListOptionByLabel(ports, name, label, staff, extra) {
  var found = listFindByLabel(ports, name, label);
  if (!found.ok || found.existed) return found;
  var clean = found.label;
  var rows = listRows(ports, name);
  if (!ports.store.addListOption) return { ok: false, reason: 'unavailable' };
  var key = listKeyFor(ports, name, clean, rows.map(function (r) { return r.key; }));
  var who = staff && (staff.name || staff.id) ? String(staff.name || staff.id) : '?';
  var rec = { list: name, key: key, label: clean, shop: '', note: 'added by ' + who + ' ' + dayKey(ports.clock.now()) };
  if (extra && CFG.LIST_KINDS.indexOf(extra.kind) >= 0) rec.kind = extra.kind;
  var res = ports.store.addListOption(rec, rows);
  if (res && res.key) key = res.key;
  if (res && res.status === 'dup') {
    // Somebody added the same name a moment ago (the key is derived from the name): use that option.
    var have = listOption(ports, name, key);
    return { ok: true, existed: true, key: key, label: have ? have.label : clean };
  }
  return { ok: true, created: true, key: key, label: clean };
}

/**
 * Set the Detail of an option (the account number and holder of a pay_method key).
 *   {ok: false, reason: 'empty' | 'unavailable' | 'missing'}  nothing typed, a store without addListOption, no such key
 *   {ok: true, saved, detail}  saved = the store took it; detail = what is stored now (the older value when a
 *                              newer one was already there and this edit was stale)
 */
function setListDetail(ports, name, key, detail) {
  var clean = listCleanText(detail, CFG.LIST_DETAIL_MAX);
  if (!clean) return { ok: false, reason: 'empty' };
  if (!ports.store.addListOption) return { ok: false, reason: 'unavailable' };
  var row = listOption(ports, name, key);
  if (!row) return { ok: false, reason: 'missing' };
  var res = ports.store.addListOption({ list: name, key: row.key, detail: clean, detailWas: row.detail }, listRows(ports, name));
  var now = listOption(ports, name, row.key);
  return { ok: true, saved: !!res && res.status === 'ok', detail: now ? now.detail : '' };
}

/* ----------------------------- item categories (round 6b, G2) ----------------------------- */

/*
 * The Lists tab's item_category list. An item stores the category's NAME (its Category cell, as before round 6b); a
 * piece and a row match by listNameKey, and a built-in's old name also finds its row by key after a rename. The row
 * keyed 'other' is the catch-all: always there, always offered, always the last option, the category of a piece with
 * none chosen and the one category the photo AI may replace. A name containing CFG.SAMPLE_WORD is never a category
 * (a sample is the switch of the new-piece screens).
 */

/**
 * The item_category rows every reader uses (active or not, in source order, new row objects): listRows' rows (the
 * Lists tab, lists_json, or the five built-ins), plus the built-in 'other' row when no row has that key (merged by
 * KEY only). Left out, each logged once: a row whose name contains the sample word, and a row whose name an earlier
 * row already has (the row keyed 'other' counts as earlier than every row). The row keyed 'other' is never left out.
 */
function itemCategoryRows(ports) {
  var rows = listRows(ports, 'item_category'), i, other = null;
  for (i = 0; i < rows.length; i++) if (rows[i].key === 'other') { other = rows[i]; break; }
  if (!other) {
    var legacy = legacyListRows(ports, 'item_category');
    for (i = 0; i < legacy.length; i++) if (legacy[i].key === 'other') { other = legacy[i]; rows.push(other); break; }
  }
  var sample = listNameKey(CFG.SAMPLE_WORD), seen = {}, out = [];
  var otherName = other ? listNameKey(other.label) : '';
  if (otherName) seen['n:' + otherName] = 'other';
  rows.forEach(function (r) {
    if (r === other) { out.push(r); return; }
    var n = listNameKey(r.label);
    if (sample && n.indexOf(sample) >= 0) {
      listWarnOnce(ports, 'icsample:' + listHash(r.key + ':' + n), 'lists', 'Lists: the item_category row "' + r.label +
        '" holds the word ' + CFG.SAMPLE_WORD + ' and is not offered; a sample is the ' + CFG.SAMPLE_EMOJI + ' switch');
      return;
    }
    if (n && seen['n:' + n]) {
      listWarnOnce(ports, 'icdup:' + listHash(r.key + ':' + n), 'lists', 'Lists: the item_category name "' + r.label +
        '" is on two rows; the first (key ' + seen['n:' + n] + ') is used');
      return;
    }
    if (n) seen['n:' + n] = r.key;
    out.push(r);
  });
  return out;
}

/**
 * The item categories offered for that shop: the active rows of itemCategoryRows for the shop, by Order, then the
 * catch-all LAST whatever its Active, Shop and Order. Every chip, every Telegram button, every pick and the AI's list
 * come from this one function.
 */
function itemCategoryOptions(ports, shop) {
  var rows = itemCategoryRows(ports), other = null;
  for (var i = 0; i < rows.length; i++) if (rows[i].key === 'other') other = rows[i];
  var out = listPick(rows.filter(function (r) { return r.key !== 'other'; }), shop, false);
  if (other) out.push(other);
  return out;
}

/**
 * The item_category row of a stored or typed name (active or retired), or null: the row of that name; else, for an
 * old built-in name (CFG.CATEGORIES), the row with that built-in's key (a renamed built-in).
 */
function itemCategoryOf(ports, name) {
  var n = listNameKey(name), i, j;
  if (!n) return null;
  var rows = itemCategoryRows(ports);
  for (i = 0; i < rows.length; i++) if (listNameKey(rows[i].label) === n) return rows[i];
  for (i = 0; i < CFG.CATEGORIES.length; i++) {
    if (listNameKey(CFG.CATEGORIES[i]) !== n) continue;
    for (j = 0; j < rows.length; j++) if (rows[j].key === CFG.ITEM_CATEGORY_KEYS[i]) return rows[j];
  }
  return null;
}

/** The catch-all's current label (the row keyed 'other', always there). */
function itemCategoryFallback(ports) {
  var rows = itemCategoryRows(ports);
  for (var i = 0; i < rows.length; i++) if (rows[i].key === 'other') return rows[i].label;
  return CFG.CATEGORIES[CFG.CATEGORIES.length - 1];
}

/** The entry of names that is the same name as name (listNameKey), else ''. Pure. */
function itemCategoryPick(names, name) {
  var n = listNameKey(name);
  if (!n || !names) return '';
  for (var i = 0; i < names.length; i++) if (listNameKey(names[i]) === n) return String(names[i]);
  return '';
}

/** The photo AI's list for a piece of that shop: {names (the offered labels, the catch-all last), other (its label)}. */
function itemCategoryAi(ports, shop) {
  return {
    names: itemCategoryOptions(ports, shop || '').map(function (r) { return r.label; }),
    other: itemCategoryFallback(ports)
  };
}

/**
 * The list a photo job decides against: the job's own ctx.categories when it carries one (a copy; the catch-all is its
 * last entry), else itemCategoryAi(ports, shop). The server's late rename and a phone's replay both read the job's ctx,
 * so they decide alike whatever each side's list holds now.
 */
function itemCategoryCats(ctx, ports, shop) {
  if (ctx && Array.isArray(ctx.categories) && ctx.categories.length) {
    var names = ctx.categories.map(function (c) { return String(c); });
    return { names: names, other: names[names.length - 1] };
  }
  return itemCategoryAi(ports, shop);
}

/** Telegram's emoji of an item category: its row's Detail, else the built-in emoji of a built-in name, else the neutral one. */
function itemCategoryEmoji(ports, name) {
  var r = itemCategoryOf(ports, name), s = String(name === null || name === undefined ? '' : name);
  if (r && r.detail) return r.detail;
  if (Object.prototype.hasOwnProperty.call(CFG.CATEGORY_EMOJI, s)) return CFG.CATEGORY_EMOJI[s];
  return CFG.ITEM_CATEGORY_NEUTRAL;
}

/** The emoji an item leads with in Telegram (G1): the sample sign for a sample, else its category's emoji. */
function itemEmoji(ports, item) {
  return item && item.sample ? CFG.SAMPLE_EMOJI : itemCategoryEmoji(ports, item ? item.category : '');
}

/**
 * The first half of the item categories' add (Telegram's ➕, the app's plus chip). Nothing is written.
 *   {ok: false, reason: 'sample'}                 the name contains the sample word (a sample is the switch)
 *   {ok: false, reason: 'empty' | 'unavailable'}  as listFindByLabel; also a name with no letter at all (only emoji,
 *                                                 signs or digits: the app would draw its chip blank)
 *   {ok: false, reason: 'closed', key, label}     a category of that name exists but the shop is not offered it
 *                                                 (the owner unticked it, or gave it another shop): typing it never reopens it
 *   {ok: true, existed: true, key, label}         an offered category has that name, or it is the old name of a renamed
 *                                                 built-in (itemCategoryOf: that row, under its current label)
 *   {ok: true, existed: false, label}             free
 */
function itemCategoryFind(ports, label, shop) {
  var clean = listCleanText(label, CFG.LIST_LABEL_MAX), sample = listNameKey(CFG.SAMPLE_WORD);
  if (sample && listNameKey(clean).indexOf(sample) >= 0) return { ok: false, reason: 'sample' };
  // A letter of any script (Latin, Myanmar and the rest below the emoji planes), Burmese digits and ၊ ။ aside.
  if (!/[A-Za-z\u00C0-\u103F\u104C-\u1FFF\u2C00-\uD7FF\uF900-\uFDFF]/.test(clean)) return { ok: false, reason: 'empty' };
  var f = listFindByLabel(ports, 'item_category', label);
  if (f.ok && !f.existed) {
    // The old name of a built-in the owner renamed reads as that row (as itemCategoryOf reads a stored name): typed at ➕
    // or the plus chip it is that row, never a second row that would take the old name over from the renamed one.
    var old = itemCategoryOf(ports, f.label);
    if (old) f = { ok: true, existed: true, key: old.key, label: old.label };
  }
  if (!f.ok || !f.existed) return f;
  var opts = itemCategoryOptions(ports, shop);
  for (var i = 0; i < opts.length; i++) if (opts[i].key === f.key) return f;
  return { ok: false, reason: 'closed', key: f.key, label: f.label };
}

/**
 * The item categories' add: itemCategoryFind, then addListOptionByLabel for a free name. Answers as
 * addListOptionByLabel, plus the reasons 'sample' and 'closed'. Shared by every shop (Shop ''), noted
 * 'added by <name> <day>' as every ➕.
 */
function addItemCategory(ports, label, staff, shop) {
  var f = itemCategoryFind(ports, label, shop);
  if (!f.ok || f.existed) return f;
  return addListOptionByLabel(ports, 'item_category', f.label, staff);
}

/* ----------------------------- commits ----------------------------- */

function commitSale(ports, p) {
  var qty = Math.max(1, Math.round(Number(p.qty) || 1));
  var unitPrice = !nullish(p.unitPrice) ? Number(p.unitPrice)
    : (!nullish(p.amount) ? Math.round(Number(p.amount) / qty) : (Number(p.item.price) || 0));
  var amount = qty * unitPrice;
  var cash = nullish(p.paid) ? amount : Math.max(0, Math.min(amount, Math.round(Number(p.paid) || 0)));
  var tx = newTx(ports, {
    shop: p.item.shop, itemId: p.item.id, type: CFG.TX.SALE, qty: -qty, unitPrice: unitPrice,
    amount: amount, cash: cash, costAtSale: p.item.cost, customerId: p.customerId || '', note: p.note,
    method: methodFor(p.method, cash),
    source: p.source, transcript: p.transcript, staffId: p.staff.id, updateId: p.updateId, when: p.when
  });
  return writeGroup(ports, [tx]);
}

/**
 * The one-item sale of round 5, now a wrapper of commitBasket (round 6, spec 3.2): p = {item, qty, unitPrice, paid,
 * method, bankPart, mixed, customerId, dueDay, note, priceChanged, staff, source, transcript, updateId, when}. One SALE
 * row, or SALE then PAYMENT when the payment is mixed (cash part > 0 and account part > 0), in one group under one lock;
 * the rows are exactly those of round 5 (the SALE and the PAYMENT now share one time: one clock read). Returns
 * {groupId, txs, sale, payment (or null), owed}.
 */
function commitSaleGroup(ports, p) {
  var r = commitBasket(ports, {
    lines: [{ item: p.item, qty: p.qty, unitPrice: p.unitPrice, priceChanged: p.priceChanged }],
    paid: p.paid, method: p.method, bankPart: p.bankPart, mixed: p.mixed, customerId: p.customerId, dueDay: p.dueDay,
    note: p.note, staff: p.staff, source: p.source, transcript: p.transcript, updateId: p.updateId, when: p.when
  });
  return { groupId: r.groupId, txs: r.txs, sale: r.sales[0], payment: r.payment, owed: r.owed };
}

/* ----------------------------- baskets: several pieces in one sale (round 6) ----------------------------- */

/**
 * The cash of a group spread over its lines in line order (spec 3.4): cash_i = min(amount_i, max(0, cash - Σ cash_<i)).
 * Σ cash_i = cash whenever cash <= Σ amounts, and every row keeps 0 <= cash_i <= amount_i.
 */
function basketAllocate(amounts, cash) {
  var left = Math.max(0, Math.round(Number(cash) || 0)), out = [];
  for (var i = 0; i < amounts.length; i++) {
    var c = Math.min(Math.max(0, Number(amounts[i]) || 0), left);
    out.push(c);
    left -= c;
  }
  return out;
}

/**
 * Steps 2-5 of commitBasket without rows, so the app's running line, the Telegram card, basketCheck and the write all
 * agree. lines = [{qty, unitPrice}] (unitPrice null, undefined or '' = a price-pending line: amount 0, listed in
 * pending); pay = {part, paid, method, mixed, bankPart}: paid now = part ? paid : the total.
 */
function basketTotals(lines, pay) {
  pay = pay || {};
  var amounts = [], pending = [], total = 0;
  (lines || []).forEach(function (l, i) {
    var qty = Math.max(1, Math.round(Number(l.qty) || 1));
    var none = l.unitPrice === null || l.unitPrice === undefined || l.unitPrice === '';
    if (none) pending.push(i);
    var amount = none ? 0 : qty * Number(l.unitPrice);
    amounts.push(amount);
    total += amount;
  });
  var paid = pay.part ? Math.max(0, Math.min(total, Math.round(Number(pay.paid) || 0))) : total;
  var KEY = String(pay.method || CFG.METHOD.CASH).toUpperCase();
  var bankPart = (KEY === CFG.METHOD.CASH || !pay.mixed) ? 0 : Math.max(0, Math.min(paid, Math.round(Number(pay.bankPart) || 0)));
  var cashPart = paid - bankPart, owed = total - paid;
  var payKey = (pay.mixed && bankPart === 0) ? CFG.METHOD.CASH : KEY;
  var twoRows = bankPart > 0 && cashPart > 0;
  var rowCash = basketAllocate(amounts, twoRows ? cashPart : paid);
  var rowMethod = rowCash.map(function (c) { return twoRows ? (c ? CFG.METHOD.CASH : '') : methodFor(payKey, c); });
  return { amounts: amounts, total: total, paid: paid, bankPart: bankPart, cashPart: cashPart, owed: owed, payKey: payKey,
           twoRows: twoRows, rowCash: rowCash, rowMethod: rowMethod, pending: pending };
}

/**
 * The promised day of a sale that still owes, from a choice: a whole number of days 0..CFG.SALE_DUE_MAX_DAYS (a number or
 * a digit string, Burmese digits too) is that many days from today; 'none' or '' is ''; any other text is a typed date
 * (parseDayText, a yearless past date not rolled), kept only from today to today + SALE_DUE_MAX_DAYS. Else null (refused).
 */
function saleDueKey(now, choice) {
  if (choice === null || choice === undefined) return null;
  var today = dayKey(now);
  if (typeof choice === 'number') {
    return choice >= 0 && choice === Math.round(choice) && choice <= CFG.SALE_DUE_MAX_DAYS ? addDaysKey(today, choice) : null;
  }
  var s = String(choice).replace(/[၀-၉]/g, function (c) { return String(MY_DIGITS.indexOf(c)); }).trim();
  if (s === '' || s.toLowerCase() === 'none') return '';
  if (/^\d+$/.test(s)) return Number(s) <= CFG.SALE_DUE_MAX_DAYS ? addDaysKey(today, Number(s)) : null;
  var key = parseDayText(s, now, { noRoll: true });
  if (!key || key < today || daysBetweenKeys(today, key) > CFG.SALE_DUE_MAX_DAYS) return null;
  return key;
}

/** The profit of a price over a cost and its markup on the cost in percent; null unless both are whole numbers >= 1. */
function itemMargin(price, cost) {
  if (price === '' || cost === '' || nullish(price) || nullish(cost)) return null;
  var p = Number(price), c = Number(cost);
  if (!(p >= 1) || !(c >= 1) || p !== Math.round(p) || c !== Math.round(c)) return null;
  return { profit: p - c, pct: Math.round((p - c) * 100 / c) };
}

/** The name a new piece gets when nobody typed one: the one name the photo AI may replace (aiRenameFields). */
function itemPlaceholderName(id) {
  return 'ပစ္စည်း ' + id;
}

/**
 * Is this sale group a basket (more than one live SALE row) and not a custom-order delivery (which writes one SALE row per
 * voucher line into the order's group)? info = saleGroupInfo(...). The guard of every basket reader branch.
 */
function basketGroup(info) {
  return !!info && !!info.rows && info.rows.length > 1 && !isOrderId(info.groupId);
}

/**
 * The photo AI's late rename (spec 6.2), one rule on the server and the phones: null unless the item still carries its
 * placeholder name (a BLANK item, name '', and a typed name are never renamed). Pure. cats (round 6b, optional) =
 * {names, other} from itemCategoryCats: the list the AI was given and its catch-all. The category is set to the entry of
 * names that is the AI's answer (listNameKey) only when the item's category is '', the catch-all (cats.other) or the
 * word of the last of CFG.CATEGORIES (old pieces keep it after a rename). Without cats, names is CFG.CATEGORIES and the
 * catch-all its last entry: the rule of before round 6b.
 */
function aiRenameFields(item, desc, cats) {
  if (!item || !desc || !desc.name || String(item.name) !== itemPlaceholderName(item.id)) return null;
  var out = { name: String(desc.name) }, last = CFG.CATEGORIES[CFG.CATEGORIES.length - 1];
  var names = (cats && cats.names) || CFG.CATEGORIES, other = (cats && cats.other) || last;
  var hit = desc.category ? itemCategoryPick(names, desc.category) : '';
  var cur = listNameKey(item.category);
  if (hit && (!cur || cur === listNameKey(other) || cur === listNameKey(last))) out.category = hit;
  return out;
}

/**
 * A piece into a basket's lines (new arrays; lines is never changed). The basket's shop is the first line's item's shop;
 * with no line, staff.shop for a seller and the item's shop for the owner. Refusals, in this order: missing, blank,
 * other_shop, then without opts.restock gone (a UNIQUE at stock <= 0) and twice (a UNIQUE already in), with opts.restock
 * unique (any UNIQUE); then max (a new line past CFG.BASKET_MAX_LINES). A stock item already in gets qty more (merged).
 * Returns {ok: true, lines, index, merged} or {ok: false, reason, vars: {id, shop, max}}; BASKET_REASON_KEY names the key.
 */
function basketAddItem(ports, staff, lines, itemId, qty, opts) {
  opts = opts || {};
  lines = lines || [];
  var n = Math.min(CFG.MAX_SALE_QTY, Math.max(1, Math.round(Number(qty) || 1)));
  var item = ports.store.getItem(itemId), shop = '';
  if (lines.length) { var first = ports.store.getItem(lines[0].id); shop = first ? first.shop : ''; }
  else shop = staff && staff.role !== 'owner' ? staff.shop : (item ? item.shop : '');
  var vars = { id: String(itemId), shop: shopName(ports, item ? item.shop : shop), max: myDigits(CFG.BASKET_MAX_LINES) };
  var refuse = function (reason) { return { ok: false, reason: reason, vars: vars }; };
  if (!item) return refuse('missing');
  if (item.status === CFG.STATUS.BLANK) return refuse('blank');
  if (item.shop !== shop) return refuse('other_shop');
  var at = -1, i;
  for (i = 0; i < lines.length; i++) if (lines[i].id === item.id) at = i;
  var unique = item.type === CFG.ITEM_TYPE.UNIQUE;
  if (!opts.restock) {
    if (unique && Number(item.stock) <= 0) return refuse('gone');
    if (unique && at >= 0) return refuse('twice');
  } else if (unique) return refuse('unique');
  if (at < 0 && lines.length >= CFG.BASKET_MAX_LINES) return refuse('max');
  var out = lines.map(function (l) { return { id: l.id, qty: l.qty, unitPrice: l.unitPrice, priceChanged: !!l.priceChanged }; });
  if (at >= 0) {
    out[at].qty = Math.min(CFG.MAX_SALE_QTY, (Math.round(Number(out[at].qty)) || 1) + n);
    return { ok: true, lines: out, index: at, merged: true };
  }
  out.push({ id: item.id, qty: unique ? 1 : n, unitPrice: Number(item.price) > 0 ? Number(item.price) : null, priceChanged: false });
  return { ok: true, lines: out, index: out.length - 1, merged: false };
}

/** The message key of each basketAddItem reason. */
var BASKET_REASON_KEY = { missing: 'tag_not_found', blank: 'basket_blank', other_shop: 'basket_other_shop', gone: 'basket_gone',
  twice: 'basket_twice', unique: 'basket_unique', max: 'basket_max' };

/**
 * The Save-time check shared by the app's sale form and the Telegram review card (spec 4.2). draft = {lines: [{id, qty,
 * unitPrice, priceChanged}], customerId, newName, newPhone, method, mixed, bankPart, part, paid, dueDay, needAccount};
 * every line is re-read. Returns {ok, problems: [{code, id, key, vars}], totals} with the problems in the order of the
 * spec (the first is what the seller sees). opts.pendingMethod skips the method check (an account typed in the form, written
 * at Save).
 */
function basketCheck(ports, staff, draft, opts) {
  opts = opts || {};
  draft = draft || {};
  var problems = [], lines = draft.lines || [], today = dayKey(ports.clock.now());
  var add = function (code, key, vars, id) { problems.push({ code: code, id: id || '', key: key, vars: vars || {} }); };
  if (saleFlow(ports) !== CFG.SALE_FLOW.FORM) add('mode', 'expired');
  if (!lines.length) add('empty', 'scan_first');
  var first = lines.length ? ports.store.getItem(lines[0].id) : null;
  var shop = staff && staff.role !== 'owner' ? staff.shop : (first ? first.shop : '');
  var seen = {};
  lines.forEach(function (l) {
    var it = ports.store.getItem(l.id), q = Number(l.qty);
    var vars = { id: String(l.id), shop: shopName(ports, it ? it.shop : shop), max: myDigits(CFG.MAX_SALE_QTY) };
    if (!it) add('missing', 'tag_not_found', vars, l.id);
    else if (it.status === CFG.STATUS.BLANK) add('blank', 'basket_blank', vars, l.id);
    else if (it.shop !== shop) add('other_shop', 'basket_other_shop', vars, l.id);
    else if (it.type === CFG.ITEM_TYPE.UNIQUE && Number(it.stock) <= 0) add('gone', 'basket_line_gone', vars, l.id);
    else if (seen['i:' + l.id]) add('twice', 'basket_twice', vars, l.id);
    else if (nullish(l.unitPrice) || l.unitPrice === '' || !(Number(l.unitPrice) >= 1)) add('need_price', 'basket_need_price', vars, l.id);
    else if (!(q >= 1 && q <= CFG.MAX_SALE_QTY && q === Math.round(q))) add('qty', 'bad_qty', vars, l.id);
    seen['i:' + l.id] = true;
  });
  if (lines.length > CFG.BASKET_MAX_LINES) add('max', 'basket_max', { max: myDigits(CFG.BASKET_MAX_LINES) });
  var key = String(draft.method || CFG.METHOD.CASH).toUpperCase();
  // A retired account (a pull made it inactive) is offered no more: payMethods lists the shop's active accounts only.
  if (!opts.pendingMethod && key !== CFG.METHOD.CASH && payMethods(ports, shop).indexOf(key) < 0) add('method', 'basket_method_gone');
  if (draft.needAccount && key === CFG.METHOD.CASH) add('account', draft.needAccount === 'all' ? 'sale_ask_split_account' : 'sale_ask_account');
  var noPaid = !!draft.part && (nullish(draft.paid) || draft.paid === '');
  var T = basketTotals(lines, { part: !!draft.part && !noPaid, paid: draft.paid, method: draft.method, mixed: draft.mixed, bankPart: draft.bankPart });
  var paidNow = draft.part && !noPaid ? Math.round(Number(draft.paid)) : T.total, bank = Number(draft.bankPart);
  if (draft.mixed && !(bank >= 1 && bank <= paidNow && bank === Math.round(bank))) add('transfer', 'sale_bad_amount', { min: fmtMoney(1), max: fmtMoney(paidNow) });
  var owed = noPaid ? T.total : T.owed;
  if (noPaid) add('paid_none', 'sale_ask_paid', { total: fmtMoney(T.total) });
  else if (draft.part) {
    var min = draft.mixed ? (Number(draft.bankPart) || 0) : 0, p = Number(draft.paid);
    if (!(p >= min && p <= T.total - 1 && p === Math.round(p))) add('paid', 'sale_bad_amount', { min: fmtMoney(min), max: fmtMoney(T.total - 1) });
  }
  if (owed > 0 && !draft.customerId && !draft.newName) add('need_buyer', 'sale_need_buyer');
  if (!draft.customerId && draft.newName) {
    var digits = normPhone(draft.newPhone);
    if (digits.length >= 1 && digits.length <= 6) add('phone', 'basket_bad_phone');
  }
  if (owed > 0 && nullish(draft.dueDay)) add('due_none', 'sale_ask_due', { owed: fmtMoney(owed) });
  else if (owed > 0 && draft.dueDay !== '') {
    var d = String(draft.dueDay);
    if (!/^\d{4}-\d{2}-\d{2}$/.test(d) || d < today || daysBetweenKeys(today, d) > CFG.SALE_DUE_MAX_DAYS) add('due', 'ord_bad_date');
  }
  return { ok: !problems.length, problems: problems, totals: T };
}

/**
 * The Credits name of a basket: basket_name with the item names of its live SALE rows in row order, each cut to
 * CFG.BASKET_NAME_MAX characters (with '…'), the first three joined by ', ', then ', …' when there are more.
 */
function basketName(ports, info) {
  var names = info.rows.map(function (r) {
    var it = ports.store.getItem(r.itemId), n = it ? String(it.name || r.itemId) : String(r.itemId);
    return n.length > CFG.BASKET_NAME_MAX ? n.slice(0, CFG.BASKET_NAME_MAX - 1) + '…' : n;
  });
  return t(ports, 'basket_name', { n: fmtCount(names.length), names: names.slice(0, 3).join(', ') + (names.length > 3 ? ', …' : '') });
}

/**
 * The open credit a returned piece would leave behind (spec 1.10): its last live SALE's group, when that is not a custom
 * order, not voided and still owes. {groupId, customerId, owed} or null. case 'T' refuses a return while it is set.
 */
function creditOpenFor(ports, itemId) {
  var s = lastLiveSale(ports, itemId), info = s ? saleGroupInfo(ports, s.groupId) : null;
  if (!info || isOrderId(info.groupId) || info.voided || !(info.owed > 0)) return null;
  return { groupId: info.groupId, customerId: info.customerId, owed: info.owed };
}

/**
 * A new piece's group (one live RESTOCK row noted 'new item' or 'new sample'): {itemId, used} where used = the piece has a
 * live row in any other group (sold, moved, restocked, returned); null for any other group.
 */
function newItemUndoInfo(ports, groupId) {
  var g = groupRows(ports, groupId);
  if (g.live.length !== 1) return null;
  var r = g.live[0];
  if (r.type !== CFG.TX.RESTOCK || (r.note !== 'new item' && r.note !== 'new sample')) return null;
  var others = liveRows(g.all.filter(function (x) { return x.itemId === r.itemId && x.groupId !== groupId; }), g.all);
  return { itemId: r.itemId, used: others.length > 0 };
}

/**
 * The one write of a sale of one or more pieces (spec 3.2): p = {lines: [{item, qty, unitPrice, priceChanged}], paid,
 * method, bankPart, mixed, customerId, dueDay, note, staff, source, transcript, updateId, when}. One clock read; one SALE
 * row per line in line order (cash filled in line order, the buyer on every row, DueDay on every SALE row while the group
 * owes), then at most one PAYMENT (the transfer part of a mixed payment, after every SALE row); one writeGroup. Throws on
 * no line or more than CFG.BASKET_MAX_LINES (a programming error: basketCheck refuses them first).
 * Returns {groupId, txs, sales, payment (or null), owed, total}.
 */
function commitBasket(ports, p) {
  var lines = p.lines || [];
  if (!lines.length || lines.length > CFG.BASKET_MAX_LINES) throw new Error('commitBasket: ' + lines.length + ' lines');
  var when = p.when instanceof Date ? p.when : ports.clock.now();
  var units = lines.map(function (l) {
    return { qty: Math.max(1, Math.round(Number(l.qty) || 1)), unitPrice: nullish(l.unitPrice) ? (Number(l.item.price) || 0) : Number(l.unitPrice) };
  });
  var T = basketTotals(units, { part: !nullish(p.paid), paid: p.paid, method: p.method, mixed: p.mixed, bankPart: p.bankPart });
  var KEY = String(p.method || CFG.METHOD.CASH).toUpperCase();
  var groupNote = p.note || (T.twoRows ? 'split' : T.owed > 0 ? 'credit' : '');
  var dueDay = T.owed > 0 ? (p.dueDay || '') : '';
  var sales = [], groupId = '';
  lines.forEach(function (l, i) {
    var tx = newTx(ports, {
      groupId: groupId, shop: l.item.shop, itemId: l.item.id, type: CFG.TX.SALE, qty: -units[i].qty, unitPrice: units[i].unitPrice,
      amount: T.amounts[i], cash: T.rowCash[i], costAtSale: l.item.cost, customerId: p.customerId || '', refGroupId: '',
      note: groupNote || (l.priceChanged ? 'price' : ''), method: T.rowMethod[i], dueDay: dueDay,
      source: p.source, transcript: i === 0 ? p.transcript : '', staffId: p.staff.id, updateId: p.updateId, when: when
    });
    if (!groupId) groupId = tx.groupId;
    sales.push(tx);
  });
  var payment = null;
  if (T.twoRows) {
    // After every SALE row: the server checks a PAYMENT against what the shadow ledger says is owed.
    payment = newTx(ports, {
      groupId: groupId, shop: lines[0].item.shop, itemId: lines[0].item.id, type: CFG.TX.PAYMENT, qty: 0, unitPrice: null,
      amount: T.bankPart, cash: T.bankPart, customerId: p.customerId || '', refGroupId: groupId, note: 'split', method: KEY,
      source: p.source, staffId: p.staff.id, updateId: p.updateId, when: when
    });
  }
  var r = writeGroup(ports, sales.concat(payment ? [payment] : []));
  return { groupId: r.groupId, txs: r.txs, sales: sales, payment: payment, owed: T.owed, total: T.total };
}

/**
 * A blank tag registered as a new piece of `count` (spec 3.6): p = {itemId, name, category, categoryKey, price, cost, count, sample,
 * photoUrl, photoFileId, staff, source, updateId, when}. Refusals (nothing written): missing, not_blank (registered
 * meanwhile), other_shop (a seller's tag of another shop), count (not a whole 1..999), price (absent, or neither '' nor a
 * whole number >= 0), cost (neither ''/absent nor a whole number >= 0). A price of 0 is stored '' (pending); an empty name
 * becomes the placeholder. The category (round 6b): p.categoryKey (optional), the key of the row the seller chose, is
 * stored with that row's current label (an owner's rename while the card was open keeps the choice); else a name that
 * matches an item_category row, active or retired (a built-in's old name included, itemCategoryOf), is stored with the
 * row's current label; '' or an unknown name gets the catch-all (itemCategoryFallback). The channels offer no retired
 * category; a card drawn before an untick may still pass one, and it is stored. One clock read; the Items fields of the chat
 * flow (count > 1: SKU, else UNIQUE) and ONE RESTOCK of count. The caller pings the owner while the price is pending.
 * Returns {ok: true, item, groupId, pending} or {ok: false, reason}.
 */
function commitNewItem(ports, p) {
  var item = ports.store.getItem(p.itemId);
  if (!item) return { ok: false, reason: 'missing' };
  if (!shopAcceptsEntry(ports, item.shop, p.when || ports.clock.now())) return { ok: false, reason: 'shop_closed' };
  if (item.status !== CFG.STATUS.BLANK) return { ok: false, reason: 'not_blank' };
  if (p.staff.role !== 'owner' && item.shop !== p.staff.shop) return { ok: false, reason: 'other_shop' };
  var count = nullish(p.count) ? 1 : Number(p.count);
  if (!(count >= 1 && count <= CFG.MAX_SALE_QTY && count === Math.round(count))) return { ok: false, reason: 'count' };
  var whole = function (v) { var n = Number(v); return v !== '' && typeof v !== 'boolean' && !nullish(v) && n >= 0 && n === Math.round(n); };
  if (nullish(p.price) || (p.price !== '' && !whole(p.price))) return { ok: false, reason: 'price' };
  if (!nullish(p.cost) && p.cost !== '' && !whole(p.cost)) return { ok: false, reason: 'cost' };
  var price = p.price === '' || Number(p.price) === 0 ? '' : Number(p.price);
  var cost = nullish(p.cost) || p.cost === '' ? '' : Number(p.cost);
  var name = String(p.name || '').trim() || itemPlaceholderName(item.id);
  var catRow = null, catKey = listNormKey('item_category', p.categoryKey), catRows = catKey ? itemCategoryRows(ports) : [];
  for (var ck = 0; ck < catRows.length && !catRow; ck++) if (catRows[ck].key === catKey) catRow = catRows[ck];
  if (!catRow) catRow = itemCategoryOf(ports, p.category);
  var category = catRow ? catRow.label : itemCategoryFallback(ports);
  var when = p.when instanceof Date ? p.when : ports.clock.now();
  ports.store.updateItem(item.id, {
    name: name, category: category, type: count > 1 ? CFG.ITEM_TYPE.SKU : CFG.ITEM_TYPE.UNIQUE, price: price, cost: cost,
    sample: !!p.sample, photoUrl: p.photoUrl || '', photoFileId: p.photoFileId || '', createdAt: when.toISOString(), createdBy: p.staff.id
  });
  var r = commitRestock(ports, { item: ports.store.getItem(item.id), qty: count, note: p.sample ? 'new sample' : 'new item',
    source: p.source || CFG.SOURCE.PHOTO, staff: p.staff, updateId: p.updateId, when: when });
  return { ok: true, item: ports.store.getItem(item.id), groupId: r.groupId, pending: price === '' };
}

/**
 * A restock of several stock items in one group (spec 3.7): p = {lines: [{item, qty}], note, staff, source, updateId,
 * when}. Refusals (nothing written): empty, max, qty (not a whole 1..999), unique, blank, other_shop (two shops, or a
 * seller's line of another shop). One clock read, one RESTOCK row per line in commitRestock's shape, one writeGroup.
 * Returns {ok: true, groupId, txs} or {ok: false, reason}.
 */
function commitRestockGroup(ports, p) {
  var lines = p.lines || [];
  if (!lines.length) return { ok: false, reason: 'empty' };
  if (lines.length > CFG.BASKET_MAX_LINES) return { ok: false, reason: 'max' };
  var items = lines.map(function (l) { return ports.store.getItem(l.item.id) || l.item; });
  var shop = items[0].shop, i, q;
  for (i = 0; i < lines.length; i++) {
    q = Number(lines[i].qty);
    if (!(q >= 1 && q <= CFG.MAX_SALE_QTY && q === Math.round(q))) return { ok: false, reason: 'qty' };
  }
  for (i = 0; i < items.length; i++) if (items[i].type === CFG.ITEM_TYPE.UNIQUE) return { ok: false, reason: 'unique' };
  for (i = 0; i < items.length; i++) if (items[i].status === CFG.STATUS.BLANK) return { ok: false, reason: 'blank' };
  for (i = 0; i < items.length; i++) {
    if (items[i].shop !== shop || (p.staff.role !== 'owner' && items[i].shop !== p.staff.shop)) return { ok: false, reason: 'other_shop' };
  }
  var when = p.when instanceof Date ? p.when : ports.clock.now(), groupId = '', txs = [];
  items.forEach(function (it, k) {
    var tx = newTx(ports, {
      groupId: groupId, shop: it.shop, itemId: it.id, type: CFG.TX.RESTOCK, qty: Number(lines[k].qty), unitPrice: null, amount: 0, cash: 0,
      note: p.note, source: p.source, transcript: p.transcript, staffId: p.staff.id, updateId: p.updateId, when: when
    });
    if (!groupId) groupId = tx.groupId;
    txs.push(tx);
  });
  var r = writeGroup(ports, txs);
  return { ok: true, groupId: r.groupId, txs: r.txs };
}

/**
 * The tag of an undone new piece blank again (spec 3.6): ONE updateItem that empties every column a blank tag has empty,
 * so its status reads BLANK and it can be registered again. Only case 'U' calls it, after the mirror of an unused new piece.
 */
function unregisterItem(ports, itemId) {
  ports.store.updateItem(itemId, { name: '', category: '', type: '', price: '', cost: '', sample: false, photoUrl: '', photoFileId: '',
    createdAt: '', createdBy: '' });
}

function commitRestock(ports, p) {
  var qty = Math.max(1, Math.round(Number(p.qty) || 1));
  var tx = newTx(ports, {
    shop: p.item.shop, itemId: p.item.id, type: CFG.TX.RESTOCK, qty: qty, unitPrice: null, amount: 0, cash: 0,
    note: p.note, source: p.source, transcript: p.transcript, staffId: p.staff.id, updateId: p.updateId, when: p.when
  });
  return writeGroup(ports, [tx]);
}

function commitReturn(ports, p) {
  var qty = Math.max(1, Math.round(Number(p.qty) || 1));
  var unitPrice = !nullish(p.unitPrice) ? Number(p.unitPrice)
    : (!nullish(p.amount) ? Math.round(Number(p.amount) / qty) : (Number(p.item.price) || 0));
  var sale = lastLiveSale(ports, p.item.id);
  var amount = -(qty * unitPrice);
  var cash = nullish(p.refund) ? amount : -Math.abs(Math.round(Number(p.refund) || 0));
  var tx = newTx(ports, {
    shop: p.item.shop, itemId: p.item.id, type: CFG.TX.RETURN, qty: qty, unitPrice: unitPrice,
    amount: amount, cash: cash, costAtSale: sale ? sale.costAtSale : p.item.cost, customerId: p.customerId || '', note: p.note,
    method: methodFor(p.method, cash),
    source: p.source, transcript: p.transcript, staffId: p.staff.id, updateId: p.updateId, when: p.when
  });
  return writeGroup(ports, [tx]);
}

/** p.category = expense category key (Settings expense_categories), p.method = CASH/KBZ/WAVE/BANK. */
function commitExpense(ports, p) {
  var amount = -Math.abs(Math.round(Number(p.amount) || 0));
  var tx = newTx(ports, {
    shop: p.shop, itemId: '', type: CFG.TX.EXPENSE, qty: 0, unitPrice: null, amount: amount, cash: amount,
    note: p.note || '', category: p.category ? String(p.category).toLowerCase() : '', method: methodFor(p.method, amount),
    source: p.source, transcript: p.transcript, staffId: p.staff.id, updateId: p.updateId, when: p.when
  });
  return writeGroup(ports, [tx]);
}

/** Moves the tag (and all its stock) to the other shop. */
function commitTransfer(ports, p) {
  var fromShop = p.item.shop, destinations = activeShopIds(ports).filter(function (s) { return s !== fromShop; });
  var toShop = p.toShop || (destinations.length === 1 ? destinations[0] : '');
  if (destinations.indexOf(toShop) < 0) throw new Error('လက်ခံမည့်ဆိုင် ရွေးပါ');
  var qty = Math.max(0, Number(p.item.stock) || 0);
  var out = newTx(ports, {
    shop: fromShop, itemId: p.item.id, type: CFG.TX.TRANSFER_OUT, qty: -qty, unitPrice: null, amount: 0, cash: 0,
    note: 'to ' + toShop, source: p.source, transcript: p.transcript, staffId: p.staff.id, updateId: p.updateId, when: p.when
  });
  var inn = newTx(ports, {
    shop: toShop, itemId: p.item.id, type: CFG.TX.TRANSFER_IN, qty: qty, unitPrice: null, amount: 0, cash: 0,
    note: 'from ' + fromShop, source: p.source, transcript: p.transcript, staffId: p.staff.id, updateId: p.updateId, when: p.when
  });
  var r = writeGroup(ports, [out, inn]);
  ports.store.updateItem(p.item.id, { shop: toShop });
  return r;
}

/** Cash received later against a credit sale (p.groupId). Capped at what is still owed. */
function commitPayment(ports, p) {
  var info = p.groupId ? saleGroupInfo(ports, p.groupId) : null;
  var amount = Math.round(Number(p.amount) || 0);
  if (info && info.owed > 0) amount = Math.min(amount, info.owed);
  if (amount <= 0) throw new Error('Payment amount must be positive');
  var tx = newTx(ports, {
    shop: p.shop || (info && info.shop), itemId: info ? info.itemId : '', type: CFG.TX.PAYMENT, qty: 0, unitPrice: null,
    amount: amount, cash: amount, customerId: p.customerId || (info && info.customerId) || '', refGroupId: p.groupId || '',
    note: p.note || '', method: methodFor(p.method, amount),
    source: p.source, transcript: p.transcript, staffId: p.staff.id, updateId: p.updateId, when: p.when
  });
  return writeGroup(ports, [tx]);
}

/**
 * Cash received in advance for an order. Held until a sale applies it. p.refGroupId = the voucher id
 * (V1-2532) earmarks the advance to that order; without it the money joins the customer's free pool.
 */
function commitDeposit(ports, p) {
  var amount = Math.round(Number(p.amount) || 0);
  if (amount <= 0) throw new Error('Deposit amount must be positive');
  var tx = newTx(ports, {
    shop: p.shop, itemId: '', type: CFG.TX.DEPOSIT, qty: 0, unitPrice: null, amount: amount, cash: amount,
    customerId: p.customerId, refGroupId: p.refGroupId || '', note: p.note || '', method: methodFor(p.method, amount),
    source: p.source, transcript: p.transcript, staffId: p.staff.id, updateId: p.updateId, when: p.when
  });
  return writeGroup(ports, [tx]);
}

/**
 * Consume a held deposit against a sale. The row joins the sale's group so that
 * undoing the sale also returns the deposit. Returns {amount, groupId} or null.
 * Only the customer's FREE pool is used (plus the earmark of p.orderId when given): an advance
 * earmarked to an open voucher (DEPOSIT with RefGroupID = order id) is never eaten by another sale.
 */
function applyDeposit(ports, p) {
  var info = saleGroupInfo(ports, p.groupId);
  if (!info || info.voided) return null;
  var customerId = p.customerId || info.customerId;
  var held = p.orderId ? depositsAvailable(ports, customerId, p.orderId) : depositsFree(ports, customerId);
  var amount = Math.min(held, info.owed, nullish(p.amount) ? Infinity : Number(p.amount));
  amount = Math.round(amount);
  if (amount <= 0) return null;
  var tx = newTx(ports, {
    groupId: info.groupId, shop: info.shop, itemId: info.itemId, type: CFG.TX.DEPOSIT_APPLIED, qty: 0, unitPrice: null,
    amount: amount, cash: 0, customerId: customerId, refGroupId: info.groupId, note: 'deposit', source: p.source,
    staffId: p.staff.id, updateId: p.updateId, when: p.when
  });
  writeGroup(ports, [tx]);
  return { amount: amount, groupId: info.groupId };
}

/* ----------------------------- live rows, undo, rewrite ----------------------------- */

/** Set of txIds that some row reverses. */
function reversedIdSet(all) {
  var s = {};
  all.forEach(function (r) { if (r.reversesTxId) s[r.reversesTxId] = true; });
  return s;
}

/**
 * Rows that neither reverse another row nor are reversed by one. `all` (the whole ledger)
 * is needed when the reversing rows may live outside `rows`; it defaults to `rows`.
 */
function liveRows(rows, all) {
  var reversed = reversedIdSet(all || rows);
  return rows.filter(function (r) { return !r.reversesTxId && !reversed[r.txId]; });
}

/** {all, rows, live} for one group. */
function groupRows(ports, groupId) {
  var all = ports.store.ledgerRows();
  var rows = all.filter(function (r) { return r.groupId === groupId; });
  return { all: all, rows: rows, live: liveRows(rows, all) };
}

/**
 * Reverse every live row of a group by appending mirror rows.
 * Returns {ok:true} or {ok:false, reason:'expired'|'already'|'missing'|'locked'}.
 * 'locked' (round 6): a later payment was taken against the group (a live PAYMENT row of ANOTHER group whose RefGroupID is
 * this one, as rewriteCheck's 'locked'); reversing it would leave that payment with no credit to pay, so neither the undo
 * nor the owner's void (opts.force) writes anything until that payment is voided. The group's own PAYMENT (a split) is not.
 * opts.force skips the time window (owner void, credit conversion); opts.note replaces 'undo'.
 */
function undoGroup(ports, groupId, staff, now, opts) {
  now = now || ports.clock.now();
  opts = opts || {};
  if (String(groupId).indexOf('SHIP-') === 0) return { ok: false, reason: 'locked' };
  var g = groupRows(ports, groupId);
  if (!g.rows.length) return { ok: false, reason: 'missing' };
  var rows = g.live;
  if (!rows.length) return { ok: false, reason: 'already' };
  var reversed = reversedIdSet(g.all);
  var paidLater = g.all.some(function (r) {
    return r.type === CFG.TX.PAYMENT && r.refGroupId === groupId && r.groupId !== groupId && !r.reversesTxId && !reversed[r.txId];
  });
  if (paidLater) return { ok: false, reason: 'locked' };
  var ageMin = (now.getTime() - new Date(rows[0].time).getTime()) / 60000;
  if (!opts.force && ageMin > CFG.UNDO_WINDOW_MIN) return { ok: false, reason: 'expired' };

  // Mirrors stay in the group they reverse, so the group's own sums (total, cash, deposit
  // applied) net to zero and an undone credit sale no longer counts as owed. They copy the
  // Method and Category so the per-method and per-category totals net out as well.
  var mirrors = rows.map(function (r) {
    return newTx(ports, {
      groupId: r.groupId, shop: r.shop, itemId: r.itemId, type: r.type, qty: -r.qty, unitPrice: r.unitPrice === '' ? null : r.unitPrice,
      amount: -r.amount, cash: -r.cash, costAtSale: r.costAtSale, customerId: r.customerId, refGroupId: r.refGroupId,
      method: r.method, category: r.category,
      note: opts.note || 'undo', source: CFG.SOURCE.UNDO, staffId: staff.id, reversesTxId: r.txId, when: now
    });
  });
  var r0 = writeGroup(ports, mirrors);
  var outRow = rows.filter(function (r) { return r.type === CFG.TX.TRANSFER_OUT; })[0];
  if (outRow) ports.store.updateItem(outRow.itemId, { shop: outRow.shop });
  return { ok: true, groupId: r0.groupId, itemId: rows[0].itemId, types: rows.map(function (r) { return r.type; }) };
}

/** Owner-only: reverse a group at any age (not one a later payment locks: undoGroup's 'locked'). Source UNDO, note 'void by owner'. */
function voidGroup(ports, groupId, staff) {
  return undoGroup(ports, groupId, staff, null, { force: true, note: 'void by owner' });
}

/**
 * Can this group be rewritten (one field corrected in place)? {ok, row, reason}.
 * Conditions: exactly one live row, of a rewritable type, from today, with no live PAYMENT
 * referencing the group (a DEPOSIT_APPLIED row in the group already makes it 'complex').
 */
function rewriteCheck(ports, groupId, now) {
  now = now || ports.clock.now();
  var g = groupRows(ports, groupId);
  if (!g.rows.length) return { ok: false, reason: 'missing' };
  if (!g.live.length) return { ok: false, reason: 'already' };
  if (g.live.length !== 1) return { ok: false, reason: 'complex' };
  var row = g.live[0];
  if (!CFG.REWRITABLE_TX[row.type]) return { ok: false, reason: 'type' };
  var reversed = reversedIdSet(g.all);
  var attached = g.all.some(function (r) {
    return r.type === CFG.TX.PAYMENT && r.refGroupId === groupId && !r.reversesTxId && !reversed[r.txId];
  });
  if (attached) return { ok: false, reason: 'locked' };
  if (dayKey(now) !== row.day) return { ok: false, reason: 'expired' };
  return { ok: true, row: row, all: g.all };
}

/**
 * The two rows of a rewrite, not yet written: [mirror, replacement] for the given live row. The mirror
 * (Note 'rewrite') reverses the row; the replacement copies every field, applies the changes (method,
 * customerId, cash, note, category) and keeps the original Time/Day and receipt number.
 * opts: {source, transcript, noteIfBlank}. rewriteGroup and splitSale write them.
 */
function rewriteRows(ports, row, changes, staff, updateId, opts) {
  opts = opts || {};
  changes = changes || {};
  var now = ports.clock.now();
  var has = function (k) { return Object.prototype.hasOwnProperty.call(changes, k) && changes[k] !== undefined; };
  var cash = has('cash') ? Math.round(Number(changes.cash) || 0) : row.cash;
  if (row.type === CFG.TX.SALE) cash = Math.max(0, Math.min(row.amount, cash));
  var method = has('method') ? changes.method : row.method;
  var note = has('note') ? changes.note : row.note;
  if (!note && opts.noteIfBlank) note = opts.noteIfBlank;
  var mirror = newTx(ports, {
    groupId: row.groupId, shop: row.shop, itemId: row.itemId, type: row.type, qty: -row.qty, unitPrice: row.unitPrice === '' ? null : row.unitPrice,
    amount: -row.amount, cash: -row.cash, costAtSale: row.costAtSale, customerId: row.customerId, refGroupId: row.refGroupId,
    method: row.method, category: row.category,
    note: 'rewrite', source: CFG.SOURCE.UNDO, staffId: staff.id, reversesTxId: row.txId, when: now
  });
  var replacement = newTx(ports, {
    groupId: row.groupId, shop: row.shop, itemId: row.itemId, type: row.type, qty: row.qty, unitPrice: row.unitPrice === '' ? null : row.unitPrice,
    amount: row.amount, cash: cash, costAtSale: row.costAtSale,
    customerId: has('customerId') ? changes.customerId : row.customerId, refGroupId: row.refGroupId,
    method: methodFor(method, cash), category: has('category') ? changes.category : row.category,
    note: note, source: opts.source || CFG.SOURCE.BUTTON, transcript: opts.transcript || row.transcript,
    staffId: staff.id, updateId: updateId, receiptNo: row.receiptNo, dueDay: has('dueDay') ? changes.dueDay : row.dueDay,
    when: new Date(row.time)
  });
  return [mirror, replacement];
}

/**
 * Rewrite the one live row of a group: append a mirror (Note 'rewrite') and a replacement that
 * copies every field, applies `changes` (method, customerId, cash, note, category) and keeps the
 * original Time/Day, all in the SAME group. opts: {source, transcript, noteIfBlank}.
 * Returns {ok:true, groupId, txs:[mirror, replacement], row} or {ok:false, reason}.
 */
function rewriteGroup(ports, groupId, changes, staff, updateId, opts) {
  var chk = rewriteCheck(ports, groupId);
  if (!chk.ok) return chk;
  var pair = rewriteRows(ports, chk.row, changes, staff, updateId, opts);
  var r = writeGroup(ports, pair);
  return { ok: true, groupId: r.groupId, txs: r.txs, row: pair[1] };
}

/**
 * One sale, part cash and part into ONE account (a split is always cash plus one account). bankPart of
 * the sale's cash is recorded as paid with the account key in method; the rest stays (or becomes) cash.
 * One write, in the sale's own group, in this order: the mirror of the live SALE row, its replacement with
 * Cash = the cash part and Method CASH (same receipt number, Time and Day), and a PAYMENT row with
 * Amount = Cash = the bank part, Method = the account, RefGroupID = the group. That is the shape a
 * custom-order delivery has, so owed, credits, by-method totals, receipts, undo and the sync server
 * already read it; the PAYMENT must come after the SALE row (the server checks a payment against what is owed).
 * Returns {ok: true, full: false, groupId, cashPart, bankPart, method, cashMethod: 'CASH'};
 * when the bank part covers the whole payment it is a plain method change (nothing at all when the sale is
 * already on that account): {ok, reason, full: true, groupId, method, bankPart, cashPart: 0};
 * or {ok: false, reason}: the rewriteCheck reasons, 'type' (not a sale with cash), 'method' (CASH, an
 * unknown key, or another account than the one the sale is already marked with), 'amount'.
 */
function splitSale(ports, groupId, bankPart, method, staff, updateId, source) {
  var chk = rewriteCheck(ports, groupId);
  if (!chk.ok) return { ok: false, reason: chk.reason };
  var row = chk.row;
  if (row.type !== CFG.TX.SALE || !(row.cash > 0)) return { ok: false, reason: 'type' };
  var key = String(method === null || method === undefined ? '' : method).trim().toUpperCase(), was = methodOf(row);
  if (!key || key === CFG.METHOD.CASH || !methodKnown(ports, key) || (was !== CFG.METHOD.CASH && key !== was)) {
    return { ok: false, reason: 'method' };
  }
  var bank = Math.round(Number(bankPart));
  if (!isFinite(bank) || bank <= 0) return { ok: false, reason: 'amount' };
  if (bank >= row.cash) {
    var full = { ok: true, reason: '', full: true, groupId: groupId, method: key, bankPart: row.cash, cashPart: 0 };
    if (was === key) return full;
    var rw = rewriteGroup(ports, groupId, { method: key }, staff, updateId, { noteIfBlank: 'method', source: source });
    full.ok = rw.ok;
    full.reason = rw.ok ? '' : rw.reason;
    return full;
  }
  var pair = rewriteRows(ports, row, { cash: row.cash - bank, method: CFG.METHOD.CASH }, staff, updateId, { noteIfBlank: 'split', source: source });
  var payment = newTx(ports, {
    groupId: groupId, shop: row.shop, itemId: row.itemId, type: CFG.TX.PAYMENT, qty: 0, unitPrice: null, amount: bank, cash: bank,
    customerId: row.customerId, refGroupId: groupId, note: 'split', method: key, staffId: staff.id,
    source: source || CFG.SOURCE.BUTTON, updateId: updateId
  });
  writeGroup(ports, [pair[0], pair[1], payment]);
  return { ok: true, full: false, groupId: groupId, cashPart: row.cash - bank, bankPart: bank, method: key, cashMethod: CFG.METHOD.CASH };
}

/**
 * Rewrite a just-made sale as a credit sale: same group, cash = what was actually received,
 * customer attached. Time and Day stay those of the sale.
 */
function convertSaleToCredit(ports, groupId, paidNow, customerId, staff, updateId) {
  var info = saleGroupInfo(ports, groupId);
  if (!info || info.voided) return { ok: false, reason: 'missing' };
  var r = rewriteGroup(ports, groupId, { cash: paidNow, customerId: customerId, note: 'credit' }, staff, updateId);
  if (!r.ok) return r;
  return { ok: true, groupId: r.groupId, txs: r.txs };
}

/* ----------------------------- credit and deposit lookups ----------------------------- */

/** Everything about one sale group: total, cash, payments, deposit used, owed. Null if not a sale. */
function saleGroupInfo(ports, groupId) {
  var all = ports.store.ledgerRows();
  var rows = all.filter(function (r) { return r.groupId === groupId; });
  // Rows written before mirrors joined their group (older data) reverse group rows from outside; count them too.
  var ids = {};
  rows.forEach(function (r) { ids[r.txId] = true; });
  all.forEach(function (r) { if (r.reversesTxId && ids[r.reversesTxId] && r.groupId !== groupId) rows.push(r); });
  var saleRows = rows.filter(function (r) { return r.type === CFG.TX.SALE; });
  if (!saleRows.length) return null;
  var live = liveRows(saleRows, all);
  var total = 0, cash = 0, applied = 0, payments = 0, qty = 0;
  saleRows.forEach(function (r) { total += r.amount; cash += r.cash; qty -= r.qty; });
  rows.forEach(function (r) { if (r.type === CFG.TX.DEPOSIT_APPLIED) applied += r.amount; });
  all.forEach(function (r) { if (r.type === CFG.TX.PAYMENT && r.refGroupId === groupId) payments += r.amount; });
  var first = live[0] || saleRows[0];
  return {
    groupId: groupId, rows: live, origin: saleRows[0], shop: first.shop, day: first.day, time: first.time, itemId: first.itemId,
    customerId: first.customerId, qty: qty, unitPrice: first.unitPrice, total: total, cash: cash, method: methodOf(first),
    // The first dated live SALE row, then any dated SALE row (round 6: a basket dates every row; one line of insurance).
    dueDay: firstDueDay(live) || firstDueDay(saleRows),
    applied: applied, payments: payments, owed: total - cash - applied - payments, voided: total <= 0,
    // The SALE rows that were live before an undo voided the group (a receipt still lists them).
    voidedRows: saleRows.filter(function (r) { return !r.reversesTxId && undoneBy(all, r.txId); })
  };
}

/** The first non-blank dueDay of the rows, else ''. */
function firstDueDay(rows) {
  for (var i = 0; i < rows.length; i++) if (rows[i].dueDay) return rows[i].dueDay;
  return '';
}

/** The row that reverses txId through an undo or void (not a rewrite), or null. */
function undoneBy(all, txId) {
  for (var i = 0; i < all.length; i++) {
    if (all[i].reversesTxId === txId && all[i].note !== 'rewrite') return all[i];
  }
  return null;
}

/**
 * How a sale group was paid: [{method, amount}] over its live SALE rows (cash now) and the live
 * PAYMENT rows that reference it, so a receipt can say "ငွေသား 6,000 · KBZPay 6,000".
 */
function groupMethods(ports, groupId) {
  var all = ports.store.ledgerRows(), reversed = reversedIdSet(all), sums = {}, order = [];
  all.forEach(function (r) {
    if (r.reversesTxId || reversed[r.txId] || !r.cash) return;
    var isSale = r.type === CFG.TX.SALE && r.groupId === groupId;
    var isPay = r.type === CFG.TX.PAYMENT && r.refGroupId === groupId;
    if (!isSale && !isPay) return;
    var key = methodOf(r);
    if (!(key in sums)) { sums[key] = 0; order.push(key); }
    sums[key] += r.cash;
  });
  return order.map(function (k) { return { method: k, amount: sums[k] }; }).filter(function (m) { return m.amount > 0; });
}

/** The live SALE row that last moved an item out (who bought this piece), or null. */
function lastLiveSale(ports, itemId) {
  var all = ports.store.ledgerRows();
  var sales = liveRows(all.filter(function (r) { return r.type === CFG.TX.SALE && r.itemId === itemId; }), all);
  return sales.length ? sales[sales.length - 1] : null;
}

/**
 * Is a credit overdue? A dated credit (DueDay on its SALE row) is overdue the day after its date; an undated one
 * after CFG.OVERDUE_DAYS days. today = dayKey(now).
 */
function creditOverdue(dueDay, days, today) {
  return dueDay ? today > dueDay : days >= CFG.OVERDUE_DAYS;
}

/** Sales with money still owed, oldest first. shop null = all shops. */
function openCredits(ports, shop) {
  var all = ports.store.ledgerRows(), out = [], now = ports.clock.now(), today = dayKey(now);
  // One pass to find the groups that can owe anything: their SALE rows (mirrors and replacements net out), the
  // PAYMENT rows that reference them and the deposits applied in them, summed the way saleGroupInfo sums them.
  // A group that owes nothing (every split sale among them: its account part is a PAYMENT) is left out here, so
  // saleGroupInfo, which reads the whole ledger, runs only for the groups that really owe.
  var groups = {}, order = [], paid = {}, applied = {}, mirrors = [];
  all.forEach(function (r) {
    if (r.type === CFG.TX.PAYMENT && r.refGroupId) paid[r.refGroupId] = (paid[r.refGroupId] || 0) + r.amount;
    if (r.type === CFG.TX.DEPOSIT_APPLIED) applied[r.groupId] = (applied[r.groupId] || 0) + r.amount;
    if (r.reversesTxId && (r.type === CFG.TX.SALE || r.type === CFG.TX.DEPOSIT_APPLIED)) mirrors.push(r);
    if (r.type !== CFG.TX.SALE) return;
    if (shop && r.shop !== shop) return;
    var g = groups[r.groupId];
    if (!g) { g = groups[r.groupId] = { amount: 0, cash: 0 }; order.push(r.groupId); }
    g.amount += r.amount;
    g.cash += r.cash;
  });
  // Older data: a mirror written outside the group of the row it reverses counts for that group too, as in saleGroupInfo.
  if (mirrors.length) {
    var groupOf = {};
    all.forEach(function (r) { if (r.txId) groupOf['t:' + r.txId] = r.groupId; });
    mirrors.forEach(function (r) {
      var og = groupOf['t:' + r.reversesTxId];
      if (og === undefined || og === r.groupId) return;
      if (r.type === CFG.TX.DEPOSIT_APPLIED) applied[og] = (applied[og] || 0) + r.amount;
      else if (groups[og]) { groups[og].amount += r.amount; groups[og].cash += r.cash; }
    });
  }
  order.forEach(function (groupId) {
    var g = groups[groupId];
    if (g.amount <= 0 || g.amount - g.cash - (applied[groupId] || 0) - (paid[groupId] || 0) <= 0) return;
    var info = saleGroupInfo(ports, groupId);
    if (!info || info.voided || info.owed <= 0) return;
    var item = ports.store.getItem(info.itemId);
    // A delivered voucher line (ItemID V1-2532-1) has no Items row: its Note (fabric + design + description) is the name.
    var itemName = item ? item.name : (isOrderLineId(info.itemId) && info.rows[0] && info.rows[0].note ? info.rows[0].note : info.itemId);
    if (basketGroup(info)) itemName = basketName(ports, info);
    if (!item && isOrderId(groupId) && info.rows.length > 1) itemName = fmtCount(info.rows.length) + ' ကြောင်း · ' + itemName;
    var days = daysSince(info.time, now);
    out.push({
      groupId: info.groupId, shop: info.shop, day: info.day, time: info.time, customerId: info.customerId,
      customer: customerName(ports, info.customerId), itemId: info.itemId, item: itemName,
      qty: info.qty, total: info.total, cash: info.cash, payments: info.payments, applied: info.applied,
      owed: info.owed, days: days,
      // The promised date (round 5) and whether the credit is overdue by it (or by age when undated); daysOver = days past it.
      dueDay: info.dueDay, overdue: creditOverdue(info.dueDay, days, today),
      daysOver: info.dueDay ? daysBetweenKeys(info.dueDay, today) : days
    });
  });
  out.sort(function (a, b) { return a.time < b.time ? -1 : a.time > b.time ? 1 : 0; });
  return out;
}

/**
 * Map customerId -> {received, used, held, lastDay, earmarks, free, earmarked} over all time.
 * An advance for a custom order is a DEPOSIT row whose RefGroupID is the order id (V1-2532); it stays
 * earmarked to that voucher until DEPOSIT_APPLIED rows in that order's group (the delivery, or the kept
 * cancellation fee) consume it, or a negative DEPOSIT row (refund) returns it. earmarks = {orderId: held},
 * free = held - sum(earmarks): what a credit sale or another order may use (only after an explicit yes).
 */
function depositsHeldMap(ports) {
  var map = {};
  ports.store.ledgerRows().forEach(function (r) {
    if (r.type !== CFG.TX.DEPOSIT && r.type !== CFG.TX.DEPOSIT_APPLIED) return;
    var m = map[r.customerId] || (map[r.customerId] = { customerId: r.customerId, received: 0, used: 0, held: 0, lastDay: '', earmarks: {}, free: 0, earmarked: '', byRef: {}, byGroup: {} });
    if (r.type === CFG.TX.DEPOSIT) {
      m.received += r.amount;
      if (isOrderId(r.refGroupId)) m.byRef[r.refGroupId] = (m.byRef[r.refGroupId] || 0) + r.amount;
    } else {
      m.used += r.amount;
      if (isOrderId(r.groupId)) m.byGroup[r.groupId] = (m.byGroup[r.groupId] || 0) + r.amount;
    }
    m.held = m.received - m.used;
    if (r.day > m.lastDay) m.lastDay = r.day;
  });
  Object.keys(map).forEach(function (k) {
    var m = map[k], sum = 0, parts = [];
    Object.keys(m.byRef).forEach(function (orderId) {
      var left = m.byRef[orderId] - (m.byGroup[orderId] || 0);
      if (left > 0) { m.earmarks[orderId] = left; sum += left; parts.push(orderId + ': ' + fmtMoney(left)); }
    });
    m.free = Math.max(0, m.held - sum);
    m.earmarked = parts.join(', ');
    delete m.byRef;
    delete m.byGroup;
  });
  return map;
}

/** Everything the customer has in advance (earmarked or not): the "deposit held" figure of cards and summaries. */
function depositsFor(ports, customerId) {
  var m = depositsHeldMap(ports)[customerId];
  return m ? m.held : 0;
}

/** The part of the held deposits that belongs to no open voucher: what a credit sale may consume. */
function depositsFree(ports, customerId) {
  var m = depositsHeldMap(ports)[customerId];
  return m ? m.free : 0;
}

/** The advance earmarked to one order (net of what its group already applied). */
function depositEarmark(ports, customerId, orderId) {
  var m = depositsHeldMap(ports)[customerId];
  return m && m.earmarks[orderId] ? m.earmarks[orderId] : 0;
}

/** What a delivery of `orderId` may apply at most: its own earmark plus the customer's free pool. */
function depositsAvailable(ports, customerId, orderId) {
  var m = depositsHeldMap(ports)[customerId];
  if (!m) return 0;
  return m.free + (m.earmarks[orderId] || 0);
}

function depositsHeldList(ports) {
  var map = depositsHeldMap(ports);
  return Object.keys(map).map(function (k) { return map[k]; }).filter(function (m) { return m.held > 0; })
    .map(function (m) { m.customer = customerName(ports, m.customerId); return m; })
    .sort(function (a, b) { return b.held - a.held; });
}

/* ----------------------------- customers ----------------------------- */

/**
 * Per-customer totals in one pass: {bought, paid, owed, depositHeld, lastDay, visits}.
 * Bought = SALE+RETURN amounts; Paid = their Cash + PAYMENT + DEPOSIT_APPLIED; Owed = Bought - Paid;
 * DepositHeld = DEPOSIT - DEPOSIT_APPLIED. Mirrors net out. LastDay and Visits count live rows only.
 */
function customerSummaryMap(ports) {
  var all = ports.store.ledgerRows(), reversed = reversedIdSet(all), map = {}, T = CFG.TX;
  all.forEach(function (r) {
    if (!r.customerId) return;
    var m = map[r.customerId] || (map[r.customerId] = { customerId: r.customerId, bought: 0, paid: 0, owed: 0, depositHeld: 0, lastDay: '', visits: 0, days: {} });
    switch (r.type) {
      case T.SALE: case T.RETURN: m.bought += r.amount; m.paid += r.cash; break;
      case T.FEE: m.bought += r.amount; break;   // a kept cancellation fee is paid by its DEPOSIT_APPLIED row
      case T.PAYMENT: m.paid += r.amount; break;
      case T.DEPOSIT_APPLIED: m.paid += r.amount; m.depositHeld -= r.amount; break;
      case T.DEPOSIT: m.depositHeld += r.amount; break;
      default: break;
    }
    if (!r.reversesTxId && !reversed[r.txId]) {
      if (!m.days[r.day]) { m.days[r.day] = true; m.visits++; }
      if (r.day > m.lastDay) m.lastDay = r.day;
    }
  });
  Object.keys(map).forEach(function (k) { map[k].owed = map[k].bought - map[k].paid; delete map[k].days; });
  return map;
}

function customerSummary(ports, customerId) {
  return customerSummaryMap(ports)[customerId] || { customerId: customerId, bought: 0, paid: 0, owed: 0, depositHeld: 0, lastDay: '', visits: 0 };
}

/** Every customer with its summary, for the Customers tab view (columns F:K). */
function customerSummaries(ports) {
  var map = customerSummaryMap(ports);
  return ports.store.listCustomers().map(function (c) {
    var m = map[c.id] || { bought: 0, paid: 0, owed: 0, depositHeld: 0, lastDay: '', visits: 0 };
    return { id: c.id, customerId: c.id, name: c.name, phone: c.phone || '', note: c.note || '', createdAt: c.createdAt || '',
             bought: m.bought, paid: m.paid, owed: m.owed, depositHeld: m.depositHeld, lastDay: m.lastDay, visits: m.visits };
  });
}

/** The last n live rows of a customer, newest first. */
function customerHistory(ports, customerId, n) {
  var all = ports.store.ledgerRows();
  var rows = liveRows(all.filter(function (r) { return r.customerId === customerId; }), all);
  rows.sort(function (a, b) { return a.time < b.time ? 1 : a.time > b.time ? -1 : 0; });
  return n ? rows.slice(0, n) : rows;
}

function customerName(ports, customerId) {
  if (!customerId) return '?';
  var c = ports.store.getCustomer(customerId);
  return c ? c.name : customerId;
}

/** Customers with the most recent ledger activity first, padded with the newest customers. */
function recentCustomers(ports, shop, n) {
  var rows = ports.store.ledgerRows(), seen = {}, out = [];
  for (var i = rows.length - 1; i >= 0 && out.length < n; i--) {
    var r = rows[i];
    if (!r.customerId || seen[r.customerId]) continue;
    if (shop && r.shop !== shop) continue;
    seen[r.customerId] = true;
    var c = ports.store.getCustomer(r.customerId);
    if (c) out.push(c);
  }
  if (out.length < n) {
    ports.store.listCustomers().slice().sort(function (a, b) { return a.createdAt < b.createdAt ? 1 : -1; })
      .forEach(function (c) { if (out.length < n && !seen[c.id]) { seen[c.id] = true; out.push(c); } });
  }
  return out;
}

function normName(s) { return String(s || '').replace(/\s+/g, '').toLowerCase(); }

/**
 * Phone digits for matching and storage: Burmese digits -> Arabic, everything but digits dropped,
 * +959... / 959... -> 09..., 9xxxxxxxx -> 09xxxxxxxx. Returns '' when there are no digits.
 */
function normPhone(s) {
  var d = String(s || '').replace(/[၀-၉]/g, function (c) { return String(MY_DIGITS.indexOf(c)); }).replace(/\D/g, '');
  if (/^959\d{6,}$/.test(d)) d = '0' + d.slice(2);
  else if (/^9\d{7,9}$/.test(d)) d = '0' + d;
  return d;
}

function isValidPhone(s) { return /^09\d{7,9}$/.test(normPhone(s)); }

/** '09777123456' -> '+95 977 712 3456' (international form, tappable in Telegram). Odd values come back as typed. */
function fmtPhone(s) {
  var d = normPhone(s);
  if (!/^09\d{7,9}$/.test(d)) return String(s || '');
  var rest = d.slice(1), groups = [];
  groups.push(rest.slice(0, 3));
  rest = rest.slice(3);
  while (rest.length > 4) { groups.push(rest.slice(0, 3)); rest = rest.slice(3); }
  if (rest) groups.push(rest);
  return '+95 ' + groups.join(' ');
}

/**
 * Customers matching a hint: phone digits first (4 or more digits typed), then exact name,
 * then names that contain the hint or vice versa. Never merges on its own; callers decide.
 */
function findCustomers(ports, hint) {
  var raw = String(hint || '').trim();
  if (!raw) return [];
  var list = ports.store.listCustomers(), out = [];
  var digits = raw.replace(/[၀-၉]/g, function (c) { return String(MY_DIGITS.indexOf(c)); }).replace(/\D/g, '');
  var letters = raw.replace(/[\d၀-၉\s+()\-\.]/g, '');
  if (digits.length >= 4 && !letters) {
    var want = normPhone(raw);
    list.forEach(function (c) {
      var p = normPhone(c.phone);
      if (!p) return;
      if (p === want) out.unshift(c); else if (p.indexOf(digits) >= 0 || p.indexOf(want) >= 0) out.push(c);
    });
    return out;
  }
  var h = normName(raw);
  var exact = list.filter(function (c) { return normName(c.name) === h; });
  var partial = list.filter(function (c) {
    var n = normName(c.name);
    return n !== h && n && (n.indexOf(h) >= 0 || h.indexOf(n) >= 0);
  });
  return exact.concat(partial);
}

/** {exact: customer|null, partial: [customers]} for a typed or spoken name. */
function matchCustomers(ports, hint) {
  var found = findCustomers(ports, hint), h = normName(hint);
  var exact = found.filter(function (c) { return normName(c.name) === h || (normPhone(hint) && normPhone(c.phone) === normPhone(hint)); })[0] || null;
  return { exact: exact, partial: found.filter(function (c) { return c !== exact; }) };
}

/** Auto-picks only an exact name (or exact phone) match; otherwise creates. Bot flows offer a chooser first. */
function resolveOrCreateCustomer(ports, name) {
  var m = matchCustomers(ports, name);
  if (m.exact) return m.exact;
  return ports.store.addCustomer({ name: String(name || '').trim() });
}

/**
 * The checks of the app's buyer form (round 6, revision 3): v = {name, phone, note, forceNew}; selfId = the edited
 * customer's id ('' for a new buyer). Problems in order: name (empty), phone (1-6 digits), known_phone (another customer
 * has that phone; its id rides along), same_name (a new buyer whose name a customer already has, unless forceNew).
 * Returns {ok, problems: [{code, field, key, vars, customerId?}]}. Reads the store only.
 */
function customerCheck(ports, v, selfId) {
  v = v || {};
  selfId = selfId || '';
  var problems = [], name = String(v.name || '').trim(), digits = normPhone(v.phone), list = ports.store.listCustomers();
  if (!name) problems.push({ code: 'name', field: 'name', key: 'ask_name', vars: {} });
  if (digits.length >= 1 && digits.length <= 6) problems.push({ code: 'phone', field: 'phone', key: 'basket_bad_phone', vars: {} });
  else if (digits.length) {
    var known = list.filter(function (c) { return c.id !== selfId && normPhone(c.phone) === digits; })[0];
    if (known) problems.push({ code: 'known_phone', field: 'phone', key: 'ui_buyer_known_phone', vars: { customer: known.name }, customerId: known.id });
  }
  if (!selfId && !v.forceNew && name) {
    var same = list.filter(function (c) { return normName(c.name) === normName(name); })[0];
    if (same) problems.push({ code: 'same_name', field: 'name', key: 'ui_buyer_same_name', vars: { customer: same.name }, customerId: same.id });
  }
  return { ok: !problems.length, problems: problems };
}

/**
 * The write of the app's buyer form: the name trimmed and cut to CFG.CUST_NAME_MAX, the note cut to CFG.CUST_NOTE_MAX, the
 * phone as savePhone stores it (normalised when it is a valid number, else the trimmed text), cut to 20. With selfId only
 * the changed fields among name, phone and note go to updateCustomer; else addCustomer. Returns the stored record.
 */
function commitCustomer(ports, v, selfId) {
  v = v || {};
  var name = String(v.name || '').trim().slice(0, CFG.CUST_NAME_MAX);
  var note = String(v.note || '').trim().slice(0, CFG.CUST_NOTE_MAX);
  var raw = String(v.phone || '').trim();
  var phone = (isValidPhone(raw) ? normPhone(raw) : raw).slice(0, 20);
  if (selfId) {
    var cur = ports.store.getCustomer(selfId) || {}, ch = {}, n = 0;
    if (String(cur.name || '') !== name) { ch.name = name; n++; }
    if (String(cur.phone || '') !== phone) { ch.phone = phone; n++; }
    if (String(cur.note || '') !== note) { ch.note = note; n++; }
    if (n) ports.store.updateCustomer(selfId, ch);
    return ports.store.getCustomer(selfId);
  }
  return ports.store.addCustomer({ name: name, phone: phone, note: note });
}

/* ----------------------------- reporting ----------------------------- */

/**
 * Add a row's cash to the in/out buckets. An undo mirror reduces the bucket its
 * original filled, so gross cash in and out stay honest after corrections.
 */
function addCash(bucket, r) {
  if (!r.cash) return;
  if (r.reversesTxId) {
    if (r.cash < 0) bucket.cashIn += r.cash; else bucket.cashOut -= r.cash;
  } else if (r.cash > 0) {
    bucket.cashIn += r.cash;
  } else {
    bucket.cashOut -= r.cash;
  }
}

/** Same as addCash, per payment method: bucket.byMethod[KEY] = {in, out}. Blank method with cash counts as CASH. */
function addMethodCash(bucket, r) {
  if (!r.cash) return;
  var key = methodOf(r);
  var b = bucket.byMethod[key] || (bucket.byMethod[key] = { 'in': 0, out: 0 });
  if (r.reversesTxId) {
    if (r.cash < 0) b['in'] += r.cash; else b.out -= r.cash;
  } else if (r.cash > 0) {
    b['in'] += r.cash;
  } else {
    b.out -= r.cash;
  }
}

/** Fill drawerIn/drawerOut/drawerNet and bankIn/bankOut/bankNet from bucket.byMethod. */
function finishMethodTotals(bucket) {
  var cash = bucket.byMethod[CFG.METHOD.CASH] || { 'in': 0, out: 0 };
  bucket.drawerIn = cash['in'];
  bucket.drawerOut = cash.out;
  bucket.drawerNet = cash['in'] - cash.out;
  bucket.bankIn = 0;
  bucket.bankOut = 0;
  Object.keys(bucket.byMethod).forEach(function (k) {
    if (k === CFG.METHOD.CASH) return;
    bucket.bankIn += bucket.byMethod[k]['in'];
    bucket.bankOut += bucket.byMethod[k].out;
  });
  bucket.bankNet = bucket.bankIn - bucket.bankOut;
  bucket.cashBank = bucket.bankIn;
  return bucket;
}

/** Totals over ledger rows of one shop whose Day passes pred. */
function statsWhere(ports, shop, pred) {
  var sampleMap = null;
  function isSample(itemId) {
    if (!sampleMap) {
      sampleMap = {};
      ports.store.listItems(null).forEach(function (it) { if (it.sample) sampleMap[it.id] = true; });
    }
    return !!sampleMap[itemId];
  }
  var T = CFG.TX;
  // Custom orders (plan 13.4) are split out the way samples are: orderRevenue = SALE rows of voucher groups,
  // ordersDelivered = voucher groups with revenue left after corrections, orderDeposits = advances earmarked
  // to vouchers, depositRefunds = negative DEPOSIT rows, fees = kept cancellation fees (FEE rows, revenue).
  var s = { revenue: 0, pieces: 0, expenses: 0, cogs: 0, unknownCostPieces: 0, sales: 0, cashIn: 0, cashOut: 0,
            payments: 0, deposits: 0, depositsApplied: 0, depositRefunds: 0, samplesSold: 0, byMethod: {}, expensesByCategory: {},
            orderRevenue: 0, ordersDelivered: 0, orderDeposits: 0, fees: 0, orderGroups: {} };
  ports.store.ledgerRows().forEach(function (r) {
    if (r.shop !== shop || !pred(r.day)) return;
    addCash(s, r);
    addMethodCash(s, r);
    switch (r.type) {
      case T.SALE:
        s.revenue += r.amount;
        s.pieces -= r.qty;
        // A row with Qty 0 (nothing left the shop) is neutral for the sales count.
        if (r.qty < 0) s.sales += 1; else if (r.qty > 0) s.sales -= 1;
        if (r.costAtSale === '' || r.costAtSale === null || r.costAtSale === undefined) s.unknownCostPieces -= r.qty;
        else s.cogs += -r.qty * Number(r.costAtSale);
        if (isSample(r.itemId)) s.samplesSold -= r.qty;
        if (isOrderId(r.groupId)) { s.orderRevenue += r.amount; s.orderGroups[r.groupId] = (s.orderGroups[r.groupId] || 0) + r.amount; }
        break;
      case T.FEE:
        // Cancellation fee kept from a deposit: revenue on the day the order died, no stock, no cash movement.
        s.revenue += r.amount;
        s.fees += r.amount;
        s.orderRevenue += r.amount;
        break;
      case T.RETURN:
        s.revenue += r.amount;
        s.pieces -= r.qty;
        if (nullish(r.costAtSale) || r.costAtSale === '') s.unknownCostPieces -= r.qty;
        else s.cogs -= r.qty * Number(r.costAtSale);
        break;
      case T.EXPENSE: {
        s.expenses -= r.amount;
        var key = r.category || 'other';
        var c = s.expensesByCategory[key] || (s.expensesByCategory[key] = { count: 0, total: 0, bank: 0 });
        c.count += r.reversesTxId ? -1 : 1;
        c.total -= r.amount;
        if (methodOf(r) !== CFG.METHOD.CASH) c.bank -= r.amount;
        break;
      }
      case T.PAYMENT: s.payments += r.amount; break;
      case T.DEPOSIT:
        // Refunds are negative DEPOSIT rows (not mirrors): shown on their own so "deposits received" stays gross.
        // A deposit's undo mirror is negative, a refund's undo mirror positive: each nets out its own figure.
        if (r.amount < 0 && !r.reversesTxId) s.depositRefunds -= r.amount;
        else if (r.amount > 0 && r.reversesTxId) s.depositRefunds -= r.amount;
        else s.deposits += r.amount;
        if (isOrderId(r.refGroupId)) s.orderDeposits += r.amount;
        break;
      case T.DEPOSIT_APPLIED: s.depositsApplied += r.amount; break;
      default: break;
    }
  });
  finishMethodTotals(s);
  s.profit = s.revenue - s.cogs - s.expenses;
  s.cashNet = s.cashIn - s.cashOut;
  Object.keys(s.orderGroups).forEach(function (g) { if (s.orderGroups[g] > 0) s.ordersDelivered++; });
  delete s.orderGroups;
  return s;
}

function dayStats(ports, shop, day) {
  return statsWhere(ports, shop, function (d) { return d === day; });
}

function monthStats(ports, shop, ym) {
  return statsWhere(ports, shop, function (d) { return String(d).slice(0, 7) === ym; });
}

function lowStockList(ports, shop) {
  var threshold = Number(ports.store.getSetting('low_stock_threshold', CFG.LOW_STOCK_DEFAULT));
  return ports.store.listItems(shop).filter(function (it) {
    return it.status === CFG.STATUS.ACTIVE && it.type === CFG.ITEM_TYPE.SKU && Number(it.stock) <= threshold;
  });
}

function buildDailySummary(ports, day) {
  var lines = [t(ports, 'summary_header', { date: fmtDayMy(day) })];
  CFG.SHOP_IDS.forEach(function (shop) {
    var s = dayStats(ports, shop, day);
    var credits = openCredits(ports, shop);
    var owedTotal = credits.reduce(function (a, c) { return a + c.owed; }, 0);
    if (s.sales === 0 && s.expenses === 0 && s.revenue === 0 && s.cashIn === 0) {
      lines.push(t(ports, 'summary_empty', { shop: shopName(ports, shop) }));
    } else {
      lines.push(t(ports, 'summary_shop', {
        shop: shopName(ports, shop), revenue: fmtMoney(s.revenue), pieces: fmtCount(s.pieces),
        expenses: fmtMoney(s.expenses), profit: fmtMoney(s.profit)
      }));
      // Net movement per channel: what the drawer count and the wallet balance should have moved by today.
      lines.push(t(ports, 'summary_cash', { cash: fmtMoney(s.drawerNet), bank: fmtMoney(s.bankNet), owed: fmtMoney(owedTotal) }));
      // On a day when two or more accounts moved money, the bank figure is broken down per account (net).
      var accounts = Object.keys(s.byMethod).filter(function (k) {
        return k !== CFG.METHOD.CASH && (s.byMethod[k]['in'] || s.byMethod[k].out);
      });
      if (accounts.length >= 2) {
        lines.push(t(ports, 'summary_accounts', { list: accounts.map(function (k) {
          return methodLabel(ports, k) + ' ' + fmtMoney(s.byMethod[k]['in'] - s.byMethod[k].out);
        }).join(' · ') }));
      }
      if (s.unknownCostPieces > 0) lines.push(t(ports, 'summary_nocost', { n: fmtCount(s.unknownCostPieces) }));
    }
  });
  var deposits = depositsHeldList(ports);
  if (deposits.length) {
    var total = deposits.reduce(function (a, d) { return a + d.held; }, 0);
    lines.push(t(ports, 'summary_deposits', {
      total: fmtMoney(total),
      list: deposits.slice(0, 5).map(function (d) { return d.customer + ' ' + fmtMoney(d.held); }).join(', ')
    }));
  }
  // Overdue credits: the undated ones by age (as before), the dated ones (a promised DueDay, round 5) on their own line.
  var overdue = openCredits(ports, null).filter(function (c) { return c.overdue; });
  var undated = overdue.filter(function (c) { return !c.dueDay; }), dated = overdue.filter(function (c) { return !!c.dueDay; });
  if (undated.length) {
    lines.push(t(ports, 'summary_overdue', {
      days: myDigits(CFG.OVERDUE_DAYS),
      list: undated.slice(0, 5).map(function (c) { return c.customer + ' ' + fmtMoney(c.owed) + ' (' + myDigits(c.days) + ' ရက်)'; }).join(', ')
    }));
  }
  if (dated.length) {
    lines.push(t(ports, 'summary_due_overdue', {
      list: dated.slice(0, 5).map(function (c) { return c.customer + ' ' + fmtMoney(c.owed) + ' (' + fmtDayShortMy(c.dueDay) + ' · ' + myDigits(c.daysOver) + ' ရက် လွန်)'; }).join(', ')
    }));
  }
  var low = [];
  CFG.SHOP_IDS.forEach(function (shop) {
    lowStockList(ports, shop).forEach(function (it) { low.push(it.name + ' (' + fmtCount(it.stock) + ')'); });
  });
  if (low.length) lines.push(t(ports, 'summary_low', { list: low.join(', ') }));
  // Custom orders due soon and overdue (core_orders.js; absent on a store without the Orders tab).
  if (typeof orderSummaryLines === 'function' && ports.store.listOrders) lines = lines.concat(orderSummaryLines(ports, day));
  // The app's stale-phone line (core_sync.js). The bot's ports carry no Devices tab, so this adds nothing
  // there; gas_main.js appends the server-side lines itself (summaryWithSyncLines).
  if (typeof syncSummaryLines === 'function') {
    try { lines = lines.concat(syncSummaryLines(ports)); } catch (err) { if (ports.store.logError) ports.store.logError('sync_summary', err, '', ''); }
  }
  return lines.join('\n');
}

/* ------------------------------ lookups ------------------------------ */

/** Fuzzy match on item names (and alias) within a shop. Best matches first. */
function findItemsByName(ports, shop, hint) {
  return rankItemsByName(ports, shop, hint).map(function (x) { return x.it; });
}

/** Same as findItemsByName but keeps the scores, so callers can tell a clear winner from a tie. */
function rankItemsByName(ports, shop, hint) {
  var h = String(hint || '').trim();
  if (!h) return [];
  var tokens = h.split(/\s+/).filter(function (x) { return x.length > 0 && !/^[\d၀-၉,]+$/.test(x) && x !== 'ထည်'; });
  var scored = ports.store.listItems(shop).filter(function (it) {
    return it.status !== CFG.STATUS.BLANK;
  }).map(function (it) {
    var name = String(it.name || '') + ' ' + String(it.category || '') + ' ' + String(it.alias || '');
    var score = 0;
    tokens.forEach(function (tk) { if (name.indexOf(tk) >= 0) score += tk.length; });
    if (String(it.id).toUpperCase() === h.toUpperCase()) score += 100;
    if (it.alias && String(it.alias).toUpperCase() === h.toUpperCase()) score += 100;
    return { it: it, score: score };
  }).filter(function (x) { return x.score > 0; });
  scored.sort(function (a, b) { return b.score - a.score; });
  return scored;
}

/** Items touched most recently in a shop (sold, restocked, returned), newest first. */
function recentItems(ports, shop, n) {
  var rows = ports.store.ledgerRows(), seen = {}, out = [];
  var T = CFG.TX;
  for (var i = rows.length - 1; i >= 0 && out.length < n; i--) {
    var r = rows[i];
    if (r.type !== T.SALE && r.type !== T.RESTOCK && r.type !== T.RETURN) continue;
    if (shop && r.shop !== shop) continue;
    if (!r.itemId || seen[r.itemId]) continue;
    seen[r.itemId] = true;
    var it = ports.store.getItem(r.itemId);
    if (it && it.status !== CFG.STATUS.BLANK) out.push(it);
  }
  return out;
}

/**
 * Receipt number of a sale group. A SALE row that carries ReceiptNo (written on a phone,
 * R1-A-000231) wins; otherwise the number is derived from the order of sale groups per shop.
 * Numbers are never reassigned: a voided group keeps its number and leaves a gap, and a
 * rewrite keeps the GroupID, so the number a customer was given stays valid.
 */
function receiptNumber(ports, groupId) {
  var rows = ports.store.ledgerRows(), seen = {}, shop = null, index = -1, count = 0;
  for (var i = 0; i < rows.length; i++) {
    var r = rows[i];
    if (r.type !== CFG.TX.SALE || r.reversesTxId || seen[r.groupId]) continue;
    seen[r.groupId] = true;
    if (r.groupId === groupId) {
      if (r.receiptNo) return r.receiptNo;
      shop = r.shop;
      break;
    }
  }
  if (!shop) return 'R?-000000';
  seen = {};
  for (var k = 0; k < rows.length; k++) {
    var row = rows[k];
    if (row.type !== CFG.TX.SALE || row.reversesTxId || row.shop !== shop || seen[row.groupId]) continue;
    seen[row.groupId] = true;
    count++;
    if (row.groupId === groupId) { index = count; break; }
  }
  return 'R' + shop.replace(/\D/g, '') + '-' + ('000000' + index).slice(-6);
}

/** Up to four price buttons for a category: the most common existing prices, padded with defaults. */
function pricePresets(ports, category, shop) {
  var counts = {};
  ports.store.listItems(null).forEach(function (it) {
    if (it.status === CFG.STATUS.BLANK || !it.price) return;
    if (category && it.category !== category) return;
    counts[it.price] = (counts[it.price] || 0) + 1;
  });
  var prices = Object.keys(counts).map(Number).sort(function (a, b) { return counts[b] - counts[a] || a - b; }).slice(0, 4);
  var defaults = (ports.store.getSetting('price_presets', '') || '').toString().split(',').map(function (x) { return Number(x); })
    .filter(function (x) { return x > 0; });
  if (!defaults.length) defaults = CFG.DEFAULT_PRICE_PRESETS;
  for (var i = 0; i < defaults.length && prices.length < 4; i++) {
    if (prices.indexOf(defaults[i]) < 0) prices.push(defaults[i]);
  }
  return prices.sort(function (a, b) { return a - b; });
}

function depositPresets(ports) {
  var v = (ports.store.getSetting('deposit_presets', '') || '').toString().split(',').map(Number).filter(function (x) { return x > 0; });
  return v.length ? v : CFG.DEPOSIT_PRESETS;
}

/* ------------------------------ product import ------------------------------ */

/**
 * Import rows from the old software: [{Code, Name, Category, Type, Price, Cost, Stock, Shop}].
 * Codes that already match a blank tag id are used as-is; other codes become the Alias of the
 * next blank tag in that shop. Opening stock is written as RESTOCK rows. Returns a summary.
 */
function importProducts(ports, rows, staff) {
  var done = [], skipped = [];
  rows.forEach(function (row) {
    var code = String(row.Code || '').trim().toUpperCase();
    var name = String(row.Name || '').trim();
    var shop = String(row.Shop || 'S1').trim().toUpperCase();
    if (!name) { skipped.push({ code: code, reason: 'no name' }); return; }
    if (CFG.SHOP_IDS.indexOf(shop) < 0) { skipped.push({ code: code, reason: 'unknown shop ' + shop }); return; }
    var target = null, alias = '';
    if (/^S[1-9]\d*-\d{4}$/.test(code)) {
      var existing = ports.store.getItem(code);
      if (existing && existing.status === CFG.STATUS.BLANK && existing.shop === shop) target = existing;
      else if (existing) { skipped.push({ code: code, reason: 'tag already in use' }); return; }
    }
    if (!target) {
      var blanks = ports.store.listItems(shop).filter(function (it) { return it.status === CFG.STATUS.BLANK; });
      if (!blanks.length) { skipped.push({ code: code, reason: 'no blank tags left in ' + shop }); return; }
      target = blanks[0];
      alias = code;
    }
    // Round 6b: a name of the item_category list (a built-in's old name finds its row) with its current label, else the catch-all.
    var catRow = itemCategoryOf(ports, String(row.Category || '')), category = catRow ? catRow.label : itemCategoryFallback(ports);
    var type = String(row.Type || '').toUpperCase() === CFG.ITEM_TYPE.UNIQUE ? CFG.ITEM_TYPE.UNIQUE : CFG.ITEM_TYPE.SKU;
    var price = Number(row.Price) || '';
    var cost = row.Cost === '' || row.Cost === null || row.Cost === undefined ? '' : Number(row.Cost);
    ports.store.updateItem(target.id, {
      name: name, category: category, type: type, price: price, cost: cost, alias: alias,
      createdAt: ports.clock.now().toISOString(), createdBy: staff.id
    });
    var stock = Math.max(0, Math.round(Number(row.Stock) || 0));
    if (stock > 0) {
      commitRestock(ports, { item: ports.store.getItem(target.id), qty: stock, staff: staff, source: CFG.SOURCE.IMPORT, note: 'import ' + (alias || code) });
    }
    done.push({ code: code, id: target.id, alias: alias, stock: stock });
  });
  return { done: done, skipped: skipped };
}

/* ======================================================================
 * core_report.js
 * ====================================================================== */
/**
 * core_report.js — report and receipt content, platform-free.
 * A report is {kind, fileName, title, subtitle, sections:[{heading, columns, rows, totals}], footer}.
 * gas_pdf.js turns it into a PDF through a Sheet export; the simulator shows it as a table.
 */
var TX_LABEL = {
  SALE: 'ရောင်း', RESTOCK: 'ကုန်ရောက်', RETURN: 'ပြန်အမ်း', EXPENSE: 'ကုန်ကျ', TRANSFER_OUT: 'ပြောင်းထွက်',
  TRANSFER_IN: 'ပြောင်းဝင်', ADJUST: 'ပြင်', PAYMENT: 'ငွေလက်ခံ', DEPOSIT: 'စရံ', DEPOSIT_APPLIED: 'စရံသုံး', FEE: 'ပယ်ဖျက်ခ'
};

function txLabel(type) { return TX_LABEL[type] || type; }

/** The header of the promised-date column in the three credit tables (round 5); a code constant, not a Messages key. */
var DUE_COL_HEADER = 'ပေးမည့်ရက်';

/** The promised-date cell of a credit row: the day, prefixed ⏰ once overdue; '' when undated. */
function creditDueCell(c) {
  if (!c.dueDay) return '';
  return (c.overdue ? '⏰ ' : '') + fmtDayShortMy(c.dueDay);
}

/** True when the custom-order module (core_orders.js) is loaded and the store has its tabs. */
function ordersEnabled(ports) {
  return typeof openOrders === 'function' && !!(ports && ports.store && ports.store.listOrders);
}

function buildReport(ports, kind, o) {
  o = o || {};
  var now = o.now || ports.clock.now();
  var shops = o.shop ? [o.shop] : CFG.SHOP_IDS;
  if (kind === 'year') return closingReport(ports, o.year || dayKey(now).slice(0, 4), shops, now);
  if (kind === 'today' || kind === 'day') return dayReport(ports, o.day || dayKey(now), shops, now);
  if (kind === 'month') return monthReport(ports, o.month || monthKey(now), shops, now);
  if (kind === 'last') return monthReport(ports, prevMonthKey(now), shops, now);
  if (kind === 'stock') return stockReport(ports, shops, now);
  if (kind === 'owed') return owedReport(ports, shops, now);
  if (kind === 'exp') return expenseReport(ports, o.month || monthKey(now), shops, now);
  if (kind === 'customer') return customerReport(ports, o.customerId, shops, now);
  // Custom orders (core_orders.js): the open-orders list, one measurement sheet, one voucher.
  if (kind === 'orders' && ordersEnabled(ports)) return ordersReport(ports, shops, now);
  if (kind === 'meas' && ordersEnabled(ports)) return measurementReport(ports, o, now);
  if (kind === 'voucher' && ordersEnabled(ports)) return voucherReport(ports, o.orderId, now);
  throw new Error('Unknown report ' + kind);
}

function reportFooter(now) {
  return 'ထုတ်သည့်အချိန် ' + fmtDayMy(dayKey(now)) + ' ' + timeKey(now);
}

/** ငွေသား + ဘဏ် = ငွေလက်ခံ (gross cash in by channel); the daily text line shows net movement instead. */
function summaryRow(ports, shop, s) {
  return [shopName(ports, shop), s.revenue, s.pieces, s.cashIn, s.drawerIn, s.bankIn, s.expenses, s.cogs, s.profit, s.samplesSold];
}
var SUMMARY_COLS = ['ဆိုင်', 'ရောင်းရငွေ', 'ထည်', 'ငွေလက်ခံ', 'ငွေသား', 'ဘဏ်', 'ကုန်ကျစရိတ်', 'ပစ္စည်းကုန်ကျ', 'အမြတ်', 'နမူနာ ရောင်း'];

function sumRows(rows, label, from) {
  var tot = rows.length ? rows[0].map(function (_, i) { return i < from ? '' : 0; }) : [];
  rows.forEach(function (r) { for (var i = from; i < r.length; i++) tot[i] += Number(r[i]) || 0; });
  if (tot.length) tot[0] = label;
  return tot;
}

function shopList(ports, shops) {
  return shops.map(function (s) { return shopName(ports, s); }).join(' · ');
}

/** Item name, or the expense category, or the note. Without the customer. */
function itemLabel(ports, r) {
  if (r.itemId) {
    var it = ports.store.getItem(r.itemId);
    if (it && it.name) return it.name;
    // A delivered voucher line (V1-2532-1) has no Items row: the Note holds fabric + design + description.
    if (isOrderLineId(r.itemId) && r.note && r.note !== 'deposit' && r.note !== 'delivery') return r.note;
    return r.itemId;
  }
  if (r.type === CFG.TX.EXPENSE) return categoryLabel(ports, r.category);
  return r.note || '';
}

function rowDescription(ports, r) {
  if (r.itemId) {
    var name = itemLabel(ports, r);
    if (r.customerId) name += ' · ' + customerName(ports, r.customerId);
    return name;
  }
  if (r.type === CFG.TX.EXPENSE) return itemLabel(ports, r);
  if (r.customerId) return customerName(ports, r.customerId);
  return r.note || '';
}

/** One line for a ledger row: 'ရောင်း ၂ ထည် · လုံချည် ကချင် အပြာ · 36,000 ကျပ်'. Used by proposals and cards. */
function describeRow(ports, r) {
  if (!r) return '';
  var parts = [txLabel(r.type) + (r.qty ? ' ' + fmtCount(Math.abs(r.qty)) + ' ထည်' : '')];
  var label = itemLabel(ports, r);
  if (label && (r.itemId || r.type === CFG.TX.EXPENSE)) parts.push(label);
  if (r.customerId) parts.push('👤 ' + customerName(ports, r.customerId));
  parts.push(fmtMoney(Math.abs(r.amount)) + ' ကျပ်');
  return parts.join(' · ');
}

/**
 * One line for a group's rows (round 6): a basket (more than one live SALE row, not a custom-order delivery) reads
 * 'ရောင်း 🛍 ၃ ခု · 83,000 ကျပ်' (+ ' · 👤 ' + the buyer); a restock of several lines (more than one live RESTOCK row, the
 * same guard) restock_group_done; anything else describeRow of its first live row, so a one-row group and a delivery read
 * as before. The app's pending lines use it.
 */
function describeGroup(ports, txs) {
  if (!txs || !txs.length) return '';
  var live = liveRows(txs), order = isOrderId(txs[0].groupId);
  var of = function (type) { return live.filter(function (r) { return r.type === type; }); };
  var sales = of(CFG.TX.SALE), restocks = of(CFG.TX.RESTOCK);
  if (!order && sales.length > 1) {
    var sum = 0;
    sales.forEach(function (r) { sum += r.amount; });
    return txLabel(CFG.TX.SALE) + ' ' + t(ports, 'basket_line', { n: fmtCount(sales.length), amount: fmtMoney(sum) }) +
      (sales[0].customerId ? ' · 👤 ' + customerName(ports, sales[0].customerId) : '');
  }
  if (!order && restocks.length > 1) {
    var qty = 0;
    restocks.forEach(function (r) { qty += Number(r.qty) || 0; });
    return t(ports, 'restock_group_done', { n: fmtCount(restocks.length), qty: fmtCount(qty) });
  }
  return describeRow(ports, live[0] || txs[0]);
}

function byTime(a, b) { return a.time < b.time ? -1 : a.time > b.time ? 1 : 0; }

/**
 * Rows for printing. A rewrite (mirror with Note 'rewrite' + replacement in the same group) is one
 * event, so the original row and its rewrite mirror are dropped and the replacement is marked (ပြင်).
 * Undo mirrors stay visible as (ပြန်ဖျက်) lines next to the row they reverse, as before.
 * `all` is the whole ledger (the mirror may be outside `rows`). Returns [{row, mark}] in time order.
 */
function printableRows(ports, all, rows) {
  var reversedBy = {}, rewrittenTypes = {};
  all.forEach(function (r) {
    if (!r.reversesTxId) return;
    reversedBy[r.reversesTxId] = r;
    if (r.note === 'rewrite') (rewrittenTypes[r.groupId] = rewrittenTypes[r.groupId] || {})[r.type] = true;
  });
  var out = [];
  rows.forEach(function (r) {
    if (r.reversesTxId && r.note === 'rewrite') return;
    var rev = reversedBy[r.txId];
    if (rev && rev.note === 'rewrite') return;
    var mark = '';
    if (r.reversesTxId) mark = t(ports, 'rep_undo_mark');
    else if (rewrittenTypes[r.groupId] && rewrittenTypes[r.groupId][r.type]) mark = t(ports, 'rep_rewrite_mark');
    out.push({ row: r, mark: mark });
  });
  out.sort(function (a, b) { return byTime(a.row, b.row); });
  return out;
}

/** 'ငွေသား 134,000 · KBZPay 36,000': net cash movement per method. */
function methodNetText(ports, s) {
  return Object.keys(s.byMethod).filter(function (k) { return s.byMethod[k]['in'] || s.byMethod[k].out; })
    .map(function (k) { return methodLabel(ports, k) + ' ' + fmtMoney(s.byMethod[k]['in'] - s.byMethod[k].out); }).join(' · ');
}

function methodSection(ports, shop, s, withShop) {
  var rows = Object.keys(s.byMethod).filter(function (k) { return s.byMethod[k]['in'] || s.byMethod[k].out; })
    .map(function (k) { var m = s.byMethod[k]; return [methodLabel(ports, k), m['in'], m.out, m['in'] - m.out]; });
  return {
    heading: t(ports, 'rep_by_method') + (withShop ? ' · ' + shopName(ports, shop) : ''),
    columns: ['နည်းလမ်း', 'ဝင်', 'ထွက်', 'ကျန်'], rows: rows, totals: rows.length ? [sumRows(rows, 'စုစုပေါင်း', 1)] : []
  };
}

function categorySection(ports, shop, s, withShop) {
  var rows = Object.keys(s.expensesByCategory).map(function (k) {
    var c = s.expensesByCategory[k];
    return [categoryLabel(ports, k), c.count, c.total, c.bank];
  }).filter(function (r) { return r[1] || r[2]; }).sort(function (a, b) { return b[2] - a[2]; });
  return {
    heading: t(ports, 'rep_by_cat') + (withShop ? ' · ' + shopName(ports, shop) : ''),
    columns: ['အမျိုးအစား', 'အကြိမ်', 'စုစုပေါင်း', 'ဘဏ်မှ'], rows: rows, totals: rows.length ? [sumRows(rows, 'စုစုပေါင်း', 1)] : []
  };
}

/**
 * A label lookup (methodLabel, categoryLabel) that asks once per key while one report is built: every
 * lookup reads the option lists, and a report prints one label per ledger row.
 */
function labelMemo(ports, lookup) {
  var known = {};
  return function (key) {
    var k = 'k:' + key;
    if (!Object.prototype.hasOwnProperty.call(known, k)) known[k] = lookup(ports, key);
    return known[k];
  };
}

function dayReport(ports, day, shops, now) {
  var all = ports.store.ledgerRows(), sections = [], method = labelMemo(ports, methodLabel);
  shops.forEach(function (shop) {
    var rows = all.filter(function (r) { return r.day === day && r.shop === shop; });
    var table = printableRows(ports, all, rows).map(function (x) {
      var r = x.row;
      // The two rows of a split sale (cash part, account part) carry the note 'split': printed in Burmese.
      var note = r.reversesTxId ? '' : (r.note === 'split' ? t(ports, 'note_split') : (r.note || ''));
      return [timeKey(new Date(r.time)), txLabel(r.type) + x.mark, rowDescription(ports, r),
              r.qty ? -r.qty : '', r.amount, r.cash, method(methodOf(r)), note];
    });
    var s = dayStats(ports, shop, day);
    sections.push({
      heading: shopName(ports, shop),
      columns: ['အချိန်', 'အမျိုးအစား', 'ပစ္စည်း / ဝယ်သူ', 'ထည်', 'ငွေ', 'ငွေလက်ခံ', 'နည်းလမ်း', 'မှတ်ချက်'],
      rows: table,
      totals: [['စုစုပေါင်း', '', '', s.pieces, s.revenue, s.cashNet, methodNetText(ports, s), '']]
    });
  });
  sections.push({
    heading: 'အနှစ်ချုပ်',
    columns: SUMMARY_COLS,
    rows: shops.map(function (shop) { return summaryRow(ports, shop, dayStats(ports, shop, day)); })
  });
  return {
    kind: 'day', fileName: 'daily-' + day, title: 'နေ့စဉ် အရောင်းစာရင်း · ' + fmtDayMy(day),
    subtitle: shopList(ports, shops), sections: sections, footer: reportFooter(now)
  };
}

function monthReport(ports, ym, shops, now) {
  var sections = [], stats = {};
  shops.forEach(function (shop) { stats[shop] = monthStats(ports, shop, ym); });
  var summary = shops.map(function (shop) { return summaryRow(ports, shop, stats[shop]); });
  sections.push({ heading: 'အနှစ်ချုပ်', columns: SUMMARY_COLS, rows: summary, totals: shops.length > 1 ? [sumRows(summary, 'စုစုပေါင်း', 1)] : [] });

  var days = {};
  ports.store.ledgerRows().forEach(function (r) {
    if (String(r.day).slice(0, 7) !== ym || shops.indexOf(r.shop) < 0) return;
    var d = days[r.day] || (days[r.day] = { revenue: 0, pieces: 0, cashIn: 0, cashOut: 0, expenses: 0, byMethod: {} });
    if (r.type === CFG.TX.SALE || r.type === CFG.TX.RETURN) { d.revenue += r.amount; d.pieces -= r.qty; }
    if (r.type === CFG.TX.EXPENSE) d.expenses -= r.amount;
    addCash(d, r);
    addMethodCash(d, r);
  });
  var dayRows = Object.keys(days).sort().map(function (k) {
    var d = finishMethodTotals(days[k]);
    return [fmtDayShortMy(k), d.revenue, d.pieces, d.cashIn, d.drawerIn, d.bankIn, d.expenses];
  });
  sections.push({ heading: 'နေ့အလိုက်', columns: ['ရက်', 'ရောင်းရငွေ', 'ထည်', 'ငွေလက်ခံ', 'ငွေသား', 'ဘဏ်', 'ကုန်ကျ'], rows: dayRows,
    totals: dayRows.length ? [sumRows(dayRows, 'စုစုပေါင်း', 1)] : [] });

  // Drawer and each wallet, line by line, so the owner can reconcile the cash count and the app statements.
  shops.forEach(function (shop) { sections.push(methodSection(ports, shop, stats[shop], shops.length > 1)); });
  shops.forEach(function (shop) { sections.push(categorySection(ports, shop, stats[shop], shops.length > 1)); });

  var credits = [];
  shops.forEach(function (shop) { credits = credits.concat(openCredits(ports, shop)); });
  credits.sort(byTime);
  sections.push({ heading: 'အကြွေး ကျန်', columns: ['ဝယ်သူ', 'ပစ္စည်း', 'ရက်စွဲ', 'စုစုပေါင်း', 'ပေးပြီး', 'ကျန်', 'ရက်', DUE_COL_HEADER],
    rows: credits.map(function (c) { return [c.customer, c.item, fmtDayShortMy(c.day), c.total, c.cash + c.payments + c.applied, c.owed, c.days, creditDueCell(c)]; }),
    totals: credits.length ? [['စုစုပေါင်း', '', '', 0, 0, credits.reduce(function (a, c) { return a + c.owed; }, 0), '', '']] : [] });

  var deposits = depositsHeldList(ports);
  sections.push({ heading: 'စရံ လက်ခံထား', columns: ['ဝယ်သူ', 'လက်ခံ', 'သုံးပြီး', 'ကျန်', 'နောက်ဆုံး', 'ဘောက်ချာ အတွက်'],
    rows: deposits.map(function (d) { return [d.customer, d.received, d.used, d.held, fmtDayShortMy(d.lastDay), d.earmarked || '']; }) });

  // Custom orders this month (plan 13.4): delivered, revenue, fees, advances, open vouchers' deposits, cancelled.
  if (ordersEnabled(ports)) sections.push(orderMonthSection(ports, ym, shops, stats));

  return {
    kind: 'month', fileName: 'monthly-' + ym, title: 'လစဉ် စာရင်း · ' + fmtMonthMy(ym),
    subtitle: shopList(ports, shops), sections: sections, footer: reportFooter(now)
  };
}

/** This month's expenses: live EXPENSE rows per shop with category and method, then the by-category totals. */
function expenseReport(ports, ym, shops, now) {
  var all = ports.store.ledgerRows(), sections = [], method = labelMemo(ports, methodLabel), category = labelMemo(ports, categoryLabel);
  shops.forEach(function (shop) {
    var rows = liveRows(all.filter(function (r) {
      return r.type === CFG.TX.EXPENSE && String(r.day).slice(0, 7) === ym && r.shop === shop;
    }), all).sort(byTime);
    var table = rows.map(function (r) { return [fmtDayShortMy(r.day), category(r.category), -r.amount, method(methodOf(r)), r.note || '']; });
    var total = rows.reduce(function (a, r) { return a - r.amount; }, 0);
    sections.push({ heading: shopName(ports, shop), columns: ['ရက်', 'အမျိုးအစား', 'ငွေ', 'နည်းလမ်း', 'မှတ်ချက်'], rows: table,
      totals: [['စုစုပေါင်း', '', total, '', '']] });
  });
  shops.forEach(function (shop) { sections.push(categorySection(ports, shop, monthStats(ports, shop, ym), shops.length > 1)); });
  return {
    kind: 'exp', fileName: 'expenses-' + ym, title: t(ports, 'rep_expense_title', { month: fmtMonthMy(ym) }),
    subtitle: shopList(ports, shops), sections: sections, footer: reportFooter(now)
  };
}

/** One customer's statement: summary, live rows with method, open credits, deposits. Shop-scoped for staff. */
function customerReport(ports, customerId, shops, now) {
  var c = ports.store.getCustomer(customerId);
  var name = c ? c.name : String(customerId || '');
  var all = ports.store.ledgerRows();
  var rows = liveRows(all.filter(function (r) { return r.customerId === customerId && shops.indexOf(r.shop) >= 0; }), all).sort(byTime);
  var s = customerSummary(ports, customerId), method = labelMemo(ports, methodLabel);
  var sections = [
    { heading: 'အနှစ်ချုပ်', columns: ['ဝယ်ပြီး', 'ပေးပြီး', 'ကျန်', 'စရံ လက်ခံထား', 'နောက်ဆုံး', 'အကြိမ်'],
      rows: [[s.bought, s.paid, s.owed, s.depositHeld, s.lastDay ? fmtDayShortMy(s.lastDay) : '', s.visits]] },
    { heading: 'စာရင်း', columns: ['ရက်', 'အမျိုးအစား', 'ပစ္စည်း', 'ငွေ', 'ငွေလက်ခံ', 'နည်းလမ်း'],
      rows: rows.map(function (r) { return [fmtDayShortMy(r.day), txLabel(r.type), itemLabel(ports, r), r.amount, r.cash, method(methodOf(r))]; }),
      totals: rows.length ? [['စုစုပေါင်း', '', '', rows.reduce(function (a, r) { return a + (r.type === CFG.TX.SALE || r.type === CFG.TX.RETURN ? r.amount : 0); }, 0),
                               rows.reduce(function (a, r) { return a + r.cash; }, 0), '']] : [] }
  ];
  var credits = openCredits(ports, null).filter(function (x) { return x.customerId === customerId && shops.indexOf(x.shop) >= 0; });
  sections.push({ heading: 'အကြွေး ကျန်', columns: ['ပစ္စည်း', 'ရက်စွဲ', 'စုစုပေါင်း', 'ပေးပြီး', 'ကျန်', 'ရက်', DUE_COL_HEADER],
    rows: credits.map(function (x) { return [x.item, fmtDayShortMy(x.day), x.total, x.cash + x.payments + x.applied, x.owed, x.days, creditDueCell(x)]; }),
    totals: credits.length ? [['စုစုပေါင်း', '', 0, 0, credits.reduce(function (a, x) { return a + x.owed; }, 0), '', '']] : [] });
  var dep = depositsHeldMap(ports)[customerId];
  sections.push({ heading: 'စရံ', columns: ['လက်ခံ', 'သုံးပြီး', 'ကျန်', 'နောက်ဆုံး'],
    rows: dep ? [[dep.received, dep.used, dep.held, fmtDayShortMy(dep.lastDay)]] : [] });
  return {
    kind: 'customer', fileName: 'customer-' + customerId + '-' + dayKey(now), title: t(ports, 'rep_customer_title', { name: name }),
    subtitle: (c && c.phone ? fmtPhone(c.phone) + ' · ' : '') + shopList(ports, shops), sections: sections, footer: reportFooter(now)
  };
}

function stockReport(ports, shops, now) {
  var sections = [];
  shops.forEach(function (shop) {
    var items = ports.store.listItems(shop).filter(function (it) { return it.status === CFG.STATUS.ACTIVE; });
    items.sort(function (a, b) { return (a.category + a.id) < (b.category + b.id) ? -1 : 1; });
    var rows = items.map(function (it) {
      return [it.id, it.name + (it.sample ? t(ports, 'sample_mark') : ''), it.category, it.price === '' ? 'စျေး မသတ်မှတ်ရသေး' : it.price,
              it.cost === '' ? '' : it.cost, it.stock];
    });
    var pieces = items.reduce(function (a, it) { return a + Number(it.stock); }, 0);
    var atPrice = items.reduce(function (a, it) { return a + Number(it.stock) * (Number(it.price) || 0); }, 0);
    var atCost = items.reduce(function (a, it) { return a + Number(it.stock) * (Number(it.cost) || 0); }, 0);
    sections.push({ heading: shopName(ports, shop), columns: ['Tag', 'အမည်', 'အမျိုးအစား', 'စျေး', 'ကုန်ကျ', 'လက်ကျန်'], rows: rows,
      totals: [['စုစုပေါင်း ' + items.length + ' မျိုး', '', '', 'တန်ဖိုး ' + fmtMoney(atPrice), 'ကုန်ကျ ' + fmtMoney(atCost), pieces]] });
  });
  return { kind: 'stock', fileName: 'stock-' + dayKey(now), title: 'ကုန်စာရင်း · ' + fmtDayMy(dayKey(now)),
    subtitle: shopList(ports, shops), sections: sections, footer: reportFooter(now) };
}

function owedReport(ports, shops, now) {
  var credits = [];
  shops.forEach(function (shop) { credits = credits.concat(openCredits(ports, shop)); });
  credits.sort(byTime);
  var rows = credits.map(function (c) { return [c.customer, shopName(ports, c.shop), c.item, fmtDayShortMy(c.day), c.total, c.cash + c.payments + c.applied, c.owed, c.days, creditDueCell(c)]; });
  return { kind: 'owed', fileName: 'owed-' + dayKey(now), title: 'အကြွေးစာရင်း · ' + fmtDayMy(dayKey(now)),
    subtitle: shopList(ports, shops),
    sections: [{ heading: '', columns: ['ဝယ်သူ', 'ဆိုင်', 'ပစ္စည်း', 'ရက်စွဲ', 'စုစုပေါင်း', 'ပေးပြီး', 'ကျန်', 'ရက်', DUE_COL_HEADER], rows: rows,
      totals: [['စုစုပေါင်း', '', '', '', 0, 0, credits.reduce(function (a, c) { return a + c.owed; }, 0), '', '']] }],
    footer: reportFooter(now) };
}

/* ------------------------------ receipts ------------------------------ */

/**
 * A voided (undone) sale still has its receipt: the number is never reused, the text says ပယ်ဖျက်.
 * Methods: how the cash arrived (sale cash plus later payments), for the "ပေးပြီး" line.
 * transfer / transferLines: where to transfer the balance (the shop's accounts that carry a number), only
 * while something is still owed on a live group; '' and [] otherwise.
 */
function buildReceipt(ports, groupId) {
  var info = saleGroupInfo(ports, groupId);
  if (!info) return null;
  var voided = info.voided;
  // One line per live SALE row (a delivered voucher has one per garment); a voided group lists the rows the undo reversed.
  var rows = voided ? (info.voidedRows.length ? info.voidedRows : [info.origin]) : info.rows;
  var origin = rows[0] || info.origin;
  var when = new Date(info.time);
  var total = rows.reduce(function (a, r) { return a + r.amount; }, 0);
  var customerId = origin.customerId || info.customerId;
  var lines = rows.map(function (r) {
    return { name: itemLabel(ports, r), qty: -r.qty, unit: r.unitPrice === '' ? 0 : Number(r.unitPrice), amount: r.amount };
  });
  var r = {
    no: receiptNumber(ports, groupId), groupId: groupId, shop: info.shop, shopName: shopName(ports, info.shop),
    day: info.day, date: fmtDayMy(info.day), time: timeKey(when),
    customer: customerId ? customerName(ports, customerId) : '',
    lines: lines,
    total: total, paid: voided ? 0 : info.cash + info.payments + info.applied, owed: voided ? 0 : info.owed,
    voided: voided, methods: voided ? [] : groupMethods(ports, groupId), applied: voided ? 0 : info.applied
  };
  if (isOrderId(groupId)) r.voucherNo = orderNo(groupId);
  var owes = !voided && r.owed > 0;
  r.transferLines = owes ? transferLines(ports, r.shop) : [];
  r.transfer = owes ? transferLine(ports, r.shop) : '';
  r.dueDay = info.dueDay || '';   // the promised date of a guided credit sale (round 5), printed while something is owed
  return r;
}

/** 'sale_due_set' for a receipt that still owes and carries a promised date, else ''. */
function receiptDueLine(ports, r) {
  return r.owed > 0 && r.dueDay ? t(ports, 'sale_due_set', { owed: fmtMoney(r.owed), date: fmtDayMy(r.dueDay) }) : '';
}

/** '' when everything was cash, ' (KBZPay)' for one non-cash method, ' (ငွေသား 6,000 · KBZPay 6,000)' when mixed. */
function receiptMethodText(ports, r) {
  var ms = (r.methods || []).filter(function (m) { return m.amount > 0; });
  if (!ms.length) return '';
  if (ms.length === 1) return ms[0].method === CFG.METHOD.CASH ? '' : ' (' + methodLabel(ports, ms[0].method) + ')';
  return ' (' + ms.map(function (m) { return methodLabel(ports, m.method) + ' ' + fmtMoney(m.amount); }).join(' · ') + ')';
}

function receiptText(ports, r) {
  var out = [t(ports, 'receipt_header', { shop: r.shopName, no: r.no + (r.voucherNo ? ' · ' + t(ports, 'btn_voucher').replace(/^\S+\s*/, '') + ' ' + r.voucherNo : ''), date: r.date, time: r.time })];
  if (r.voided) out.push(t(ports, 'receipt_void'));
  r.lines.forEach(function (l) { out.push(t(ports, 'receipt_line', { name: l.name, qty: fmtCount(l.qty), amount: fmtMoney(l.amount) })); });
  out.push('──────────');
  if (r.applied) out.push(t(ports, 'voucher_deposit', { deposit: fmtMoney(r.applied), method: '' }));
  out.push(t(ports, 'receipt_total', { total: fmtMoney(r.total), paid: fmtMoney(r.paid), owed: fmtMoney(r.owed), method: receiptMethodText(ports, r) }));
  if (r.transfer) out.push(r.transfer);
  var due = receiptDueLine(ports, r);
  if (due) out.push(due);
  if (r.customer) out.push(t(ports, 'receipt_customer', { customer: r.customer }));
  out.push(t(ports, 'receipt_thanks'));
  return out.join('\n');
}

/**
 * The receipt as PDF data. With a balance, the accounts to transfer to go into the footer ONE PER LINE, above
 * the thanks line: gas_pdf.js sizes column A to its longest cell and exports fit-to-width, so one long line
 * (or the subtitle) would shrink the whole receipt.
 */
function receiptReport(ports, r, now) {
  var totals = [['စုစုပေါင်း', '', '', r.total], ['ပေးပြီး' + receiptMethodText(ports, r), '', '', r.paid], ['ကျန်', '', '', r.owed]];
  var accounts = r.transferLines || [], footer = [t(ports, 'receipt_thanks')];
  // The promised date (one line, never in the subtitle) sits after the account lines and above the thanks line.
  var due = receiptDueLine(ports, r);
  if (due) footer = [due].concat(footer);
  if (accounts.length) footer = [t(ports, 'receipt_transfer', { accounts: accounts[0] })].concat(accounts.slice(1)).concat(footer);
  return {
    kind: 'receipt', fileName: r.no, title: r.shopName + ' · ဘောက်ချာ ' + r.no,
    subtitle: r.date + ' ' + r.time + (r.customer ? ' · ' + r.customer : '') + (r.voided ? ' · ' + t(ports, 'receipt_void') : ''),
    sections: [{ heading: '', columns: ['ပစ္စည်း', 'ထည်', 'စျေး', 'ငွေ'],
      rows: r.lines.map(function (l) { return [l.name, l.qty, l.unit, l.amount]; }),
      totals: totals }],
    footer: footer.join('\n')
  };
}

/** One period on paper or on screen. All totals use the same signed ledger rows as the daily close. */
function closingReport(ports, period, shops, now) {
  if (!/^\d{4}(-\d{2}(-\d{2})?)?$/.test(period)) throw new Error('ရက်စွဲ ရွေးပါ');
  var matches = function (day) { return String(day).slice(0, period.length) === period; };
  var sections = [], summary = [], costsMissing = 0;
  var totals = { revenue: 0, cashIn: 0, cashOut: 0, expenses: 0, cogs: 0, profit: 0, pieces: 0 };
  var entries = ports.store.ledgerRows(), moves = {}, stock = {}, byCategory = {};
  var asOf = entries.filter(function (r) { return String(r.day).slice(0, period.length) <= period; });
  var closingPorts = Object.create(ports);
  closingPorts.store = Object.create(ports.store);
  closingPorts.store.ledgerRows = function () { return asOf; };
  var owed = openCredits(closingPorts, null).filter(function (c) { return shops.indexOf(c.shop) >= 0; });
  var moneyOwed = owed.reduce(function (n, c) { return n + c.owed; }, 0);
  var held = 0;
  var itemNames = {}, categories = {};
  ports.store.listItems(null).forEach(function (it) {
    itemNames[it.id] = it.name;
    categories[it.id] = it.category;
  });
  shops.forEach(function (shop) {
    var s = statsWhere(ports, shop, matches);
    Object.keys(totals).forEach(function (key) { totals[key] += s[key]; });
    costsMissing += Math.abs(s.unknownCostPieces);
    summary.push(summaryRow(ports, shop, s));
    sections.push(methodSection(ports, shop, s, true), categorySection(ports, shop, s, true));
  });
  var detail = [], receipts = [], sales = {}, months = {};
  entries.forEach(function (r) {
    var kind = r.type, T = CFG.TX, own = shops.indexOf(r.shop) >= 0;
    if (String(r.day).slice(0, period.length) > period) return;
    if (own) {
      if (kind === T.DEPOSIT) held += r.amount;
      if (kind === T.DEPOSIT_APPLIED) held -= r.amount;
      if (r.itemId && r.qty) {
        var stockKey = JSON.stringify([r.shop, r.itemId]);
        stock[stockKey] = (stock[stockKey] || 0) + r.qty;
      }
    }
    var name = shopName(ports, r.shop);
    var label = itemNames[r.itemId] || r.itemId || r.note || '';
    if (kind === T.TRANSFER_IN || kind === T.TRANSFER_OUT) {
      var move = moves[r.groupId] || (moves[r.groupId] = { day: r.day, item: label, qty: 0 });
      if (r.reversesTxId) move.undone = true;
      else {
        if (kind === T.TRANSFER_IN) { move.received = true; move.to = r.shop; move.from = String(r.note || '').replace(/^from /, '') || move.from; }
        if (kind === T.TRANSFER_OUT) { move.from = r.shop; move.to = String(r.note || '').replace(/^to /, '') || move.to; }
        move.qty = Math.abs(r.qty);
        if (matches(r.day)) { move.inPeriod = true; move.day = r.day; }
      }
    }
    if (!own || !matches(r.day)) return;
    if (kind === T.SALE || kind === T.RETURN || kind === T.FEE) {
      var cat = categories[r.itemId] || (isOrderId(r.groupId) ? 'အော်ဒါ' : txLabel(kind));
      var categoryKey = JSON.stringify([r.shop, cat]);
      byCategory[categoryKey] = (byCategory[categoryKey] || 0) + r.amount;
      var key = JSON.stringify([r.shop, cat, r.itemId || label]);
      var bucket = sales[key] || (sales[key] = [name, cat, label, 0, 0]);
      bucket[3] -= Number(r.qty) || 0;
      bucket[4] += Number(r.amount) || 0;
    }
    if (r.cash > 0 || r.cash < 0) receipts.push([r.day, name, txLabel(kind), methodLabel(ports, methodOf(r)), r.cash, r.receiptNo || r.groupId]);
    if (kind === T.EXPENSE) label = categoryLabel(ports, r.category) + ' ' + (r.note || '');
    detail.push([r.day, name, txLabel(kind), label, r.qty, r.amount, r.receiptNo || r.groupId]);
    months[String(r.day).slice(0, 7)] = true;
  });
  if (period.length === 4) {
    var byMonth = Object.keys(months).sort().map(function (ym) {
      var vals = [ym, 0, 0, 0, 0];
      shops.forEach(function (shop) {
        var m = monthStats(ports, shop, ym);
        vals[1] += m.revenue; vals[2] += m.cogs; vals[3] += m.expenses; vals[4] += m.profit;
      });
      return vals;
    });
    sections.unshift({ heading: 'လအလိုက်', columns: ['လ', 'ရောင်းရငွေ', 'ပစ္စည်းကုန်ကျ', 'စရိတ်', 'အမြတ် / အရှုံး'], rows: byMonth });
  }
  sections.unshift({ heading: 'ဆိုင်အလိုက်', columns: SUMMARY_COLS, rows: summary });
  sections.push({ heading: 'အမျိုးအစားအလိုက် ဝင်ငွေ', columns: ['ဆိုင်', 'အမျိုးအစား', 'ဝင်ငွေ'], rows: Object.keys(byCategory).sort().map(function (k) {
    var ids = JSON.parse(k); return [shopName(ports, ids[0]), ids[1], byCategory[k]];
  }) });
  sections.push({ heading: 'ကာလအဆုံး ရရန်ကျန်ငွေ', columns: ['ဆိုင်', 'ဝယ်သူ', 'ဘောက်ချာ', 'ကျန်ငွေ'], rows: owed.map(function (c) { return [shopName(ports, c.shop), c.customer, c.groupId, c.owed]; }) });
  sections.push({ heading: 'ကာလအဆုံး ဆိုင်ရှိပစ္စည်း', columns: ['ဆိုင်', 'Tag', 'ပစ္စည်း', 'လက်ကျန်'], rows: Object.keys(stock).sort().filter(function (k) { return stock[k] !== 0; }).map(function (k) {
    var ids = JSON.parse(k); return [shopName(ports, ids[0]), ids[1], itemNames[ids[1]] || ids[1], fmtCount(stock[k])];
  }) });
  sections.push({ heading: 'ပစ္စည်းအလိုက် အရောင်း', columns: ['ဆိုင်', 'အမျိုးအစား', 'ပစ္စည်း', 'ထည်', 'ရောင်းရငွေ'], rows: Object.keys(sales).sort().map(function (k) { return sales[k]; }) });
  sections.push({ heading: 'ငွေဝင် ငွေထွက်', columns: ['ရက်', 'ဆိုင်', 'အကြောင်း', 'နည်းလမ်း', 'ငွေ', 'ဘောက်ချာ'], rows: receipts });
  sections.push({ heading: 'ဆိုင်ပြောင်းစာရင်း', columns: ['ရက်', 'ပစ္စည်း', 'ပို့သည့်ဆိုင်', 'ရောက်သည့်ဆိုင်', 'ထည်', 'အခြေအနေ'], rows: Object.keys(moves).filter(function (k) { var m = moves[k]; return !m.undone && (m.inPeriod || !m.received) && (shops.indexOf(m.from) >= 0 || shops.indexOf(m.to) >= 0); }).map(function (k) {
    var m = moves[k]; return [m.day, m.item, shopName(ports, m.from), shopName(ports, m.to), m.qty, (m.received || k.indexOf('SHIP-') !== 0) ? 'လက်ခံပြီး' : 'ပို့ပြီး'];
  }) });
  sections.push({ heading: 'မှတ်တမ်း အပြည့်အစုံ', columns: ['ရက်', 'ဆိုင်', 'အကြောင်း', 'ပစ္စည်း', 'ထည်', 'ငွေ', 'ဘောက်ချာ'], rows: detail });
  var first = { heading: 'အနှစ်ချုပ်', columns: ['အကြောင်း', 'စုစုပေါင်း'], rows: [
    ['ရောင်းရငွေ (ပြန်အမ်းငွေ နုတ်ပြီး)', totals.revenue], ['ရောင်းထွက်သည့် အထည်', fmtCount(totals.pieces)],
    ['ငွေလက်ခံရရှိ', totals.cashIn], ['ငွေထွက်', totals.cashOut], ['ဝယ်သူများထံမှ ရရန်ကျန်', moneyOwed], ['လက်ကျန် စရန်ငွေ', held], ['ရောင်းပြီးပစ္စည်း အရင်း', totals.cogs], ['ဆိုင်ကုန်ကျစရိတ်', totals.expenses],
    [totals.profit < 0 ? 'အရှုံး' : 'အမြတ်', Math.abs(totals.profit)]
  ] };
  return { kind: 'close', title: 'ဆိုင်စာရင်း · ' + period, subtitle: shopList(ports, shops) + ' · ငွေပမာဏအားလုံး ကျပ်ဖြင့်', sections: [first].concat(sections),
    fileName: 'close-' + period, footer: reportFooter(now), missingCosts: costsMissing };
}

/* ======================================================================
 * core_bot.js
 * ====================================================================== */
/**
 * core_bot.js — the conversation. Entry point: processUpdate(update, ports).
 *
 * ports = {
 *   store: getItem, listItems, updateItem, appendLedger, ledgerRows, getStaff, listStaff,
 *          getCustomer, listCustomers, addCustomer, updateCustomer, getSetting, getMessage, logError, logUnknownUser,
 *          refreshViews (optional)
 *          option lists (optional, core_ledger.js listRows): listOptions, addListOption. Without addListOption the ➕
 *          buttons and the account-number entry answer add_unavailable.
 *          custom tailoring (optional, core_orders.js): getOrder, listOrders, addOrder, updateOrder, nextOrderNo,
 *          listOrderItems, addOrderItem, updateOrderItem, removeOrderItem, listDesigns, getDesign, listMeasureFields,
 *          addMeasurement, getMeasurement, listMeasurements, addDesign (optional: a typed new design code can be created)
 *   chat:  sendMessage, sendPhoto, sendDocument, editMessage, answerCallback, typing, getFile, savePhoto
 *   ai:    parseVoice, parseText, describePhoto, readNotebook, readMeasurementSheet
 *   pdf:   make(report) -> document handle for chat.sendDocument
 *   cache: get, put, remove        lock: run(fn)       clock: now()       uuid()
 *   sync (optional, plan 14.2): mintCode(staff, label) -> {text}, devicesText() -> {text, kb},
 *          deviceAction(deviceId, action) -> {text, kb}. Without it the 📲 button and /devices are absent.
 * }
 * Callback data (max 64 bytes): ACTION|arg|arg
 *   S sale  Q quantity grid  QN typed quantity  D sell at a price  R restock-ask  RQ restock-commit  T return  X transfer
 *   U undo  V owner void  Y/N confirm proposal  P price  C cost  PS sample toggle  SP set price  K open card  M menu  Z cancel
 *   M|restock the app's restock form (forms), else Telegram's 📦 restock loop (round 6b): RT|done ends the 📦 restock loop of
 *     the menu, RT|skip drops the tag at its count screen (round 6b)
 *   CR credit start  CP credit paid-now  CC credit customer  CD credit use-deposit
 *   PY payment pick  PL pay list of one customer  PA payment amount  DC deposit customer  DA deposit amount  DN deposit note skip
 *   PM payment method of a group  CU attach customer  CUP customer pick  CF phone  CH customer card  CS customer statement
 *   ES expense shop  EC expense category  EA expense amount  EM expense method (commits)  EN note on an expense
 *   RP report  RC receipt  RCP receipt pdf  NB notebook line item  DV device drain/revoke/activate (owner)
 *   SX split a sale (cash + one account)  SXM split account -> the amount screen  SXA split amount all/half (commits)
 *   LA|<list code>|<resume>|<args> add an option to a pick list (➕), then resume the flow it was tapped in
 *   LD|pm|<KEY> the number of an account (typed)
 *   SS|<a>|<letter>|<arg> the sale review card (round 6, Telegram in Settings sale_flow = form; <a> = the item the card was
 *     opened on): o|<buyer|method|paid|due> open a sub-screen, l|<id> a line, add ➕ another piece, i|<id> add that piece
 *     (the add screen, or the item card of a paused basket), go resume a paused card, q|<n> qn pr rm|<id> a line's count,
 *     typed count, typed price and removal, b buyer, ph phone, m how paid, a account (a|p<n> = page n), x transfer part,
 *     p how much now (p|all = paid in full), d due day, k kind of a new account, back|<step> to the parent, z cancel into
 *     the item card  SC|<a>|ok saves the card (the one write of the basket)
 *   NI|<id>|<q|qn|n|c|back>|<arg> the new-piece review card (form mode): count -/+, typed count, name, category, back
 *     (round 6b: c|<key> picks an item_category row by its key; LA|ic|NIC|<id> is the ➕ of the category screen)
 *     NC|<id>|ok registers the piece (the one write)
 *   LA|pm|SSA|<a> ➕ an account inside the review card  CD|<g>|yes|p[|<KEY>] the deposit question on the sold card (plain rows)
 *   O... and M[SMQKFGLP] custom tailoring orders and measurements (see the order section below; ORDER_ACTIONS)
 * Per-user cache keys: st:<uid> state, li:<uid> last scanned item, lg:<uid> last committed money group (for "Wave နဲ့ ပေးသွားတယ်"),
 *   rl:<uid> the ☰ 📦 loop's latest count screen (round 6b: a tap there after the loop's 180 s still counts as the loop's).
 * A committed card (sale, payment, deposit, expense, return, voucher reply) is never edited into a question: a
 * follow-up question from it is a new message. The actionable screen is always the last message of a reply.
 */

/**
 * Dedupe + error guard. Mirrors what doPost does in production; the simulator calls it too.
 * Telegram re-delivers an update until it is satisfied with the response, sometimes for
 * hours, so an update id is remembered twice: in the cache (6 h) and in a durable list
 * (ports.dedupe) that survives cache expiry.
 */
function processUpdate(update, ports) {
  var id = String(update.update_id);
  var key = 'upd:' + id;
  if (ports.cache.get(key)) return 'duplicate';
  if (ports.dedupe && ports.dedupe.seen(id)) return 'duplicate';
  ports.cache.put(key, '1', 21600);
  if (ports.dedupe) ports.dedupe.remember(id);
  try {
    handleUpdate(update, ports);
    return 'ok';
  } catch (err) {
    ports.store.logError('handleUpdate', err, update.update_id, safeJson(update));
    return 'error';
  }
}

function handleUpdate(update, ports) {
  var src = update.message || update.callback_query;
  if (!src || !src.from) return;
  // Group chats are only used for the daily summary. Log the id once so it can be configured.
  if (update.message && update.message.chat && update.message.chat.type !== 'private') {
    ports.store.logError('group_chat', 'Seen in group "' + (update.message.chat.title || '') +
      '". Put this chat id in Script Property GROUP_CHAT_ID: ' + update.message.chat.id, update.update_id, '');
    return;
  }
  var staff = ports.store.getStaff(String(src.from.id));
  if (!staff) {
    ports.store.logUnknownUser(src.from, update.update_id);
    if (update.message && update.message.chat) ports.chat.sendMessage(update.message.chat.id, t(ports, 'staff_only'));
    if (update.callback_query) ports.chat.answerCallback(update.callback_query.id);
    return;
  }
  loadShopRegistry(ports);
  if (officeRole(staff.role) || (staff.shops && staff.role !== 'owner' && !ports.ui)) {
    if (update.message) return sendEnrollCode(update.message.chat.id, staff, ports);
    ports.chat.answerCallback(update.callback_query.id);
    return;
  }
  if (update.callback_query) return handleCallback(update.callback_query, staff, update.update_id, ports);
  if (update.message) return handleMessage(update.message, staff, update.update_id, ports);
}

/* ------------------------------ messages ------------------------------ */

function handleMessage(msg, staff, updateId, ports) {
  var chatId = msg.chat.id, uid = String(msg.from.id);
  if (msg.text && /^\/start/.test(msg.text)) {
    var payload = (msg.text.split(/\s+/)[1] || '').trim().toUpperCase();
    // The voucher's link (?start=V1-2532) opens the order card.
    if (payload && isOrderId(payload) && ordersEnabled(ports)) { dropAddState(ports, uid); return openOrderCard(chatId, payload, staff, uid, ports); }
    // A scan: openTag decides the state as before (a known tag replaces or clears any prompt).
    if (payload && /^[A-Z0-9_-]{1,64}$/.test(payload)) return openTag(chatId, payload, staff, uid, ports);
    dropAddState(ports, uid);
    return showMenu(chatId, staff, ports);
  }
  if (msg.text === '/today') return answerToday(chatId, staff, ports);
  if (msg.text === '/help') return ports.chat.sendMessage(chatId, t(ports, 'help'));
  if (msg.text === '/report' || msg.text === '/reports') return showReportMenu(chatId, staff, ports);
  if (msg.text === '/devices') return showDevices(chatId, staff, ports);
  if (msg.voice || msg.audio) return handleVoice(msg, staff, updateId, ports);
  if (msg.photo) return handlePhoto(msg, staff, updateId, ports);
  if (msg.text) return handleText(msg, staff, updateId, ports);
}

/**
 * A scanned or typed tag (and K|, opts.card: always the item card). After the custom-order branches: (1) a Telegram basket
 * waiting at its add screen takes the piece; (2) a blank tag: in form mode a seller's tag of another shop is refused, in the
 * app the new-piece form opens, else the new-piece chat (form mode: its review card); (3) in the app with forms a sellable
 * piece of the basket's shop opens the sale form; (4) another tag while a Telegram basket is live pauses it; (5) else the
 * item card. quick: (2)'s form parts and (4) never apply.
 */
function openTag(chatId, itemId, staff, uid, ports, opts) {
  opts = opts || {};
  // Telegram's ☰ 📦 restock loop (round 6b, G3) takes every scanned or typed tag first (K|, opts.card, keeps the item card).
  var lp = opts.card ? null : restockLoopOf(getState(ports, uid));
  if (lp) return restockLoopTag(chatId, uid, lp, itemId, staff, ports);
  var item = ports.store.getItem(itemId);
  var form = saleFlow(ports) === CFG.SALE_FLOW.FORM, live = form && !formsInApp(ports) ? saleStateOf(ports, uid) : null;
  if (!item) {
    // An unknown tag at a basket's add screen comes back as the card with tag_not_found on top (the basket kept).
    if (live && live.step === 'add' && !live.paused && !opts.card) return basketAddScanned(saleCtx(chatId, uid, staff, null, ports), live, { id: itemId }, {});
    return ports.chat.sendMessage(chatId, t(ports, 'tag_not_found', { id: itemId }));
  }
  if (ordersEnabled(ports)) {
    // 🏷 Tag တပ် on an order card: the next scanned blank tag becomes that voucher line's piece.
    var st = getState(ports, uid);
    if (st && st.kind === 'order_tag') return attachTagToItem(chatId, uid, st, item, staff, ports);
    // A tag attached to a voucher line (Alias V1-2532-1) opens the order card while the order is open.
    if (isOrderLineId(item.alias)) {
      var tagged = ports.store.getOrder(orderIdOfLine(item.alias));
      if (tagged && orderIsOpen(tagged)) {
        clearState(ports, uid);
        setLastItem(ports, uid, itemId);
        return sendOrderCard(chatId, null, tagged.id, staff, ports);
      }
    }
  }
  if (live && live.step === 'add' && !live.paused && !opts.card) {
    return basketAddScanned(saleCtx(chatId, uid, staff, null, ports), live, item, {});
  }
  if (item.status === CFG.STATUS.BLANK) {
    if (form && staff.role !== 'owner' && item.shop !== staff.shop) {
      return ports.chat.sendMessage(chatId, t(ports, 'basket_other_shop', { id: itemId, shop: shopName(ports, item.shop) }));
    }
    if (formsInApp(ports)) {
      clearState(ports, uid);
      return ports.ui.openForm('newitem', { chatId: chatId, uid: uid, staff: staff, itemId: itemId });
    }
    basketClose(ports, chatId, uid);
    var ns = { kind: 'new_item', itemId: itemId, step: 'photo', draft: {} };
    if (form) ns.form = true;
    setState(ports, uid, ns);
    return ports.chat.sendMessage(chatId, t(ports, 'new_tag', { id: itemId }), [[btn(t(ports, 'btn_cancel'), 'Z')]]);
  }
  if (formsInApp(ports) && !opts.card && basketAddItem(ports, staff, [], itemId, 1).ok) {
    clearState(ports, uid);
    setLastItem(ports, uid, itemId);
    return ports.ui.openForm('sale', { chatId: chatId, uid: uid, staff: staff, itemId: itemId, qty: 1 });
  }
  if (live && !opts.card) {
    setLastItem(ports, uid, itemId);
    return basketPause(saleCtx(chatId, uid, staff, null, ports), live, item);
  }
  clearState(ports, uid);
  setLastItem(ports, uid, itemId);
  return sendItemCard(chatId, item, staff, ports);
}

function showMenu(chatId, staff, ports) {
  var rows = [
    [btn(t(ports, 'btn_today'), 'M|today'), btn(t(ports, 'btn_recent'), 'M|recent'), btn(t(ports, 'btn_find'), 'M|find')],
    [btn(t(ports, 'btn_pay'), 'M|pay'), btn(t(ports, 'btn_deposit'), 'M|dep'), btn(t(ports, 'btn_expense'), 'M|exp')],
    [btn(t(ports, 'btn_customers'), 'M|cust'), btn(t(ports, 'btn_reports'), 'M|rep'), btn(t(ports, 'btn_help'), 'M|help')]
  ];
  // Orders, the notebook import and the bank accounts share one row below the three everyday rows (the sale paths are unchanged).
  var extra = [];
  if (ordersEnabled(ports)) extra.push(btn(t(ports, 'btn_orders'), 'M|ord'));
  else if (measureFormEnabled(ports)) extra.push(btn(t(ports, 'btn_measure'), 'M|meas'));   // the app: no orders, the measurement form
  // 📦 in every channel and both sale modes (round 6b, G3): the app's restock form with forms, else the restock loop.
  extra.push(btn(t(ports, 'btn_restock'), 'M|restock'));
  // The notebook needs the owner's AI switch too (round 6, F9b), in both channels.
  if (aiOn(ports) && settingOn(ports, 'notebook_import')) extra.push(btn(t(ports, 'btn_notebook'), 'M|nb'));
  extra.push(btn(t(ports, 'btn_accounts'), 'M|acct'));
  rows.push(extra);
  if (ports.sync) {
    // The app (plan 14.2): a typed one-time code for everyone, the phone list for the owner. Below the sale paths.
    var app = [btn(t(ports, 'btn_app'), 'M|app')];
    if (staff.role === 'owner') app.push(btn(t(ports, 'btn_devices'), 'M|devices'));
    rows.push(app);
  }
  return ports.chat.sendMessage(chatId, t(ports, 'menu'), rows);
}

/** 📲: a typed one-time enrollment code for the app, bound to this staff member (never inside a link). */
function sendEnrollCode(chatId, staff, ports) {
  if (!ports.sync) return ports.chat.sendMessage(chatId, t(ports, 'app_not_ready'));
  var minted = ports.sync.mintCode(staff, staff.name);
  return ports.chat.sendMessage(chatId, minted.text);
}

/** Owner-only 📱: the enrolled phones with ⏸ drain / 🟢 activate / ❌ revoke buttons (DV|<id>|action). */
function showDevices(chatId, staff, ports) {
  if (!ports.sync) return ports.chat.sendMessage(chatId, t(ports, 'app_not_ready'));
  if (staff.role !== 'owner') return ports.chat.sendMessage(chatId, t(ports, 'devices_owner_only'));
  var r = ports.sync.devicesText();
  return ports.chat.sendMessage(chatId, r.text, r.kb || []);
}

/**
 * PC / USB-scanner path (plan 13.5): a bare tag id typed into Telegram Desktop, or a pasted
 * t.me/<bot>?start=<id> link, opens the card without an AI call. Returns the id or null.
 */
function tagIdFromText(text) {
  var s = String(text || '').trim();
  if (/^S[1-9]\d*-\d{4}$/i.test(s) && CFG.SHOP_IDS.indexOf(s.toUpperCase().split('-')[0]) >= 0) return s.toUpperCase();
  var m = s.match(/t\.me\/[^?\s]+\?start=([A-Za-z0-9_-]{1,64})/i);
  return m ? m[1].toUpperCase() : null;
}

/* ------------------------------ item card ------------------------------ */

function isPricePending(item) {
  return item.price === '' || item.price === null || item.price === undefined || Number(item.price) <= 0;
}

function cardText(ports, item) {
  var name = item.name + (item.sample ? t(ports, 'sample_mark') : '');
  var vars = { emoji: itemEmoji(ports, item), id: item.id, name: name, price: fmtMoney(item.price), stock: fmtCount(item.stock) };
  if (isPricePending(item)) return t(ports, 'card_pending', vars);
  var soldOut = item.type === CFG.ITEM_TYPE.UNIQUE && Number(item.stock) <= 0;
  var text = t(ports, soldOut ? 'card_sold_out' : 'card', vars);
  if (soldOut) {
    // "Which customer bought this piece" from the item side (plan 13.2).
    var sale = lastLiveSale(ports, item.id);
    if (sale && sale.customerId) {
      var info = saleGroupInfo(ports, sale.groupId);
      // How it was paid: one method by its label; a split or a later payment as "label amount · label amount".
      var ms = groupMethods(ports, sale.groupId), how;
      if (ms.length === 1) how = methodLabel(ports, ms[0].method);
      else if (ms.length > 1) how = ms.map(function (m) { return methodLabel(ports, m.method) + ' ' + fmtMoney(m.amount); }).join(' · ');
      else how = methodLabel(ports, methodOf(sale) || CFG.METHOD.CASH);
      var buyerVars = {
        customer: customerName(ports, sale.customerId),
        paid: fmtMoney(info ? info.cash + info.payments + info.applied : sale.cash),
        method: how
      };
      // A piece sold in a basket (round 6): the figure is the basket's, and the line says so.
      if (basketGroup(info)) buyerVars.n = fmtCount(info.rows.length);
      text += '\n' + t(ports, basketGroup(info) ? 'card_buyer_basket' : 'card_buyer', buyerVars);
    }
  }
  return text;
}

function cardKeyboard(ports, item) {
  var id = item.id, rows = [];
  var transfer = btn(CFG.SHOP_IDS.length > 2 ? 'လက်ခံမည့်ဆိုင် ရွေးပါ' : t(ports, 'btn_transfer', { shop: shopName(ports, otherShop(item.shop)) }), 'X|' + id);
  if (isPricePending(item)) {
    rows.push([btn(t(ports, 'btn_sell_at'), 'D|' + id)]);
    rows.push([btn(t(ports, 'btn_set_price'), 'SP|' + id + '|ask'), transfer]);
    return rows;
  }
  if (item.type === CFG.ITEM_TYPE.UNIQUE) {
    if (Number(item.stock) > 0) {
      rows.push([btn(t(ports, 'btn_sold'), 'S|' + id + '|1')]);
      rows.push([btn(t(ports, 'btn_discount'), 'D|' + id), btn(t(ports, 'btn_return'), 'T|' + id)]);
      rows.push([transfer]);
    } else {
      rows.push([btn(t(ports, 'btn_return'), 'T|' + id)]);
    }
  } else {
    // One tap sells one piece (most sales); the 🔢 button opens a 2..9 grid plus "type it" (plan 14.3b).
    rows.push([btn(t(ports, 'btn_sell_one'), 'S|' + id + '|1'), btn(t(ports, 'btn_qty'), 'Q|' + id)]);
    rows.push([btn(t(ports, 'btn_discount'), 'D|' + id), btn(t(ports, 'btn_restock'), 'R|' + id)]);
    rows.push([btn(t(ports, 'btn_return'), 'T|' + id), transfer]);
  }
  return rows;
}

/**
 * The item card. opts (round 6): undo = a group id (the form-mode new piece: ↩️ as the first row), addTo = {anchor} (a
 * paused basket: ➕ စာရင်းထဲ ထည့် as the first row), extra = lines under the card in the app's view. The owner's card of a
 * piece last sold in a basket ends with 🧾 (ownerBasketRow). Without opts and for a seller: the card of before, byte for byte.
 */
function sendItemCard(chatId, item, staff, ports, opts) {
  opts = opts || {};
  var text = cardText(ports, item), kb = cardKeyboard(ports, item);
  if (opts.addTo) kb = [[btn(t(ports, 'btn_add_to_list'), 'SS|' + opts.addTo.anchor + '|i|' + item.id)]].concat(kb);
  if (opts.undo) kb = undoRow(ports, opts.undo).concat(kb);
  kb = kb.concat(ownerBasketRow(ports, staff, item));
  var x = viewOf(ports, { kind: 'item', id: item.id, extra: opts.extra || [] });
  // Settings text_cards = TRUE sends cards without the photo: faster on a slow connection.
  if ((item.photoFileId || item.photoUrl) && !settingOn(ports, 'text_cards')) {
    return x ? ports.chat.sendPhoto(chatId, item.photoFileId || item.photoUrl, text, kb, x) : ports.chat.sendPhoto(chatId, item.photoFileId || item.photoUrl, text, kb);
  }
  return x ? ports.chat.sendMessage(chatId, text, kb, x) : ports.chat.sendMessage(chatId, text, kb);
}

function soldText(ports, item, qty, r) {
  return cardText(ports, item) + '\n' + t(ports, 'sold_done', { qty: fmtCount(qty), amount: fmtMoney(r.txs[0].amount), stock: fmtCount(item.stock) });
}

/**
 * The 🔢 grid: ၂..၉ sell that many through the same S|id|N action (in Telegram's form mode S opens the review card with that
 * count); ✏️ asks for a typed number. Returns sendMessage's {messageId}.
 */
function askQty(chatId, uid, item, ports) {
  var rows = [], row = [];
  CFG.QTY_GRID.forEach(function (n) {
    row.push(btn(myDigits(n), 'S|' + item.id + '|' + n));
    if (row.length === 4) { rows.push(row); row = []; }
  });
  if (row.length) rows.push(row);
  rows.push([btn(t(ports, 'btn_type_qty'), 'QN|' + item.id), btn(t(ports, 'btn_cancel'), 'Z')]);
  return ports.chat.sendMessage(chatId, t(ports, 'ask_qty') + '\n' + item.id + ' · ' + item.name, rows);
}

function clampQty(v) {
  var q = Math.round(Number(v));
  if (!(q >= 1)) q = 1;
  return Math.min(q, CFG.MAX_SALE_QTY);
}

/**
 * Buttons under a committed sale. Undo and receipt always; "receive payment" while money is owed;
 * while the group can still be rewritten (one live row, today, no payment attached): "not fully paid"
 * when it is paid, 👤 when no customer is attached, and, while cash was paid, one 🏦 button per other
 * account of the sale's shop with a last row "💵+🏦 split" and "➕ new bank".
 * The credit state comes from the ledger (owed > 0), never from whether a customer is attached.
 * opts.plain (the guided sale's sold card): the undo/receipt row and the 💰 row only, no corrective buttons.
 */
function afterSaleKeyboard(ports, groupId, opts) {
  var rows = [[btn(t(ports, 'btn_undo'), 'U|' + groupId), btn(t(ports, 'btn_receipt'), 'RC|' + groupId)]];
  var info = saleGroupInfo(ports, groupId);
  if (!info || info.voided) return rows;
  if (info.owed > 0) rows.push([btn(t(ports, 'btn_pay'), 'PY|' + groupId)]);
  if (opts && opts.plain) return rows;
  var chk = rewriteCheck(ports, groupId);
  if (chk.ok) {
    var extra = [];
    if (info.owed <= 0) extra.push(btn(t(ports, 'btn_credit'), 'CR|' + groupId));
    if (!info.customerId) extra.push(btn(t(ports, 'btn_customer'), 'CU|' + groupId));
    if (extra.length) rows.push(extra);
    if (chk.row.cash > 0) {
      rows = rows.concat(methodRows(ports, chk.row.shop, methodOf(chk.row), groupMethodData(groupId),
        { split: chk.row.type === CFG.TX.SALE ? 'SX|' + groupId : '', add: 'LA|pm|PM|' + groupId }));
    }
  }
  return rows;
}

/** mk(key) of the method buttons under a committed group: PM|<group>|<KEY>. */
function groupMethodData(groupId) {
  return function (key) { return 'PM|' + groupId + '|' + key; };
}

/**
 * The method buttons of a screen, as keyboard rows. One button per key of payMethods(ports, shop): 💵 for CASH,
 * 🏦 + the account's label for the others, callback data mk(key). current (a key, an array of keys, or null)
 * gets no button. Layout: one row while there are at most three buttons and no label is longer than ten
 * characters, otherwise rows of two. opts.split and opts.add (callback data) add "💵+🏦 split" and "➕ new bank":
 * they never share a row with method buttons, they form one extra last row, split first. A button whose callback
 * data would exceed Telegram's 64 bytes is skipped (one oversize button makes it reject the whole keyboard).
 * The caller appends its own cancel row on the screens that have one.
 */
function methodRows(ports, shop, current, mk, opts) {
  opts = opts || {};
  var skip = {}, buttons = [], wide = false, rows = [], last = [], i;
  var cur = current === null || current === undefined ? []
    : (Object.prototype.toString.call(current) === '[object Array]' ? current : [current]);
  for (i = 0; i < cur.length; i++) if (cur[i]) skip['k:' + String(cur[i]).toUpperCase()] = true;
  payMethods(ports, shop).forEach(function (k) {
    if (skip['k:' + k]) return;
    var data = mk(k);
    if (utf8ByteLength(data) > 64) return;
    if (k === CFG.METHOD.CASH) { buttons.push(btn(t(ports, 'btn_cash'), data)); return; }
    var label = methodLabel(ports, k);
    if (label.length > 10) wide = true;
    buttons.push(btn(t(ports, 'btn_bank', { method: label }), data));
  });
  if (buttons.length <= 3 && !wide) {
    if (buttons.length) rows.push(buttons);
  } else {
    for (i = 0; i < buttons.length; i += 2) rows.push(buttons.slice(i, i + 2));
  }
  if (opts.split && utf8ByteLength(opts.split) <= 64) last.push(btn(t(ports, 'btn_split'), opts.split));
  if (opts.add && utf8ByteLength(opts.add) <= 64) last.push(btn(t(ports, 'btn_add_bank'), opts.add));
  if (last.length) rows.push(last);
  return rows;
}

/** Undo (or the given first row) plus the 🏦 rows and "➕ new bank" while the group's one cash row can still be rewritten. */
function moneyKeyboard(ports, groupId, firstRow) {
  var rows = [firstRow || [btn(t(ports, 'btn_undo'), 'U|' + groupId)]];
  var chk = rewriteCheck(ports, groupId);
  if (chk.ok && chk.row.cash) {
    rows = rows.concat(methodRows(ports, chk.row.shop, methodOf(chk.row), groupMethodData(groupId), { add: 'LA|pm|PM|' + groupId }));
  }
  return rows;
}

/** The keyboard that belongs under a committed group, by the type of its live row. */
function replyKeyboard(ports, groupId) {
  var live = groupRows(ports, groupId).live, row = live[0];
  if (!row) return undoRow(ports, groupId);
  if (row.type === CFG.TX.SALE) return afterSaleKeyboard(ports, groupId);
  if (row.type === CFG.TX.PAYMENT) {
    return moneyKeyboard(ports, groupId, [btn(t(ports, 'btn_undo'), 'U|' + groupId), btn(t(ports, 'btn_receipt'), 'RC|' + (row.refGroupId || groupId))]);
  }
  if (row.type === CFG.TX.EXPENSE) {
    return moneyKeyboard(ports, groupId, [btn(t(ports, 'btn_undo'), 'U|' + groupId), btn(t(ports, 'btn_note'), 'EN|' + groupId)]);
  }
  return moneyKeyboard(ports, groupId);
}

function undoRow(ports, groupId) {
  return [[btn(t(ports, 'btn_undo'), 'U|' + groupId)]];
}

/** The owner-only void button, for conflict pings and anything else that needs to reverse a group at any age. */
function voidButton(ports, groupId) {
  return btn(t(ports, 'btn_void'), 'V|' + groupId);
}

/** The 📱 button when a customer has no phone yet. Never asked inside a money flow. */
function phoneRow(ports, customer) {
  return customer && !customer.phone ? [[btn(t(ports, 'btn_phone'), 'CF|' + customer.id)]] : [];
}

function methodLine(ports, method) {
  var m = String(method || '').toUpperCase();
  return m && m !== CFG.METHOD.CASH ? '\n' + t(ports, 'method_done', { method: methodLabel(ports, m) }) : '';
}

function rewriteRefusal(ports, reason) {
  if (reason === 'expired') return t(ports, 'rewrite_refused');
  if (reason === 'locked' || reason === 'complex' || reason === 'type') return t(ports, 'rewrite_locked');
  if (reason === 'already') return t(ports, 'undo_already');
  return t(ports, 'expired');
}

/**
 * Edit the tapped message, or send a new one when there is none (typed or spoken input, a flow resumed after ➕).
 * isCaption: the tapped message is a photo card (its caption is edited); the callers before round 5 pass nothing.
 */
function editOrSend(ports, chatId, msgId, text, kb, isCaption, view) {
  // view (round 6): the app's view hint of the message (spec 13.9); Telegram gets the call of before, without it.
  var x = viewOf(ports, view);
  if (msgId) return x ? ports.chat.editMessage(chatId, msgId, text, kb || [], !!isCaption, x) : ports.chat.editMessage(chatId, msgId, text, kb || [], !!isCaption);
  return x ? ports.chat.sendMessage(chatId, text, kb || [], x) : ports.chat.sendMessage(chatId, text, kb || []);
}

/** A reply with the line a resumed flow puts in front of it ("➕ ... added"), or the text alone. */
function withPrefix(prefix, text) {
  return prefix ? prefix + '\n' + text : text;
}

/**
 * hint = {line, row} or null: one more text line and one more last keyboard row on the ONE message a resumed flow
 * sends (after a new account: "add its number" with the 🔢 button). Never a message of its own: the resumed
 * card must stay the last bot message (the app shows only that one).
 */
function withHintLine(text, hint) {
  return hint && hint.line ? text + '\n' + hint.line : text;
}
function withHintRow(kb, hint) {
  return hint && hint.row ? (kb || []).concat([hint.row]) : (kb || []);
}

/**
 * The refusal of a tap on a committed card, the way a refused method tap answers: the card keeps its own text
 * (earlier 🏦 lines dropped), the reason is added once, and the buttons that still apply are redrawn.
 */
function refuseOnCard(chatId, msgId, isCaption, groupId, line, ports, message) {
  var base = stripMethodLines((message && (message.caption || message.text)) || '');
  var text = !base ? line : (base.split('\n').indexOf(line) >= 0 ? base : base + '\n' + line);
  return ports.chat.editMessage(chatId, msgId, text, replyKeyboard(ports, groupId), isCaption);
}

/* ------------------------------ callbacks ------------------------------ */

var ITEM_ACTIONS = { S: 1, Q: 1, QN: 1, D: 1, R: 1, RQ: 1, T: 1, X: 1, K: 1, P: 1, C: 1, PS: 1, SP: 1, SS: 1, SC: 1, NI: 1, NC: 1 };
// Actions that write money or stock. On a slow connection the same button can be tapped
// twice before the card is redrawn; the second tap within two minutes is ignored.
// S is exempt in form mode (sale_flow = form: it writes nothing there, it opens the review card or the app's form).
var MUTATING_ACTIONS = { S: 1, RQ: 1, T: 1, X: 1, PA: 1, DN: 1, CC: 1, CD: 1, DA: 1, PM: 1, CUP: 1, EM: 1, V: 1, DV: 1,
  OC: 1, ODA: 1, ODP: 1, ODM: 1, OXR: 1, OXM: 1, OS: 1, MK: 1, SXA: 1, SC: 1, NC: 1 };
// Custom tailoring callbacks (core_orders.js); without the module they answer "expired".
var ORDER_ACTIONS = { O: 1, OL: 1, ON: 1, OC: 1, OI: 1, OP: 1, OQ: 1, OA: 1, OF: 1, OE: 1, OD: 1, ODA: 1, OS: 1, OV: 1, OVP: 1, ORM: 1,
  ODL: 1, ODU: 1, ODP: 1, ODM: 1, OX: 1, OXR: 1, OXM: 1, OT: 1, OTL: 1, MS: 1, MM: 1, MQ: 1, MK: 1, MF: 1, MG: 1, ML: 1, MP: 1 };

function handleCallback(cq, staff, updateId, ports) {
  ports.chat.answerCallback(cq.id);
  var chatId = cq.message.chat.id, msgId = cq.message.message_id, isCaption = !!cq.message.photo;
  var uid = String(cq.from.id);
  var parts = String(cq.data || '').split('|'), action = parts[0], id = parts[1], arg = parts[2];
  if (MUTATING_ACTIONS[action] && !(action === 'S' && saleFlow(ports) === CFG.SALE_FLOW.FORM)) {
    var tapKey = 'tap:' + chatId + ':' + msgId + ':' + cq.data;
    if (ports.cache.get(tapKey)) return;
    ports.cache.put(tapKey, '1', 120);
  }
  var edit = function (text, kb) { ports.chat.editMessage(chatId, msgId, text, kb || [], isCaption); };
  var editV = function (text, kb, view) {
    var x = viewOf(ports, view);
    return x ? ports.chat.editMessage(chatId, msgId, text, kb || [], isCaption, x) : edit(text, kb);
  };
  var item = ITEM_ACTIONS[action] && id ? ports.store.getItem(id) : null;
  var base = { staff: staff, source: CFG.SOURCE.BUTTON, updateId: updateId };
  var sctx = saleCtx(chatId, uid, staff, updateId, ports, msgId, isCaption);   // the review card's view of this tap
  if (ITEM_ACTIONS[action] && !item && action !== 'K') return edit(t(ports, 'tag_not_found', { id: id }));
  if (ORDER_ACTIONS[action]) {
    // MS also opens the app's measurement form where the order module is off (spec 9.2); every other order action needs the module.
    if (!ordersEnabled(ports) && !(action === 'MS' && measureEnabled(ports))) return edit(t(ports, 'expired'));
    return orderCallback(action, parts, chatId, msgId, uid, staff, updateId, ports);
  }

  switch (action) {
    case 'S': {
      // Form mode: nothing is written here; the app opens its sale form, Telegram turns the card into the review card.
      if (saleFlow(ports) === CFG.SALE_FLOW.FORM) return startSaleFor(sctx, item, clampQty(arg), {});
      var qty = clampQty(arg);
      var r = commitSale(ports, merge(base, { item: item, qty: qty }));
      var fresh = ports.store.getItem(id);
      setLastItem(ports, uid, id);
      setLastGroup(ports, uid, r.groupId);
      return editV(soldText(ports, fresh, qty, r), afterSaleKeyboard(ports, r.groupId), saleSoldView(ports, r.groupId, ''));
    }
    case 'Q': {
      // The app's forms: the sale form with a count of 1 (its stepper is the count). Telegram (both modes): quick's grid,
      // whose digits are S|id|n (in form mode they open the review card with that count).
      if (formsInApp(ports)) return startSaleFor(sctx, item, 1, {});
      return askQty(chatId, uid, item, ports);
    }
    case 'QN': {
      if (formsInApp(ports)) return startSaleFor(sctx, item, 1, {});
      // Form mode: another sale starts, so a live Telegram basket ends here (its card reads basket_closed), as ✅ ends it.
      if (saleFlow(ports) === CFG.SALE_FLOW.FORM) basketClose(ports, chatId, uid, msgId);
      setState(ports, uid, { kind: 'await_number', purpose: 'sale_qty', itemId: id });
      return edit(t(ports, 'ask_qty_number'));
    }
    case 'D': {
      if (formsInApp(ports)) return startSaleFor(sctx, item, 1, { price: true });
      if (saleFlow(ports) === CFG.SALE_FLOW.FORM) basketClose(ports, chatId, uid, msgId);
      setState(ports, uid, { kind: 'await_number', purpose: 'sale_price', itemId: id });
      return ports.chat.sendMessage(chatId, t(ports, 'ask_sale_price'), [[btn(t(ports, 'btn_cancel'), 'Z')]]);
    }
    case 'SS': return basketCallback(sctx, parts, item, cq.message);
    case 'SC': return basketSave(sctx, item, cq.message);
    case 'NI': return newItemCallback(chatId, msgId, uid, parts, staff, ports);
    case 'NC': return newItemSave(chatId, msgId, uid, id, staff, updateId, ports);
    case 'R': {
      if (formsInApp(ports)) {
        clearState(ports, uid);
        return ports.ui.openForm('restock', { chatId: chatId, uid: uid, staff: staff, itemId: id });
      }
      return restockQtyScreen(chatId, item, ports, '', false);
    }
    case 'RQ': {
      // Inside the ☰ 📦 loop (round 6b) at this item's count screen: a count saves and offers the next tag; ✏️ asks a count.
      var rqState = getState(ports, uid), lpq = restockLoopOf(rqState), inLoop = !!lpq && lpq.step === 'qty' && lpq.itemId === id;
      if (!rqState) {
        // The loop ran out (its RESTOCK_LOOP_TTL_SEC) while the seller counted at its latest count screen (the rl: mark):
        // a tap there is still the loop's, so the count keeps its tag line and the loop opens again for the next tag.
        var rqRaw = ports.cache.get('rl:' + uid), rqMark = rqRaw ? JSON.parse(rqRaw) : null;
        if (rqMark && rqMark.id === id && String(rqMark.m) === String(msgId)) {
          lpq = { n: Number(rqMark.n) || 0, step: 'qty', itemId: id, msgId: msgId };
          inLoop = true;
        }
      }
      if (arg === 'other') {
        if (inLoop) {
          setState(ports, uid, { kind: 'await_number', purpose: 'restock_qty', itemId: id, loop: lpq.n, msgId: msgId });
          return edit(t(ports, 'restock_type_qty'), [[btn(t(ports, 'btn_cancel'), 'RT|skip')]]);
        }
        setState(ports, uid, { kind: 'await_number', purpose: 'restock_qty', itemId: id });
        return edit(t(ports, 'ask_number'));
      }
      if (inLoop) return restockLoopSave(chatId, msgId, uid, lpq.n, merge(base, { item: item, qty: Number(arg) }), isCaption, staff, ports);
      var r2 = commitRestock(ports, merge(base, { item: item, qty: Number(arg) }));
      var fresh2 = ports.store.getItem(id);
      setLastItem(ports, uid, id);
      return editOrSend(ports, chatId, msgId, t(ports, 'restock_done', { qty: fmtCount(arg), stock: fmtCount(fresh2.stock) }), undoRow(ports, r2.groupId), isCaption,
        { kind: 'group', id: r2.groupId });
    }
    case 'T': {
      // A piece whose last sale still owes is not taken back here (round 6, spec 1.10): the refund would leave the credit open.
      var open = creditOpenFor(ports, id);
      if (open) {
        var openLine = t(ports, 'ret_credit_open', { customer: customerName(ports, open.customerId), owed: fmtMoney(open.owed) });
        return editOrSend(ports, chatId, msgId, cardText(ports, item) + '\n' + openLine, cardKeyboard(ports, item).concat(ownerBasketRow(ports, staff, item)),
          isCaption, { kind: 'item', id: id, extra: [openLine] });
      }
      var r3 = commitReturn(ports, merge(base, { item: item, qty: 1 }));
      var fresh3 = ports.store.getItem(id);
      setLastGroup(ports, uid, r3.groupId);
      return edit(cardText(ports, fresh3) + '\n' + t(ports, 'return_done', {
        qty: fmtCount(1), amount: fmtMoney(-r3.txs[0].amount), stock: fmtCount(fresh3.stock)
      }), replyKeyboard(ports, r3.groupId));
    }
    case 'X': {
      var destinations = activeShopIds(ports).filter(function (s) { return s !== item.shop; });
      if (destinations.length !== 1 && !arg) return edit('လက်ခံမည့်ဆိုင် ရွေးပါ', destinations.map(function (s) { return [btn(shopName(ports, s), 'X|' + id + '|' + s)]; }));
      var to = arg || destinations[0];
      if (destinations.indexOf(to) < 0 || (staff.role !== 'owner' && item.shop !== staff.shop)) return edit(t(ports, 'expired'));
      var r4 = commitTransfer(ports, merge(base, { item: item, toShop: to }));
      return edit(t(ports, 'transfer_done', { id: id, shop: shopName(ports, to) }), undoRow(ports, r4.groupId));
    }
    case 'U': {
      // A new piece (round 6): once one of its pieces moved, its group cannot be undone; else the undo blanks the tag again.
      var ni = newItemUndoInfo(ports, id);
      if (ni && ni.used) return edit(t(ports, 'undo_new_used', { id: ni.itemId }));
      var u = undoGroup(ports, id, staff);
      if (!u.ok) {
        var why = u.reason === 'expired' ? t(ports, 'undo_expired', { min: myDigits(CFG.UNDO_WINDOW_MIN) })
          : u.reason === 'already' ? t(ports, 'undo_already') : u.reason === 'locked' ? t(ports, 'rewrite_locked') : t(ports, 'expired');
        return edit(why);
      }
      clearLastGroup(ports, uid, id);
      if (ni) {
        unregisterItem(ports, ni.itemId);
        return edit(t(ports, 'undo_done') + '\n' + t(ports, 'item_unregistered', { id: ni.itemId }));
      }
      var uHead = t(ports, 'undo_done') + orderUndoLine(ports, id, staff);
      return editV(uHead + groupUndoTail(ports, id, u), [], undoReplyView(ports, id, u, uHead.split('\n')));
    }
    case 'V': {
      // Owner-only: reverse a group at any age (Source UNDO, note 'void by owner'). Attached to conflict pings.
      if (staff.role !== 'owner') return ports.chat.sendMessage(chatId, t(ports, 'void_owner_only'));
      var v = voidGroup(ports, id, staff);
      // A later payment taken against the group locks it (undoGroup's 'locked'): the owner voids that payment first.
      if (!v.ok) return edit(v.reason === 'already' ? t(ports, 'undo_already') : v.reason === 'locked' ? t(ports, 'rewrite_locked') : t(ports, 'expired'));
      clearLastGroup(ports, uid, id);
      var vHead = t(ports, 'void_done') + orderUndoLine(ports, id, staff);
      return editV(vHead + groupUndoTail(ports, id, v), [], undoReplyView(ports, id, v, vHead.split('\n')));
    }
    case 'Y': return confirmProposal(chatId, msgId, isCaption, id, staff, uid, updateId, ports);
    case 'N': {
      var pj = ports.cache.get('cf:' + id);
      ports.cache.remove('cf:' + id);
      edit(t(ports, 'rejected'));
      if (pj) {
        var p = JSON.parse(pj);
        var it = p.itemId ? ports.store.getItem(p.itemId) : null;
        if (it) sendItemCard(chatId, it, staff, ports);
      }
      return;
    }
    case 'P': return newItemPrice(chatId, msgId, uid, id, arg, staff, ports);
    case 'C': return newItemCost(chatId, msgId, uid, id, arg, staff, ports);
    case 'PS': return toggleSample(chatId, msgId, uid, id, staff, ports);
    case 'SP': return setPrice(chatId, msgId, uid, id, arg, staff, ports);
    case 'K': {
      // 🛒 ရောင်းမယ် on the loop's count screen (and any K| while the loop is open) ends the loop, its count screen included.
      if (restockLoopOf(getState(ports, uid))) restockLoopEnd(ports, uid);
      return openTag(chatId, id, staff, uid, ports, { card: true });
    }
    case 'RT': {
      // The ☰ 📦 loop (round 6b): skip -> the tapped message becomes the ask again (nothing saved); done -> the loop ends.
      var lpt = restockLoopOf(getState(ports, uid));
      // Only the loop's live prompt acts (its msgId in the state): ✖️ or ✅ on an older count screen or ask only loses its
      // buttons (its text kept), so it never resets or ends the loop the seller is in now.
      if (lpt && lpt.msgId && String(lpt.msgId) !== String(msgId)) return edit(cq.message.text || cq.message.caption || t(ports, 'expired'));
      if (id === 'skip') return lpt ? restockAsk(chatId, msgId, uid, staff, ports, lpt.n, '') : edit(t(ports, 'expired'));
      if (lpt) clearState(ports, uid);
      return edit(t(ports, 'restock_loop_done'));
    }
    case 'M': {
      dropAddState(ports, uid);
      return menuAction(chatId, uid, id, staff, ports);
    }
    case 'Z': {
      clearState(ports, uid);
      return edit(t(ports, 'cancelled'));
    }
    case 'CR': return startCredit(chatId, uid, id, staff, ports);
    case 'CP': return creditPaid(chatId, msgId, uid, id, arg, staff, ports);
    case 'CC': return creditCustomer(chatId, msgId, uid, id, arg, staff, updateId, ports);
    case 'CD': return creditDeposit(chatId, msgId, isCaption, id, arg, staff, updateId, ports, parts[3] === 'p', parts[4]);
    case 'PY': return payPick(chatId, msgId, uid, id, staff, ports);
    case 'PL': return showPayList(chatId, staff, ports, '', id);
    case 'PA': return payAmount(chatId, msgId, uid, id, arg, staff, updateId, ports);
    case 'DC': return depCustomer(chatId, msgId, uid, id, staff, ports);
    case 'DA': return depAmount(chatId, msgId, uid, id, arg, staff, ports);
    case 'DN': return finishDeposit(chatId, msgId, uid, id, Number(arg), '', staff, updateId, ports, CFG.SOURCE.BUTTON, '', null);
    case 'PM': return changeMethod(chatId, msgId, isCaption, id, arg, staff, uid, updateId, ports, cq.message);
    case 'SX': return startSplit(chatId, msgId, isCaption, uid, id, staff, ports, cq.message);
    case 'SXM': return sendSplitAmount(chatId, msgId, uid, id, arg, ports, '');
    case 'SXA': {
      var splitState = { kind: 'await_number', purpose: 'split_bank', groupId: id, method: String(arg || '').toUpperCase() };
      return finishSplit(chatId, msgId, uid, splitState, parts[3] === 'all' || parts[3] === 'half' ? parts[3] : '', staff, updateId, ports, CFG.SOURCE.BUTTON);
    }
    case 'LA': return askAddOption(chatId, msgId, isCaption, uid, parts, staff, ports, cq.message);
    case 'LD': return askListDetail(chatId, uid, id, arg, staff, ports);
    case 'CU': return startAttachCustomer(chatId, uid, id, staff, ports);
    case 'CUP': return attachCustomerPick(chatId, msgId, uid, id, arg, staff, updateId, ports);
    case 'CF': return askPhone(chatId, uid, id, ports);
    case 'CH': return customerCard(chatId, id, staff, ports);
    case 'CS': return sendCustomerStatement(chatId, id, staff, ports);
    case 'ES': return expenseShop(chatId, msgId, uid, id, staff, ports);
    case 'EC': return expenseCategory(chatId, msgId, uid, id, staff, ports);
    case 'EA': return expenseAmountTap(chatId, msgId, uid, id, staff, ports);
    case 'EM': return expenseMethod(chatId, msgId, uid, id, staff, updateId, ports);
    case 'EN': return askExpenseNote(chatId, uid, id, ports);
    case 'RP': return sendReport(chatId, id, staff, ports);
    case 'RC': return sendReceipt(chatId, id, staff, ports);
    case 'RCP': return sendReceiptPdf(chatId, id, staff, ports);
    case 'NB': return notebookPick(chatId, msgId, uid, id, arg, staff, updateId, ports);
    case 'DV': {
      // Owner-only: drain, revoke or re-activate an enrolled phone; the list is redrawn in place.
      if (!ports.sync) return edit(t(ports, 'app_not_ready'));
      if (staff.role !== 'owner') return ports.chat.sendMessage(chatId, t(ports, 'devices_owner_only'));
      var dv = ports.sync.deviceAction(id, arg);
      return edit(dv.text, dv.kb || []);
    }
    default:
      return;
  }
}

/**
 * The lines under an undo or void reply: a basket or a restock of several lines (more than one SALE, or more than one
 * RESTOCK, and not a custom-order delivery) lists every item of the group that has an Items row with its stock now
 * (group_item_line); any other group shows the first item's card as before (none when it has no Items row).
 */
function groupUndoTail(ports, groupId, u) {
  var types = u.types || [], sales = 0, restocks = 0;
  types.forEach(function (k) { if (k === CFG.TX.SALE) sales++; if (k === CFG.TX.RESTOCK) restocks++; });
  if (!isOrderId(groupId) && (sales > 1 || restocks > 1)) {
    var seen = {}, lines = [];
    groupRows(ports, groupId).rows.forEach(function (r) {
      if (r.reversesTxId || !r.itemId || seen['i:' + r.itemId]) return;
      seen['i:' + r.itemId] = true;
      var it = ports.store.getItem(r.itemId);
      if (it) lines.push(t(ports, 'group_item_line', { id: it.id, name: it.name, stock: fmtCount(it.stock) }));
    });
    return lines.length ? '\n' + lines.join('\n') : '';
  }
  var after = u.itemId ? ports.store.getItem(u.itemId) : null;
  return after ? '\n' + cardText(ports, after) : '';
}

/**
 * The app's view of an undo or void reply (spec 13.9; F7: no joined lines): a basket or a restock of several lines (the
 * list of groupUndoTail) and an expense, a payment or a deposit → the group view, drawn under ui_hist_undone (for a
 * basket the app's group view lists the group's own SALE rows: item, qty, stock now); any other group with an Items row
 * → that item's view with the reply's own lines (head: undo_done, an order's line) in extra; else null (the text).
 * Telegram never reads it.
 */
function undoReplyView(ports, groupId, u, head) {
  var types = u.types || [], sales = 0, restocks = 0, T = CFG.TX;
  types.forEach(function (k) { if (k === T.SALE) sales++; if (k === T.RESTOCK) restocks++; });
  if (!isOrderId(groupId) && (sales > 1 || restocks > 1)) return { kind: 'group', id: groupId };
  var after = u.itemId ? ports.store.getItem(u.itemId) : null;
  if (after) return { kind: 'item', id: after.id, extra: head };
  if (!isOrderId(groupId) && (types[0] === T.EXPENSE || types[0] === T.PAYMENT || types[0] === T.DEPOSIT)) return { kind: 'group', id: groupId };
  return null;
}

function menuAction(chatId, uid, which, staff, ports) {
  switch (which) {
    case 'restock':
      // The app's restock form, empty, its camera running (round 6, F12); Telegram and the app under quick ask for the tag
      // and run the restock loop (round 6b, G3).
      if (!formsInApp(ports)) return restockAsk(chatId, null, uid, staff, ports, 0, '');
      clearState(ports, uid);
      return ports.ui.openForm('restock', { chatId: chatId, uid: uid, staff: staff });
    case 'today': return answerToday(chatId, staff, ports);
    case 'help': return ports.chat.sendMessage(chatId, t(ports, 'help'));
    case 'find':
      setState(ports, uid, { kind: 'find' });
      return ports.chat.sendMessage(chatId, t(ports, 'find_prompt'), [[btn(t(ports, 'btn_cancel'), 'Z')]]);
    case 'recent': return showRecent(chatId, uid, staff, ports);
    case 'pay': return showPayList(chatId, staff, ports, '');
    case 'dep': return startDeposit(chatId, uid, staff, ports, null);
    case 'exp': return startExpense(chatId, uid, staff, ports);
    case 'cust': return showCustomers(chatId, uid, staff, ports);
    case 'cfind':
      setState(ports, uid, { kind: 'find_customer' });
      return ports.chat.sendMessage(chatId, t(ports, 'cust_find'), [[btn(t(ports, 'btn_cancel'), 'Z')]]);
    case 'rep': return showReportMenu(chatId, staff, ports);
    case 'acct': return sendAccounts(chatId, staff, ports, '');
    case 'nb': return startNotebook(chatId, uid, staff, ports);
    case 'app': return sendEnrollCode(chatId, staff, ports);
    case 'devices': return showDevices(chatId, staff, ports);
    case 'ord': return ordersEnabled(ports) ? orderMenu(chatId, staff, ports) : undefined;
    case 'meas': return measureEnabled(ports) ? startMeasure(chatId, uid, 'pick', staff, ports) : undefined;
    default: return;
  }
}

function showRecent(chatId, uid, staff, ports) {
  var items = recentItems(ports, staff.role === 'owner' ? null : staff.shop, 5);
  var last = getLastItem(ports, uid);
  if (last && !items.some(function (it) { return it.id === last.id; })) items.unshift(last);
  if (!items.length) return ports.chat.sendMessage(chatId, t(ports, 'recent_none'));
  return showChoices(chatId, items.slice(0, 6), t(ports, 'recent_title') + '\n', ports);
}

/* ------------------------------ ☰ 📦 the restock loop (round 6b, G3) ------------------------------ */

/**
 * The loop inside a state, or null (pure): {n (counts saved so far), step ('tag' | 'qty'), itemId, msgId (the loop's
 * live prompt: the ask, the count screen or its ✏️ prompt; null in a state written before it was kept)}. Two shapes: the
 * restock_loop state itself, and the ✏️ count prompt of its count screen (await_number / restock_qty with loop = n).
 */
function restockLoopOf(state) {
  if (!state) return null;
  if (state.kind === 'restock_loop') return { n: state.n || 0, step: state.step, itemId: state.itemId || '', msgId: state.msgId || null };
  if (state.kind === 'await_number' && state.purpose === 'restock_qty' && !nullish(state.loop)) {
    return { n: state.loop, step: 'qty', itemId: state.itemId, msgId: state.msgId || null };
  }
  return null;
}

/**
 * The loop ends where the seller moved on (a menu tap, 🛒, a one-of-a-kind scan): the state and the rl: mark of its
 * latest count screen both go, so a later tap on that screen is an item card's restock again.
 */
function restockLoopEnd(ports, uid) {
  clearState(ports, uid);
  ports.cache.remove('rl:' + uid);
}

/**
 * A typed count at the loop's count screen or its ✏️ prompt (pure): the text is a number on its own (digits or Burmese
 * digits, with thousands commas or a decimal point, or number words such as ငါး), with ထည် after it or not; else null.
 * A text with anything else in it (a tag such as S1-5, a sentence, a phone number) is never the count.
 */
function restockCountOf(text) {
  var s = String(text === null || text === undefined ? '' : text).trim().replace(/\s*ထည်$/, '');
  if (!s) return null;
  if (/^[0-9၀-၉][0-9၀-၉,]*(\.[0-9၀-၉]+)?$/.test(s)) {
    var v = Number(s.replace(/[၀-၉]/g, function (c) { return String(MY_DIGITS.indexOf(c)); }).replace(/,/g, ''));
    return isNaN(v) ? null : v;
  }
  var nums = parseBurmeseNumbers(s);
  return nums.length === 1 && nums[0].index === 0 && nums[0].end >= s.length ? nums[0].value : null;
}

/**
 * A typed tag inside the loop (pure): a shop id of CFG.SHOP_IDS and one to four digits ('S1-5', 's1 0005'; F10b: any
 * configured shop) -> that tag id; with digitsOk (the ask), bare digits too: the staff's shop (else the first shop) and
 * four digits, as the app's tag keypad composes it. Else ''. At the count screen bare digits are the count, never a tag.
 */
function restockTagOf(text, staff, digitsOk) {
  var s = String(text === null || text === undefined ? '' : text).trim();
  var num = function (x) { return Number(String(x).replace(/[၀-၉]/g, function (c) { return String(MY_DIGITS.indexOf(c)); })); };
  var pad = function (x) { return ('0000' + num(x)).slice(-4); };
  var shops = CFG.SHOP_IDS.slice().sort(function (a, b) { return String(b).length - String(a).length; });
  for (var i = 0; i < shops.length; i++) {
    var sid = String(shops[i]);
    if (s.slice(0, sid.length).toUpperCase() !== sid.toUpperCase()) continue;
    var rest = s.slice(sid.length).replace(/^[\s-]+/, '');
    if (/^[0-9၀-၉]{1,4}$/.test(rest)) return sid + '-' + pad(rest);
  }
  if (digitsOk && /^[0-9၀-၉]{1,4}$/.test(s)) return ((staff && staff.shop) || CFG.SHOP_IDS[0]) + '-' + pad(s);
  return '';
}

/**
 * Ask for the next tag: the loop armed at step tag with n counts saved. Before any save the way out is ✖️ (Z); after a
 * save it is ✅ ပြီးပြီ (RT|done), and the text names it exactly then. prefix (a refusal) goes on top. msgId -> that
 * message is edited into the ask, else a new message. The ask is the loop's live prompt (state.msgId).
 */
function restockAsk(chatId, msgId, uid, staff, ports, n, prefix) {
  n = n || 0;
  var text = withPrefix(prefix, t(ports, n > 0 ? 'restock_more' : 'restock_ask_tag'));
  var kb = n > 0 ? [[btn(t(ports, 'btn_restock_done'), 'RT|done')]] : [[btn(t(ports, 'btn_cancel'), 'Z')]];
  var r = msgId ? ports.chat.editMessage(chatId, msgId, text, kb, false) : ports.chat.sendMessage(chatId, text, kb);
  setState(ports, uid, { kind: 'restock_loop', step: 'tag', n: n, msgId: (r && r.messageId) || msgId || null });
  return r;
}

/**
 * The loop at an item's count screen (a new message, group_item_line on top): the state restock_loop / qty with that
 * screen as its live prompt, and the rl: mark (CFG.STATE_TTL_SEC) that lets a tap on this screen carry on as the loop's
 * after the loop's own window ran out (counting a big bundle takes time).
 */
function restockLoopQty(chatId, uid, item, n, ports) {
  var r = restockQtyScreen(chatId, item, ports, t(ports, 'group_item_line', { id: item.id, name: item.name, stock: fmtCount(item.stock) }), true);
  var mid = (r && r.messageId) || null;
  setState(ports, uid, { kind: 'restock_loop', step: 'qty', itemId: item.id, n: n, msgId: mid });
  if (mid) ports.cache.put('rl:' + uid, JSON.stringify({ m: mid, id: item.id, n: n }), CFG.STATE_TTL_SEC);
  return r;
}

/**
 * A count at the loop's count screen (state restock_loop / qty), typed (restockCountOf) or spoken (handleIntent): a whole
 * 1..CFG.MAX_SALE_QTY saves (restockLoopSave); another number answers bad_qty and the count screen comes again, the loop
 * re-armed (180 s from that prompt); the item gone -> the ask with tag_not_found on top.
 */
function restockLoopCount(chatId, uid, state, n, staff, updateId, ports, source, transcript) {
  var item = ports.store.getItem(state.itemId);
  if (!item) return restockAsk(chatId, null, uid, staff, ports, state.n || 0, t(ports, 'tag_not_found', { id: state.itemId }));
  if (n >= 1 && n <= CFG.MAX_SALE_QTY && n === Math.round(n)) {
    return restockLoopSave(chatId, null, uid, state.n || 0, { item: item, qty: n, staff: staff, source: source, transcript: transcript,
      updateId: updateId }, false, staff, ports);
  }
  ports.chat.sendMessage(chatId, t(ports, 'bad_qty', { max: myDigits(CFG.MAX_SALE_QTY) }));
  return restockLoopQty(chatId, uid, item, state.n || 0, ports);
}

/**
 * The restock count screen of an item (a new message): the presets, ✏️ and ✖️. head goes on top. Outside the loop (an
 * item card's 📦, loop false) it is the screen of before round 6b byte for byte; in the loop ✖️ skips this tag (RT|skip)
 * and a last row 🛒 ရောင်းမယ် opens the item card (K|).
 */
function restockQtyScreen(chatId, item, ports, head, loop) {
  var id = item.id;
  var presets = CFG.RESTOCK_PRESETS.map(function (n) { return btn('+' + myDigits(n), 'RQ|' + id + '|' + n); });
  var kb = [presets, [btn(t(ports, 'btn_other'), 'RQ|' + id + '|other'), btn(t(ports, 'btn_cancel'), loop ? 'RT|skip' : 'Z')]];
  if (loop) kb.push([btn(t(ports, 'btn_restock_sell'), 'K|' + id)]);
  return ports.chat.sendMessage(chatId, withPrefix(head, t(ports, 'ask_restock_qty')), kb);
}

/**
 * A tag scanned or typed while the loop waits (openTag; lp from restockLoopOf). Refused (missing, blank, another shop's
 * tag of a seller): the refusal on top of the ask, the loop kept, nothing written. A one-of-a-kind piece ends the loop
 * and its item card comes (a scan for a sale or a look). Else the loop waits at that item's count screen.
 */
function restockLoopTag(chatId, uid, lp, itemId, staff, ports) {
  var add = basketAddItem(ports, staff, [], itemId, 1, { restock: true });
  if (!add.ok && add.reason === 'unique') {
    restockLoopEnd(ports, uid);
    ports.chat.sendMessage(chatId, t(ports, 'basket_unique', add.vars) + (lp.n > 0 ? '\n' + t(ports, 'restock_loop_done') : ''));
    return openTag(chatId, itemId, staff, uid, ports);
  }
  if (!add.ok) return restockAsk(chatId, null, uid, staff, ports, lp.n, t(ports, BASKET_REASON_KEY[add.reason] || 'expired', add.vars));
  var item = ports.store.getItem(itemId);
  setLastItem(ports, uid, item.id);
  return restockLoopQty(chatId, uid, item, lp.n, ports);
}

/**
 * A count of the loop (a preset tap, a number typed or spoken at the count screen or after ✏️, a confirmed restock
 * proposal of that piece): ONE RESTOCK group with its own ↩️ (commitRestock; p = its params). A tap edits the tapped
 * message into 'id · restock_done', a typed count (msgId null) is a new message; then the next ask as a new message,
 * n + 1 counts saved.
 */
function restockLoopSave(chatId, msgId, uid, n, p, isCaption, staff, ports) {
  var r = commitRestock(ports, p);
  var fresh = ports.store.getItem(p.item.id);
  setLastItem(ports, uid, p.item.id);
  ports.cache.remove('rl:' + uid);   // this count screen is answered: a later tap on it is an R| screen's again
  editOrSend(ports, chatId, msgId, p.item.id + ' · ' + t(ports, 'restock_done', { qty: fmtCount(p.qty), stock: fmtCount(fresh.stock) }),
    undoRow(ports, r.groupId), isCaption, { kind: 'group', id: r.groupId });
  return restockAsk(chatId, null, uid, staff, ports, n + 1, '');
}

/* ------------------------------ voice / text ------------------------------ */

function buildAiContext(ports, staff, uid) {
  var state = getState(ports, uid);
  var awaiting = null;
  if (state) {
    if (state.kind === 'new_item') awaiting = state.step;
    else if (state.kind === 'await_number' || state.kind === 'await_text') awaiting = state.purpose;
    else if (state.kind === 'notebook') awaiting = 'notebook_photo';
    else if (state.kind === 'find' || state.kind === 'find_customer') awaiting = state.kind;
    else if (state.step) awaiting = state.kind + '_' + state.step;     // credit_name, dep_note, exp_amount, cu_name
  }
  // The accounts of this staff member's shop as [KEY, label] pairs, CASH first (the shape expenseCategories has):
  // the model answers with the KEY of the account whose label it heard (core_ai_prompt.js aiContextText).
  var methods = payMethods(ports, staff.shop).map(function (k) { return [k, methodLabel(ports, k)]; });
  return {
    shop: staff.shop, staff: staff.name, item: getLastItem(ports, uid),
    awaiting: awaiting, categories: itemCategoryAi(ports, staff.shop).names, state: state,
    payMethods: methods, expenseCategories: expenseCategories(ports)
  };
}

function handleVoice(msg, staff, updateId, ports) {
  var chatId = msg.chat.id, uid = String(msg.from.id);
  // The owner's AI switch is off (round 6, F9b): no AI call; the buttons instead.
  if (!aiOn(ports)) return fallbackToButtons(chatId, uid, staff, ports, 'ai_off', '');
  ports.chat.typing(chatId);
  var ctx = buildAiContext(ports, staff, uid), intent;
  try {
    var file = ports.chat.getFile((msg.voice || msg.audio).file_id);
    intent = ports.ai.parseVoice(file, ctx);
  } catch (err) {
    ports.store.logError('voice', err, updateId, '');
    return fallbackToButtons(chatId, uid, staff, ports, 'ai_down', '');
  }
  return handleIntent(intent, msg, staff, updateId, ports, CFG.SOURCE.VOICE, ctx);
}

function handleText(msg, staff, updateId, ports) {
  var chatId = msg.chat.id, uid = String(msg.from.id), text = String(msg.text || '').trim();
  // A typed tag id or a pasted tag link (PC, USB scanner, torn tag) opens the card. No state, no AI.
  var tagId = tagIdFromText(text);
  if (tagId) return openTag(chatId, tagId, staff, uid, ports);
  // A typed voucher id (V1-2532) opens the order card the same way.
  if (ordersEnabled(ports) && isOrderId(text.toUpperCase())) return openOrderCard(chatId, text.toUpperCase(), staff, uid, ports);

  var state = getState(ports, uid);
  // Free-text states come before the number path: a phone number parses as a number and would become a price,
  // "AYA 2" would become the number 2, an account number would become an amount.
  if (state && state.kind === 'await_text') {
    if (state.purpose === 'phone') return savePhone(chatId, uid, state.customerId, text, staff, ports);
    if (state.purpose === 'exp_note') return attachExpenseNote(chatId, uid, state.groupId, text, staff, updateId, ports, CFG.SOURCE.TEXT, '');
    if (state.purpose === 'add_option') return finishAddOption(chatId, uid, state, text, staff, updateId, ports, CFG.SOURCE.TEXT);
    if (state.purpose === 'list_detail') return saveListDetail(chatId, uid, state, text, staff, ports);
  }
  var n = parseNumberText(text);

  if (state) {
    // Telegram's ☰ 📦 loop (round 6b): a typed tag (a shop id and digits; at the ask also bare digits, the shop and four
    // digits) opens that tag, the loop taking it as the next one; at the count screen and its ✏️ prompt only a number on
    // its own is the count (restockCountOf), and any other text (a mistyped tag, a sentence, a phone number) goes on to
    // the model as today's text does, never as a count of the piece on screen.
    var lpx = restockLoopOf(state);
    if (lpx) {
      var lTag = restockTagOf(text, staff, lpx.step === 'tag');
      if (lTag) return openTag(chatId, lTag, staff, uid, ports);
      if (lpx.step === 'qty') {
        var lCount = restockCountOf(text);
        if (lCount !== null && state.kind === 'await_number') return applyAwaitedNumber(chatId, uid, state, lCount, staff, updateId, ports, CFG.SOURCE.TEXT, text);
        if (lCount !== null) return restockLoopCount(chatId, uid, state, lCount, staff, updateId, ports, CFG.SOURCE.TEXT, text);
        n = null;
      }
    }
    // The review card or a sub-screen that takes a typed answer (a buyer search, a name, a phone, a date, a count, an
    // amount, a piece's name): before the number path, because a phone number parses as a number.
    if (state.kind === 'sale' && saleText(saleCtx(chatId, uid, staff, updateId, ports), state, text)) return true;
    // The new-piece card (form mode): a name before the number path; a price, cost or count as a number.
    if (state.kind === 'new_item' && state.form && state.step !== 'photo' && newItemText(chatId, uid, state, text, n, staff, ports)) return true;
    if (state.kind === 'find') {
      clearState(ports, uid);
      return showFindResults(chatId, staff, text, ports);
    }
    if (state.kind === 'find_customer') {
      clearState(ports, uid);
      return showCustomerFind(chatId, staff, text, ports);
    }
    if (n !== null && state.kind === 'new_item' && (state.step === 'price' || state.step === 'cost')) {
      return state.step === 'price' ? newItemPrice(chatId, null, uid, state.itemId, n, staff, ports)
        : newItemCost(chatId, null, uid, state.itemId, n, staff, ports);
    }
    if (n !== null && state.kind === 'await_number') {
      return applyAwaitedNumber(chatId, uid, state, n, staff, updateId, ports, CFG.SOURCE.TEXT, text);
    }
    if (n !== null && state.kind === 'exp' && state.step === 'amount') return expenseAmount(chatId, null, uid, state, n, staff, ports);
    if (state.kind === 'credit' && state.step === 'name') return creditNamed(chatId, uid, state, text, staff, updateId, ports);
    if (state.kind === 'dep' && state.step === 'name') return depositNamed(chatId, uid, state, text, staff, ports);
    if (state.kind === 'dep' && state.step === 'note') {
      return finishDeposit(chatId, null, uid, state.customerId, state.amount, text, staff, updateId, ports, CFG.SOURCE.TEXT, text, null);
    }
    if (state.kind === 'cu' && state.step === 'name') return attachNamed(chatId, uid, state, text, staff, updateId, ports);
    // Who is measured: a typed name (orderStateText does the same where the order module is on; the app has the form only).
    if (text && state.kind === 'meas_pick' && measureEnabled(ports)) return measPickNamed(chatId, uid, state, text, staff, ports) || true;
    if (ordersEnabled(ports)) {
      var handled = orderStateText(chatId, uid, state, text, n, null, staff, updateId, ports);
      if (handled) return handled;
    }
  }

  // The owner's AI switch is off (round 6, F9b): free text reaches no AI; the buttons instead.
  if (!aiOn(ports)) return fallbackToButtons(chatId, uid, staff, ports, 'ai_off', '');
  ports.chat.typing(chatId);
  var ctx = buildAiContext(ports, staff, uid), intent;
  try {
    intent = ports.ai.parseText(text, ctx);
  } catch (err) {
    ports.store.logError('text', err, updateId, text);
    return fallbackToButtons(chatId, uid, staff, ports, 'ai_down', '');
  }
  return handleIntent(intent, msg, staff, updateId, ports, CFG.SOURCE.TEXT, ctx);
}

function applyAwaitedNumber(chatId, uid, state, n, staff, updateId, ports, source, transcript) {
  clearState(ports, uid);
  var sctx = saleCtx(chatId, uid, staff, updateId, ports);   // the review card: a typed answer has no tapped message
  switch (state.purpose) {
    case 'sale_price': {
      if (state.saved) return basketLineNumber(sctx, state, 'price', n);
      var item = ports.store.getItem(state.itemId);
      if (!item) return ports.chat.sendMessage(chatId, t(ports, 'tag_not_found', { id: state.itemId }));
      if (saleFlow(ports) === CFG.SALE_FLOW.FORM) {
        if (!(Math.round(n) >= 1)) {
          setState(ports, uid, state);
          return ports.chat.sendMessage(chatId, t(ports, 'ask_sale_price'), [[btn(t(ports, 'btn_cancel'), 'Z')]]);
        }
        return startSaleFor(sctx, item, 1, { unitPrice: Math.round(n), priceChanged: true });
      }
      var r = commitSale(ports, { item: item, qty: 1, unitPrice: n, note: 'spoken price', staff: staff, source: source, transcript: transcript, updateId: updateId });
      var fresh = ports.store.getItem(item.id);
      setLastItem(ports, uid, item.id);
      setLastGroup(ports, uid, r.groupId);
      return sendView(ports, chatId, soldText(ports, fresh, 1, r), afterSaleKeyboard(ports, r.groupId), saleSoldView(ports, r.groupId, ''));
    }
    case 'sale_qty': {
      if (state.saved) return basketLineNumber(sctx, state, 'qty', n);
      var itq = ports.store.getItem(state.itemId);
      if (!itq) return ports.chat.sendMessage(chatId, t(ports, 'tag_not_found', { id: state.itemId }));
      if (n < 1 || n > CFG.MAX_SALE_QTY || n !== Math.round(n)) {
        setState(ports, uid, state);
        return ports.chat.sendMessage(chatId, t(ports, 'bad_qty', { max: myDigits(CFG.MAX_SALE_QTY) }), [[btn(t(ports, 'btn_cancel'), 'Z')]]);
      }
      if (saleFlow(ports) === CFG.SALE_FLOW.FORM) return startSaleFor(sctx, itq, n, {});
      var rq = commitSale(ports, { item: itq, qty: n, staff: staff, source: source, transcript: transcript, updateId: updateId });
      var fq = ports.store.getItem(itq.id);
      setLastItem(ports, uid, itq.id);
      setLastGroup(ports, uid, rq.groupId);
      return sendView(ports, chatId, soldText(ports, fq, n, rq), afterSaleKeyboard(ports, rq.groupId), saleSoldView(ports, rq.groupId, ''));
    }
    case 'restock_qty': {
      var item2 = ports.store.getItem(state.itemId);
      if (!nullish(state.loop)) {
        // ✏️ inside the ☰ 📦 loop (round 6b): a whole 1..999 saves and offers the next tag; another number is asked again.
        if (!item2) return restockAsk(chatId, null, uid, staff, ports, state.loop, t(ports, 'tag_not_found', { id: state.itemId }));
        if (n >= 1 && n <= CFG.MAX_SALE_QTY && n === Math.round(n)) {
          return restockLoopSave(chatId, null, uid, state.loop, { item: item2, qty: n, staff: staff, source: source, transcript: transcript,
            updateId: updateId }, false, staff, ports);
        }
        // The re-ask is the loop's live prompt now: its ✖️ (RT|skip) is the one that acts.
        var bq = ports.chat.sendMessage(chatId, t(ports, 'bad_qty', { max: myDigits(CFG.MAX_SALE_QTY) }), [[btn(t(ports, 'btn_cancel'), 'RT|skip')]]);
        state.msgId = (bq && bq.messageId) || state.msgId || null;
        setState(ports, uid, state);
        return bq;
      }
      if (!item2) return ports.chat.sendMessage(chatId, t(ports, 'tag_not_found', { id: state.itemId }));
      var r2 = commitRestock(ports, { item: item2, qty: n, staff: staff, source: source, transcript: transcript, updateId: updateId });
      var fresh2 = ports.store.getItem(item2.id);
      return sendView(ports, chatId, t(ports, 'restock_done', { qty: fmtCount(n), stock: fmtCount(fresh2.stock) }), undoRow(ports, r2.groupId), { kind: 'group', id: r2.groupId });
    }
    case 'credit_paid': return askCreditCustomer(chatId, null, uid, state.groupId, n, staff, ports);
    case 'pay_amount': return commitPaymentAndReply(chatId, null, state.groupId, n, staff, updateId, ports, source, transcript, null, uid);
    case 'dep_amount': return askDepositNote(chatId, null, uid, state.customerId, n, staff, ports);
    case 'exp_amount': return expenseAmount(chatId, null, uid, state, n, staff, ports);
    case 'set_price': return applyPrice(chatId, null, state.itemId, n, staff, ports);
    // The account part of a split sale, typed or spoken (the state was cleared above; a bad amount sets it again).
    case 'split_bank': return finishSplit(chatId, null, uid, state, n, staff, updateId, ports, source);
    // The review card's transfer part (step bank) or amount now (step paid), typed or spoken; the basket rides in saved.
    case 'sale_step': return state.saved ? saleNumber(sctx, state.saved, n, source, transcript) : undefined;
    case 'order_price': case 'order_qty': case 'order_advance': case 'deliver_paid':
      return ordersEnabled(ports) ? orderAwaitedNumber(chatId, uid, state, n, staff, updateId, ports) : undefined;
    default: return;
  }
}

/**
 * A typed or spoken count or price for the open line of the review card (the prompt of qn / pr; the state was cleared by
 * applyAwaitedNumber). Refused (a count outside 1..999, a price below 1): the prompt again with the line's ⏮, the state set
 * again. Accepted: the line takes it and the card comes back as a new message.
 */
function basketLineNumber(ctx, prompt, what, n) {
  var ports = ctx.ports, state = prompt.saved, item = ports.store.getItem(state.item);
  var l = state.draft.lines[basketLineIndex(state.draft, state.line)];
  if (!item || !l) return ports.chat.sendMessage(ctx.chatId, t(ports, 'expired'));
  var v = Math.round(Number(n));
  var bad = what === 'qty' ? !(Number(n) === v && v >= 1 && v <= CFG.MAX_SALE_QTY) : !(v >= 1);
  if (bad) {
    var m = ports.chat.sendMessage(ctx.chatId, what === 'qty' ? t(ports, 'bad_qty', { max: myDigits(CFG.MAX_SALE_QTY) }) : t(ports, 'ask_sale_price'),
      [saleBackRow(ports, item, 'line')]);
    state.msgId = m && m.messageId ? m.messageId : state.msgId;
    state.cap = false;
    setState(ports, ctx.uid, prompt);
    return;
  }
  if (what === 'qty') l.qty = v;
  else { l.unitPrice = v; l.priceChanged = true; }
  return saleGo(ctx, state, 'card', '');
}

function handleIntent(intent, msg, staff, updateId, ports, source, ctx) {
  var chatId = msg.chat.id, uid = String(msg.from.id);
  var heard = intent && intent.transcript ? t(ports, 'heard', { transcript: intent.transcript }) + '\n' : '';
  var I = CFG.INTENT, state = ctx.state;
  var transcript = intent && intent.transcript ? String(intent.transcript) : '';
  var spokenName = intent ? (intent.customer || intent.item_hint || transcript) : '';

  // ➕ is waiting for the name of a new option: the transcript is the name, whatever the model made of it. Unless the
  // note clearly is a sale, an expense, a payment, a deposit, a transfer or an order: then the add state gives way
  // (the state it was tapped in comes back) and the note is handled as if ➕ had not been tapped, so a spoken sale
  // is never turned into an account name.
  if (state && transcript && state.kind === 'await_text' && state.purpose === 'add_option') {
    if (!isMoneyIntent(intent)) return finishAddOption(chatId, uid, state, transcript, staff, updateId, ports, source);
    if (sameAddState(getState(ports, uid), state)) {
      if (state.saved) setState(ports, uid, state.saved); else clearState(ports, uid);
    }
    state = state.saved || null;
  }

  // States that wait for free text take the transcript as it is, whatever the model made of it.
  if (state && transcript) {
    // The review card's text steps: a spoken name, phone or date lands in the sub-screen it was spoken in.
    if (state.kind === 'sale' && !state.paused) {
      var sctxT = saleCtx(chatId, uid, staff, updateId, ports), sItemT = ports.store.getItem(state.item);
      if (sItemT && (state.step === 'buyer' || state.step === 'name')) return saleBuyerNamed(sctxT, state, sItemT, intent.customer || transcript) || true;
      if (sItemT && state.step === 'phone' && normPhone(transcript).length >= 7) return salePhoneTyped(sctxT, state, sItemT, normPhone(transcript)) || true;
      if (sItemT && state.step === 'due_text') return saleDueTyped(sctxT, state, sItemT, transcript) || true;
    }
    if (state.kind === 'await_text' && state.purpose === 'list_detail') {
      // An account number is typed, never spoken (a spoken number arrives as words): ask again, save nothing.
      var acct = listOption(ports, state.list, state.key);
      return ports.chat.sendMessage(chatId, heard + t(ports, 'acct_ask_detail', { label: acct ? acct.label : state.key }), [[btn(t(ports, 'btn_cancel'), 'Z')]]);
    }
    if (state.kind === 'await_text' && state.purpose === 'phone') {
      var digits = normPhone(transcript);
      if (digits.length >= 7) return savePhone(chatId, uid, state.customerId, digits, staff, ports);
      var cph = ports.store.getCustomer(state.customerId);
      return ports.chat.sendMessage(chatId, heard + t(ports, 'ask_phone', { customer: cph ? cph.name : '' }), [[btn(t(ports, 'btn_skip'), 'Z')]]);
    }
    if (state.kind === 'await_text' && state.purpose === 'exp_note') {
      return attachExpenseNote(chatId, uid, state.groupId, intent.note || transcript, staff, updateId, ports, source, transcript);
    }
    if (state.kind === 'find_customer') {
      clearState(ports, uid);
      return showCustomerFind(chatId, staff, intent.customer || transcript, ports);
    }
    if (state.kind === 'credit' && state.step === 'name') return creditNamed(chatId, uid, state, spokenName, staff, updateId, ports);
    if (state.kind === 'dep' && state.step === 'name') return depositNamed(chatId, uid, state, spokenName, staff, ports);
    if (state.kind === 'cu' && state.step === 'name') return attachNamed(chatId, uid, state, spokenName, staff, updateId, ports);
    if (state.kind === 'dep' && state.step === 'note') {
      return finishDeposit(chatId, null, uid, state.customerId, state.amount, intent.note || transcript, staff, updateId, ports, source, transcript,
        methodKeyFor(ports, intent.method, staff.shop) || null);
    }
    // Who is measured: a spoken name (as orderStateText does where the order module is on).
    if (state.kind === 'meas_pick' && measureEnabled(ports)) return measPickNamed(chatId, uid, state, intent.customer || transcript, staff, ports) || true;
    // Orders and measurements: a spoken name, design, fabric, description, date or measurement value.
    if (ordersEnabled(ports)) {
      var heardOrder = orderStateText(chatId, uid, state, transcript, null, intent, staff, updateId, ports);
      if (heardOrder) return heardOrder;
    }
  }

  if (!intent || !intent.intent || intent.intent === I.UNKNOWN || Number(intent.confidence || 0) < CFG.MIN_CONFIDENCE) {
    return fallbackToButtons(chatId, uid, staff, ports, 'not_understood', heard);
  }
  var spokenMoney = firstNumber([intent.unit_price, intent.amount]);

  // Telegram's ☰ 📦 loop (round 6b), by voice as by typing: at its count screen (or the ✏️ prompt) a spoken count is that
  // tag's count, at its ask a spoken number is a tag number (the shop and four digits). Only a restock or a bare number
  // (RESTOCK, NEW_ITEM_INFO) reads so, and a restock naming another piece does not (it is proposed as before). Typed text
  // reaches the model here only when it was no count (handleText), so it is never made one.
  var lpv = source === CFG.SOURCE.VOICE ? restockLoopOf(state) : null;
  if (lpv && (intent.intent === I.RESTOCK || intent.intent === I.NEW_ITEM_INFO)) {
    if (lpv.step === 'qty') {
      var lvItem = ports.store.getItem(lpv.itemId), lvq = firstNumber([intent.qty, intent.amount]), lvOther = false;
      if (lvItem && intent.item_hint) {
        var lvRes = resolveItem(ports, staff, lvItem, intent.item_hint);
        lvOther = !lvRes.item || lvRes.item.id !== lvItem.id;
      }
      if (lvq !== null && !lvOther) {
        if (state.kind === 'await_number') return applyAwaitedNumber(chatId, uid, state, lvq, staff, updateId, ports, source, transcript);
        return restockLoopCount(chatId, uid, state, lvq, staff, updateId, ports, source, transcript);
      }
    } else if (lpv.step === 'tag' && intent.intent === I.NEW_ITEM_INFO && !intent.item_hint) {
      var lvt = firstNumber([intent.qty, intent.unit_price, intent.amount]);
      if (lvt !== null && lvt >= 1 && lvt <= 9999 && lvt === Math.round(lvt)) return openTag(chatId, restockTagOf(String(lvt), staff, true), staff, uid, ports);
    }
  }

  // Multi-step flows waiting for a number accept it from voice too.
  if (state && state.kind === 'new_item' && (state.step === 'price' || state.step === 'cost')) {
    var v = state.step === 'cost' ? firstNumber([intent.amount, intent.unit_price]) : spokenMoney;
    if (v !== null) {
      return state.step === 'price' ? newItemPrice(chatId, null, uid, state.itemId, v, staff, ports)
        : newItemCost(chatId, null, uid, state.itemId, v, staff, ports);
    }
  }
  // (The loop's ✏️ prompt took its count above; another kind of note there is not read as a count.)
  if (state && state.kind === 'await_number' && !restockLoopOf(state)) {
    var wantsQty = state.purpose === 'restock_qty' || state.purpose === 'sale_qty';
    var w = wantsQty ? firstNumber([intent.qty, intent.amount, intent.unit_price]) : spokenMoney;
    // The split asks for the account part; "ငွေသား ငါးထောင်" (the model says CASH) is the cash part.
    if (w !== null && state.purpose === 'split_bank' && intent.method && methodKeyFor(ports, intent.method, staff.shop) === CFG.METHOD.CASH) {
      w = splitBankFromCash(ports, state.groupId, w);
    }
    // The review card's transfer part (step bank): a spoken cash part is converted to the account part the same way.
    if (w !== null && state.purpose === 'sale_step' && state.saved && state.saved.step === 'bank' && intent.method &&
        methodKeyFor(ports, intent.method, staff.shop) === CFG.METHOD.CASH) {
      w = saleBankFromCash(ports, state.saved, w);
    }
    if (w !== null) return applyAwaitedNumber(chatId, uid, state, w, staff, updateId, ports, source, transcript);
  }
  // The review card's number steps: a spoken count goes to the open line, a spoken amount to the how-much-now screen.
  if (state && state.kind === 'sale' && !state.paused && (state.step === 'line' || state.step === 'paid')) {
    var sctxN = saleCtx(chatId, uid, staff, updateId, ports), sItemN = ports.store.getItem(state.item);
    var sn = state.step === 'line' ? firstNumber([intent.qty, intent.amount]) : spokenMoney;
    if (sItemN && sn !== null) {
      return (state.step === 'line' ? saleQtyTyped(sctxN, state, sItemN, sn) : saleNumber(sctxN, state, sn, source, transcript)) || true;
    }
  }
  if (state && state.kind === 'exp' && state.step === 'amount' && spokenMoney !== null) {
    return expenseAmount(chatId, null, uid, state, spokenMoney, staff, ports);
  }
  // A spoken price, quantity or advance while an order screen waits for one.
  if (state && state.kind === 'order' && ORDER_NUMBER_STEPS[state.step] && ordersEnabled(ports)) {
    var on = state.step === 'qty' ? firstNumber([intent.qty, intent.amount, intent.unit_price]) : spokenMoney;
    if (on !== null) return orderAwaitedNumber(chatId, uid, { purpose: ORDER_NUMBER_STEPS[state.step], orderId: state.orderId, saved: state }, on, staff, updateId, ports);
  }

  // A basket is live: a spoken or typed sale (restock, return, transfer) of one of its pieces would be a second entry
  // beside the card, and a method would rewrite the previous committed sale, not this one. Neither is proposed: the live
  // screen comes back as a new message, so the answer is a tap (voice in the card stays the routing lines above).
  var liveSale = saleStateOf(ports, uid);
  if (liveSale && saleIntentClashes(ports, staff, ctx.item, intent, liveSale)) {
    return saleResend(saleCtx(chatId, uid, staff, updateId, ports), liveSale, heard);
  }

  // The model answers with a KEY of pay_methods, or with the name it heard: both become the key of an account the
  // lists know (core_ledger.js methodKeyFor). A method nobody knows is dropped: the row is then cash, as before.
  var method = intent.method ? (methodKeyFor(ports, intent.method, staff.shop) || null) : null;
  var common = { source: source, transcript: transcript, updateId: updateId, note: intent.note || '', method: method };

  switch (intent.intent) {
    case I.SALE: case I.RESTOCK: case I.RETURN: case I.TRANSFER: {
      var res = resolveItem(ports, staff, ctx.item, intent.item_hint);
      if (res.choices) return showChoices(chatId, res.choices, heard, ports);
      if (!res.item) return ports.chat.sendMessage(chatId, heard + t(ports, 'scan_first'));
      var p = merge(common, { kind: intent.intent, itemId: res.item.id, qty: intent.qty || 1,
        unitPrice: nullish(intent.unit_price) ? null : intent.unit_price,
        amount: nullish(intent.amount) ? null : intent.amount,
        paid: intent.intent === I.SALE && !nullish(intent.paid) ? intent.paid : null,
        customer: intent.intent === I.SALE && intent.customer ? intent.customer : null });
      return propose(chatId, uid, p, heard, ports);
    }
    case I.EXPENSE: {
      var eAmount = firstNumber([intent.amount, intent.unit_price]);
      if (!eAmount) return ports.chat.sendMessage(chatId, heard + t(ports, 'need_amount'));
      // The spoken category maps to a key; unknown words keep the reason in the note so nothing is lost.
      var catKey = expenseCategoryKey(ports, intent.category || intent.note || '');
      var eNote = String(intent.note || '').trim();
      if (eNote && normName(eNote) === normName(categoryLabel(ports, catKey))) eNote = '';
      if (!eNote && catKey === 'other' && intent.category) eNote = String(intent.category);
      var pe = merge(common, { kind: I.EXPENSE, amount: eAmount, shop: staff.shop, category: catKey, note: eNote });
      return propose(chatId, uid, pe, heard, ports);
    }
    case I.PAYMENT: {
      var amount = firstNumber([intent.amount, intent.unit_price]);
      if (!amount) return ports.chat.sendMessage(chatId, heard + t(ports, 'need_amount'));
      var cands = openCredits(ports, staff.role === 'owner' ? null : staff.shop);
      if (intent.customer) cands = cands.filter(function (c) { return nameMatch(c.customer, intent.customer); });
      if (!cands.length) return showPayList(chatId, staff, ports, heard + t(ports, 'pay_no_credit', { customer: intent.customer || '?' }) + '\n');
      var pick = cands.length === 1 ? cands[0] : (cands.filter(function (c) { return c.owed === amount; })[0] || null);
      if (!pick) return ports.chat.sendMessage(chatId, heard + t(ports, 'pay_list'), creditButtons(cands.slice(0, 5)));
      return propose(chatId, uid, merge(common, { kind: I.PAYMENT, groupId: pick.groupId, amount: Math.min(amount, pick.owed), customerId: pick.customerId }), heard, ports);
    }
    case I.DEPOSIT: {
      var dAmount = firstNumber([intent.amount, intent.unit_price]);
      if (!dAmount) return ports.chat.sendMessage(chatId, heard + t(ports, 'need_amount'));
      if (!intent.customer) return startDeposit(chatId, uid, staff, ports, dAmount, heard);
      return propose(chatId, uid, merge(common, { kind: I.DEPOSIT, customer: intent.customer, amount: dAmount, note: intent.note || '' }), heard, ports);
    }
    case I.METHOD: {
      // "Wave နဲ့ ပေးသွားတယ်": how the last committed money row was paid.
      if (!method || !methodKnown(ports, method)) return fallbackToButtons(chatId, uid, staff, ports, 'not_understood', heard);
      var lg = getLastGroup(ports, uid);
      if (!lg) return ports.chat.sendMessage(chatId, heard + t(ports, 'method_nothing', { method: methodLabel(ports, method) }));
      var chk = rewriteCheck(ports, lg);
      if (!chk.ok) return ports.chat.sendMessage(chatId, heard + rewriteRefusal(ports, chk.reason));
      return propose(chatId, uid, merge(common, { kind: I.METHOD, groupId: lg }), heard, ports);
    }
    case I.QUERY: {
      if (intent.note === 'stock') {
        var rq = resolveItem(ports, staff, ctx.item, intent.item_hint);
        if (rq.item) return ports.chat.sendMessage(chatId, heard + t(ports, 'stock_query', { name: rq.item.name, stock: fmtCount(rq.item.stock) }));
        if (rq.choices) return showChoices(chatId, rq.choices, heard, ports);
        return ports.chat.sendMessage(chatId, heard + t(ports, 'scan_first'));
      }
      return answerToday(chatId, staff, ports, heard);
    }
    case I.ORDER: {
      // "ဒေါ်မြင့် ဝမ်းဆက် တစ်ထည် အော်ဒါ၊ စရံ တစ်သိန်း": confirm, then the new-order flow pre-filled (nothing is written before the tap).
      if (!ordersEnabled(ports)) return fallbackToButtons(chatId, uid, staff, ports, 'not_understood', heard);
      var draft = { designHint: intent.item_hint || '', qty: intent.qty || null, unitPrice: nullish(intent.unit_price) ? null : intent.unit_price,
                    advance: firstNumber([intent.amount]) };
      if (!intent.customer) return startNewOrder(chatId, uid, staff, ports, draft, heard);
      return propose(chatId, uid, merge(common, { kind: I.ORDER, customer: intent.customer, draft: draft }), heard, ports);
    }
    case I.NEW_ITEM_INFO: {
      if (!(state && state.kind === 'new_item')) return fallbackToButtons(chatId, uid, staff, ports, 'not_understood', heard);
      if (state.form && state.step !== 'photo') {
        // The new-piece card (form mode): a spoken name is the name; the card comes back.
        if (intent.item_hint) state.draft.name = String(intent.item_hint).trim().slice(0, 60);
        return newItemCardShow(chatId, null, uid, state, staff, ports, heard.replace(/\n+$/, ''));
      }
      if (intent.item_hint) { state.draft.name = intent.item_hint; setState(ports, uid, state); }
      return ports.chat.sendMessage(chatId, heard + t(ports, state.step === 'photo' ? 'new_tag' : 'ask_' + state.step, { id: state.itemId }));
    }
    default:
      return fallbackToButtons(chatId, uid, staff, ports, 'not_understood', heard);
  }
}

function nameMatch(a, b) {
  var x = normName(a), y = normName(b);
  return !!x && !!y && (x === y || x.indexOf(y) >= 0 || y.indexOf(x) >= 0);
}

function resolveItem(ports, staff, lastItem, hint) {
  var h = String(hint || '').trim();
  if (lastItem && (!h || String(lastItem.name).indexOf(h) >= 0 || h.indexOf(String(lastItem.category)) >= 0)) return { item: lastItem };
  if (h) {
    var ranked = rankItemsByName(ports, staff.shop, h);
    if (ranked.length === 1 || (ranked.length > 1 && ranked[0].score > ranked[1].score)) return { item: ranked[0].it };
    if (ranked.length > 1) return { choices: ranked.slice(0, 5).map(function (x) { return x.it; }) };
  }
  if (lastItem) return { item: lastItem };
  return {};
}

function showChoices(chatId, items, heard, ports) {
  var rows = items.map(function (it) { return [btn(itemEmoji(ports, it) + ' ' + it.id + ' · ' + it.name, 'K|' + it.id)]; });
  return ports.chat.sendMessage(chatId, heard + t(ports, 'which_item'), rows);
}

function showFindResults(chatId, staff, text, ports) {
  var found = findItemsByName(ports, staff.shop, text);
  if (!found.length && staff.role === 'owner') found = findItemsByName(ports, null, text);
  if (!found.length) return ports.chat.sendMessage(chatId, t(ports, 'find_none'));
  return showChoices(chatId, found.slice(0, 5), '', ports);
}

function fallbackToButtons(chatId, uid, staff, ports, key, prefix) {
  ports.chat.sendMessage(chatId, (prefix || '') + t(ports, key));
  var last = getLastItem(ports, uid);
  if (last) sendItemCard(chatId, last, staff, ports);
}

function answerToday(chatId, staff, ports, prefix) {
  var day = dayKey(ports.clock.now());
  var shops = staff.role === 'owner' ? CFG.SHOP_IDS : [staff.shop];
  var lines = shops.map(function (shop) {
    var s = dayStats(ports, shop, day);
    return t(ports, 'today_query', { shop: shopName(ports, shop), revenue: fmtMoney(s.revenue), pieces: fmtCount(s.pieces),
      cash: fmtMoney(s.cashIn), expenses: fmtMoney(s.expenses), profit: fmtMoney(s.profit),
      drawer: fmtMoney(s.drawerNet), bank: fmtMoney(s.bankNet) });
  });
  var todayText = (prefix || '') + lines.join('\n\n'), tx = viewOf(ports, { kind: 'today' });
  return tx ? ports.chat.sendMessage(chatId, todayText, [], tx) : ports.chat.sendMessage(chatId, todayText);
}

/* ------------------------------ proposals ------------------------------ */

function propose(chatId, uid, p, heard, ports) {
  var token = ports.uuid().replace(/-/g, '').slice(0, 10);
  ports.cache.put('cf:' + token, JSON.stringify(p), CFG.CONFIRM_TTL_SEC);
  return ports.chat.sendMessage(chatId, heard + describeProposal(ports, p) + '\n' + t(ports, 'confirm_ask'),
    [[btn(t(ports, 'btn_yes'), 'Y|' + token), btn(t(ports, 'btn_no'), 'N|' + token)]]);
}

function describeProposal(ports, p) {
  var I = CFG.INTENT, item = p.itemId ? ports.store.getItem(p.itemId) : null;
  var qty = Math.max(1, Number(p.qty) || 1);
  var mark = p.method && String(p.method).toUpperCase() !== CFG.METHOD.CASH ? t(ports, 'method_mark', { method: methodLabel(ports, p.method) }) : '';
  if (p.kind === I.SALE || p.kind === I.RETURN) {
    var unit = !nullish(p.unitPrice) ? p.unitPrice : (!nullish(p.amount) ? Math.round(p.amount / qty) : (Number(item.price) || 0));
    var text = t(ports, p.kind === I.SALE ? 'confirm_sale' : 'confirm_return', { qty: fmtCount(qty), name: item.name, amount: fmtMoney(qty * unit) });
    if (p.kind === I.SALE && (p.customer || !nullish(p.paid))) {
      text += t(ports, 'confirm_sale_credit', { paid: fmtMoney(nullish(p.paid) ? qty * unit : p.paid), customer: p.customer || '?' });
    }
    return text + mark;
  }
  if (p.kind === I.RESTOCK) return t(ports, 'confirm_restock', { qty: fmtCount(qty), name: item.name });
  if (p.kind === I.TRANSFER) return t(ports, 'confirm_transfer', { name: item.name, shop: shopName(ports, otherShop(item.shop)) });
  if (p.kind === I.EXPENSE) {
    return t(ports, 'confirm_expense', { amount: fmtMoney(p.amount), cat: categoryLabel(ports, p.category), note: p.note ? ' · ' + p.note : '',
      method: methodLabel(ports, p.method || CFG.METHOD.CASH), shop: shopName(ports, p.shop) });
  }
  if (p.kind === I.PAYMENT) {
    var info = saleGroupInfo(ports, p.groupId);
    return t(ports, 'confirm_payment', { customer: customerName(ports, p.customerId), amount: fmtMoney(p.amount), owed: fmtMoney(info ? info.owed - p.amount : 0) }) + mark;
  }
  if (p.kind === I.DEPOSIT) return t(ports, 'confirm_deposit', { customer: p.customer, amount: fmtMoney(p.amount), note: p.note ? ' · ' + p.note : '' }) + mark;
  if (p.kind === I.ORDER) {
    var dr = p.draft || {};
    return t(ports, 'confirm_order', { customer: p.customer, design: dr.designHint ? ' · 🎨 ' + dr.designHint : '',
      qty: dr.qty ? ' × ' + fmtCount(dr.qty) : '', advance: dr.advance ? ' · 📥 ' + fmtMoney(dr.advance) : '' });
  }
  if (p.kind === I.METHOD) {
    var live = groupRows(ports, p.groupId).live[0];
    return t(ports, 'method_voice', { method: methodLabel(ports, p.method), desc: describeRow(ports, live) });
  }
  return '';
}

function confirmProposal(chatId, msgId, isCaption, token, staff, uid, updateId, ports) {
  var edit = function (text, kb) { ports.chat.editMessage(chatId, msgId, text, kb || [], isCaption); };
  var pj = ports.cache.get('cf:' + token);
  if (!pj) return edit(t(ports, 'expired'));
  ports.cache.remove('cf:' + token);
  var p = JSON.parse(pj), I = CFG.INTENT;
  var base = { staff: staff, source: p.source, transcript: p.transcript, updateId: updateId, note: p.note, method: p.method || null };
  var item = p.itemId ? ports.store.getItem(p.itemId) : null;
  if ((p.kind === I.SALE || p.kind === I.RESTOCK || p.kind === I.RETURN || p.kind === I.TRANSFER) && !item) return edit(t(ports, 'tag_not_found', { id: p.itemId }));
  var r, fresh, text, kb, view = null;
  if (p.kind === I.SALE) {
    var customer = p.customer ? resolveOrCreateCustomer(ports, p.customer) : null;
    r = commitSale(ports, merge(base, { item: item, qty: p.qty, unitPrice: p.unitPrice, amount: p.amount, paid: p.paid, customerId: customer ? customer.id : '' }));
    fresh = ports.store.getItem(item.id);
    var info = saleGroupInfo(ports, r.groupId);
    text = t(ports, 'sold_done', { qty: fmtCount(p.qty || 1), amount: fmtMoney(r.txs[0].amount), stock: fmtCount(fresh.stock) });
    if (customer) text += '\n' + t(ports, 'credit_done', { customer: customer.name, paid: fmtMoney(info.cash), owed: fmtMoney(info.owed) });
    text += methodLine(ports, p.method);
    kb = afterSaleKeyboard(ports, r.groupId).concat(phoneRow(ports, customer));
    view = saleSoldView(ports, r.groupId, '');
    setLastGroup(ports, uid, r.groupId);
    // A basket holding this piece was live beside the proposal (spoken before the card started): it is closed, so its
    // card answers expired and the piece is never booked twice.
    var liveSale = saleStateOf(ports, uid);
    if (liveSale && basketHasItem(liveSale, item.id)) clearState(ports, uid);
  } else if (p.kind === I.RESTOCK) {
    // Said or typed at the ☰ 📦 loop's count screen of this very piece (round 6b): it is that tag's count, so the reply
    // carries the tag line and the loop goes on to the next tag (a bare number typed next is a tag, never a second count).
    var lpc = restockLoopOf(getState(ports, uid));
    if (lpc && lpc.step === 'qty' && lpc.itemId === item.id) {
      return restockLoopSave(chatId, msgId, uid, lpc.n, merge(base, { item: item, qty: p.qty || 1 }), isCaption, staff, ports);
    }
    r = commitRestock(ports, merge(base, { item: item, qty: p.qty }));
    fresh = ports.store.getItem(item.id);
    text = t(ports, 'restock_done', { qty: fmtCount(p.qty || 1), stock: fmtCount(fresh.stock) });
    kb = undoRow(ports, r.groupId);
    view = { kind: 'group', id: r.groupId };
  } else if (p.kind === I.RETURN) {
    r = commitReturn(ports, merge(base, { item: item, qty: p.qty, unitPrice: p.unitPrice, amount: p.amount }));
    fresh = ports.store.getItem(item.id);
    text = t(ports, 'return_done', { qty: fmtCount(p.qty || 1), amount: fmtMoney(-r.txs[0].amount), stock: fmtCount(fresh.stock) }) + methodLine(ports, p.method);
    kb = replyKeyboard(ports, r.groupId);
    setLastGroup(ports, uid, r.groupId);
  } else if (p.kind === I.TRANSFER) {
    r = commitTransfer(ports, merge(base, { item: item }));
    text = t(ports, 'transfer_done', { id: item.id, shop: shopName(ports, otherShop(item.shop)) });
    kb = undoRow(ports, r.groupId);
  } else if (p.kind === I.EXPENSE) {
    r = commitExpense(ports, merge(base, { amount: p.amount, shop: p.shop || staff.shop, category: p.category }));
    text = t(ports, 'expense_done', { amount: fmtMoney(p.amount), cat: categoryLabel(ports, p.category), note: p.note ? ' · ' + p.note : '',
      method: methodLabel(ports, methodOf(r.txs[0])) });
    kb = replyKeyboard(ports, r.groupId);
    setLastGroup(ports, uid, r.groupId);
    view = { kind: 'group', id: r.groupId };
  } else if (p.kind === I.PAYMENT) {
    return commitPaymentAndReply(chatId, msgId, p.groupId, p.amount, staff, updateId, ports, p.source, p.transcript, p.method, uid);
  } else if (p.kind === I.DEPOSIT) {
    var c = resolveOrCreateCustomer(ports, p.customer);
    return finishDeposit(chatId, msgId, uid, c.id, p.amount, p.note || '', staff, updateId, ports, p.source, p.transcript, p.method);
  } else if (p.kind === I.ORDER) {
    if (!ordersEnabled(ports)) return edit(t(ports, 'not_understood'));
    edit(describeProposal(ports, p));
    var os = { kind: 'order', step: 'customer', draft: p.draft || {}, uid: uid };
    setState(ports, uid, os);
    return orderNamed(chatId, uid, os, p.customer, staff, ports);
  } else if (p.kind === I.METHOD) {
    var liveRow = groupRows(ports, p.groupId).live[0];
    if (liveRow && methodOf(liveRow) !== String(p.method).toUpperCase()) {
      var rm = rewriteGroup(ports, p.groupId, { method: p.method }, staff, updateId, { source: p.source, transcript: p.transcript, noteIfBlank: 'method' });
      if (!rm.ok) return edit(rewriteRefusal(ports, rm.reason));
      liveRow = rm.row;
    }
    if (!liveRow) return edit(t(ports, 'expired'));
    setLastGroup(ports, uid, p.groupId);
    return edit(describeRow(ports, liveRow) + '\n' + t(ports, 'method_done', { method: methodLabel(ports, p.method) }), replyKeyboard(ports, p.groupId));
  } else {
    return edit(t(ports, 'not_understood'));
  }
  if (item) setLastItem(ports, uid, item.id);
  if (view) return editOrSend(ports, chatId, msgId, text, kb, isCaption, view);
  return edit(text, kb);
}

/* ------------------------------ payment method ------------------------------ */

/** PM|group|KEY: rewrite the group's one cash row with the new method; the card keeps its text and buttons. */
function changeMethod(chatId, msgId, isCaption, groupId, key, staff, uid, updateId, ports, message) {
  var edit = function (text, kb) { ports.chat.editMessage(chatId, msgId, text, kb || [], isCaption); };
  var base = stripMethodLines((message && (message.caption || message.text)) || '');
  var join = function (line) { return base ? base + '\n' + line : line; };
  key = String(key || '').toUpperCase();
  // Any account the lists know, a retired one included: the button of an old card stays valid.
  if (!methodKnown(ports, key)) return edit(join(t(ports, 'expired')), replyKeyboard(ports, groupId));
  var chk = rewriteCheck(ports, groupId);
  if (!chk.ok) return edit(join(rewriteRefusal(ports, chk.reason)), replyKeyboard(ports, groupId));
  if (methodOf(chk.row) !== key) {
    var r = rewriteGroup(ports, groupId, { method: key }, staff, updateId, { noteIfBlank: 'method' });
    if (!r.ok) return edit(join(rewriteRefusal(ports, r.reason)), replyKeyboard(ports, groupId));
  }
  setLastGroup(ports, uid, groupId);
  var mText = join(t(ports, 'method_done', { method: methodLabel(ports, key) })), mKb = replyKeyboard(ports, groupId);
  var mx = viewOf(ports, methodReplyView(ports, groupId));
  return mx ? ports.chat.editMessage(chatId, msgId, mText, mKb, isCaption, mx) : edit(mText, mKb);
}

/**
 * The view a card keeps in the app after its method changed (13.9): a sale's sold view, an expense's, a payment's or a
 * deposit's group view; any other group none (its text, as before).
 */
function methodReplyView(ports, groupId) {
  var live = groupRows(ports, groupId).live[0], T = CFG.TX;
  if (!live) return null;
  if (live.type === T.SALE) return saleSoldView(ports, groupId, '');
  if (live.type === T.EXPENSE || live.type === T.PAYMENT || live.type === T.DEPOSIT) return { kind: 'group', id: groupId };
  return null;
}

/** Drop an earlier "🏦 ... မှတ်ပြီး" line so a second method tap does not stack them. */
function stripMethodLines(text) {
  return String(text || '').split('\n').filter(function (l) { return l.indexOf('🏦 ') !== 0; }).join('\n');
}

/**
 * The method of a committed group after ➕ added (or found) the account key: the PM tap without a tapped
 * message. One new message: prefix, the row, "paid with ...", the buttons of the group (plus the hint row).
 * A refusal is the same one message with the reason instead.
 */
function resumeMethod(chatId, uid, groupId, key, staff, updateId, ports, source, prefix, hint) {
  var refuse = function (reason) {
    return ports.chat.sendMessage(chatId, withHintLine(withPrefix(prefix, rewriteRefusal(ports, reason)), hint), withHintRow(replyKeyboard(ports, groupId), hint));
  };
  key = String(key || '').toUpperCase();
  if (!methodKnown(ports, key)) return refuse('method');
  var chk = rewriteCheck(ports, groupId);
  if (!chk.ok) return refuse(chk.reason);
  var row = chk.row;
  if (methodOf(row) !== key) {
    var r = rewriteGroup(ports, groupId, { method: key }, staff, updateId, { source: source, noteIfBlank: 'method' });
    if (!r.ok) return refuse(r.reason);
    row = r.row;
  }
  setLastGroup(ports, uid, groupId);
  var text = describeRow(ports, row) + '\n' + t(ports, 'method_done', { method: methodLabel(ports, key) });
  return ports.chat.sendMessage(chatId, withHintLine(withPrefix(prefix, text), hint), withHintRow(replyKeyboard(ports, groupId), hint));
}

/* ------------------------------ one sale, part cash and part into one account ------------------------------ */

/**
 * Can this group be split? {ok, row} for a rewritable group whose live row is a SALE with cash paid;
 * {ok: false, reason} otherwise (the rewriteCheck reasons, or 'type').
 */
function splitGuard(ports, groupId) {
  var chk = rewriteCheck(ports, groupId);
  if (!chk.ok) return { ok: false, reason: chk.reason };
  if (chk.row.type !== CFG.TX.SALE || !(chk.row.cash > 0)) return { ok: false, reason: 'type' };
  return { ok: true, row: chk.row };
}

/**
 * A split question (or its typed answer) that cannot go on: the row it was about, when one is still live, and
 * the reason, with the buttons the group still has. Edits the question, or sends when there is none.
 */
function splitRefuse(chatId, msgId, groupId, reason, ports, prefix) {
  var live = groupRows(ports, groupId).live;
  var row = live.filter(function (r) { return r.type === CFG.TX.SALE; })[0] || live[0] || null;
  var text = (row ? describeRow(ports, row) + '\n' : '') + rewriteRefusal(ports, reason);
  return editOrSend(ports, chatId, msgId, withPrefix(prefix, text), replyKeyboard(ports, groupId));
}

/**
 * SX|group on a sale card. The card is a committed entry and stays as it is (text, undo, receipt): the question
 * is a new message, so its cancel button only cancels the question. A sale already marked with an account is
 * split with that account; otherwise one account is used at once and several are offered as buttons.
 */
function startSplit(chatId, msgId, isCaption, uid, groupId, staff, ports, message) {
  var g = splitGuard(ports, groupId);
  if (!g.ok) return refuseOnCard(chatId, msgId, isCaption, groupId, rewriteRefusal(ports, g.reason), ports, message);
  var row = g.row, was = methodOf(row);
  if (was !== CFG.METHOD.CASH) return sendSplitAmount(chatId, null, uid, groupId, was, ports, '');
  var banks = payMethods(ports, row.shop).filter(function (k) { return k !== CFG.METHOD.CASH; });
  if (!banks.length) {
    return ports.chat.sendMessage(chatId, t(ports, 'split_no_bank'),
      [[btn(t(ports, 'btn_add_bank'), 'LA|pm|SXM|' + groupId), btn(t(ports, 'btn_cancel'), 'Z')]]);
  }
  if (banks.length === 1) return sendSplitAmount(chatId, null, uid, groupId, banks[0], ports, '');
  var rows = methodRows(ports, row.shop, CFG.METHOD.CASH, function (k) { return 'SXM|' + groupId + '|' + k; }, { add: 'LA|pm|SXM|' + groupId });
  rows.push([btn(t(ports, 'btn_cancel'), 'Z')]);
  return ports.chat.sendMessage(chatId, t(ports, 'split_ask_bank', { cash: fmtMoney(row.cash) }), rows);
}

/**
 * SXM|group|KEY, and the amount screen wherever it is reached from: how much of the payment went into the account
 * KEY (the rest is cash). The state waits for a number (in the app the keypad opens by itself); "all" and "half"
 * are buttons. Edits the question it was tapped on; a new message when there is none (SX straight to it, ➕ resumed).
 */
function sendSplitAmount(chatId, msgId, uid, groupId, key, ports, prefix) {
  key = String(key || '').toUpperCase();
  var g = splitGuard(ports, groupId), reason = g.ok ? '' : g.reason;
  // Cash plus ONE account: a sale already marked with an account can only be split with that account.
  if (g.ok && (key === CFG.METHOD.CASH || !methodKnown(ports, key) ||
               (methodOf(g.row) !== CFG.METHOD.CASH && methodOf(g.row) !== key))) reason = 'method';
  if (reason) return splitRefuse(chatId, msgId, groupId, reason, ports, prefix);
  setState(ports, uid, { kind: 'await_number', purpose: 'split_bank', groupId: groupId, method: key });
  var cash = g.row.cash, half = Math.round(cash / 2);
  var text = t(ports, 'split_ask_amount', { method: methodLabel(ports, key), cash: fmtMoney(cash) });
  // A button whose callback data would exceed 64 bytes is skipped (a sale marked by voice with an account whose
  // hand-typed key is very long): the amount can still be typed.
  var amounts = [];
  [['all', 'btn_all', cash], ['half', 'btn_half', half]].forEach(function (a) {
    var data = 'SXA|' + groupId + '|' + key + '|' + a[0];
    if (utf8ByteLength(data) <= 64) amounts.push(btn(t(ports, a[1], { amount: fmtMoney(a[2]) }), data));
  });
  var kb = (amounts.length ? [amounts] : []).concat([[btn(t(ports, 'btn_cancel'), 'Z')]]);
  return editOrSend(ports, chatId, msgId, withPrefix(prefix, text), kb);
}

/**
 * The split is known: SXA|group|KEY|all or half (msgId = the tapped question), or a typed or spoken amount
 * (msgId null; applyAwaitedNumber cleared the state before calling). state = the split_bank state.
 * amount = 'all', 'half' or a number. A number outside 1..cash keeps the state and asks again.
 * The reply names the row from the ledger (never the text of the tapped message): the sale, the two parts,
 * how to correct it, and the buttons the group has now (undo and receipt; 💰 while something is owed).
 */
function finishSplit(chatId, msgId, uid, state, amount, staff, updateId, ports, source) {
  var groupId = state.groupId, key = String(state.method || '').toUpperCase();
  var g = splitGuard(ports, groupId);
  if (!g.ok) {
    clearSplitState(ports, uid, groupId);
    return splitRefuse(chatId, msgId, groupId, g.reason, ports, '');
  }
  var cash = g.row.cash, bank;
  if (amount === 'all') bank = cash;
  else if (amount === 'half') bank = Math.round(cash / 2);
  else if (typeof amount === 'number') {
    bank = amount;
    if (!(bank >= 1) || bank > cash || bank !== Math.round(bank)) {
      setState(ports, uid, state);
      return ports.chat.sendMessage(chatId, t(ports, 'split_bad', { max: fmtMoney(cash) }), [[btn(t(ports, 'btn_cancel'), 'Z')]]);
    }
  } else {
    clearSplitState(ports, uid, groupId);
    return splitRefuse(chatId, msgId, groupId, 'amount', ports, '');
  }
  clearSplitState(ports, uid, groupId);
  var r = splitSale(ports, groupId, bank, key, staff, updateId, source);
  if (!r.ok) return splitRefuse(chatId, msgId, groupId, r.reason, ports, '');
  var sale = groupRows(ports, groupId).live.filter(function (x) { return x.type === CFG.TX.SALE; })[0] || null;
  var lines = [];
  if (sale) lines.push(describeRow(ports, sale));
  if (r.full) {
    lines.push(t(ports, 'method_done', { method: methodLabel(ports, key) }));
  } else {
    lines.push(t(ports, 'split_done', { cash: fmtMoney(r.cashPart), cashMethod: methodLabel(ports, r.cashMethod),
      bank: fmtMoney(r.bankPart), method: methodLabel(ports, key) }));
    // Undo counts from the sale's own time (the rewritten row keeps it): later only the owner can reverse it.
    var ageMin = sale ? (ports.clock.now().getTime() - new Date(sale.time).getTime()) / 60000 : 0;
    lines.push(t(ports, ageMin <= CFG.UNDO_WINDOW_MIN ? 'split_hint' : 'split_hint_late'));
  }
  setLastGroup(ports, uid, groupId);
  return editOrSend(ports, chatId, msgId, lines.join('\n'), replyKeyboard(ports, groupId));
}

/**
 * The split of this group is answered: its waiting state goes. Only that state: an SXA tapped on an older amount
 * screen while the seller is in another flow (an expense, an order) leaves that flow alone. On the typed and spoken
 * path applyAwaitedNumber has already cleared it.
 */
function clearSplitState(ports, uid, groupId) {
  var cur = getState(ports, uid);
  if (cur && cur.kind === 'await_number' && cur.purpose === 'split_bank' && cur.groupId === groupId) clearState(ports, uid);
}

/**
 * The split question asks for the ACCOUNT part. A spoken answer that names cash ("ငွေသား ငါးထောင်": the model
 * answers method CASH) gives the cash part instead: the account part is the rest. A cash part that leaves nothing
 * for the account (or is all of it) is no split: -1, which finishSplit answers with split_bad, the state kept.
 */
function splitBankFromCash(ports, groupId, cashPart) {
  var g = splitGuard(ports, groupId);
  if (!g.ok) return cashPart;   // finishSplit refuses it anyway
  var n = Math.round(Number(cashPart));
  if (!(n >= 1) || n >= g.row.cash || n !== Number(cashPart)) return -1;
  return g.row.cash - n;
}

/* ------------------------------ bank accounts: the list and an account's number ------------------------------ */

/** The accounts a staff member works with: the active pay_method options of their shop (owner: every shop), CASH left out. */
function accountRows(ports, staff) {
  return listOptions(ports, 'pay_method', staff.role === 'owner' ? null : staff.shop)
    .filter(function (r) { return r.key !== CFG.METHOD.CASH; });
}

/**
 * M|acct: every account with its number (— while none is stored). One 🔢 button per account, those without a
 * number first, then the others (to correct a wrong number), eight in all; then ➕ new bank and cancel.
 */
function accountsScreen(ports, staff) {
  var rows = accountRows(ports, staff), lines = [t(ports, 'acct_title')], kb = [];
  if (!rows.length) lines.push(t(ports, 'acct_none'));
  rows.forEach(function (r) { lines.push(t(ports, 'acct_line', { label: r.label, detail: r.detail || '—' })); });
  var ordered = rows.filter(function (r) { return !r.detail; }).concat(rows.filter(function (r) { return !!r.detail; }));
  ordered.forEach(function (r) {
    var data = 'LD|pm|' + r.key;
    if (kb.length >= 8 || utf8ByteLength(data) > 64) return;
    kb.push([btn(t(ports, 'btn_acct_detail', { label: r.label }), data)]);
  });
  kb.push([btn(t(ports, 'btn_add_bank'), 'LA|pm|AC'), btn(t(ports, 'btn_cancel'), 'Z')]);
  return { text: lines.join('\n'), kb: kb };
}

function sendAccounts(chatId, staff, ports, prefix) {
  var scr = accountsScreen(ports, staff);
  return ports.chat.sendMessage(chatId, withPrefix(prefix, scr.text), scr.kb);
}

/**
 * LD|pm|KEY (any staff member): ask for the account's number. A new message with a cancel button (the button may
 * sit under a committed card). The answer is typed: it is read before the number path in handleText.
 */
function askListDetail(chatId, uid, code, key, staff, ports) {
  var list = Object.prototype.hasOwnProperty.call(CFG.LIST_CODES, String(code)) ? CFG.LIST_CODES[code] : '';
  var row = list === 'pay_method' ? listOption(ports, list, key) : null;
  if (!row || row.key === CFG.METHOD.CASH) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
  if (!ports.store.addListOption) return ports.chat.sendMessage(chatId, t(ports, 'add_unavailable'));
  setState(ports, uid, { kind: 'await_text', purpose: 'list_detail', list: list, key: row.key });
  return ports.chat.sendMessage(chatId, t(ports, 'acct_ask_detail', { label: row.label }), [[btn(t(ports, 'btn_cancel'), 'Z')]]);
}

/** The typed number of an account: stored through setListDetail; the reply shows what is stored now, then the accounts. */
function saveListDetail(chatId, uid, state, text, staff, ports) {
  var row = listOption(ports, state.list, state.key);
  var r = setListDetail(ports, state.list, state.key, text);
  if (!r.ok) {
    if (r.reason === 'empty' && row) {
      return ports.chat.sendMessage(chatId, t(ports, 'acct_ask_detail', { label: row.label }), [[btn(t(ports, 'btn_cancel'), 'Z')]]);
    }
    clearState(ports, uid);
    return ports.chat.sendMessage(chatId, t(ports, r.reason === 'unavailable' ? 'add_unavailable' : 'expired'));
  }
  clearState(ports, uid);
  ports.chat.sendMessage(chatId, t(ports, 'acct_detail_saved', { label: row ? row.label : state.key, detail: r.detail }));
  return sendAccounts(chatId, staff, ports, '');
}

/* ------------------------------ ➕ adding a missing option where it is needed ------------------------------ */

// What a ➕ button resumes once the name is known, and the list its option goes to. PM is tapped under the card
// of a committed entry (never edited); every other one sits on a question screen, which becomes the prompt.
var ADD_RESUME_LIST = { PM: 'pay_method', EM: 'pay_method', SXM: 'pay_method', ODM: 'pay_method', OXM: 'pay_method',
  AC: 'pay_method', EC: 'expense_category', OF: 'fabric', SSA: 'pay_method', NIC: 'item_category' };
// Intents that are money or stock, never the name of an option.
var ADD_YIELD_INTENTS = { SALE: 1, RETURN: 1, RESTOCK: 1, EXPENSE: 1, PAYMENT: 1, DEPOSIT: 1, TRANSFER: 1, ORDER: 1 };

/**
 * Does the note clearly make an entry, so the add state gives way? A money intent the model is sure about AND that
 * carries what the entry needs: a number for a sale, return, restock, expense, payment or deposit, a number or an
 * item for a transfer, a customer for an order. A category name such as "ရေဖိုး" or "မီးဖိုး" reads like an
 * expense but has no amount: it stays the name of the new option.
 */
function isMoneyIntent(intent) {
  if (!intent || ADD_YIELD_INTENTS[intent.intent] !== 1 || Number(intent.confidence || 0) < CFG.MIN_CONFIDENCE) return false;
  var hasNumber = firstNumber([intent.amount, intent.unit_price, intent.qty]) !== null;
  if (intent.intent === CFG.INTENT.ORDER) return !!intent.customer;
  if (intent.intent === CFG.INTENT.TRANSFER) return hasNumber || !!intent.item_hint;
  return hasNumber;
}

/** The short code of a list inside callback data and message keys (pay_method -> pm). */
function listCodeOf(list) {
  for (var c in CFG.LIST_CODES) if (Object.prototype.hasOwnProperty.call(CFG.LIST_CODES, c) && CFG.LIST_CODES[c] === list) return c;
  return '';
}

/** Is cur (the state now in the cache) the add state that state was read from? Same list and same resume. */
function sameAddState(cur, state) {
  return !!cur && !!state && cur.kind === 'await_text' && cur.purpose === 'add_option' && state.purpose === 'add_option' &&
    cur.list === state.list && !!cur.resume && !!state.resume && cur.resume.a === state.resume.a;
}

/**
 * LA|<list code>|<resume>|<args...>: ask for the name of a new option. Not a committing action. In this order,
 * before anything is edited: an unknown code says expired; a store that cannot add options says so in a new
 * message (the tapped screen keeps its buttons, the state is untouched); a ➕ under a card that can no longer be
 * rewritten is refused like a method tap and asks no name. Then the state the user was in is kept inside the add
 * state (a second tap never nests an add state in an add state) and the prompt is shown: a new message for a
 * committed card (PM), an edit of the question screen for every other resume.
 */
function askAddOption(chatId, msgId, isCaption, uid, parts, staff, ports, message) {
  var code = String(parts[1] || ''), a = String(parts[2] || ''), args = parts.slice(3);
  var list = Object.prototype.hasOwnProperty.call(CFG.LIST_CODES, code) ? CFG.LIST_CODES[code] : '';
  var known = Object.prototype.hasOwnProperty.call(ADD_RESUME_LIST, a);
  if (!list || (known && ADD_RESUME_LIST[a] !== list)) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
  if (!ports.store.addListOption) return ports.chat.sendMessage(chatId, t(ports, 'add_unavailable'));
  if (a === 'PM' || a === 'SXM') {
    var g = a === 'SXM' ? splitGuard(ports, args[0]) : rewriteCheck(ports, args[0]);
    if (!g.ok) return refuseOnCard(chatId, msgId, isCaption, args[0], rewriteRefusal(ports, g.reason), ports, message);
  }
  if ((a === 'OF' || a === 'ODM' || a === 'OXM') && !ordersEnabled(ports)) {
    return ports.chat.editMessage(chatId, msgId, t(ports, 'expired'), [], isCaption);
  }
  // The question screen this ➕ sits on was already turned into a committed card (🏦 tapped, then ➕ before the redraw
  // reached the phone): the card is never edited into a question. Expired, as a new message; the card stays.
  if (known && a !== 'PM' && isCommittedCard(ports, chatId, msgId)) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
  var cur = getState(ports, uid);
  var saved = cur && cur.kind === 'await_text' && cur.purpose === 'add_option' ? (cur.saved || null) : (cur || null);
  var text = t(ports, 'add_ask_' + code), kb = [[btn(t(ports, 'btn_cancel'), 'Z')]];
  if (a === 'SSA') {
    // ➕ inside the guided sale (round 5): the prompt replaces the how-paid or account screen and carries that screen's
    // back row (never Z, which would cancel the sale); the sale state rides in saved. A stale screen reads expired.
    // The flow's stale-tap rules: no state, or an older screen -> expired (saleGuard answers); a ➕ that raced a redraw on
    // the live screen (the step moved on) -> ignored without an edit, as every other step tap (rule (c)).
    var sItem = ports.store.getItem(args[0]);
    if (!sItem) return ports.chat.editMessage(chatId, msgId, t(ports, 'expired'), [], isCaption);
    var sCtx = saleCtx(chatId, uid, staff, null, ports, msgId, isCaption);
    var sLive = saleGuard(sCtx, sItem, null, message);
    if (!sLive || (sLive.step !== 'method' && sLive.step !== 'account')) return;
    var se = ports.chat.editMessage(chatId, msgId, text, [saleBackRow(ports, sItem, sLive.step)], isCaption);
    sLive.msgId = saleShownId(sCtx, se);
    setState(ports, uid, { kind: 'await_text', purpose: 'add_option', list: list, resume: { a: a, args: args }, saved: sLive });
    return se;
  }
  if (a === 'NIC') {
    // ➕ on the new-piece card's category screen (round 6b, G2): the prompt replaces that screen and carries the card's
    // back row (never Z, which would drop the card); the card's state rides in saved. No card -> expired; a ➕ that raced
    // a redraw (the card left its category screen) -> ignored without an edit (rule (c)).
    var ns = newItemFormState(ports, uid, args[0]);
    if (!ns) return ports.chat.editMessage(chatId, msgId, t(ports, 'expired'), [], isCaption);
    if (ns.step !== 'cat') return;
    var ne = ports.chat.editMessage(chatId, msgId, text, [[btn(t(ports, 'btn_back'), 'NI|' + args[0] + '|back')]], false);
    ns.msgId = (ne && ne.messageId) || msgId || null;
    setState(ports, uid, { kind: 'await_text', purpose: 'add_option', list: list, resume: { a: a, args: args }, saved: ns });
    return ne;
  }
  setState(ports, uid, { kind: 'await_text', purpose: 'add_option', list: list, resume: { a: a, args: args }, saved: saved });
  if (known && a !== 'PM') return ports.chat.editMessage(chatId, msgId, text, kb, isCaption);
  return ports.chat.sendMessage(chatId, text, kb);
}

/**
 * A question screen (expense, delivery or refund method) that a committing tap has just edited into the card of the
 * entry. Remembered for ten minutes: a ➕ of the old screen can only be tapped before the redraw reaches the phone.
 */
function markCommittedCard(ports, chatId, msgId) {
  if (msgId) ports.cache.put('card:' + chatId + ':' + msgId, '1', 600);
}

function isCommittedCard(ports, chatId, msgId) {
  return !!msgId && !!ports.cache.get('card:' + chatId + ':' + msgId);
}

/**
 * The name of the new option arrived, typed (handleText) or spoken (handleIntent). state = the add state it was
 * read in. The option is added (or an option of that name is found), the state the user was in comes back and
 * the flow goes on with the option already chosen: ONE new message, "➕ ... added" in front of the usual reply
 * of that step (or of its refusal). When the add state is no longer the waiting one (in the app a voice note is
 * replayed later; the entry may have been finished by typing meanwhile) the option is still added but nothing
 * is restored and nothing is resumed.
 */
function finishAddOption(chatId, uid, state, text, staff, updateId, ports, source) {
  // Inside the guided sale nothing is written before the kind is known: the name is only looked up here.
  if (state.resume && state.resume.a === 'SSA') return saleAddNamed(chatId, uid, state, text, staff, updateId, ports);
  var waiting = sameAddState(getState(ports, uid), state), cancel = [[btn(t(ports, 'btn_cancel'), 'Z')]];
  // The new-piece card's ➕ (round 6b): its re-ask keeps the card's back row; the name goes through addItemCategory for the
  // item's shop (a name containing the sample word and a name the owner closed are refused, nothing written).
  var nic = !!state.resume && state.resume.a === 'NIC', nicId = nic ? String((state.resume.args || [])[0] || '') : '';
  if (nic) cancel = [[btn(t(ports, 'btn_back'), 'NI|' + nicId + '|back')]];
  var r;
  if (state.list === 'item_category') {
    var icItem = nicId ? ports.store.getItem(nicId) : null;
    r = addItemCategory(ports, text, staff, icItem ? icItem.shop : staff.shop);
  } else r = addListOptionByLabel(ports, state.list, text, staff);
  if (!r.ok) {
    if (r.reason === 'empty' || r.reason === 'sample' || r.reason === 'closed') {
      // Nothing usable (also a mistyped amount): ask again, the state stays. Without a waiting state there is nothing to ask for.
      if (!waiting) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
      var why = r.reason === 'sample' ? t(ports, 'add_ic_sample') : r.reason === 'closed' ? t(ports, 'add_ic_closed', { label: r.label }) : '';
      return ports.chat.sendMessage(chatId, withPrefix(why, t(ports, 'add_ask_' + listCodeOf(state.list))), cancel);
    }
    if (waiting) clearState(ports, uid);
    if (nic && waiting && state.saved && state.saved.kind === 'new_item') {
      return newItemCardShow(chatId, null, uid, state.saved, staff, ports, t(ports, 'add_unavailable'));
    }
    return ports.chat.sendMessage(chatId, t(ports, 'add_unavailable'));
  }
  var prefix = t(ports, r.created ? 'add_done' : 'add_exists', { label: r.label });
  if (!waiting) return ports.chat.sendMessage(chatId, prefix);
  if (state.saved) setState(ports, uid, state.saved); else clearState(ports, uid);
  var a = state.resume.a, args = state.resume.args || [], key = r.key, hint = null;
  // A new account has no number yet: the resumed message says where it will be printed and offers the 🔢 button.
  // Not on the split amount screen (the state waits for an amount) nor on the accounts screen (it has the button).
  if (r.created && state.list === 'pay_method' && (a === 'PM' || a === 'EM' || a === 'ODM' || a === 'OXM')) {
    hint = { line: t(ports, 'acct_detail_hint', { label: r.label }), row: [btn(t(ports, 'btn_acct_number'), 'LD|pm|' + key)] };
  }
  var orderResume = a === 'OF' || a === 'ODM' || a === 'OXM';
  if (orderResume && !ordersEnabled(ports)) return ports.chat.sendMessage(chatId, withPrefix(prefix, t(ports, 'expired')));
  switch (a) {
    case 'PM': return resumeMethod(chatId, uid, args[0], key, staff, updateId, ports, source, prefix, hint);
    case 'EM': return expenseMethod(chatId, null, uid, key, staff, updateId, ports, prefix, hint);
    case 'EC': return expenseCategory(chatId, null, uid, key, staff, ports, prefix);
    case 'SXM': return sendSplitAmount(chatId, null, uid, args[0], key, ports, prefix);
    case 'ODM': return deliverCommit(chatId, null, uid, args[0], Math.max(0, Math.round(Number(args[1]) || 0)), key, args[2], staff, updateId, ports, prefix, hint);
    case 'OXM': return cancelCommit(chatId, null, uid, args[0], 'refund', key, staff, updateId, ports, prefix, hint);
    case 'OF': return resumeFabric(chatId, uid, args[0], r.label, ports, prefix);
    case 'AC': return sendAccounts(chatId, staff, ports, prefix);
    case 'NIC': return newItemCatAdded(chatId, uid, args[0], r.label, staff, ports, prefix, r.key);
    default: return ports.chat.sendMessage(chatId, prefix);
  }
}

/* ------------------------------ customers ------------------------------ */

/**
 * A typed or spoken customer name: an exact name (or phone) match is used; a name nobody resembles
 * is created; look-alikes are offered as buttons together with "create this name", never merged
 * silently. mk(idOrCreate) builds the callback data. Returns the customer, or null after asking.
 */
function pickCustomer(chatId, uid, state, name, ports, mk) {
  name = String(name || '').trim();
  if (!name) { ports.chat.sendMessage(chatId, t(ports, 'ask_name')); return null; }
  var m = matchCustomers(ports, name);
  if (m.exact) return m.exact;
  if (!m.partial.length) return ports.store.addCustomer({ name: name });
  state.name = name;
  setState(ports, uid, state);
  var rows = m.partial.slice(0, 4).map(function (c) { return [btn(customerLabel(c), mk(c.id))]; });
  rows.push([btn(t(ports, 'btn_create_named', { name: name }), mk('create')), btn(t(ports, 'btn_cancel'), 'Z')]);
  ports.chat.sendMessage(chatId, t(ports, 'cust_pick', { name: name }), rows);
  return null;
}

function customerLabel(c) {
  return '👤 ' + c.name + (c.phone ? ' · ' + fmtPhone(c.phone) : '');
}

/** CU|group on a paid sale: pick who bought it. */
function startAttachCustomer(chatId, uid, groupId, staff, ports) {
  var chk = rewriteCheck(ports, groupId);
  if (!chk.ok) return ports.chat.sendMessage(chatId, rewriteRefusal(ports, chk.reason));
  setState(ports, uid, { kind: 'cu', groupId: groupId, step: 'customer' });
  var rows = recentCustomers(ports, staff.shop, 4).map(function (c) { return [btn('👤 ' + c.name, 'CUP|' + groupId + '|' + c.id)]; });
  rows.push([btn(t(ports, 'btn_new_customer'), 'CUP|' + groupId + '|new'), btn(t(ports, 'btn_cancel'), 'Z')]);
  return ports.chat.sendMessage(chatId, t(ports, 'credit_ask_customer'), rows);
}

function attachCustomerPick(chatId, msgId, uid, groupId, arg, staff, updateId, ports) {
  var state = getState(ports, uid);
  if (!state || state.kind !== 'cu' || state.groupId !== groupId) state = { kind: 'cu', groupId: groupId, step: 'customer' };
  if (arg === 'new') {
    state.step = 'name';
    setState(ports, uid, state);
    return ports.chat.sendMessage(chatId, t(ports, 'ask_name'));
  }
  var customerId = arg;
  if (arg === 'create') {
    if (!state.name) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
    customerId = ports.store.addCustomer({ name: state.name }).id;
  }
  return finishAttach(chatId, msgId, uid, groupId, customerId, staff, updateId, ports);
}

function attachNamed(chatId, uid, state, name, staff, updateId, ports) {
  var c = pickCustomer(chatId, uid, state, name, ports, function (x) { return 'CUP|' + state.groupId + '|' + x; });
  if (!c) return;
  return finishAttach(chatId, null, uid, state.groupId, c.id, staff, updateId, ports);
}

function finishAttach(chatId, msgId, uid, groupId, customerId, staff, updateId, ports) {
  clearState(ports, uid);
  var customer = ports.store.getCustomer(customerId);
  if (!customer) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
  var r = rewriteGroup(ports, groupId, { customerId: customerId }, staff, updateId, { noteIfBlank: 'customer' });
  if (!r.ok) return ports.chat.sendMessage(chatId, rewriteRefusal(ports, r.reason));
  var text = describeRow(ports, r.row) + '\n' + t(ports, 'cust_attached', { customer: customer.name });
  var kb = afterSaleKeyboard(ports, groupId).concat(phoneRow(ports, customer));
  var x = viewOf(ports, saleSoldView(ports, groupId, ''));   // the app: the sale's sold card again (13.9)
  if (msgId) return x ? ports.chat.editMessage(chatId, msgId, text, kb, false, x) : ports.chat.editMessage(chatId, msgId, text, kb, false);
  return x ? ports.chat.sendMessage(chatId, text, kb, x) : ports.chat.sendMessage(chatId, text, kb);
}

/** CF|custId: ask for the phone; the answer is read before the number path in handleText. */
function askPhone(chatId, uid, customerId, ports) {
  var c = ports.store.getCustomer(customerId);
  if (!c) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
  setState(ports, uid, { kind: 'await_text', purpose: 'phone', customerId: customerId });
  return ports.chat.sendMessage(chatId, t(ports, 'ask_phone', { customer: c.name }), [[btn(t(ports, 'btn_skip'), 'Z')]]);
}

/** Normalised to 09... when it looks like a Myanmar number; anything else is kept as typed, never refused. */
function savePhone(chatId, uid, customerId, text, staff, ports) {
  clearState(ports, uid);
  var c = ports.store.getCustomer(customerId);
  if (!c) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
  var valid = isValidPhone(text);
  var phone = valid ? normPhone(text) : String(text || '').trim();
  ports.store.updateCustomer(customerId, { phone: phone });
  if (valid) return ports.chat.sendMessage(chatId, t(ports, 'phone_saved', { customer: c.name, phone: fmtPhone(phone) }));
  return ports.chat.sendMessage(chatId, t(ports, 'phone_odd', { customer: c.name, phone: phone }), [[btn(t(ports, 'btn_phone'), 'CF|' + customerId)]]);
}

/** M|cust: the six most recent customers, search, cancel. In the app (round 6, revision 3): the buyers page. */
function showCustomers(chatId, uid, staff, ports) {
  if (screensInApp(ports)) {
    clearState(ports, uid);
    return ports.ui.openScreen('buyers', { chatId: chatId, uid: uid, staff: staff });
  }
  var list = recentCustomers(ports, staff.role === 'owner' ? null : staff.shop, CFG.CUST_MENU_RECENT);
  var rows = list.map(function (c) { return [btn(customerLabel(c), 'CH|' + c.id)]; });
  rows.push([btn(t(ports, 'btn_find'), 'M|cfind'), btn(t(ports, 'btn_cancel'), 'Z')]);
  return ports.chat.sendMessage(chatId, t(ports, 'cust_list'), rows);
}

function showCustomerFind(chatId, staff, text, ports) {
  var found = findCustomers(ports, text);
  if (!found.length) return ports.chat.sendMessage(chatId, t(ports, 'cust_none'));
  return ports.chat.sendMessage(chatId, t(ports, 'cust_list'), found.slice(0, 6).map(function (c) { return [btn(customerLabel(c), 'CH|' + c.id)]; }));
}

function customerLine(ports, r) {
  var desc = txLabel(r.type), label = itemLabel(ports, r);
  if (label && (r.itemId || r.type === CFG.TX.EXPENSE)) desc += ' ' + label;
  var paid = r.type === CFG.TX.SALE && r.cash !== r.amount ? t(ports, 'cust_line_paid', { paid: fmtMoney(r.cash) }) : '';
  var m = methodOf(r);
  return t(ports, 'cust_line', { day: fmtDayShortMy(r.day), desc: desc, amount: fmtMoney(r.amount), paid: paid, method: m ? ' · ' + methodLabel(ports, m) : '' });
}

/**
 * A customer's ledger history as entries, newest first, the first n (0 = all): {groupId, day, type, desc, name, amount,
 * cash, method, n, row}. The SALE rows of a basket (a group with more than one live SALE row, not a custom-order delivery)
 * are ONE entry (n = its lines, amount and cash summed, desc 'ရောင်း 🛍 {n} ခု', name = its first item's name, method = that
 * of the rows that carry cash); every other row is its own entry (n 1, row = the ledger row; name = its item's name, '' for
 * a row without an item). The structured twin of customerLines (the app's buyer page draws it).
 */
function customerRows(ports, customerId, n) {
  var rows = customerHistory(ports, customerId, 0), all = ports.store.ledgerRows(), out = [], done = {}, saleCount = {};
  var reversed = reversedIdSet(all);
  all.forEach(function (r) {
    if (r.type === CFG.TX.SALE && !r.reversesTxId && !reversed[r.txId]) saleCount[r.groupId] = (saleCount[r.groupId] || 0) + 1;
  });
  rows.forEach(function (r) {
    var basket = r.type === CFG.TX.SALE && saleCount[r.groupId] > 1 && !isOrderId(r.groupId);
    if (basket) {
      if (done['g:' + r.groupId]) return;
      done['g:' + r.groupId] = true;
      var lines = liveRows(all.filter(function (x) { return x.groupId === r.groupId && x.type === CFG.TX.SALE; }), all);
      var amount = 0, cash = 0, method = '';
      lines.forEach(function (x) { amount += x.amount; cash += x.cash; if (!method && x.cash) method = methodOf(x); });
      var first = ports.store.getItem(lines[0].itemId);
      out.push({ groupId: r.groupId, day: r.day, type: CFG.TX.SALE, desc: txLabel(CFG.TX.SALE) + ' ' + t(ports, 'basket_count', { n: fmtCount(lines.length) }),
        name: first ? first.name : lines[0].itemId, amount: amount, cash: cash, method: method, n: lines.length, row: null });
      return;
    }
    var desc = txLabel(r.type), label = itemLabel(ports, r);
    if (label && (r.itemId || r.type === CFG.TX.EXPENSE)) desc += ' ' + label;
    var it = r.itemId && r.type !== CFG.TX.PAYMENT && r.type !== CFG.TX.DEPOSIT_APPLIED ? ports.store.getItem(r.itemId) : null;
    out.push({ groupId: r.groupId, day: r.day, type: r.type, desc: desc, name: it ? it.name : '', amount: r.amount, cash: r.cash,
      method: methodOf(r), n: 1, row: r });
  });
  return n ? out.slice(0, n) : out;
}

/** customerRows as the customer card's lines (cust_line): a one-row entry is exactly customerLine of its row. */
function customerLines(ports, customerId, n) {
  return customerRows(ports, customerId, n).map(function (e) {
    if (e.row) return customerLine(ports, e.row);
    return t(ports, 'cust_line', { day: fmtDayShortMy(e.day), desc: e.desc, amount: fmtMoney(e.amount),
      paid: e.cash !== e.amount ? t(ports, 'cust_line_paid', { paid: fmtMoney(e.cash) }) : '', method: e.method ? ' · ' + methodLabel(ports, e.method) : '' });
  });
}

/** CH|custId: bought, paid, owed, deposit held, last visit, visits, the last lines, and the four actions. In the app: the buyer page. */
function customerCard(chatId, customerId, staff, ports) {
  if (screensInApp(ports)) return ports.ui.openScreen('buyer', { chatId: chatId, customerId: customerId, staff: staff });
  var c = ports.store.getCustomer(customerId);
  if (!c) return ports.chat.sendMessage(chatId, t(ports, 'cust_none'));
  var s = customerSummary(ports, customerId);
  var head = t(ports, 'cust_card', {
    name: c.name, phone: c.phone ? ' · ' + fmtPhone(c.phone) : '', bought: fmtMoney(s.bought), paid: fmtMoney(s.paid), owed: fmtMoney(s.owed),
    deposit: fmtMoney(s.depositHeld), last: s.lastDay ? fmtDayShortMy(s.lastDay) : '-', visits: myDigits(s.visits)
  });
  var lines = customerLines(ports, customerId, CFG.CUST_HISTORY_LINES);
  var text = head + '\n──────────\n' + (lines.length ? lines.join('\n') : t(ports, 'cust_no_rows'));
  var row1 = [];
  if (s.owed > 0) {
    var credits = openCredits(ports, null).filter(function (x) { return x.customerId === customerId; });
    row1.push(btn(t(ports, 'btn_pay'), credits.length === 1 ? 'PY|' + credits[0].groupId : 'PL|' + customerId));
  }
  row1.push(btn(t(ports, 'btn_deposit'), 'DC|' + customerId));
  var rows = [row1, [btn(t(ports, 'btn_phone'), 'CF|' + customerId), btn(t(ports, 'btn_statement'), 'CS|' + customerId)]];
  // 📏 the customer's measurements: the Telegram flow where the order module is on, the app's form there (spec 9.2).
  if (measureEnabled(ports) && utf8ByteLength('MS|' + customerId) <= 64) rows.push([btn(t(ports, 'btn_measure'), 'MS|' + customerId)]);
  return ports.chat.sendMessage(chatId, text, rows);
}

function sendCustomerStatement(chatId, customerId, staff, ports) {
  ports.chat.typing(chatId);
  var report = buildReport(ports, 'customer', { customerId: customerId, shop: staff.role === 'owner' ? null : staff.shop, now: ports.clock.now() });
  var doc = ports.pdf.make(report);
  return ports.chat.sendDocument(chatId, doc, t(ports, 'rep_caption', { title: report.title }));
}

/* ------------------------------ credit sales ------------------------------ */

function startCredit(chatId, uid, groupId, staff, ports) {
  var info = saleGroupInfo(ports, groupId);
  if (!info || info.voided) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
  var chk = rewriteCheck(ports, groupId);
  if (!chk.ok) return ports.chat.sendMessage(chatId, rewriteRefusal(ports, chk.reason));
  setState(ports, uid, { kind: 'credit', groupId: groupId, step: 'paid' });
  var half = Math.round(info.total / 2);
  return ports.chat.sendMessage(chatId, t(ports, 'credit_ask_paid', { total: fmtMoney(info.total) }), [
    [btn('0', 'CP|' + groupId + '|0'), btn(fmtMoney(half), 'CP|' + groupId + '|' + half), btn(t(ports, 'btn_other'), 'CP|' + groupId + '|other')],
    [btn(t(ports, 'btn_cancel'), 'Z')]
  ]);
}

function creditPaid(chatId, msgId, uid, groupId, arg, staff, ports) {
  var info = saleGroupInfo(ports, groupId);
  if (!info || info.voided) return ports.chat.editMessage(chatId, msgId, t(ports, 'expired'), [], false);
  if (arg === 'other') {
    setState(ports, uid, { kind: 'await_number', purpose: 'credit_paid', groupId: groupId });
    return ports.chat.editMessage(chatId, msgId, t(ports, 'ask_number'), [], false);
  }
  var paidNow = Math.max(0, Math.min(info.total, Number(arg) || 0));
  return askCreditCustomer(chatId, msgId, uid, groupId, paidNow, staff, ports);
}

function askCreditCustomer(chatId, msgId, uid, groupId, paidNow, staff, ports) {
  setState(ports, uid, { kind: 'credit', groupId: groupId, step: 'customer', paidNow: paidNow });
  var rows = recentCustomers(ports, staff.shop, 4).map(function (c) { return [btn('👤 ' + c.name, 'CC|' + groupId + '|' + c.id)]; });
  rows.push([btn(t(ports, 'btn_new_customer'), 'CC|' + groupId + '|new'), btn(t(ports, 'btn_cancel'), 'Z')]);
  var text = t(ports, 'credit_ask_customer');
  if (msgId) return ports.chat.editMessage(chatId, msgId, text, rows, false);
  return ports.chat.sendMessage(chatId, text, rows);
}

function creditCustomer(chatId, msgId, uid, groupId, arg, staff, updateId, ports) {
  var state = getState(ports, uid);
  if (!state || state.kind !== 'credit' || state.groupId !== groupId) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
  if (arg === 'new') {
    state.step = 'name';
    setState(ports, uid, state);
    return ports.chat.sendMessage(chatId, t(ports, 'ask_name'));
  }
  var customerId = arg;
  if (arg === 'create') {
    if (!state.name) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
    customerId = ports.store.addCustomer({ name: state.name }).id;
  }
  return finishCredit(chatId, msgId, uid, groupId, state.paidNow, customerId, staff, updateId, ports);
}

function creditNamed(chatId, uid, state, name, staff, updateId, ports) {
  var c = pickCustomer(chatId, uid, state, name, ports, function (x) { return 'CC|' + state.groupId + '|' + x; });
  if (!c) return;
  return finishCredit(chatId, null, uid, state.groupId, state.paidNow, c.id, staff, updateId, ports);
}

function finishCredit(chatId, msgId, uid, groupId, paidNow, customerId, staff, updateId, ports) {
  clearState(ports, uid);
  var customer = ports.store.getCustomer(customerId);
  if (!customer) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
  var r = convertSaleToCredit(ports, groupId, paidNow, customerId, staff, updateId);
  if (!r.ok) return ports.chat.sendMessage(chatId, rewriteRefusal(ports, r.reason));
  var info = saleGroupInfo(ports, r.groupId);
  var held = depositsFor(ports, customerId);
  var text = t(ports, 'credit_done', { customer: customer.name, paid: fmtMoney(info.cash), owed: fmtMoney(info.owed) });
  // view: the app's sold card of the sale (13.9); Telegram gets the calls of before.
  var send = function (txt, kb, view) {
    var x = viewOf(ports, view);
    if (msgId) { if (x) ports.chat.editMessage(chatId, msgId, txt, kb, false, x); else ports.chat.editMessage(chatId, msgId, txt, kb, false); }
    else if (x) ports.chat.sendMessage(chatId, txt, kb, x);
    else ports.chat.sendMessage(chatId, txt, kb);
  };
  var soldView = saleSoldView(ports, r.groupId, '');
  if (held > 0 && info.owed > 0) {
    var question = t(ports, 'credit_use_deposit', { customer: customer.name, deposit: fmtMoney(held) });
    soldView.extra = [question];
    return send(text + '\n' + question,
      [[btn(t(ports, 'btn_use_deposit'), 'CD|' + r.groupId + '|yes'), btn(t(ports, 'btn_no_deposit'), 'CD|' + r.groupId + '|no')]], soldView);
  }
  return send(text, afterSaleKeyboard(ports, r.groupId).concat(phoneRow(ports, customer)), soldView);
}

/**
 * CD|<g>|yes|no: use (or not) the buyer's held deposit against the credit. isCaption = the tapped message is a photo card
 * (the guided sale's sold card is one). plain (CD|<g>|yes|p[|<KEY>], the guided sale): the card is redrawn from the ledger
 * (saleCardText) with the plain rows, the 🔢 hint row for addedKey and the 📱 row; without it today's credit card.
 */
function creditDeposit(chatId, msgId, isCaption, groupId, arg, staff, updateId, ports, plain, addedKey) {
  var edit = function (text, kb) { ports.chat.editMessage(chatId, msgId, text, kb || [], !!isCaption); };
  var info = saleGroupInfo(ports, groupId);
  if (!info || info.voided) return edit(t(ports, 'expired'));
  var customer = customerName(ports, info.customerId);
  if (plain) {
    var cust = ports.store.getCustomer(info.customerId);
    // The sold card again (with the app's sold view, round 6, revision 3).
    var soldView = saleSoldView(ports, groupId, addedKey);
    if (arg !== 'yes') return editOrSend(ports, chatId, msgId, saleCardText(ports, groupId, addedKey), saleCardKeyboard(ports, groupId, addedKey, cust), isCaption, soldView);
    var rp = applyDeposit(ports, { groupId: groupId, customerId: info.customerId, staff: staff, source: CFG.SOURCE.BUTTON, updateId: updateId });
    var afterP = saleGroupInfo(ports, groupId);
    return editOrSend(ports, chatId, msgId, saleCardText(ports, groupId, addedKey) + '\n' + t(ports, 'deposit_applied', { amount: fmtMoney(rp ? rp.amount : 0), owed: fmtMoney(afterP.owed) }),
      saleCardKeyboard(ports, groupId, addedKey, cust), isCaption, soldView);
  }
  // The app: the sale's sold card again (13.9); Telegram: the edit of before.
  var editSold = function (text, kb) {
    var x = viewOf(ports, saleSoldView(ports, groupId, ''));
    return x ? ports.chat.editMessage(chatId, msgId, text, kb || [], !!isCaption, x) : edit(text, kb);
  };
  if (arg !== 'yes') return editSold(t(ports, 'credit_done', { customer: customer, paid: fmtMoney(info.cash), owed: fmtMoney(info.owed) }), afterSaleKeyboard(ports, groupId));
  var r = applyDeposit(ports, { groupId: groupId, customerId: info.customerId, staff: staff, source: CFG.SOURCE.BUTTON, updateId: updateId });
  var after = saleGroupInfo(ports, groupId);
  return editSold(t(ports, 'credit_done', { customer: customer, paid: fmtMoney(after.cash), owed: fmtMoney(after.owed) }) + '\n' +
    t(ports, 'deposit_applied', { amount: fmtMoney(r ? r.amount : 0), owed: fmtMoney(after.owed) }), afterSaleKeyboard(ports, groupId));
}

/* ------------------------------ payments ------------------------------ */

function creditButtons(credits) {
  return credits.map(function (c) { return [btn('👤 ' + c.customer + ' · ' + fmtMoney(c.owed) + ' · ' + fmtDayShortMy(c.day), 'PY|' + c.groupId)]; });
}

/** Open credits as buttons; customerId narrows the list to one person (from the customer card). */
function showPayList(chatId, staff, ports, prefix, customerId) {
  var credits = openCredits(ports, staff.role === 'owner' ? null : staff.shop);
  if (customerId) credits = credits.filter(function (c) { return c.customerId === customerId; });
  if (!credits.length) return ports.chat.sendMessage(chatId, (prefix || '') + t(ports, 'pay_none'));
  var rows = creditButtons(credits.slice(0, 8));
  rows.push([btn(t(ports, 'btn_cancel'), 'Z')]);
  return ports.chat.sendMessage(chatId, (prefix || '') + t(ports, 'pay_list'), rows);
}

function payPick(chatId, msgId, uid, groupId, staff, ports) {
  var info = saleGroupInfo(ports, groupId);
  if (!info || info.owed <= 0) return ports.chat.editMessage(chatId, msgId, t(ports, 'pay_none'), [], false);
  setState(ports, uid, { kind: 'await_number', purpose: 'pay_amount', groupId: groupId });
  var text = t(ports, 'pay_ask_amount', { customer: customerName(ports, info.customerId), owed: fmtMoney(info.owed) });
  var kb = [[btn(t(ports, 'btn_all', { amount: fmtMoney(info.owed) }), 'PA|' + groupId + '|all'), btn(t(ports, 'btn_other'), 'PA|' + groupId + '|other')],
            [btn(t(ports, 'btn_cancel'), 'Z')]];
  return ports.chat.sendMessage(chatId, text, kb);
}

function payAmount(chatId, msgId, uid, groupId, arg, staff, updateId, ports) {
  var info = saleGroupInfo(ports, groupId);
  if (!info || info.owed <= 0) return ports.chat.editMessage(chatId, msgId, t(ports, 'pay_none'), [], false);
  if (arg === 'other') {
    setState(ports, uid, { kind: 'await_number', purpose: 'pay_amount', groupId: groupId });
    return ports.chat.editMessage(chatId, msgId, t(ports, 'ask_number'), [], false);
  }
  clearState(ports, uid);
  var amount = arg === 'all' ? info.owed : Number(arg);
  return commitPaymentAndReply(chatId, msgId, groupId, amount, staff, updateId, ports, CFG.SOURCE.BUTTON, '', null, uid);
}

function commitPaymentAndReply(chatId, msgId, groupId, amount, staff, updateId, ports, source, transcript, method, uid) {
  var info = saleGroupInfo(ports, groupId);
  if (!info || info.owed <= 0) return ports.chat.sendMessage(chatId, t(ports, 'pay_none'));
  var r = commitPayment(ports, { groupId: groupId, amount: amount, method: method, staff: staff, source: source, transcript: transcript, updateId: updateId });
  var after = saleGroupInfo(ports, groupId);
  if (uid) setLastGroup(ports, uid, r.groupId);
  var text = t(ports, 'pay_done', { customer: customerName(ports, after.customerId), amount: fmtMoney(r.txs[0].amount), owed: fmtMoney(after.owed) }) + methodLine(ports, method);
  var kb = replyKeyboard(ports, r.groupId), view = { kind: 'group', id: r.groupId };
  if (msgId) return editOrSend(ports, chatId, msgId, text, kb, false, view);
  return sendView(ports, chatId, text, kb, view);
}

/* ------------------------------ deposits ------------------------------ */

function startDeposit(chatId, uid, staff, ports, presetAmount, prefix) {
  setState(ports, uid, { kind: 'dep', step: 'customer', amount: presetAmount || null });
  var rows = recentCustomers(ports, staff.shop, 4).map(function (c) { return [btn('👤 ' + c.name, 'DC|' + c.id)]; });
  rows.push([btn(t(ports, 'btn_new_customer'), 'DC|new'), btn(t(ports, 'btn_cancel'), 'Z')]);
  return ports.chat.sendMessage(chatId, (prefix || '') + t(ports, 'dep_ask_customer'), rows);
}

function depCustomer(chatId, msgId, uid, arg, staff, ports) {
  var state = getState(ports, uid);
  if (!state || state.kind !== 'dep') state = { kind: 'dep', step: 'customer', amount: null };
  if (arg === 'new') {
    state.step = 'name';
    setState(ports, uid, state);
    return ports.chat.sendMessage(chatId, t(ports, 'ask_name'));
  }
  var customerId = arg;
  if (arg === 'create') {
    if (!state.name) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
    customerId = ports.store.addCustomer({ name: state.name }).id;
  }
  return depositForCustomer(chatId, msgId, uid, customerId, state, staff, ports);
}

function depositNamed(chatId, uid, state, name, staff, ports) {
  var c = pickCustomer(chatId, uid, state, name, ports, function (x) { return 'DC|' + x; });
  if (!c) return;
  return depositForCustomer(chatId, null, uid, c.id, state, staff, ports);
}

function depositForCustomer(chatId, msgId, uid, customerId, state, staff, ports) {
  if (state && state.amount) return askDepositNote(chatId, msgId, uid, customerId, state.amount, staff, ports);
  return askDepositAmount(chatId, msgId, uid, customerId, staff, ports);
}

function askDepositAmount(chatId, msgId, uid, customerId, staff, ports) {
  var c = ports.store.getCustomer(customerId);
  if (!c) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
  setState(ports, uid, { kind: 'await_number', purpose: 'dep_amount', customerId: customerId });
  var presets = depositPresets(ports).map(function (a) { return btn(fmtMoney(a), 'DA|' + customerId + '|' + a); });
  var kb = [presets, [btn(t(ports, 'btn_other'), 'DA|' + customerId + '|other'), btn(t(ports, 'btn_cancel'), 'Z')]];
  var text = t(ports, 'dep_ask_amount', { customer: c.name });
  if (msgId) return ports.chat.editMessage(chatId, msgId, text, kb, false);
  return ports.chat.sendMessage(chatId, text, kb);
}

function depAmount(chatId, msgId, uid, customerId, arg, staff, ports) {
  if (arg === 'other') {
    setState(ports, uid, { kind: 'await_number', purpose: 'dep_amount', customerId: customerId });
    return ports.chat.editMessage(chatId, msgId, t(ports, 'ask_number'), [], false);
  }
  return askDepositNote(chatId, msgId, uid, customerId, Number(arg), staff, ports);
}

function askDepositNote(chatId, msgId, uid, customerId, amount, staff, ports) {
  setState(ports, uid, { kind: 'dep', step: 'note', customerId: customerId, amount: amount });
  var kb = [[btn(t(ports, 'btn_skip'), 'DN|' + customerId + '|' + amount), btn(t(ports, 'btn_cancel'), 'Z')]];
  var text = t(ports, 'dep_ask_note');
  if (msgId) return ports.chat.editMessage(chatId, msgId, text, kb, false);
  return ports.chat.sendMessage(chatId, text, kb);
}

function finishDeposit(chatId, msgId, uid, customerId, amount, note, staff, updateId, ports, source, transcript, method) {
  clearState(ports, uid);
  var c = ports.store.getCustomer(customerId);
  if (!c) return ports.chat.sendMessage(chatId, t(ports, 'expired'));
  var r = commitDeposit(ports, { customerId: customerId, amount: amount, note: note, method: method, shop: staff.shop, staff: staff, source: source, transcript: transcript, updateId: updateId });
  setLastGroup(ports, uid, r.groupId);
  var text = t(ports, 'dep_done', { customer: c.name, amount: fmtMoney(amount), held: fmtMoney(depositsFor(ports, customerId)) }) + methodLine(ports, method);
  var kb = replyKeyboard(ports, r.groupId).concat(phoneRow(ports, c)), view = { kind: 'group', id: r.groupId };
  if (msgId) return editOrSend(ports, chatId, msgId, text, kb, false, view);
  return sendView(ports, chatId, text, kb, view);
}

/* ------------------------------ expenses by buttons ------------------------------ */

/** M|exp: owners pick the shop first; staff go straight to the category grid. Three taps commit. */
function startExpense(chatId, uid, staff, ports) {
  // The app with its forms (round 6): the expense form, one screen.
  if (formsInApp(ports)) {
    clearState(ports, uid);
    return ports.ui.openForm('expense', { chatId: chatId, uid: uid, staff: staff });
  }
  if (staff.role === 'owner') {
    setState(ports, uid, { kind: 'exp', step: 'shop', draft: {} });
    var shops = CFG.SHOP_IDS.map(function (s) { return btn(shopName(ports, s), 'ES|' + s); });
    return ports.chat.sendMessage(chatId, t(ports, 'exp_ask_shop'), [shops, [btn(t(ports, 'btn_cancel'), 'Z')]]);
  }
  setState(ports, uid, { kind: 'exp', step: 'cat', draft: { shop: staff.shop } });
  var scr = expenseCatScreen(ports, staff.shop);
  return ports.chat.sendMessage(chatId, scr.text, scr.kb);
}

/**
 * The category grid: the active expense categories of that shop with their emoji, three per row; the last row
 * adds a category on the spot (➕) or cancels. A button whose callback data would exceed 64 bytes is skipped.
 */
function expenseCatScreen(ports, shop) {
  var rows = [], row = [];
  expenseCategories(ports, shop).forEach(function (c) {
    var data = 'EC|' + c[0];
    if (utf8ByteLength(data) > 64) return;
    row.push(btn(expenseEmoji(ports, c[0]) + ' ' + c[1], data));
    if (row.length === 3) { rows.push(row); row = []; }
  });
  if (row.length) rows.push(row);
  rows.push([btn(t(ports, 'btn_add_cat'), 'LA|ec|EC'), btn(t(ports, 'btn_cancel'), 'Z')]);
  return { text: t(ports, 'exp_ask_cat'), kb: rows };
}

function expenseState(ports, uid, step) {
  var s = getState(ports, uid);
  return s && s.kind === 'exp' && s.draft && (!step || s.step === step) ? s : null;
}

function expenseShop(chatId, msgId, uid, shop, staff, ports) {
  var state = expenseState(ports, uid, 'shop');
  if (!state || CFG.SHOP_IDS.indexOf(shop) < 0) return ports.chat.editMessage(chatId, msgId, t(ports, 'expired'), [], false);
  state.draft.shop = shop;
  state.step = 'cat';
  setState(ports, uid, state);
  var scr = expenseCatScreen(ports, shop);
  return ports.chat.editMessage(chatId, msgId, scr.text, scr.kb, false);
}

/** EC|<key>: the amount screen. prefix (and no msgId): resumed after ➕ added the category, as one new message. */
function expenseCategory(chatId, msgId, uid, cat, staff, ports, prefix) {
  var state = expenseState(ports, uid, 'cat');
  if (!state) return editOrSend(ports, chatId, msgId, withPrefix(prefix, t(ports, 'expired')), []);
  state.draft.cat = String(cat || 'other').toLowerCase();
  state.step = 'amount';
  setState(ports, uid, state);
  var presets = expensePresets(ports, state.draft.cat).map(function (a) { return btn(fmtMoney(a), 'EA|' + a); });
  var kb = [presets, [btn(t(ports, 'btn_other'), 'EA|other'), btn(t(ports, 'btn_cancel'), 'Z')]];
  return editOrSend(ports, chatId, msgId, withPrefix(prefix, t(ports, 'exp_ask_amount', { cat: categoryLabel(ports, state.draft.cat) })), kb);
}

function expenseAmountTap(chatId, msgId, uid, arg, staff, ports) {
  var state = expenseState(ports, uid, 'amount');
  if (!state) return ports.chat.editMessage(chatId, msgId, t(ports, 'expired'), [], false);
  if (arg === 'other') {
    setState(ports, uid, { kind: 'await_number', purpose: 'exp_amount', draft: state.draft });
    return ports.chat.editMessage(chatId, msgId, t(ports, 'ask_number'), [], false);
  }
  return expenseAmount(chatId, msgId, uid, state, Number(arg), staff, ports);
}

/** The amount is known (tap, typed or spoken): ask how it was paid. 💵 first, then one 🏦 per account of the shop, ➕, cancel. */
function expenseAmount(chatId, msgId, uid, state, amount, staff, ports) {
  amount = Math.abs(Math.round(Number(amount) || 0));
  var draft = state.draft || {};
  if (!amount) {
    setState(ports, uid, { kind: 'await_number', purpose: 'exp_amount', draft: draft });
    return ports.chat.sendMessage(chatId, t(ports, 'ask_number'));
  }
  draft.amount = amount;
  setState(ports, uid, { kind: 'exp', step: 'method', draft: draft });
  var text = t(ports, 'exp_ask_method', { cat: categoryLabel(ports, draft.cat), amount: fmtMoney(amount) });
  var kb = methodRows(ports, draft.shop || staff.shop, null, function (k) { return 'EM|' + k; }, { add: 'LA|pm|EM' });
  kb.push([btn(t(ports, 'btn_cancel'), 'Z')]);
  if (msgId) return ports.chat.editMessage(chatId, msgId, text, kb, false);
  return ports.chat.sendMessage(chatId, text, kb);
}

/**
 * EM|METHOD commits at once (category, amount, method = three taps); a note can be added afterwards.
 * prefix and hint (and no msgId): resumed after ➕ added the account, as one new message.
 */
function expenseMethod(chatId, msgId, uid, method, staff, updateId, ports, prefix, hint) {
  var state = expenseState(ports, uid, 'method');
  method = String(method || CFG.METHOD.CASH).toUpperCase();
  // A stale screen, or a key the lists do not know (a retired account still counts): nothing is written.
  if (!state || !state.draft.amount || !methodKnown(ports, method)) {
    return editOrSend(ports, chatId, msgId, withHintLine(withPrefix(prefix, t(ports, 'expired')), hint), withHintRow([], hint));
  }
  clearState(ports, uid);
  var d = state.draft;
  var r = commitExpense(ports, { amount: d.amount, shop: d.shop || staff.shop, category: d.cat, method: method, note: '',
    staff: staff, source: CFG.SOURCE.BUTTON, updateId: updateId });
  setLastGroup(ports, uid, r.groupId);
  markCommittedCard(ports, chatId, msgId);
  var text = t(ports, 'expense_done', { amount: fmtMoney(d.amount), cat: categoryLabel(ports, d.cat), note: '', method: methodLabel(ports, method) });
  return editOrSend(ports, chatId, msgId, withHintLine(withPrefix(prefix, text), hint), withHintRow(replyKeyboard(ports, r.groupId), hint), false,
    { kind: 'group', id: r.groupId });
}

/** EN|group: the optional note, attached to the expense within the state TTL as a rewrite of its row. */
function askExpenseNote(chatId, uid, groupId, ports) {
  var chk = rewriteCheck(ports, groupId);
  if (!chk.ok) return ports.chat.sendMessage(chatId, rewriteRefusal(ports, chk.reason));
  setState(ports, uid, { kind: 'await_text', purpose: 'exp_note', groupId: groupId });
  return ports.chat.sendMessage(chatId, t(ports, 'exp_ask_note'), [[btn(t(ports, 'btn_cancel'), 'Z')]]);
}

function attachExpenseNote(chatId, uid, groupId, note, staff, updateId, ports, source, transcript) {
  clearState(ports, uid);
  note = String(note || '').trim();
  if (!note) return askExpenseNote(chatId, uid, groupId, ports);
  var r = rewriteGroup(ports, groupId, { note: note }, staff, updateId, { source: source, transcript: transcript });
  if (!r.ok) return ports.chat.sendMessage(chatId, rewriteRefusal(ports, r.reason));
  var row = r.row;
  var text = t(ports, 'exp_note_saved') + '\n' + t(ports, 'expense_done', { amount: fmtMoney(-row.amount), cat: categoryLabel(ports, row.category),
    note: ' · ' + note, method: methodLabel(ports, methodOf(row)) });
  return ports.chat.sendMessage(chatId, text, replyKeyboard(ports, groupId));
}

/* ------------------------------ reports and receipts ------------------------------ */

function showReportMenu(chatId, staff, ports) {
  var rows = [
    [btn(t(ports, 'rep_today'), 'RP|today'), btn(t(ports, 'rep_month'), 'RP|month'), btn(t(ports, 'rep_last'), 'RP|last')],
    [btn(t(ports, 'rep_stock'), 'RP|stock'), btn(t(ports, 'rep_owed'), 'RP|owed'), btn(t(ports, 'rep_expense'), 'RP|exp')]
  ];
  if (ordersEnabled(ports)) rows.push([btn(t(ports, 'rep_orders'), 'RP|orders')]);
  return ports.chat.sendMessage(chatId, t(ports, 'rep_menu'), rows);
}

function sendReport(chatId, kind, staff, ports) {
  ports.chat.typing(chatId);
