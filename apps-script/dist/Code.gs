/**
 * The unfilled text of a message (the Sheet override first, then the default above, else the key): for the callers
 * that need the template itself, such as the text of a button up to its first placeholder (the label rule of the
 * guided sale and the simulator). t() fills every {placeholder}, with '' when no value is given, so it cannot be split on '{'.
 */
function msgTemplate(ports, key) {
  var s = null;
  if (ports && ports.store && ports.store.getMessage) s = ports.store.getMessage(key);
  if (s === null || s === undefined || s === '') s = MSG[key];
  if (s === undefined) s = key;
  return String(s);
}

/** Look up a message: Sheet override first, then the default above. */
function t(ports, key, vars) {
  var s = null;
  if (ports && ports.store && ports.store.getMessage) s = ports.store.getMessage(key);
  if (s === null || s === undefined || s === '') s = MSG[key];
  if (s === undefined) s = key;
  return fill(s, vars);
}

